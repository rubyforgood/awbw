<div class="mx-auto max-w-6xl px-4 py-8">
  <div class="border-primary/10 mx-auto max-w-6xl rounded-2xl border bg-white p-6 shadow-sm">
    <h1 class="text-primary mb-4 font-display text-2xl font-semibold">
      <%= @viewing_self ? "My" : "#{@user_name}'s" %> Bookmarks
    </h1>

    <div class="mt-4 pt-4">
      <%= render "search_boxes", url: personal_bookmarks_path, frame_id: "personal_bookmarks_results" %>

      <%= render "bookmarks_count" %>

      <% result_src = personal_bookmarks_path + "?" + request.query_string %>
      <%= turbo_frame_tag "personal_bookmarks_results", src: result_src do %>
        <%= render "personal_results_skeleton" %>
      <% end %>
    </div>
  </div>
</div>

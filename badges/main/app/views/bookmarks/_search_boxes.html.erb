<%= form_with url: url,
              method: :get,
              data: { controller: "collection",
                      turbo_frame: frame_id },
              autocomplete: "off",
              class: "space-y-4" do |f| %>
  <%= render "search_fields" %>

  <!-- Clear filters -->
  <div class="flex items-end sm:justify-end">
    <%= render "shared/search_clear", url: url %>
  </div>
<% end %>

<h1>Workshop log received</h1>

<div style="margin-top: 36px; text-align: left;">
  <p>
    Hello <strong><%= @user.name %></strong>,
  </p>

  <p>
    Thank you for submitting your workshop log. We have received it and will review it shortly.
  </p>

  <% if @report.present? %>
    <div style="text-align: center; background-color: #f3f4f6; border-radius: 6px; padding: 24px; margin: 16px 0;">
      <h2 style="font-size: 22px; font-weight: bold; color: #166534; margin: 0 0 8px; font-family: Lato, sans-serif;">
        <%= @noticeable.workshop&.title %>
      </h2>

      <% if @noticeable.windows_type.present? %>
        <p style="font-size: 16px; color: #374151; margin: 0 0 4px;">
          <%= @noticeable.windows_type.short_name %>
        </p>
      <% end %>

      <p style="font-size: 13px; color: #6b7280; margin: 0;">
        Submitted on <%= @noticeable.created_at
                                    .in_time_zone("Pacific Time (US & Canada)")
                                    .strftime("%B %-d, %Y at %-l:%M %p %Z") %>
      </p>
    </div>
  <% end %>
</div>

<p>
  <% if @report.present? %>
    <%= link_to "View workshop log",
                workshop_log_url(@report),
                style: "display:inline-block;
                        padding:10px 16px;
                        background:#2563eb;
                        color:#ffffff;
                        text-decoration:none;
                        border-radius:6px;
                        font-weight:bold;" %>
  <% end %>
</p>

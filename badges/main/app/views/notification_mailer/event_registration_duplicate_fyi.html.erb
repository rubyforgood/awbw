<p style="margin-bottom: 6px; font-weight: bold; color: #b91c1c;">
  DUPLICATE <%= @event_registration.registration_subject_noun %>
</p>

<h1 style="margin: 0;">
  <strong><%= @person.full_name %></strong>
  (<%= @person.preferred_email %>)
</h1>

<p style="margin: 4px 0 16px; font-size: 13px; color: #6b7280;">
  Resubmitted on
  <%= @resubmitted_at.in_time_zone("Pacific Time (US & Canada)").strftime("%B %-d, %Y at %-l:%M %p %Z") %>.
  Originally registered on
  <%= @event_registration.created_at.in_time_zone("Pacific Time (US & Canada)").strftime("%B %-d, %Y at %-l:%M %p %Z") %>.
  The answers were added to the existing registration.
</p>

<%= render "shared/resubmission_changes", notes: @change_notes %>

<%= render "event_registration_fyi_details" %>

<div class="min-h-screen py-10">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-lg sm:p-8">
      <div class="mb-6 flex items-center">
        <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-yellow-100">
          <svg
            class="h-6 w-6 text-yellow-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            />
          </svg>
        </div>

        <h1 class="ml-4 text-xl font-semibold text-gray-900">Possible duplicate organization</h1>
      </div>

      <p class="mb-2 text-sm text-gray-600">Checking: <span class="font-medium text-gray-900"><%= @name %></span></p>

      <p class="mb-4 text-sm text-gray-500">
        We found existing organizations in the system with a similar name.
      </p>

      <p class="mt-4 mb-2 text-sm text-gray-500">
        Please review the list below:
      </p>

      <ul class="mb-6 divide-y divide-gray-200 rounded-lg border border-gray-200">
        <% @duplicates.each do |dup| %>
          <li class="px-4 py-3">
            <div class="flex flex-wrap items-center gap-2">
              <%= link_to dup[:name],
                          organization_path(dup[:id]),
                          target: "_blank",
                          class: "text-blue-600 hover:text-blue-800 underline font-medium" %>

              <% if dup[:blocked] %>
                <span class="text-2xs rounded bg-red-100 px-1.5 py-0.5 font-medium text-red-700">exact match</span>
              <% else %>
                <span class="text-2xs rounded bg-yellow-100 px-1.5 py-0.5 font-medium text-yellow-700">similar match</span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>

      <div class="flex flex-col items-center gap-3">
        <% shareable_url = check_duplicates_organizations_url(name: @name) %>

        <%= mail_to "",
              "Ask a colleague",
              subject: "Possible duplicate organization: #{@name}",
              body: "I'm trying to add a new organization and found a possible duplicate. Can you take a look?\n\n#{shareable_url}",
              class: "text-sm text-gray-500 hover:text-blue-600 underline" %>
      </div>
    </div>
  </div>
</div>

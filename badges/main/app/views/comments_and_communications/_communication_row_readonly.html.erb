<%# One automated-email row on the combined feed — read-only. An autoemail is
    generated by the system, not authored, so unlike communication_row (manually
    logged communications) it carries no Edit affordance — only the same quick
    "Responded" toggle the notifications index offers (e.g. for a contact-us
    FYI, which needs a reply despite being system-generated). Locals: entry (a
    Notification where entry.manual_log? is false). %>
<% chip_class = "inline-flex shrink-0 items-center gap-1 rounded-full border border-gray-300 bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-900" %>
<% record = entry.noticeable %>
<% source_chip = if record.present?
     inner = safe_join([ entry.decorate.channel_icon, commentable_label(record) ], " ")
     path = record_edit_path(record)
     path ? link_to(inner, path, target: "_blank", rel: "noopener", class: "#{chip_class} hover:underline") : content_tag(:span, inner, class: chip_class)
   end %>
<% trailing = content_tag(:span, render("notifications/responded_checkbox", notification: entry), class: "ml-auto shrink-0") %>
<div id="<%= dom_id(entry) %>">
  <%= render "notifications/communication_line", notification: entry, admin: true, truncate: false, leading: source_chip, trailing: trailing %>
</div>

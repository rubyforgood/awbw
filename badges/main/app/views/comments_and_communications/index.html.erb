<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<% return_record = notification_return_record %>
<%# Topbar: back to the record whose combined section linked here, then the
    person's profile, then the global people list when the feed spans everyone
    — paired with quick nav to other admin areas on the right. %>
<% topbar = capture do %>
  <% if return_record %>
    <%= link_to notification_return_path(return_record), class: "inline-flex items-center gap-1.5 text-sm #{eyebrow_link_class} px-2 py-1" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> <%= noticeable_label(return_record) %>
    <% end %>
  <% elsif @person %>
    <%= link_to person_path(@person), class: "inline-flex items-center gap-1.5 text-sm #{eyebrow_link_class} px-2 py-1" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> Back to <%= @person.full_name %>
    <% end %>
  <% else %>
    <%= link_to people_path, class: "inline-flex items-center gap-1.5 text-sm #{eyebrow_link_class} px-2 py-1" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> Back to people
    <% end %>
  <% end %>

  <div class="flex flex-wrap items-center gap-1">
    <%= link_to "Events", events_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
    <%= link_to "People", people_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
    <%= link_to "Activities", admin_activities_events_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
  </div>
<% end %>
<% subtitle = capture do %>
  <%= pluralize(@total_count, "entry", plural: "entries") %><% if @flagged_count.positive? %> · <span class="font-medium text-orange-600"><%= @flagged_count %> flagged</span><% end %>
<% end %>
<%# Title: the person's name (or "Everyone"), with the jump-to-a-person picker
    right beside it — a full page swap (title, eyebrow, ready composers), not a
    same-page filter. A <span> (not <div>) keeps this valid phrasing content
    inside the layout's <h1>. %>
<% title = capture do %>
  <%= @person ? link_to(@person.full_name, person_path(@person), class: "hover:underline") : "Everyone" %>
  <span class="ml-3 inline-flex items-center gap-2 align-middle">
    <%= select_tag :jump_person_id, options_for_select([]),
                   include_blank: true, prompt: "Jump to a person…",
                   class: "w-44 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-sans focus:border-blue-500 focus:ring-blue-500",
                   data: { controller: "remote-select navigate-select",
                           remote_select_model_value: "person",
                           remote_select_exclude_value: @person&.id,
                           navigate_select_url_template_value: comments_and_communications_path(person_id: "__ID__"),
                           action: "change->navigate-select#navigate" } %>
    <% if @person %>
      <%= link_to "View everyone", comments_and_communications_path, class: "text-xs font-sans #{eyebrow_link_class} whitespace-nowrap hover:underline" %>
    <% end %>
  </span>
<% end %>

<%= render layout: "shared/index_page",
           locals: { domain: :people, surface: "bg-white", eyebrow: "Comments & communications",
                     title: title, subtitle: subtitle, topbar: topbar } do %>
  <div class="space-y-6">
    <%# Add-a-note / log-a-communication, each revealing a composer with a picker
        for which of the person's records to file it against. On a person's own
        feed the composers are ready; on the everyone feed you pick the person
        first and the composers (with that person's records) load into the frame. %>
    <% if @person %>
      <%= render "comments_and_communications/add_area", person: @person,
                 new_comment: @new_comment, new_notification: @new_notification,
                 record_targets: @record_targets %>
    <% else %>
      <div class="bg-brand-cream rounded-lg border border-gray-200 p-4">
        <%= form_with url: composers_comments_and_communications_path, method: :get,
                      data: { controller: "collection", turbo_frame: "cc_composers" },
                      class: "flex items-center gap-2" do %>
          <label for="person_id" class="text-xs font-semibold tracking-wide whitespace-nowrap text-gray-500 uppercase">Add for a person</label>
          <%= select_tag :person_id, options_for_select([]),
                         include_blank: true, prompt: "Search people…",
                         class: "min-w-[240px] rounded-lg border border-gray-300 bg-white px-3 py-2 focus:border-blue-500 focus:ring-blue-500",
                         data: { controller: "remote-select", remote_select_model_value: "person" } %>
        <% end %>
        <%= turbo_frame_tag "cc_composers", class: "mt-3 block" %>
      </div>
    <% end %>

    <%= render "comments_and_communications/comments_and_communications_filters",
               url: comments_and_communications_path(person_id: @person&.id),
               clear_path: comments_and_communications_path(person_id: @person&.id),
               frame: "comments_and_communications_results" %>

    <% result_src = comments_and_communications_path(request.query_parameters) %>
    <%= turbo_frame_tag "comments_and_communications_results", src: result_src, data: { turbo: "temporary" } do %>
      <div class="py-6 text-center text-sm text-gray-400">Loading comments &amp; communications…</div>
    <% end %>
  </div>
<% end %>

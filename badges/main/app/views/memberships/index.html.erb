<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<div class="mx-auto max-w-6xl">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-primary font-display text-2xl font-bold">Memberships</h1>
    <%= link_to "Membership invoices", membership_invoices_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
  </div>

  <%= render "memberships/filters", status: @status_filter %>

  <%= turbo_frame_tag :memberships_results,
        src: memberships_path(status: @status_filter, person_name: params[:person_name]),
        data: { turbo: "temporary" } do %>
    <%= render "memberships/results_skeleton" %>
  <% end %>
</div>

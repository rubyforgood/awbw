<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<% active_membership = @memberships.any? { |membership| !membership.cancelled? } %>

<div class="mx-auto max-w-3xl bg-white border border-gray-200 rounded-xl shadow p-4 sm:p-6">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-6">
    <%= link_to person_path(@person), class: "text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> <%= @person.full_name %>
    <% end %>
    <%= link_to "All memberships", membership_invoices_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <div class="flex flex-wrap items-end justify-between gap-2 mb-6">
    <div>
      <h1 class="text-2xl font-bold mb-1">Memberships</h1>
      <p class="text-sm text-gray-500"><%= @person.full_name %></p>
    </div>
    <% if !active_membership || params[:admin] == "true" %>
      <%= link_to new_person_membership_path(@person), class: "btn btn-primary inline-flex items-center gap-1.5" do %>
        <i class="fa-solid fa-plus text-xs"></i>
        New membership
      <% end %>
    <% end %>
  </div>

  <% if @memberships.none? %>
    <p class="text-gray-500 italic">No membership yet.</p>
  <% else %>
    <div class="space-y-6">
      <% @memberships.each do |membership| %>
        <div class="border border-gray-200 rounded-lg p-3 sm:p-4">
          <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 mb-3">
            <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm">
              <span class="text-gray-600">Cost: <span class="font-medium text-gray-800"><%= membership.cost_label %></span></span>
              <span class="text-gray-600">Status: <span class="font-medium text-gray-800"><%= membership.status_label %></span></span>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <% if !membership.covered_on? || params[:admin] == "true" %>
                <%= link_to "Add invoice", new_membership_membership_invoice_path(membership), class: "btn btn-secondary-outline btn-sm" %>
              <% end %>
              <%= link_to "Edit cost", edit_membership_path(membership), class: "btn btn-secondary-outline btn-sm" %>

              <% if !membership.cancelled? %>
                <%= button_to "Cancel", membership_path(membership),
                      method: :patch, class: "btn btn-secondary-outline btn-sm",
                      params: { membership: { cancelled: "1" } },
                      data: { turbo_confirm: "Stop renewing membership for #{@person.full_name}? They keep the invoice period they have already paid for." } %>
              <% elsif !active_membership %>
                <%= button_to "Resume", membership_path(membership),
                      method: :patch, class: "btn btn-secondary-outline btn-sm",
                      params: { membership: { cancelled: "0" } },
                      data: { turbo_confirm: "Resume renewals for #{@person.full_name}?" } %>
              <% end %>
            </div>
          </div>

          <% if membership.membership_invoices.empty? %>
            <p class="text-gray-500 italic">No membership invoices yet.</p>
          <% else %>
            <ul class="space-y-2">
              <% membership.membership_invoices.each do |invoice| %>
                <%= render "membership_invoices/invoice_row", invoice: invoice, editable: true, linked: true %>
              <% end %>
            </ul>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<div class="max-w-7xl mx-auto px-6 py-8 space-y-10">
  <div class="admin-only bg-blue-100 rounded p-6">
    <div class="bg-gray-50 rounded py-6">
      <div class="flex justify-between items-center mb-6">
        <section class="pl-8">
          <div class="flex flex-col items-start mb-4">
            <h1 class="text-3xl font-bold text-gray-900 my-2">System notifications</h1>
          </div>

          <%= render "search_boxes" %>
          <div class="overflow-x-auto bg-white border border-gray-200 rounded-lg shadow-sm">
           <%= render "index" %>
          </div>

          <!-- Pagination -->
          <div class="pagination flex justify-center mt-12">
            <%= tailwind_paginate @notifications %>
          </div>
        </section>
      </div>
    </div>
  </div>
</div>

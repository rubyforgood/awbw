<div class="overflow-hidden rounded-2xl border-2 shadow-sm <%= profile_hidden_wash_class %>"
     data-controller="expandable-card"
     data-expandable-card-expanded-value="true">
  <!-- Header -->
  <button type="button" data-action="expandable-card#toggle"
          aria-expanded="true"
          class="section-header flex w-full items-center gap-3 border-b px-5 py-4 text-left sm:px-6 <%= profile_hidden_border_class %>">
    <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-white <%= profile_hidden_icon_class %>">
      <i class="fa-solid fa-id-card"></i>
    </span>
    <h2 class="font-display text-2xl text-gray-900">Annual membership</h2>
    <span class="ml-auto flex items-center gap-3">
      <span class="text-sm italic <%= profile_hidden_text_class %>"><%= owner_and_admins_label(person) %></span>
      <i class="fa-solid fa-chevron-down rotate-180 text-gray-400 transition-transform" data-expandable-card-target="icon"></i>
    </span>
  </button>
  <!-- Membership -->
  <div class="section-content space-y-4 px-4 py-5 sm:px-6 sm:py-6"
       data-expandable-card-target="body">
    <% if membership&.current_invoice %>
      <ul>
        <%= render "membership_invoices/invoice_row", invoice: membership.current_invoice %>
      </ul>
    <% end %>

    <div>
      <% if autopay %>
        <p class="text-sm text-gray-700">Your membership renews automatically on the card you have on file.</p>
      <% else %>
        <p class="mb-3 text-sm text-gray-700">
          Set up your membership to renew automatically each year at
          <%= dollars_from_cents(membership&.cost_cents || Membership::ANNUAL_COST_CENTS) %>.
        </p>
        <%# Turbo can't follow the cross-origin redirect to Stripe Checkout. %>
        <%= button_to "Set up annual membership", membership_checkouts_path,
                      class: button_classes(:primary),
                      data: { turbo: false } %>
      <% end %>
    </div>
  </div>
</div>

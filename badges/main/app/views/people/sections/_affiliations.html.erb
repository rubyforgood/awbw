<%= turbo_frame_tag "person_affiliations_section" do %>
  <% grouped = affiliations.select { |a| a.organization.present? }.group_by(&:organization) %>
  <% if grouped.any? %>
    <div class="grid grid-cols-1 gap-2 blur-on-submit sm:grid-cols-2">
      <% grouped.each do |organization, org_affiliations| %>
        <% titles = org_affiliations.filter_map { |a| a.title.presence }.uniq %>
        <% titles = titles.sort_by { |t| [t.downcase.include?("facilitator") ? 0 : 1, t.downcase] } %>
        <%= organization_profile_button(organization, subtitle: titles.any? ? titles.join(", ") : nil, data: { turbo_frame: "_top" }) %>
      <% end %>
    </div>
    <div class="mt-6 flex justify-center">
      <%= tailwind_paginate affiliations, params: { section: "affiliations" } %>
    </div>
  <% else %>
    <p class="text-gray-500 italic">No active affiliations.</p>
  <% end %>
  <%# Admins see the same "which organization / what to change" options the person gets. %>
  <% if allowed_to?(:index?, ProfileChangeRequest) %>
    <div class="mt-4">
      <%= link_to new_profile_change_request_path(person_id: person, field: "affiliation"),
                  data: { turbo_frame: "_top" }, class: admin_button_classes do %>
        <i class="fa-solid fa-list-check"></i> Change request options
      <% end %>
    </div>
  <% end %>
<% end %>

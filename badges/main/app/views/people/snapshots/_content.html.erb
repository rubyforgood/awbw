<% person = snapshot.person %>
<div class="p-6">
  <p id="person_snapshot_title" class="pr-8 text-sm text-gray-600">
    <span class="font-semibold text-gray-900"><%= person_name(person) %></span>

    <% if person.preferred_email.present? %>
      <span class="text-gray-400">·</span>
      <%= person.preferred_email %>
    <% end %>
  </p>

  <div class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-3">
    <% if snapshot.affiliations.any? || snapshot.affiliated_since.present? %>
      <section class="col-span-full mt-5 grid grid-cols-subgrid">
        <h2 class="col-span-full mb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase"><%= snapshot.affiliations_heading %></h2>
        <% if snapshot.affiliations.any? %>
          <ul class="col-span-full grid grid-cols-subgrid gap-y-3">
            <% snapshot.affiliation_rows.each do |row| %>
              <% affiliation = row.affiliation.decorate %>
              <li class="col-span-full grid grid-cols-subgrid items-start">
                <%# The pill means "facilitator here" — JA-only rows leave the slot blank. %>
                <span><%= affiliation.status_badge if affiliation.facilitator? %></span>
                <div class="min-w-0">
                  <%= link_to affiliation.organization.name, organization_path(affiliation.organization),
                              class: "block font-medium hover:underline" %>
                  <p class="text-xs text-gray-500"><%= affiliation.display_title %> · <%= affiliation.period_label %></p>
                  <% row.job_affiliations.each do |job| %>
                    <% job = job.decorate %>
                    <p class="text-xs text-gray-500"><%= job.display_title %> · <%= job.period_label %></p>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>
    <% end %>

    <% if snapshot.empty? %>
      <p class="col-span-full mt-4 text-sm text-gray-500 italic">No snapshot content yet.</p>
    <% else %>
      <% if snapshot.trainings.any? %>
        <section class="col-span-full mt-5 grid grid-cols-subgrid">
          <h2 class="col-span-full mb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">Facilitator trainings</h2>
          <ul class="col-span-full grid grid-cols-subgrid gap-y-3">
            <% snapshot.trainings.each do |registration| %>
              <% registration = registration.decorate %>
              <li class="col-span-full grid grid-cols-subgrid items-start">
                <span class="inline-flex items-center gap-1 justify-self-start rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap <%= registration.attendance_status_classes %>">
                  <%= render "event_registrations/attendance_status_label",
                             icon: registration.attendance_status_icon,
                             label: registration.compact_attendance_status_label,
                             outcome: registration.pre_transfer_outcome %>
                </span>
                <div class="min-w-0">
                  <%= link_to truncate(registration.event.title, length: 50), event_path(registration.event),
                              class: "block font-medium hover:underline" %>
                  <p class="text-xs text-gray-500"><%= [ registration.event.decorate.short_date_range, *registration.organizations.map(&:name) ].compact_blank.join(" · ") %></p>
                </div>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <% if (membership = snapshot.membership) %>
        <% membership = membership.decorate %>
        <section class="col-span-full mt-5 grid grid-cols-subgrid">
          <h2 class="col-span-full mb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">Membership</h2>
          <ul class="col-span-full grid grid-cols-subgrid gap-y-3">
            <li class="col-span-full grid grid-cols-subgrid items-start">
              <% if membership.payment_badge? %>
                <span class="inline-flex items-center justify-self-start rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap <%= membership.payment_classes %>">
                  <%= membership.payment_label %>
                </span>
              <% end %>
              <div class="col-start-2 min-w-0">
                <%= link_to membership.status_label, membership_path(membership),
                            class: "block font-medium hover:underline" %>
                <p class="text-xs text-gray-500"><%= membership.period_label %></p>
              </div>
            </li>
          </ul>
        </section>
      <% end %>
    <% end %>
  </div>

  <% footer_link_class = "#{eyebrow_link_class} hover:underline" %>
  <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-gray-100 pt-4 text-sm">
    <%= link_to "Profile", person_path(person), class: footer_link_class %>
    <%= link_to "Edit", edit_person_path(person), class: footer_link_class %>

    <% if person.user.present? %>
      <%= link_to "User", user_path(person.user), class: footer_link_class %>
    <% end %>

    <%= link_to "Activity", person_activity_path(person), class: footer_link_class %>
    <%= link_to "Comments & communications", comments_and_communications_path(person_id: person.id), class: footer_link_class %>
  </div>
</div>

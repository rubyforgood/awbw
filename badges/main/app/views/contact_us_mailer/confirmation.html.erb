<h1>We received your message</h1>

<div style="text-align: left;">
  <p>
    <% if @user.present? %>
      Hello <strong><%= @user.first_name %></strong>,
    <% else %>
      Hello <strong><%= @contact_us[:first_name] %></strong>,
    <% end %>
  </p>

  <p>
    Thank you for reaching out to us. We have received your message
    and our team will respond as soon as possible.
  </p>
</div>

<div style="
  background-color:#f3f4f6;
  border-radius:6px;
  padding:12px;
  margin:16px 0;
  text-align:left;
">
  <p>
    <strong>Subject:</strong> <%= @contact_us[:subject] %>
  </p>

  <p>
    <%= @contact_us[:message] %>
  </p>
</div>

<div style="text-align: left;">
  <p>
    If you have any additional questions, please visit
    <%= link_to "our contact page", contact_us_url %> to connect with staff.
  </p>
</div>

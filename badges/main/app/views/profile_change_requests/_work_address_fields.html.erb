<%# locals: (f:, affiliation:) %>
<% if affiliation&.organization %>
  <p class="text-sm text-gray-600">We'll use it for all your active roles at <%= affiliation.organization.name %>.</p>
<% end %>
<% if affiliation&.organization_address %>
  <p class="text-gray-700">Right now: <span class="font-medium"><%= affiliation.organization_address.name %></span></p>
<% end %>
<% listed = affiliation&.organization&.addresses.to_a.reject { |address| address.inactive? || address.id == affiliation.organization_address_id } %>
<% if listed.any? %>
  <%= f.input :proposed_organization_address_id, label: "Pick your work address",
              collection: listed.map { |address| [ address.name, address.id ] }, include_blank: "Not on the list",
              input_html: { class: "w-full text-lg" } %>
<% end %>
<fieldset class="space-y-3">
  <legend class="mb-2 font-medium text-gray-700"><%= listed.any? ? "Not on the list? Enter it here" : "Your work address" %></legend>
  <%= f.input :proposed_street_address, label: "Street", required: false, input_html: { class: "w-full", autocomplete: "address-line1" } %>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,1fr)_10rem_8rem]">
    <%= f.input :proposed_city, label: "City", required: false, wrapper_html: { class: "mb-0" }, input_html: { class: "w-full", autocomplete: "address-level2" } %>
    <div>
      <%= f.input :proposed_state, label: "State / territory", as: :select, required: false, collection: us_states,
                  selected: (f.object.proposed_state unless outside_usa_state?(f.object.proposed_state)),
                  include_blank: true, wrapper_html: { class: "mb-0" }, input_html: { class: "w-full", autocomplete: "address-level1" } %>
      <%= render layout: "shared/outside_usa", locals: { open: outside_usa_state?(f.object.proposed_state) } do %>
        <%= f.input :proposed_state_outside_usa, label: "Province / State", required: false, wrapper_html: { class: "mb-0" },
                    input_html: { value: (f.object.proposed_state if outside_usa_state?(f.object.proposed_state)), class: "w-full" } %>
      <% end %>
    </div>
    <%= f.input :proposed_zip_code, label: "ZIP code", required: false, wrapper_html: { class: "mb-0" }, input_html: { class: "w-full", autocomplete: "postal-code" } %>
  </div>
</fieldset>

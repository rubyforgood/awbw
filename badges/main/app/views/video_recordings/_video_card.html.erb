<div class="overflow-hidden rounded-xl bg-white shadow-sm transition-shadow hover:shadow-md">
  <% if video_recording.youtube_url.present? %>
    <div class="relative w-full overflow-hidden" style="padding-top: 56.25%;">
      <iframe
        src="<%= youtube_embed_url(video_recording.youtube_url) %>"
        title="<%= video_recording.title %>"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
        class="absolute inset-0 h-full w-full border-0">
      </iframe>
    </div>
  <% end %>

  <div class="flex gap-2 p-4">
    <div class="flex-1">
      <%= link_to title_with_badges(video_recording), video_recording_path(video_recording),
                  class: "hover:text-primary",
                  data: { turbo_frame: "_top" } %>
    </div>
    <div class="flex flex-shrink-0 flex-col gap-2">
      <div class="flex gap-2">
        <%= link_to "View", video_recording_path(video_recording),
                    data: { turbo_frame: "_top" },
                    class: "text-xs px-2 py-1 rounded border border-gray-300 hover:bg-gray-100" %>
        <%= render "bookmarks/editable_bookmark_icon", resource: video_recording %>
      </div>
      <% if allowed_to?(:edit?, video_recording) %>
        <%= link_to "Edit",
                    edit_video_recording_path(video_recording),
                    data: { turbo_frame: "_top" },
                    class: "admin-only bg-blue-100 text-xs px-2 py-1 rounded" %>
      <% end %>
    </div>
  </div>
</div>

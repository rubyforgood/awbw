<div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="animate-pulse bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left">
          <div class="h-4 w-28 rounded bg-gray-200"></div>
        </th>

        <th class="px-6 py-3 text-left">
          <div class="h-4 w-40 rounded bg-gray-200"></div>
        </th>

        <th class="px-6 py-3 text-left">
          <div class="h-4 w-12 rounded bg-gray-200"></div>
        </th>

        <th class="px-6 py-3 text-left">
          <div class="h-4 w-16 rounded bg-gray-200"></div>
        </th>

        <th class="px-6 py-3 text-left">
          <div class="h-4 w-20 rounded bg-gray-200"></div>
        </th>
      </tr>
    </thead>

    <tbody class="animate-pulse divide-y divide-gray-100">
      <% 10.times do %>
        <tr>
          <!-- Person -->
          <td class="px-6 py-4">
            <div class="h-4 w-32 rounded bg-gray-200"></div>
          </td>

          <!-- Invoice period -->
          <td class="px-6 py-4">
            <div class="h-4 w-44 rounded bg-gray-200"></div>
          </td>

          <!-- Cost -->
          <td class="px-6 py-4">
            <div class="h-4 w-12 rounded bg-gray-200"></div>
          </td>

          <!-- Paid -->
          <td class="px-6 py-4">
            <div class="h-4 w-12 rounded bg-gray-200"></div>
          </td>

          <!-- Status -->
          <td class="px-6 py-4">
            <div class="h-6 w-24 rounded-full bg-gray-200"></div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% content_for(:page_title, "Edit invoice details") %>
<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<% invoice = @membership_invoice.decorate %>
<% person = @membership_invoice.person %>

<div class="border-primary/10 mx-auto max-w-2xl rounded-2xl border bg-white p-4 shadow-sm sm:p-6">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
    <%= link_to membership_invoice_path(@membership_invoice), class: "text-sm #{eyebrow_link_class} px-2 py-1" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i>
      Invoice
    <% end %>
  </div>

  <h1 class="text-primary mb-1 font-display text-2xl font-bold">Invoice details</h1>

  <p class="mb-6 text-sm text-gray-500"><%= person.full_name %> &middot; <%= invoice.period_range %></p>

  <%= simple_form_for @membership_invoice do |f| %>
    <%= render "shared/errors", resource: f.object %>

    <div class="space-y-4">
      <%= f.input :bill_to_organization_id,
            as: :select,
            collection: @bill_to_organizations.map { |organization| [ organization.name, organization.id ] },
            selected: @membership_invoice.bill_to_organization_id,
            include_blank: "The member (default)",
            label: "Bill to",
            hint: "Billed to #{person.full_name} unless you pick one of their organizations.",
            input_html: { class: "bg-white" } %>

      <%= f.input :bill_to_address_id,
            as: :select,
            collection: @bill_to_address_options,
            selected: @membership_invoice.bill_to_address_id,
            include_blank: "Default address",
            label: "Address",
            hint: "Default uses the bill-to's invoice address, else their oldest active address.",
            input_html: { class: "bg-white" } %>
    </div>

    <%= f.input :hide_invoicee,
          as: :boolean,
          label: "Hide name from invoice",
          input_html: { class: "h-4 w-4 rounded border-gray-300" } %>

    <%= f.input :hide_address,
          as: :boolean,
          label: "Hide address from invoice",
          input_html: { class: "h-4 w-4 rounded border-gray-300" } %>

    <%= f.input :bill_to_additional_info,
          as: :text,
          label: "Additional info",
          required: false,
          hint: "Printed under the bill-to block.",
          input_html: { rows: 3, class: "bg-white" } %>

    <%= f.input :attention_person_id,
          collection: @membership_invoice.attention_person_id.present? ? [ [ @membership_invoice.attention_person&.compound_search_label&.dig(:label) || "", @membership_invoice.attention_person_id ] ] : [],
          selected: @membership_invoice.attention_person_id,
          required: false,
          input_html: {
            class: "bg-white",
            data: { controller: "remote-select", remote_select_model_value: "person" }
          },
          prompt: "Search a person for attention",
          label: "Attention (optional)",
          hint: "Printed only when set." %>

    <div class="mt-6 flex items-center gap-3 border-t border-gray-200 pt-6">
      <div class="ml-auto flex items-center gap-3"><%= link_to "Cancel", membership_invoice_path(@membership_invoice), class: button_classes(:secondary_outline) %><%= f.button :submit, "Save details", class: button_classes(:primary) %></div>
    </div>
  <% end %>
</div>

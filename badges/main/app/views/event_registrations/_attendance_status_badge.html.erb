<% deco = registration.decorate %>
<div id="<%= dom_id(registration, :attendance_status) %>">
  <%= form_with model: registration, url: event_registration_path(registration), method: :patch, data: { turbo_frame: "_top" } do |f| %>
    <div class="relative inline-flex items-center gap-1.5 rounded-full text-xs font-medium border px-5 py-0.5 <%= deco.attendance_status_classes %>">
      <i class="fas <%= deco.attendance_status_icon %>"></i>
      <%= f.select :status,
            EventRegistration::ATTENDANCE_STATUSES.map { |s| [EventRegistration.new(status: s).attendance_status_label, s] },
            {},
            class: "absolute inset-0 w-full opacity-0 cursor-pointer",
            onchange: "this.form.requestSubmit()",
            "aria-label": "Change attendance status" %>
      <span><%= registration.attendance_status_label %></span>
      <i class="fas fa-chevron-down text-[0.6rem]"></i>
    </div>
  <% end %>
</div>

<%# locals: (summary:, open: false, data: {}) %>
<%# A field hint that reveals more inputs when clicked, with no JS. Pass open: when
    the revealed inputs already hold a value. %>
<%= tag.details open: open, class: "mt-1", data: data do %>
  <summary class="w-fit cursor-pointer text-xs text-gray-500 hover:text-gray-700"><%= summary %></summary>
  <div class="mt-1 space-y-2"><%= yield %></div>
<% end %>

<nav class="relative bg-white print:hidden">
  <style>
      /* Mega menu: full-width overlay under the top row */
      .nav-item.has-dropdown { position: relative; }

      .nav-item.has-dropdown .mega-menu {
          position: fixed;              /* <-- key: not absolute (prevents layout pushing/inline flow) */
          left: 0;
          right: 0;
          top: var(--mega-top, 72px);   /* fallback; JS sets this accurately */
          width: 100vw;
          background: #f7f7f9;
          padding: 24px 0;
          box-shadow: 0 10px 30px rgba(0,0,0,0.10);
          z-index: 9999;               /* above your rows 2/3 */
          display: none;
      }

      .nav-item.has-dropdown:hover .mega-menu,
      .nav-item.has-dropdown:focus-within .mega-menu {
          display: block;
      }

      .mega-container {
          max-width: 1280px;
          margin: 0 auto;
          padding: 0 24px;
          display: grid;
          grid-template-columns: 1.1fr 1fr 0.9fr;
          gap: 32px;
          align-items: start;
      }

      .mega-col h3,
      .mega-col h4 {
          font-weight: 800;
          letter-spacing: 0.02em;
          margin-bottom: 12px;
      }

      .mega-col p {
          margin: 0 0 10px 0;
          line-height: 1.5;
          color: #111827;
          font-weight: 400; /* force normal */
      }

      .image-col img {
          width: 100%;
          height: auto;
          border-radius: 8px;
          display: block;
      }

      /* About + News horizontal */
      .links-wrapper {display: flex;gap: 48px;}
      .links-group { margin-bottom: 18px; }
      .links-group ul { list-style: none; padding: 0; margin: 0; }
      .links-group li { margin-bottom: 8px; }
      .links-group a { color: #111827; text-decoration: none; }
      .links-group a:hover { color: #6d28d9; text-decoration: underline; }

      .search-box { display: flex; gap: 8px; }
      .search-box input {
          flex: 1;
          padding: 10px 12px;
          border: 1px solid #d1d5db;
          border-radius: 8px;
          background: white;
      }
      .search-box button {
          padding: 10px 12px;
          border-radius: 8px;
          background: #e5e7eb;
      }
  </style>

  <script>
      // Sets mega menu top offset to sit directly under Row 1 (regardless of header height)
      document.addEventListener("turbo:load", () => {
          const row1 = document.querySelector(".nav-row.row-1");
          const mega = document.querySelector(".nav-item.has-dropdown .mega-menu");
          if (!row1 || !mega) return;

          const rect = row1.getBoundingClientRect();
          const top = Math.round(rect.bottom);
          mega.style.setProperty("--mega-top", `${top}px`);
      });
  </script>

  <div class="px-2 sm:px-6 lg:px-8">
    <!-- Row 1: Logo and Main Navigation -->

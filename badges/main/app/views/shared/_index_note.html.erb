<%# Inline autosaving note for an index row — reuses the generic `autosave`
    Stimulus controller. Saves on blur to the row's `save_note` action, which
    upserts the record's latest comment and streams back a fresh hint.
    Locals: record, url, comment. %>
<%= text_area_tag "note", comment&.body,
      rows: 1,
      placeholder: "Add a comment…",
      "aria-label": "Latest comment",
      class: "w-full min-w-[180px] rounded-lg border border-gray-200 bg-white px-2 py-1 text-sm text-gray-700 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none",
      data: { controller: "autosave", autosave_url_value: url, autosave_id_value: record.id, autosave_stream_value: true, action: "change->autosave#save" } %>
<%= render "shared/index_note_hint", record: record, comment: comment %>

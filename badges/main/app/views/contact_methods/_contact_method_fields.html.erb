<div class="nested-fields mb-4 rounded-lg border border-gray-200 bg-white p-6">
  <%= f.hidden_field :kind, value: :phone %>
  <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-5">
    <!-- Contact Type -->
    <div>
      <%= f.input :contact_type,
                  as: :select,
                  required: true,
                  wrapper: false,
                  label: "Contact type",
                  collection: ContactMethod::CONTACT_TYPES.compact.map { |t| [t.humanize, t] } %>
    </div>

    <!-- Value -->
    <div>
      <%= f.input :value,
                  wrapper: false,
                  label: "Value",
                  input_html: {
                    class: "rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500"
                  } %>
    </div>

    <!-- Primary -->
    <div class="flex h-[42px] items-center">
      <%= f.input :primary,
                  as: :boolean,
                  wrapper: false,
                  label: false,
                  input_html: { checked: f.object.new_record? || f.object.primary?, class: "mr-2 text-blue-600 focus:ring-blue-500" } %>
    </div>

    <!-- Inactive -->
    <div class="flex h-[42px] items-center">
      <%= f.input :inactive,
                  as: :boolean,
                  wrapper: false,
                  label: false,
                  input_html: { class: "mr-2 text-blue-600 focus:ring-blue-500" } %>
    </div>

    <div class="text-end text-right">
      <!-- Remove button -->
      <%= link_to_remove_association "Remove",
                                     f,
                                     class: "text-sm text-gray-400 hover:text-red-600 underline whitespace-nowrap" %>
    </div>
  </div>
</div>

<div class="w-full max-w-7xl mx-auto bg-white border border-gray-200 rounded-xl shadow p-6" id="contact-us-container">
      <!-- Header -->
      <header class="space-y-4">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900">
          Contact Us
        </h2>
        <p class="text-lg text-gray-600 leading-relaxed max-w-2xl">
          Questions? Comments? Concerns? We'd love to hear from you.
        </p>
        <div class="text-sm text-amber-700 bg-amber-50 border border-amber-300 rounded-lg p-4">
          <strong>Please note:</strong> We are a training organization. If you are a survivor and in need of support,
          call <strong>211</strong>, which connects people with social service organizations.
        </div>
      </header>
      <!-- Contact Details -->
      <div class="mt-10 grid grid-cols-1 md:grid-cols-5 gap-x-10 gap-y-6 text-gray-800">
        <div class="space-y-4 md:col-span-3">
          <div class="grid grid-cols-2 gap-x-8">
            <div>
              <div class="text-sm font-semibold uppercase tracking-wide text-gray-500 mb-1">
                Email
              </div>
              <%= mail_to ENV.fetch("REPLY_TO_EMAIL", "programs@awbw.org"),
                          subject: "AWBW portal: Website question",
                          class: "text-blue-600 hover:text-blue-800 font-medium" %>
            </div>
            <div>
              <div class="text-sm font-semibold uppercase tracking-wide text-gray-500 mb-1">
                Phone
              </div>
              <%= link_to "310-396-0317",
                          "tel:310-396-0317",
                          class: "text-blue-600 hover:text-blue-800 font-medium" %>
            </div>
          </div>
          <div>
            <div class="text-sm font-semibold uppercase tracking-wide text-gray-500 mb-2">
              Social Media
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <!-- LinkedIn -->
              <%= link_to "https://www.linkedin.com/company/a-window-between-worlds",
                          target: "_blank", rel: "noopener noreferrer",
                          class: "group inline-flex items-center justify-center w-11 h-11 rounded-xl bg-gray-50 shadow-sm hover:shadow-md hover:bg-[#0A66C2] transition" do %>
                <i class="fab fa-linkedin-in text-gray-600 group-hover:text-white text-lg"></i>
              <% end %>
              <!-- Instagram -->
              <%= link_to "https://www.instagram.com/awbworg",
                          target: "_blank", rel: "noopener noreferrer",
                          class: "group inline-flex items-center justify-center w-11 h-11 rounded-xl bg-gray-50 shadow-sm hover:shadow-md hover:bg-gradient-to-tr hover:from-[#F58529] hover:via-[#DD2A7B] hover:to-[#8134AF] transition" do %>
                <i class="fab fa-instagram text-gray-600 group-hover:text-white text-lg"></i>
              <% end %>
              <!-- Facebook -->
              <%= link_to "https://www.facebook.com/awbworg",
                          target: "_blank", rel: "noopener noreferrer",
                          class: "group inline-flex items-center justify-center w-11 h-11 rounded-xl bg-gray-50 shadow-sm hover:shadow-md hover:bg-[#1877F2] transition" do %>
                <i class="fab fa-facebook-f text-gray-600 group-hover:text-white text-lg"></i>
              <% end %>
              <!-- YouTube -->
              <%= link_to "https://www.youtube.com/@awbworg",
                          target: "_blank", rel: "noopener noreferrer",
                          class: "group inline-flex items-center justify-center w-11 h-11 rounded-xl bg-gray-50 shadow-sm hover:shadow-md hover:bg-[#FF0000] transition" do %>
                <i class="fa-brands fa-youtube text-gray-600 group-hover:text-white text-lg"></i>
              <% end %>
            </div>
          </div>
        </div>
        <div class="md:col-span-2">
          <div class="text-sm font-semibold uppercase tracking-wide text-gray-500 mb-1">
            Mailing Address
          </div>
          <div class="text-gray-700 leading-relaxed">
            Attn: Zachery Scott, Executive Director<br>
            A Window Between Worlds<br>
            1029 1/2 W 24th Street<br>
            Los Angeles, CA 90007
          </div>
        </div>
      </div>
      <!-- Divider -->
      <div class="mt-12 pt-12 border-t border-gray-200">
        <!-- Contact Form -->
        <div id="contact-form" class="space-y-8">
          <% if @form_submitted %>
            <!-- Thank You Message -->
            <div id="thank-you" class="text-center py-12 space-y-4">
              <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 mb-4">
                <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <h3 class="text-2xl font-semibold text-gray-900">
                Thank you for contacting us!
              </h3>
              <p class="text-gray-600 max-w-md mx-auto">
                Your message has been received and our team will respond as soon as possible.
              </p>
            </div>
            <script>document.getElementById("thank-you").scrollIntoView({ behavior: "smooth", block: "center" });</script>
          <% else %>
            <!-- Contact Form -->
            <div class="space-y-2">
              <h3 class="text-2xl font-semibold text-gray-900">
                Send us a message
              </h3>
              <p class="text-gray-600">
                Please complete the form below and our team will respond as soon as possible.
              </p>
            </div>
            <% if current_user && @user %>
              <div class="text-sm text-blue-700 bg-blue-50 border border-blue-300 rounded-lg p-4">
                <strong>Hello, <%= @user.first_name %>!</strong> We're glad to hear from you.
              </div>
            <% end %>
            <%= form_tag("/contact_us", method: "POST", class: "space-y-8", id: "contact-us-form", novalidate: true) do %>
              <input type="hidden" name="contact_us[q]" value="general">
              <% unless current_user %>
                <!-- Name Row -->
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                      First Name *
                    </label>
                    <input type="text"
                           name="contact_us[first_name]"
                           required
                           data-error-message="First name is required"
                           class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none transition">
                    <p class="field-error hidden mt-1 text-xs text-red-600"></p>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                      Last Name
                    </label>
                    <input type="text"
                           name="contact_us[last_name]"
                           class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none transition">
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                      Email *
                    </label>
                    <input type="email"
                           name="contact_us[from]"
                           required
                           pattern="[^@\s]+@[^@\s]+\.[^@\s]+"
                           data-error-message="Please enter a valid email address"
                           class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none transition">
                    <p class="field-error hidden mt-1 text-xs text-red-600"></p>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                      Agency / Organization *
                    </label>
                    <input type="text"
                           name="contact_us[agency]"
                           required
                           data-error-message="Agency / Organization is required"
                           class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none transition">
                    <p class="field-error hidden mt-1 text-xs text-red-600"></p>
                  </div>
                </div>
              <% else %>
                <input type="hidden" name="contact_us[first_name]" value="<%= @user.first_name %>">
                <input type="hidden" name="contact_us[last_name]" value="<%= @user.last_name %>">
                <input type="hidden" name="contact_us[from]" value="<%= @user.email %>">
                <input type="hidden" name="contact_us[agency]" value="<%= @user.person&.primary_organization&.name || '' %>">
              <% end %>
              <!-- Honeypot -->
              <div class="absolute opacity-0 top-0 left-0 h-0 w-0 -z-10" aria-hidden="true">
                <label for="website_url">Website</label>
                <input type="text" name="contact_us[website_url]" id="website_url" tabindex="-1" autocomplete="off">
              </div>
              <!-- Subject -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">
                  Subject Line *
                </label>
                <input type="text"
                       name="contact_us[subject]"
                       required
                       maxlength="100"
                       data-error-message="Subject line is required"
                       class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none transition">
                <p class="field-error hidden mt-1 text-xs text-red-600"></p>
              </div>
              <!-- Message -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">
                  Your Message *
                </label>
                <textarea name="contact_us[message]"
                          required
                          rows="6"
                          data-error-message="Message is required"
                          class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none transition resize-none"></textarea>
                <p class="field-error hidden mt-1 text-xs text-red-600"></p>
              </div>
              <!-- Submit -->
              <div class="flex justify-end">
                <button type="submit"
                        class="btn btn-primary">
                  Submit
                </button>
              </div>
            <% end %>
            <script>
              document.addEventListener("DOMContentLoaded", function() {
                var form = document.getElementById("contact-us-form");
                if (!form) return;

                form.addEventListener("submit", function(e) {
                  var fields = form.querySelectorAll("[required]");
                  var valid = true;

                  fields.forEach(function(field) {
                    var error = field.parentElement.querySelector(".field-error");
                    if (!field.validity.valid) {
                      valid = false;
                      field.classList.add("border-red-500");
                      field.classList.remove("border-gray-300");
                      if (error) {
                        error.textContent = field.getAttribute("data-error-message") || "This field is required";
                        error.classList.remove("hidden");
                      }
                    } else {
                      field.classList.remove("border-red-500");
                      field.classList.add("border-gray-300");
                      if (error) {
                        error.textContent = "";
                        error.classList.add("hidden");
                      }
                    }
                  });

                  if (!valid) e.preventDefault();
                });

                form.querySelectorAll("[required]").forEach(function(field) {
                  field.addEventListener("input", function() {
                    var error = field.parentElement.querySelector(".field-error");
                    if (field.validity.valid) {
                      field.classList.remove("border-red-500");
                      field.classList.add("border-gray-300");
                      if (error) {
                        error.textContent = "";
                        error.classList.add("hidden");
                      }
                    }
                  });
                });
              });
            </script>
          <% end %>
        </div>
      </div>
    </div>
</div>

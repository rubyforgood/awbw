<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
  <% 4.times do %>
    <div class="relative flex animate-pulse flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
      <!-- Image banner -->
      <div class="aspect-video w-full bg-gray-200"></div>

      <!-- Content -->
      <div class="flex flex-1 flex-col gap-3 p-4">
        <div class="h-5 w-3/4 rounded bg-gray-200"></div>

        <div class="mt-auto flex items-end justify-between gap-3">
          <div class="flex flex-col gap-2">
            <div class="h-4 w-24 rounded bg-gray-200"></div>
            <div class="h-4 w-40 rounded bg-gray-200"></div>
          </div>
          <div class="h-8 w-24 rounded-lg bg-gray-200"></div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-6 text-right"><%= link_to "View all events",
                events_path,
                class: "text-primary font-medium hover:underline", data: { turbo_frame: "_top" } %></div>

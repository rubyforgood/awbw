<%# Combined event search (matches abbreviation OR title) shared by the report
    forms. Submits the form on change (blur/Enter), matching the auto-submitting
    selects beside it. %>
<%= render "shared/filter_text", param: :search, label: "Event search", placeholder: "Abbreviation or name",
      field_class: search_field_class(extra: "bg-white"), wrapper_class: "w-full sm:w-56",
      input_options: { onchange: "this.form.requestSubmit()" } %>

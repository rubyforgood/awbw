<% content_for(:page_bg_class, "public") %>

<% reg = @person.event_registrations.find_by(event: @event) %>
<%# Viewed from the admin Registrants roster (same-tab nav): return to that
    registrant's row, not the public ticket. Falls back to ticket/event. %>
<% if params[:return_to] == "registrants" && reg && allowed_to?(:index?, EventRegistration) %>
  <% back_path = registrants_event_row_path(@event, params[:return_registration_id].presence || reg.id) %>
  <% back_label = "Back to registrants" %>
<% elsif reg&.slug.present? %>
  <% back_path = registration_ticket_path(reg.slug) %>
  <% back_label = "Back to ticket" %>
<% else %>
  <% back_path = event_path(@event) %>
  <% back_label = "Back to event" %>
<% end %>
<div class="max-w-3xl mx-auto px-4 pt-4">
  <div class="flex flex-wrap items-center gap-2">
    <%= link_to back_path, class: "inline-flex items-center gap-1.5 text-sm #{eyebrow_link_class} px-2 py-1" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> <%= back_label %>
    <% end %>
    <%# Came here from the admin org-linking popup (opens in a new tab, so the
        browser back button is useless); carry its own return_to so its
        "Back to registrants" eyebrow still resolves. %>
    <% if reg && params[:return_to] == "link_organization" && allowed_to?(:index?, EventRegistration) %>
      <%= link_to link_organization_event_registration_path(reg, return_to: params[:link_org_return_to].presence), class: "inline-flex items-center gap-1.5 text-sm #{eyebrow_link_class} px-2 py-1" do %>
        <i class="fa-solid fa-arrow-left text-xs"></i> Back to linked organizations
      <% end %>
    <% end %>
    <% if reg && allowed_to?(:index?, EventRegistration) %>
      <%# Admin's counterpart to this public view — jump back to the event-scoped
          submission page this page's "View public version" link came from. %>
      <%= link_to "Admin view", event_registrant_submissions_path(@event, person_id: @person.id), class: "ml-auto admin-only bg-blue-100 text-sm #{eyebrow_link_class} px-2 py-1" %>
      <%= link_to "Edit registration", edit_event_registration_path(reg), class: "admin-only bg-blue-100 text-sm #{eyebrow_link_class} px-2 py-1" %>
    <% end %>
  </div>
</div>

<div class="max-w-3xl mx-auto pb-12 pt-6 px-4">
  <% if (registration_submission = @sitting.registration) %>
    <%# Admin-only audit banner — sits above the registrant-facing card so it
        stands out to admins as an overlay, not part of what the registrant sees. %>
    <%= render "form_submissions/changes_link", submission: registration_submission, return_to: "public_registration", badge: true %>

    <%# ---- FORM RESPONSES CARD ---- %>
    <div class="bg-white rounded-2xl shadow-xl ring-1 ring-black/5 overflow-hidden">

      <%# Card Header %>
      <%= render accent_strip_partial %>
      <div class="bg-primary text-white px-6 sm:px-8 py-5">
        <div class="flex items-center gap-5">
          <div class="shrink-0">
            <%= image_tag("logo.png", alt: "Organization logo", class: "h-9 w-auto") %>
          </div>
          <div class="flex-1">
            <h1 class="text-xl font-semibold tracking-wide leading-tight">Your form responses</h1>
            <p class="text-sm text-blue-200"><%= @event.title %></p>
          </div>
        </div>
      </div>

      <%# Card Body %>
      <div class="px-6 sm:px-8 py-7">
        <%= render "forms/header", form: @registration_form, event: @event %>

        <%= render "submission_answers", submission: registration_submission, form_fields: @form_fields %>

        <div class="pt-4 border-t border-gray-200 mt-4">
          <p class="text-xs text-gray-500">
            Submitted on <%= registration_submission.created_at.strftime("%B %d, %Y at %l:%M %P") %>
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <%# ---- SCHOLARSHIP APPLICATION CARD — the scholarship answers sent in this sitting. ---- %>
  <% if (scholarship = @sitting.scholarship) %>
    <div id="scholarship-application" class="bg-white rounded-2xl shadow-xl ring-1 ring-black/5 overflow-hidden mt-8 scroll-mt-24">

      <%# Card Header %>
      <%= render accent_strip_partial %>
      <div class="bg-primary text-white px-6 sm:px-8 py-5">
        <div class="flex items-center gap-3">
          <i class="fa-solid fa-hand-holding-heart text-accent text-xl"></i>
          <div class="flex-1">
            <h2 class="text-xl font-semibold tracking-wide leading-tight">Scholarship application</h2>
            <p class="text-sm text-blue-200"><%= @scholarship_form.display_name %></p>
          </div>
        </div>
      </div>

      <%# Card Body %>
      <div class="px-6 sm:px-8 py-7">
        <%= render "forms/header", form: @scholarship_form, event: @event %>

        <%= render "submission_answers", submission: scholarship.submission, form_fields: @scholarship_fields,
                   responses: scholarship.responses, skip_name: @scholarship_form.display_name %>

        <div class="pt-4 border-t border-gray-200 mt-4">
          <p class="text-xs text-gray-500">
            Submitted on <%= scholarship.submission.created_at.strftime("%B %d, %Y at %l:%M %P") %>
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <%# ---- CONTINUING EDUCATION CARD — the CE answers sent in this sitting. ---- %>
  <% if (continuing_education = @sitting.continuing_education) %>
    <div id="continuing-education" class="bg-white rounded-2xl shadow-xl ring-1 ring-black/5 overflow-hidden mt-8 scroll-mt-24">

      <%# Card Header %>
      <div class="relative bg-gradient-to-r from-teal-800 to-teal-600 text-white px-6 sm:px-8 py-5">
        <div class="flex items-center gap-3">
          <i class="fa-solid fa-certificate text-teal-200 text-xl"></i>
          <div class="flex-1">
            <h2 class="text-xl font-semibold tracking-wide leading-tight">Continuing education</h2>
            <p class="text-sm text-teal-100"><%= @continuing_education_form.display_name %></p>
          </div>
        </div>
        <div class="absolute inset-x-0 bottom-0 h-1 bg-gradient-to-r from-teal-300 via-amber-400 to-teal-300"></div>
      </div>

      <%# Card Body %>
      <div class="px-6 sm:px-8 py-7">
        <%= render "forms/header", form: @continuing_education_form, event: @event %>

        <%= render "submission_answers", submission: continuing_education.submission, form_fields: @continuing_education_fields,
                   responses: continuing_education.responses, skip_name: @continuing_education_form.display_name %>

        <div class="pt-4 border-t border-gray-200 mt-4">
          <p class="text-xs text-gray-500">
            Submitted on <%= continuing_education.submission.created_at.strftime("%B %d, %Y at %l:%M %P") %>
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <% if (bulk_payment = @sitting.bulk_payment) %>
    <div class="bg-white rounded-2xl shadow-xl ring-1 ring-black/5 overflow-hidden mt-8 px-6 sm:px-8 py-7">
      <h2 class="text-xl font-semibold text-gray-800"><%= bulk_payment.form.name %></h2>
      <%= render "form_submissions/submission", submission: bulk_payment %>
    </div>
  <% end %>

  <% if @other_sittings.any? %>
    <section class="mt-10 space-y-3">
      <h2 class="text-sm font-semibold tracking-wide text-gray-500 uppercase">
        <%= @other_sittings.first.created_at < @sitting.created_at ? "Earlier" : "Other" %> submissions
      </h2>
      <% @other_sittings.each do |sitting| %>
        <details id="form-submission-<%= sitting.submissions.first.id %>" class="group rounded-xl border border-gray-200 bg-white scroll-mt-24">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-medium text-gray-700 select-none [&::-webkit-details-marker]:hidden">
            <span><%= sitting.form_names %> — Submitted on <%= sitting.created_at.strftime("%B %d, %Y at %l:%M %P") %></span>
            <i class="fa-solid fa-chevron-down text-xs text-gray-400 transition-transform group-open:rotate-180"></i>
          </summary>
          <div class="border-t border-gray-100 px-4 pt-4 pb-4">
            <%= render "sitting_details", sitting: sitting %>
          </div>
        </details>
      <% end %>
    </section>
  <% end %>
</div>

<% content_for(:page_title, "Bulk payments — #{@event.title}") %>
<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="max-w-7xl mx-auto <%= DomainTheme.bg_class_for(:events) %> border border-gray-200 rounded-xl shadow p-4 sm:p-6">
  <%# Top bar: eyelash + sub-nav, matching the other event pages %>
  <div class="flex flex-wrap items-center justify-between gap-2 sm:gap-4 mb-6">
    <%= link_to "← Registrants", registrants_event_path(@event), class: "text-sm text-gray-500 hover:text-gray-700" %>
    <%= render "events/subnav", event: @event, current: :bulk_payments %>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <h1 class="text-2xl font-semibold text-gray-900">Bulk payments</h1>
    <div class="flex items-center gap-3">
      <%= link_to event_invoice_path(@event),
                  class: "inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition-colors" do %>
        <i class="fa-solid fa-file-invoice-dollar text-xs"></i> Blank invoice
      <% end %>
      <p class="text-sm text-gray-500"><%= @submissions.size %> submission<%= "s" unless @submissions.size == 1 %></p>
    </div>
  </div>

  <% if @submissions.any? %>
    <div class="grid grid-cols-1 gap-3">
      <% @submissions.each do |submission| %>
        <%= render "events/bulk_payment_card", submission: submission,
              event_registrations: @event_registrations,
              allocated_by_registration: @allocated_by_registration %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-white border border-gray-200 rounded-lg">
      <i class="fa-regular fa-receipt text-4xl text-gray-300 mb-3"></i>
      <p class="text-gray-500">No bulk payment submissions yet.</p>
    </div>
  <% end %>
</div>

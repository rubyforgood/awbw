<% content_for(:page_bg_class, "public") %>
<% content_for(:page_title, "Facilitator Portal access — #{@event.title}") %>
<%= render layout: "events/callouts/callout_page", locals: { title: "Facilitator Portal access" } do %>
  <div class="space-y-5 text-sm text-gray-700 leading-relaxed">
    <p>Access to the Facilitator Portal is granted once you've completed both training days and paid your training fee.</p>

    <dl class="divide-y divide-gray-100 rounded-xl border border-gray-200">
      <% [
        [ "Attended both training days", @event_registration.attended? ],
        [ "Training fee paid", @event_registration.paid_in_full? ]
      ].each do |label, met| %>
        <div class="flex items-center justify-between gap-3 px-4 py-3">
          <dt class="font-medium text-gray-900"><%= label %></dt>
          <% if met %>
            <dd class="inline-flex items-center gap-1 rounded-full border border-green-200 bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700">
              <i class="fa-solid fa-circle-check"></i> Met
            </dd>
          <% else %>
            <dd class="inline-flex items-center gap-1 rounded-full border border-gray-200 bg-gray-50 px-2.5 py-0.5 text-xs font-medium text-gray-500">
              <i class="fa-solid fa-clock"></i> Not yet
            </dd>
          <% end %>
        </div>
      <% end %>
    </dl>

    <% if @event_registration.portal_access? %>
      <p>You're all set — watch for your portal invitation. Once you have access, you can sign in from the home screen.</p>
      <%= link_to root_path, target: "_blank", rel: "noopener",
                  class: "inline-flex items-center gap-2 rounded-lg border-2 border-green-200 bg-green-50 px-4 py-2 text-sm font-semibold text-green-700 hover:bg-green-100" do %>
        <i class="fa-solid fa-right-to-bracket"></i> Go to the home screen
      <% end %>
    <% else %>
      <p class="text-gray-500">Once both requirements above are met, we'll send your portal invitation by email.</p>
    <% end %>
  </div>
<% end %>

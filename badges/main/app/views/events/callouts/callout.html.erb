<% content_for(:page_bg_class, "public") %>
<% content_for(:page_title, "#{@callout.title} — #{@event.title}") %>

<%# The CE callout's form is reached from the CE page, so its eyebrow returns
    there rather than to the ticket. %>
<% callout_eyebrow = if params[:return_to] == "ce"
     { back_path: registration_ce_path(@event_registration.slug), back_label: "Back to #{@event.ce_hours_label}" }
   end || {} %>

<%= render layout: "events/callouts/callout_page", locals: { title: @callout.title, **callout_eyebrow } do %>
  <% if @callout.subtitle.present? %>
    <p class="mb-4 text-base text-gray-500"><%= @callout.subtitle %></p>
  <% end %>

  <% if @callout.description.present? %>
    <div class="mb-6">
      <%= render "events/callouts/rich_content", content: @callout.description %>
    </div>
  <% end %>

  <%# Any linked resources sit above the forms, like reference material for them. %>
  <% if @resource_cards.any? %>
    <div class="mb-6 space-y-3">
      <% @resource_cards.each do |card| %>
        <%= render "event_registrations/callout_card", callout: card %>
      <% end %>
    </div>
  <% end %>

  <div class="space-y-4">
    <% @callout_forms.each do |callout_form| %>
      <%= render "events/callouts/callout_form", callout: @callout, callout_form: callout_form,
            submission: @submissions[callout_form.form_id],
            editing: @editing_form_id == callout_form.form_id %>
    <% end %>
  </div>
<% end %>

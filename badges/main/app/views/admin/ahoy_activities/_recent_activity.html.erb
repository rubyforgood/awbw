<% user = activity.event.user %>
<% decorated_activity = activity.decorate %>
<% display_resource = activity.object || user %>

<div
  class="flex flex-col overflow-hidden rounded border border-gray-200 bg-white shadow-sm transition hover:shadow-md md:flex-row">
  <div class="w-60 items-center p-2">
    <div class="pt-2">
      <span class="font-bold"><%= activity.event.name.gsub("."," ").titleize %></span>
    </div>

    <div class="pt-2 text-sm font-medium whitespace-nowrap text-gray-500">
      <%= activity.occurred_at.in_time_zone.strftime("%m-%d-%Y @ %I:%M %p") %>
      <%= Rails.application.config.time_zone %>
    </div>

    <% unless params[:user_id].present? %>
      <div class="pt-2 text-sm font-medium text-gray-500">
        <% if user %>
          by
          <%= link_to user.full_name,
                      user_path(user),
                      data: { turbo_prefetch: false },
                      class: "hover:underline" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="items-top flex w-20 justify-center bg-white pt-3">
    <!-- Assets -->
    <%= render "assets/display_image",
               resource: display_resource,
               file: display_resource.decorate.display_image,
               link_to_object: true,
               icon_display: activity.object.is_a?(Resource),
               width: 20, height: 16 if activity.object || (user && activity.event.name.include?("auth")) %>
  </div>

  <div class="flex-1 p-4">
    <% if activity.event.name.include?("taggings") %>
      <% path = taggings_path(sector_names_all: activity.event.properties["sectors"].join("--"),
                              category_names_all: activity.event.properties["categories"].join("--")) %>
      <% title = "Taggings" %>
      <% detail = activity.event.properties %>
    <% elsif activity.event.name.include?("auth") %>
      <% path = edit_user_path(user) %>
      <% title = activity.event.name.gsub("auth.","").titleize %>
      <% detail = "" %>
    <% else %>
      <% path = polymorphic_path(activity) %>
      <% title = decorated_activity.title %>
      <% detail = decorated_activity.detail %>
    <% end %>

    <%= link_to path, class: "hover:underline" do %>
      <h3 class="text-lg font-semibold text-gray-900">
        <%= link_to title,
                    path,
                    data: { turbo_prefetch: false },
                    class: "hover:underline" %>
      </h3>

      <p class="line-clamp-3 mt-1 text-sm text-gray-600">
        <%= detail %>
      </p>

      <div class="mt-4 flex justify-end space-x-2">
        <% if activity.object.is_a?(Resource) && decorated_activity.downloadable_asset&.file&.attached? %>
          <%= link_to raw("<span class='fa fa-download'></span>"),
                      resource_download_path(activity),
                      data: { turbo_prefetch: false },
                      class: button_classes(:utility) %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% if records.any? %>
  <ul class="divide-y divide-gray-200 border-t border-gray-200">
    <% records.each do |record| %>
      <li class="grid grid-cols-5 gap-4 py-3 text-sm">
        <span class="col-span-2 font-medium break-words text-gray-500">
          <%= record.decorate.kind %>
          <%= fm_archive_id_tag(record) %>
          <% [ ("This record" if record == owner), *owner.decorate.try(:contact_tags, record) ].compact.each do |tag| %>
            <span class="ml-1 rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium whitespace-nowrap text-gray-700"><%= tag %></span>
          <% end %>
        </span>
        <span class="col-span-3 break-words text-gray-900">
          <%= fm_archive_summary_tag(record) %>
          <% if FmAffiliationComments::ARCHIVES.include?(record.class) %>
            <div class="mt-1 flex flex-wrap gap-3 empty:hidden">
              <%= render "affiliation_notes", record: record, affiliations: @affiliation_comments.affiliations(record), origin: owner %>
            </div>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>
<% end %>

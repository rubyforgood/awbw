<%= simple_form_for(@faq) do |f| %>
  <!-- Form Errors -->
  <%= f.error_notification %>
  <%= render "shared/errors", resource: @faq if @faq.errors.any? %>

  <!-- Form Fields -->
  <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-4">
    <div class="flex flex-col gap-4 md:col-span-3">
      <div class="flex flex-col">
        <%= render "inline_fields", form: f, attribute: :question  do %>
          <%= f.label :question unless turbo_frame_request? %>

          <%= f.input_field :question,
                        class:
                          "w-full grow rounded-lg border border-gray-300 px-3 py-2 text-gray-800 shadow-sm" %>
        <% end %>
      </div>

      <div class="flex flex-col">
        <%= render "inline_fields", form: f, attribute: :answer do %>
          <%= f.label :answer unless turbo_frame_request? %>

          <%= f.input_field :answer,
                        class:
                          "w-full grow rounded-lg border border-gray-300 px-3 py-2 text-gray-800 shadow-sm",
                        rows: "8" %>
        <% end %>
      </div>

      <div class="flex"><%= f.input :position %></div>
    </div>

    <div class="admin-only mt-6 rounded bg-blue-100 p-3 md:mt-0">
      <%= render "shared/visibility_info", flags: %i[published publicly_visible] %>
      <div class="grid grid-cols-1 items-center">
        <%= render "inline_fields", form: f, attribute: :published do %>
          <%= visibility_flag_input f, :published %>
        <% end %>
        <%= render "inline_fields", form: f, attribute: :publicly_visible do %>
          <%= visibility_flag_input f, :publicly_visible %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="action-buttons mt-8 flex justify-center gap-3">
    <% if allowed_to?(:destroy?, f.object) %>
      <%= link_to "Delete", @faq, class: button_classes(:danger_outline),
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete?" } %>
    <% end %>
    <%= link_to "Cancel", faqs_path, class: button_classes(:secondary_outline) %>
    <%= f.button :submit, class: button_classes(:primary) %>
  </div>
<% end %>

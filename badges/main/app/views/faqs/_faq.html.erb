<% hide_options ||= false %>
<div
  id="<%= dom_id faq %>"
  data-controller="dropdown"
  data-sortable-id="<%= faq.id %>"
>

    <div class="flex w-full cursor-pointer items-center rounded-md px-2 transition-colors duration-150 hover:bg-gray-50">
    

      <% if faq_admin_mode? && allowed_to?(:edit?, faq) %>
        <span class="admin-only bg-blue-100">
          <i class="fa-solid fa-sort cursor-move self-center pr-2" data-sortable-handle=""></i>
        </span>

        <div class="flex grow sm:items-center">

          <div class="admin-only flex flex-col bg-blue-100">
            <span>
              <%= render "inline_edit", model: faq, attribute: :published, form_class: "md:min-w-44" do %>
                <%= button_to faq_path(faq),
                              method: :patch,
                              params: { faq: { published: !faq.published? } },
                              class: "cursor-pointer pl-2" do %>
                  <% if faq.published? %>
                    <i class="fa-solid fa-toggle-on text-primary text-2xl"></i>
                  <% else %>
                    <i class="fa-solid fa-toggle-off text-2xl text-gray-400"></i>
                  <% end %>
                <% end %>
                <span class="hidden pl-1 md:inline-block"><%= faq.published? ? "[PUBLISHED]" : "[UNPUBLISHED]" %>
                </span>
              <% end %>
            </span>

            <span>
              <%= render "inline_edit", model: faq, attribute: :publicly_visible, form_class: "md:min-w-44" do %>
                <%= button_to faq_path(faq),
                              method: :patch,
                              params: { faq: { publicly_visible: !faq.publicly_visible? } },
                              class: "cursor-pointer pl-2" do %>
                  <% if faq.publicly_visible? %>
                    <i class="fa-solid fa-toggle-on text-2xl text-green-600"></i>
                  <% else %>
                    <i class="fa-solid fa-toggle-off text-2xl text-gray-400"></i>
                  <% end %>
                <% end %>
                <span class="hidden pl-1 md:inline-block"><%= faq.publicly_visible? ? "[PUBLIC]" : "[NOT PUBLIC]" %>
                </span>
              <% end %>
            </span>
          </div>

          <strong class="sr-only">Question:</strong>

          <div class="grow">
            <%= render "inline_edit", model: faq, attribute: :question, form_class: "sm:pl-0 flex", frame_class: "flex flex-wrap sm:flex-nowrap w-full items-center gap-2" do %>
              <span class="w-full border-transparent text-lg font-bold peer-has-hover:rounded-md peer-has-hover:border peer-has-hover:border-gray-300 peer-has-hover:p-1 peer-has-hover:shadow-sm"
                data-action="click->dropdown#toggle"
                data-dropdown-payload-param='[{"<%= dom_id faq, :answer %>":"hidden"}, {"<%= dom_id faq, :arrow %>":"rotate-180"}]' >
                <%= faq.question %></span>
              <%= link_to edit_faq_path(faq), class: "peer" do %>
                <span class="admin-only bg-blue-100">
                  <i class="far fa-edit text-primary hover:text-secondary"></i>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% else %>
        <span class="w-full py-2 pl-4 text-lg font-bold"
              data-action="click->dropdown#toggle"
              data-dropdown-payload-param='[{"<%= dom_id faq, :answer %>":"hidden"}, {"<%= dom_id faq, :arrow %>":"rotate-180"}]' >
          <%= faq.question %></span>
      <% end %>

      <% if faq_admin_mode? && allowed_to?(:destroy?, faq) %>
        <div class="mx-3 flex flex-col">
          <span class="admin-only bg-blue-100">
            <%= link_to faq, data: {
                              turbo_method: :delete,
                              turbo_confirm: "Confirm: Delete FAQ?" } do %>

              <button class="hover:bg-danger rounded-md p-1 transition">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 200 200"
                  class="text-danger h-8 w-8 fill-current hover:text-white"
                >
                  <path
                    d="M119.032 145.698h-37.4c-6.2 0-11.3-5.1-11.3-11.3v-50.7c0-1.1.9-2 2-2h56c1.1 0 2 .9 2 2v50.7c0 6.2-5.1 11.3-11.3 11.3zm-44.7-60v48.7c0 4 3.3 7.3 7.3 7.3h37.3c4 0 7.3-3.3 7.3-7.3v-48.7h-51.9zM138.332 73.598h-76c-1.1 0-2-.9-2-2s.9-2 2-2h76c1.1 0 2 .9 2 2s-.9 2-2 2z"
                  />
                  <path
                    d="M138.332 85.598h-76c-1.1 0-2-.9-2-2s.9-2 2-2h76c1.1 0 2 .9 2 2s-.9 2-2 2zM112.332 73.698h-24c-1.1 0-2-.9-2-2v-6c0-6.6 5.4-12 12-12h4c6.6 0 12 5.4 12 12v6c0 1.1-.9 2-2 2zm-22-4h20v-4c0-4.4-3.6-8-8-8h-4c-4.4 0-8 3.6-8 8v4zM88.732 131.698c-1.1 0-2-.9-2-2v-32c0-1.1.9-2 2-2s2 .9 2 2v32c0 1.1-.9 2-2 2zM100.732 131.698c-1.1 0-2-.9-2-2v-32c0-1.1.9-2 2-2s2 .9 2 2v32c0 1.1-.9 2-2 2zM112.732 131.698c-1.1 0-2-.9-2-2v-32c0-1.1.9-2 2-2s2 .9 2 2v32c0 1.1-.9 2-2 2z"
                  />
                </svg>
              </button>
          <% end %>
          </span>
        </div>
      <% end %>

      <%= render "bookmarks/editable_bookmark_icon", resource: faq %>

      <button
        type="button"
        class="cursor-pointer py-5 text-left font-medium"
        data-action="dropdown#toggle"
        data-dropdown-payload-param='[{"<%= dom_id faq, :answer %>":"hidden"}, {"<%= dom_id faq, :arrow %>":"rotate-180"}]'
      >

        <svg
          id="<%= dom_id faq, :arrow %>"
          class="h-6 w-6 shrink-0"
          fill="curentColor"
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            fill-rule="evenodd"
            d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
            clip-rule="evenodd"
          ></path>
        </svg>

      </button>
    </div>

  <div
    id="<%= dom_id faq, :answer %>"
    class="hidden pt-2 pb-4 md:px-6"
    data-dropdown-target="content">
    <strong class="sr-only">Answer:</strong>

    <%= render "inline_edit", model: faq, attribute: :answer, frame_class: "flex flex-col" do %>
      <% if faq_admin_mode? && allowed_to?(:edit?, faq) %>
        <%= link_to("Edit", edit_faq_path(faq), class: button_classes(:secondary_outline, extra: "self-end admin-only bg-blue-100")) %>

      <% end %>

      <span class="max-w-none px-6 prose text-gray-600" data-turbo="false"><!--email_off--><%= simple_format(faq.answer) %><!--email_on--></span>
    <% end %>
  </div>

</div>

<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<% person = @dues_subscription.person %>

<div class="mx-auto max-w-2xl bg-white border border-gray-200 rounded-xl shadow p-4 sm:p-6">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-6">
    <%= link_to person_dues_subscriptions_path(person), class: "text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> Dues
    <% end %>
  </div>

  <h1 class="text-2xl font-bold mb-1">Add dues year</h1>
  <p class="text-sm text-gray-500 mb-6"><%= person.full_name %></p>

  <%= simple_form_for @dues_registration, url: dues_subscription_dues_registrations_path(@dues_subscription) do |f| %>
    <%= render "fields", f: f, include_end_date: false %>

    <div class="flex items-center gap-3 border-t border-gray-200 pt-6 mt-6">
      <div class="ml-auto flex items-center gap-3">
        <%= link_to "Cancel", person_dues_subscriptions_path(person), class: "btn btn-secondary-outline" %>
        <%= f.button :submit, "Add year", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>

<%= turbo_frame_tag :dues_registrations_results do %>
  <% if @dues_registrations.any? %>
    <div class="overflow-x-auto animate-fade blur-on-submit bg-white border border-gray-200 rounded-xl shadow-sm">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Person</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dues year</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cost</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Paid</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @dues_registrations.each do |dues_registration| %>
            <% term = dues_registration.decorate %>
            <% badge = term.status_badge %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= link_to term.person.full_name, person_path(term.person),
                            class: "text-primary hover:text-primary-dark",
                            data: { turbo_frame: "_top" } %>
                <% if term.dues_subscription.cancelled? %>
                  <span class="block text-xs text-gray-500">Subscription cancelled</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= term.term_range %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= term.cost %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= term.paid %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium <%= badge.classes %>">
                  <i class="<%= badge.icon %>"></i>
                  <%= badge.label %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500 text-center py-6">No dues years yet.</p>
  <% end %>
  <div class="pagination flex justify-center mt-6"><%= tailwind_paginate @dues_registrations %></div>
<% end %>

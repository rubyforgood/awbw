<%= simple_form_for(@project_status) do |f| %>
  <div class="form-body space-y-6">
    <!-- Form Errors -->
    <%= f.error_notification %>
    <%= render "shared/errors", resource: @project_status if @project_status.errors.any? %>

    <!-- Form Fields -->
    <div class="row">
      <% @project_status.attribute_names.reject { |a| ["id", "created_at", "updated_at"].include?(a) }.each do |attr| %>
        <% next if ["id", "created_at", "updated_at"].include?(attr) %>
        <div class="col-md-6 mb-3">
          <%= f.input attr.to_sym, input_html: { class: "form-control" } %>
        </div>
      <% end %>
    </div>

    <div class="action-buttons mt-8 flex justify-center gap-3">
      <% if f.object.persisted? && allowed_to?(:destroy?, f.object) %>
        <%= link_to "Delete", @project_status, method: :delete, class: "btn btn-danger-outline",
                    data: { confirm: "Are you sure you want to delete?" } %>
      <% end %>
      <%= link_to "Cancel", project_statuses_path, class: "btn btn-secondary-outline" %>
      <%= f.button :submit, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>

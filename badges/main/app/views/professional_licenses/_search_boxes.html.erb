<%# Filters — field/label styling modeled on the CE registrations search. %>
<% field_class = search_field_class %>
<% label_class = search_label_class %>
<% placeholder_select_class = "#{field_class} search-select-placeholder" %>
<% kinds = ProfessionalLicense.where.not(kind: [ nil, "" ]).distinct.order(:kind).limit(20).pluck(:kind) %>

<div class="mb-6 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
  <%= form_tag professional_licenses_path, method: :get, class: "space-y-4",
    data: {
      controller: "collection",
      turbo_frame: "professional_licenses_results"
    }, autocomplete: "off" do %>
    <div class="flex flex-wrap items-end gap-4 md:flex-nowrap">
      <%= render "shared/filter_text", param: :person_query, label: "Registrant", placeholder: "Search by name or email",
            field_class: field_class, label_class: label_class, wrapper_class: "min-w-[200px] flex-1",
            input_options: { autocomplete: "off" } %>

      <%= render "shared/filter_text", param: :location, label: "Location", placeholder: "City, state, province, or country",
            field_class: field_class, label_class: label_class, wrapper_class: "min-w-[200px] flex-1",
            tooltip: "Where the license was issued, or the city or state of the holder's address",
            input_options: { autocomplete: "off" } %>

      <div class="min-w-[150px]">
        <label for="kind" class="<%= label_class %>">Type</label>
        <%= select_tag "kind",
          options_for_select(kinds, params[:kind]),
          include_blank: "All types",
          class: placeholder_select_class %>
      </div>

      <div class="min-w-[150px]">
        <label for="expired" class="<%= label_class %>">Active</label>
        <%= select_tag "expired",
          options_for_select({ "All" => "", "Active" => "no", "Expired" => "yes" }, params[:expired]),
          class: placeholder_select_class %>
      </div>
    </div>

    <div class="flex justify-end gap-2">
      <%= submit_tag "Search", class: button_classes(:primary) %>
      <%= render "shared/search_clear", url: professional_licenses_path %>
    </div>
  <% end %>
</div>

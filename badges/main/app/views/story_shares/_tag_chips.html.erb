<%# Sector + audience chips that link back into the portal's own filters
    (not sectors/_tagging_label, which links to the auth-gated taggings page).
    Sectors come first, then audience categories — each starred primary leads its
    group, the rest alphabetical.
    Pass compact: true for the tighter sidebar variant (bare chips, no label). %>
<% compact = local_assigns.fetch(:compact, false) %>
<% chip_pad = compact ? "px-2 py-0.5" : "px-3 py-1" %>
<% sector_chip = "bg-brand-magenta-50 text-brand-magenta-700 hover:bg-brand-magenta-100 inline-flex items-center rounded-full text-xs font-medium transition-colors #{chip_pad}" %>
<% audience_chip = "bg-brand-amber-50 text-brand-amber-800 hover:bg-brand-amber-100 inline-flex items-center rounded-full text-xs font-medium transition-colors #{chip_pad}" %>
<% primary_sector = story.primary_sector %>
<% primary_category = story.primary_category %>
<% sectors = story.sectors.sort_by { |sector| [ sector == primary_sector ? 0 : 1, sector.name.downcase ] } %>
<% audiences = story.audience_categories.map(&:decorate).sort_by { |category| [ category.object == primary_category ? 0 : 1, category.display_name.downcase ] } %>
<% if sectors.any? || audiences.any? %>
  <div class="flex flex-wrap items-center <%= compact ? "mb-3 gap-1.5" : "mb-8 gap-2 text-sm text-gray-700" %>">
    <% unless compact %>
      <strong>Tags:</strong>
    <% end %>
    <% sectors.each do |sector| %>
      <%= link_to story_shares_path(sector_names_all: sector.name), class: sector_chip, title: ("Primary sector" if sector == primary_sector) do %>
        <% if sector == primary_sector %><i class="fa-solid fa-star mr-1 text-amber-400" aria-hidden="true"></i><% end %><%= sector.name %>
      <% end %>
    <% end %>
    <% audiences.each do |category| %>
      <%= link_to story_shares_path(category_names_all: category.name), class: audience_chip, title: ("Primary category" if category.object == primary_category) do %>
        <% if category.object == primary_category %><i class="fa-solid fa-star mr-1 text-amber-400" aria-hidden="true"></i><% end %><%= category.display_name %>
      <% end %>
    <% end %>
  </div>
<% end %>

<%= form_tag(workshop_variations_path, method: :get, class: "space-y-4",
             data: { controller: "collection", turbo_frame: "workshop_variations_results" }) do %>
  <div class="mb-6 flex flex-col md:flex-row md:items-end md:gap-4">
    <!-- Search -->
    <%= render "shared/filter_text", param: :query, label: "Search", submit: true,
          wrapper_class: "mb-3 w-full md:mb-0 md:flex-1" %>

    <!-- Author name -->
    <%= render "shared/filter_text", param: :author_name, label: "Author name", placeholder: "e.g. Jane Doe", submit: true,
          wrapper_class: "mb-3 w-full md:mb-0 md:w-64" %>

    <!-- Clear filters -->
    <div class="w-full md:w-auto">
      <%= render "shared/search_clear", url: workshop_variations_path %>
    </div>
  </div>
<% end %>

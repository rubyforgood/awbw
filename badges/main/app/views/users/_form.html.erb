<%= simple_form_for @user, html: { multipart: true, class: "space-y-8" } do |f| %>
  <%= render "shared/errors", resource: @user if user.errors.any? %>
  <%= f.hidden_field :facilitator_id, value: @facilitator&.id || f.object.facilitator_id || params[:facilitator_id] %>
  <!-- Basic Info + Avatar -->
  <!-- Container -->
  <div class="flex gap-8 items-start">
    <!-- LEFT COLUMN: 75% -->
    <div class="flex-1">
      <div class="space-y-6">
        <div class="flex flex-col md:flex-row gap-2">
          <% if @facilitator %>
            <%= f.hidden_field :first_name, value: @facilitator.first_name %>
            <%= f.hidden_field :last_name, value: @facilitator.last_name %>
            <div>
              <div class="w-full">
                <label class="block text-md font-medium text-gray-700 mb-1">
                  First name
                </label>
                <div class="flex gap-x-2 items-center">
                  <div class="text-gray-900 font-medium mt-2">
                    <%= @facilitator.first_name %>
                  </div>
                </div>
                <p class="text-sm text-gray-500 mt-3">
                  Edit on <%= link_to "facilitator profile", facilitator_path(@facilitator), class: "underline" %>
                </p>
              </div>
            </div>
            <div>
              <div class="w-full">
                <label class="block text-md font-medium text-gray-700 mb-1">
                  Last name
                </label>
                <div class="flex gap-x-2 items-center">
                  <div class="text-gray-900 font-medium mt-2">
                    <%= @facilitator.last_name %>
                  </div>
                </div>
                <p class="text-sm text-gray-500 mt-3">
                  Edit on <%= link_to "facilitator profile", facilitator_path(@facilitator), class: "underline" %>
                </p>
              </div>
            </div>
          <% else %>
            <% if @user.persisted? %>
              <div>
                Not associated with a facilitator!
                <br>
                <%= link_to "Create facilitator",
                            new_facilitator_path(user_id: @user.id),
                            class: "btn btn-primary"%>
              </div>
            <% end %>
          <% end %>
          <div class="md:flex-grow md:basis-1/3" id="email_field_wrapper">
            <% if current_user&.super_user? %>
              <div class="w-full">
                <%= f.input :email,
                            label: @user.persisted? ? email_label_with_confirmation_icon(@user) : "Email",
                            hint: "Only editable by admins",
                            input_html: { value: f.object.email.presence || @facilitator&.email,
                                          class: "w-full" },
                            wrapper_html: { class: "w-full" },
                            label_html: { id: "email_label" } %>
                <div id="confirm_email_button">
                  <% if @user.persisted? && @user.confirmed_at.nil? && current_user&.super_user? %>
                    <div class="mt-2">
                      <button type="button"
                              data-controller="confirm-email"
                              data-confirm-email-user-id-value="<%= @user.id %>"
                              data-action="click->confirm-email#confirm"
                        class="btn btn-sm bg-blue-600 hover:bg-blue-700 text-white border-blue-600">
                        Manually confirm email
                      </button>
                    </div>
                  <% end %>
                </div>
              </div>
            <% else %>
              <div class="w-full">
                <label class="block text-md font-medium text-gray-700 mb-3">
                  Email <%= email_confirmation_icon(@user) %>
                </label>
                <div class="flex gap-x-2 items-center">
                  <span class="text-gray-900 font-medium mb-2">
                    <%= f.object.email.presence || @facilitator&.email %>
                  </span>
                </div>
                <p class="text-sm text-gray-500 mt-1">
                  Only editable by admins
                </p>
              </div>
            <% end %>
          </div>
          <div>
            <% if current_user&.super_user? %>
              <div class="w-full p-3">
                <div class="flex flex-col md:flex-row gap-4">
                  <%= f.input :inactive %>
                  <%= f.input :super_user, label: "Admin?" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <!-- Notes -->
        <% if current_user&.super_user? %>
          <div class="comments-section">
            <%= f.input :comment, as: :text, input_html: { rows: 3, class: "w-full" } %>

            <% if params[:admin] %>
              <div class="bg-red-100">
                <%= f.input :notes, as: :text, input_html: { rows: 3, class: "w-full" } %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Preferences: timezone for event times etc. -->
  <div class="space-y-6 p-3">
    <%= f.input :time_zone,
                as: :select,
                collection: us_time_zone_fundamentals,
                selected: f.object.time_zone.presence || "Pacific Time (US & Canada)",
                include_blank: false,
                hint: "Event times and other dates will be shown in this timezone.",
                input_html: { class: "w-full" },
                wrapper_html: { class: "w-full max-w-md" } %>
  </div>

  <% if current_user&.super_user? %>
    <div class="p-3">
      <%= f.input :comment, as: :text, input_html: { rows: 3, class: "w-full" } %>
    </div>
  <% end %>

  <div class="action-buttons mt-8 flex justify-center gap-3">
    <%= render "toggle_lock_button", user: @user %>
    <% if f.object.persisted? && allowed_to?(:destroy?, f.object) %>
      <%= link_to "Delete", @user, method: :delete, class: "btn btn-danger-outline",
                  data: { confirm: "Are you sure you want to delete?" } %>
    <% end %>
    <%= link_to "Cancel", users_path, class: "btn btn-secondary-outline" %>
    <%= f.button :submit, class: "btn btn-primary" %>
  </div>
<% end %>

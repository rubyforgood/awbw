<%= form_tag(users_path, method: :get,
  data: { controller: "collection", turbo_frame: "users_results" },
  autocomplete: "off",
  class: "w-full") do %>
  <div class="mb-6 grid grid-cols-1 items-end gap-4 sm:grid-cols-2 lg:flex">
    <!-- Search -->
    <%= render "shared/filter_text", param: :search, label: "Search", placeholder: "Name, email, or phone", submit: true,
          wrapper_class: "w-full lg:min-w-0 lg:flex-1" %>

    <!-- Access -->
    <%= render "shared/filter_select", param: :access, label: "Access",
          options: [ [ "Has access", "true" ], [ "No access", "false" ] ], selected: params[:access],
          blank: "All", field_class: search_field_class, wrapper_class: "w-full lg:w-36" %>

    <!-- Confirmation -->
    <%= render "shared/filter_select", param: :confirmed, label: "Confirmation",
          options: User::CONFIRMATION_FILTER_OPTIONS, selected: params[:confirmed],
          blank: "All", field_class: search_field_class, wrapper_class: "w-full lg:w-36" %>

    <!-- Admin -->
    <%= render "shared/filter_select", param: :super_user, label: "Admin",
          options: [ [ "Admins", "true" ], [ "Non-admins", "false" ] ], selected: params[:super_user],
          blank: "All", field_class: search_field_class, wrapper_class: "w-full lg:w-36" %>

    <!-- Clear filters -->
    <div class="flex items-end sm:col-span-2 sm:justify-end">
      <%= render "shared/search_clear", url: users_path %>
    </div>
  </div>
<% end %>

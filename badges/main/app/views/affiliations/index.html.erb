<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<% content_for(:full_width, true) %>
<div class="mx-auto max-w-[120rem] px-2 sm:px-6 lg:px-8">
  <div class="w-full <%= DomainTheme.bg_class_for(:people) %> border-primary/10 rounded-2xl border p-6 shadow-sm">
    <div class="mb-6 flex items-start justify-between">
      <div class="pr-6">
        <span class="text-2xs font-semibold tracking-widest uppercase <%= DomainTheme.text_class_for(:people, intensity: 700) %>">Directory</span>
        <h1 class="text-primary font-display text-3xl">Affiliations</h1>
        <p class="mt-1 max-w-2xl text-sm text-gray-600">
          Every facilitator (FA) and job (JA) affiliation. Start and end dates save as you change them.
        </p>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-2 text-right">
        <%= link_to "People", people_path, class: "admin-only bg-blue-100 text-sm #{eyebrow_link_class} px-2 py-1" %>
        <%= link_to "Organizations", organizations_path, class: "admin-only bg-blue-100 text-sm #{eyebrow_link_class} px-2 py-1" %>
      </div>
    </div>

    <%= render "search_boxes" %>

    <% result_src = affiliations_path + "?" + request.query_string %>
    <%= turbo_frame_tag :affiliations_results, src: result_src, data: { turbo: "temporary" } do %>
      <%= render "results_skeleton" %>
    <% end %>
  </div>
</div>

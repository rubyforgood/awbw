<%# The affiliation editor rows with an Active / Inactive segmented control, shared
    by the person and organization forms.

    Locals: f (the parent form builder), label (the counterpart column header),
    scope ("person" / "organization"), add_class (classes for the add button).

    No JavaScript. The server decides each row's bucket (`active?`) and renders
    both; two radios detached from the form (`form="affiliation_tab_none"` names no
    form, so they never submit) drive visibility through :has().

    Two Tailwind traps this markup is shaped around:
      - Radio ids must not contain underscores. Tailwind reads `_` in an arbitrary
        value as a space, so `[#aff_tab_active:checked]` compiles to the selector
        `#aff tab active:checked`, which silently matches nothing.
      - The group is NAMED (`group/afftabs`). `group-hover:` matches any `.group`
        ancestor, and each row's comment icon is its own unnamed `.group` — an
        unnamed group here made hovering anywhere pop every row's tooltip at once.

    A row you end while editing therefore stays exactly where it is and just picks
    up the inactive styling from inactive-toggle — its bucket only moves on save.

    `affiliationsContainer` stays on the OUTER element so affiliation-dates keeps
    seeing every row when it recomputes the live "since" figures; each bucket gets
    its own paginated-fields so paging is per tab. %>
<% rows = f.object.affiliations.each_with_index.to_a %>
<% active_rows, inactive_rows = rows.partition { |affiliation, _index| affiliation.active? } %>
<% tab_base = "cursor-pointer select-none rounded-md px-3 py-1 text-gray-500 transition-colors hover:text-gray-700" %>

<div class="group/afftabs p-3" data-affiliation-dates-target="affiliationsContainer">
  <% if rows.any? %>
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <nav class="inline-flex rounded-lg bg-gray-100 p-0.5 text-sm font-medium">
        <input type="radio" id="aff-tab-active" name="affiliation_tab" form="affiliation_tab_none"
               checked class="peer/active sr-only">
        <input type="radio" id="aff-tab-inactive" name="affiliation_tab" form="affiliation_tab_none"
               class="peer/inactive sr-only">
        <label for="aff-tab-active"
               class="<%= tab_base %> peer-checked/active:bg-white peer-checked/active:text-gray-800 peer-checked/active:shadow-sm">
          Active <span class="text-gray-400"><%= active_rows.size %></span>
        </label>
        <label for="aff-tab-inactive"
               class="<%= tab_base %> peer-checked/inactive:bg-white peer-checked/inactive:text-gray-800 peer-checked/inactive:shadow-sm">
          Inactive <span class="text-gray-400"><%= inactive_rows.size %></span>
        </label>
      </nav>
      <p class="text-xs text-gray-400">
        Ending a row here leaves it on this tab, restyled — it moves after you save.
      </p>
    </div>
  <% end %>

  <div id="<%= scope %>_affiliation_rows_active" class="group-has-[#aff-tab-inactive:checked]/afftabs:hidden"
       data-controller="paginated-fields" data-paginated-fields-per-page-value="10">
    <% if active_rows.any? %>
      <%= render "affiliations/header", label: label %>
    <% else %>
      <p class="py-4 text-center text-sm text-gray-500">No active affiliations.</p>
    <% end %>
    <% active_rows.each do |affiliation, index| %>
      <%= f.fields_for :affiliations, affiliation, child_index: index do |affiliation_form| %>
        <div data-paginated-fields-target="item">
          <%= render "affiliation_fields", f: affiliation_form %>
        </div>
      <% end %>
    <% end %>
    <div data-paginated-fields-target="nav"></div>
  </div>

  <div id="<%= scope %>_affiliation_rows_inactive" class="group-has-[#aff-tab-active:checked]/afftabs:hidden"
       data-controller="paginated-fields" data-paginated-fields-per-page-value="10">
    <% if inactive_rows.any? %>
      <%= render "affiliations/header", label: label %>
    <% else %>
      <p class="py-4 text-center text-sm text-gray-500">No inactive affiliations.</p>
    <% end %>
    <% inactive_rows.each do |affiliation, index| %>
      <%= f.fields_for :affiliations, affiliation, child_index: index do |affiliation_form| %>
        <div data-paginated-fields-target="item">
          <%= render "affiliation_fields", f: affiliation_form %>
        </div>
      <% end %>
    <% end %>
    <div data-paginated-fields-target="nav"></div>
  </div>

  <%# Adding is an Active-tab action — a new row is active by definition, so it
      would land on the other tab and look like nothing happened. %>
  <div class="mt-2 group-has-[#aff-tab-inactive:checked]/afftabs:hidden">
    <%= link_to_add_association "➕ Add Affiliation", f, :affiliations,
          data: { association_insertion_node: "##{scope}_affiliation_rows_active",
                  association_insertion_method: "append" },
          class: add_class %>
  </div>
</div>

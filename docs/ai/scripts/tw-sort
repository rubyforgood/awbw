#!/usr/bin/env bash
# Sort Tailwind utility classes into canonical order with rustywind.
# Delegates to bin/tw-sort — this wrapper exists for the ai/ workflow.
set -euo pipefail
source "$(dirname "$0")/.ruby-env"

# Logical cd, so ../ is the repo root even when ai/ is a symlink to docs/ai/scripts.
exec "$(cd "$(dirname "$0")/.." && pwd)/bin/tw-sort" "$@"

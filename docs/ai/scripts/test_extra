#!/usr/bin/env bash
# Full RSpec run, including the headless-Chrome system specs that ai/test skips.
# Builds the Vite test bundle up front so those specs render current assets in
# one clean build (instead of ViteRuby rebuilding lazily mid-run). Slower — use
# ai/test for iteration, and this when you've changed frontend assets or
# system-tested behavior, or before pushing.
set -euo pipefail
source "$(dirname "$0")/.ruby-env"
bin/vite build --mode test
bundle exec rspec "$@"

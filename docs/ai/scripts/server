#!/usr/bin/env bash
# Start development services (web + vite).
# Starts at WORKSPACE_PORT (the workspace's assigned port) if set, otherwise 3000,
# and steps up until both the server port and its Vite port (server_port + 1) are free.
set -euo pipefail
source "$(dirname "$0")/.ruby-env"

listening() { lsof -iTCP:"$1" -sTCP:LISTEN -n -P >/dev/null 2>&1; }

preferred_port="${WORKSPACE_PORT:-3000}"
server_port="$preferred_port"
while listening "$server_port" || listening "$((server_port + 1))"; do
  server_port=$((server_port + 1))
done
[ "$server_port" != "$preferred_port" ] && echo "ai/server: port $preferred_port (or its Vite port) is taken, using $server_port"

export VITE_RUBY_PORT=$((server_port + 1))
bin/dev -p "$server_port"

# Opt-in sample: copy to .conductor/settings.toml. See docs/ai/README.md.

"$schema" = "https://conductor.build/schemas/settings.repo.schema.json"

[scripts]
setup = "bin/conductor-setup"
archive = "bin/conductor-archive"
run_mode = "concurrent"

[scripts.run.server]
command = "bin/conductor-server"
default = true
available_in = [ "local" ]
icon = "play"

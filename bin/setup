#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

# def run_sql_file(path)
#   puts "== Running SQL file: #{path} =="
#
#   config = ActiveRecord::Base.connection_db_config.configuration_hash

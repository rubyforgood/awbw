# If using database in docker compose
DATABASE_URL=trilogy://root@$(docker compose port database 3306)/
# DATABASE_URL=trilogy://root@localhost:3306/

# AWS - Used for S3 storage
AWS_ACCESS_KEY_ID=SOME_ID
AWS_SECRET_ACCESS_KEY=SOME_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=awbwassets_development

# Email settings
SMTP_USERNAME=SOME_USERNAME
SMTP_PASSWORD=SOME_PASSWORD
SMTP_SERVER=SOME_HOST
SMTP_PORT=2525

# Honeycomb / OpenTelemetry (production only)
HONEYCOMB_API_KEY=your-api-key-here
OTEL_SERVICE_NAME=awbw

# Honeybadger error monitoring (production only)
HONEYBADGER_API_KEY=your-api-key-here

# Asset CDN (DigitalOcean Spaces)
# ASSET_HOST=https://the-bucket.sfo3.cdn.digitaloceanspaces.com

# Container user mapping (docker compose user: "${UID:-0}:${GID:-0}")
# Unset, these default to 0:0 (root), the containers' default behavior.
# To run the web/vite containers as your user instead of root (prevents
# root-owned files in the repo), set them to your ids from `id -u` and `id -g`.
UID=1000
GID=1000

# Other
RAILS_ENV=development
APP_HOST=localhost:3000
RAILS_SERVE_STATIC_FILES=true
ORGANIZATION_NAME=A Window Between Worlds
# General contact mailbox (contact page, portal footer, invoice/receipt header);
# falls back to REPLY_TO_EMAIL when unset
INFO_EMAIL=umberto.user@awbw.org
REPLY_TO_EMAIL=umberto.user@example.com
# App settings. Each is a fallback: the Setting row (edited at /admin/settings)
# wins when its field is filled in.
# Staffed programs mailbox: the reply_to on portal mail and the address users are
# told to write to; falls back to REPLY_TO_EMAIL when unset
PROGRAMS_EMAIL=umberto.programs@example.com
# Unattended mailbox used as the from: on event mail, so replies go to
# PROGRAMS_EMAIL instead; falls back to REPLY_TO_EMAIL when unset
NO_REPLY_EMAIL=umberto.no-reply@example.com
# Public contact mailbox printed on invoices, receipts, and portal contact info;
# falls back to PROGRAMS_EMAIL when unset
INFO_EMAIL=umberto.info@example.com
# Default annual membership price, in cents
ANNUAL_MEMBERSHIP_CENTS=2500
# Days before a term ends that a renewal invoice is generated
ANNUAL_MEMBERSHIP_RENEWAL_WINDOW_DAYS=30
# Days past a term's start that an unpaid membership invoice still reads as current
ANNUAL_MEMBERSHIP_GRACE_PERIOD_DAYS=30
# Leading tag on generated invoice numbers, e.g. INV-004
INVOICE_PREFIX=INV
BLAZER_DATABASE_URL=db_url # Optional if you want to use a different db for Blazer

# Pay Gem
STRIPE_PUBLIC_KEY=test
STRIPE_PRIVATE_KEY=test
STRIPE_WEBHOOK_RECEIVE_TEST_EVENTS=true
# STRIPE_SIGNING_SECRET=

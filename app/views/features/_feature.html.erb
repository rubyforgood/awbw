<article
  class="relative bg-white rounded-xl shadow-sm hover:shadow-md transition border border-gray-200 overflow-hidden"
  data-feature-list-target="card"
  data-area="<%= feature.area %>"
  data-status="<%= feature.display_status %>"
  data-date="<%= feature.released_iso %>"
  data-text="<%= feature.search_text %>">

  <span class="absolute inset-y-0 left-0 w-1.5 bg-<%= feature.area_meta[:color] %>-500"></span>

  <div class="p-4 pl-6">
    <div class="flex items-start justify-between gap-2 mb-2">
      <div class="flex flex-wrap items-center gap-2">
        <%= feature.area_badge %>
        <%= feature.status_badge %>
        <% unless feature.published? %>
          <span class="admin-only <%= badge_classes("bg-gray-100 text-gray-700 border-gray-200") %>">
            <i class="fa-solid fa-eye-slash"></i> Draft
          </span>
        <% end %>
      </div>
      <span class="text-xs font-medium text-gray-500 whitespace-nowrap mt-0.5">
        <i class="fa-regular fa-calendar"></i> <%= feature.released_label %>
      </span>
    </div>

    <h3 class="text-lg font-semibold text-gray-900 leading-tight">
      <%= link_to feature.name, feature_path(feature), class: "hover:text-primary" %>
    </h3>
    <p class="text-gray-600 text-sm mt-1"><%= feature.summary %></p>

    <% if feature.pro_tips_list.any? %>
      <div class="mt-3 rounded-lg bg-amber-50 border border-amber-200 p-3">
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mb-1">
          <i class="fa-solid fa-lightbulb"></i> <%= "Pro tip".pluralize(feature.pro_tips_list.size) %>
        </p>
        <ul class="list-disc list-inside space-y-0.5 text-sm text-amber-900">
          <% feature.pro_tips_list.each do |tip| %>
            <li><%= tip %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mt-3 flex items-center gap-4 text-sm">
      <%= link_to feature_path(feature), class: "text-primary font-medium hover:underline" do %>
        Details <i class="fa-solid fa-arrow-right text-xs"></i>
      <% end %>
      <% if feature.external_url.present? %>
        <%= link_to safe_url(feature.external_url), target: "_blank", rel: "noopener noreferrer",
                    class: "text-gray-500 hover:text-gray-700" do %>
          <i class="fa-solid fa-up-right-from-square"></i> Full guide
        <% end %>
      <% end %>
    </div>
  </div>
</article>

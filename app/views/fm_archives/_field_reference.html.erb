<section class="rounded-xl border border-blue-200 bg-blue-50 p-6">
  <h2 class="mb-1 text-lg font-semibold">Available fields &amp; associations</h2>
  <p class="mb-5 text-sm text-gray-600">Everything a <%= model.name %> record can hold, whether or not this one has it filled in.</p>
  <div class="grid gap-8 lg:grid-cols-2">
    <div>
      <h3 class="mb-3 text-sm font-semibold text-gray-700">Fields</h3>
      <dl class="space-y-3">
        <% model::FIELD_GROUPS.each do |label, keys| %>
          <div>
            <dt class="text-xs font-medium text-gray-500"><%= label %></dt>
            <dd class="mt-1 flex flex-wrap gap-1">
              <% keys.each do |key| %>
                <span class="rounded bg-white px-2 py-0.5 font-mono text-xs text-gray-700"><%= key %></span>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
    <div class="space-y-6">
      <div>
        <h3 class="mb-3 text-sm font-semibold text-gray-700">Linked from this record</h3>
        <ul class="space-y-1 text-sm">
          <% model::FM_LINKS.each do |key, table| %>
            <li>
              <span class="rounded bg-white px-2 py-0.5 font-mono text-xs text-gray-700"><%= key %></span>
              <span class="text-gray-400">→</span>
              <%= link_to FmArchivesController::TABLES.dig(table.delete_prefix("fm_"), :label), fm_archives_path(table: table.delete_prefix("fm_")),
                          class: "text-primary hover:underline" %>
            </li>
          <% end %>
        </ul>
      </div>
      <div>
        <h3 class="mb-3 text-sm font-semibold text-gray-700">Records pointing here</h3>
        <ul class="space-y-1 text-sm">
          <% model::HAS_MANY.each do |table, config| %>
            <li>
              <%= link_to config[:label], fm_archives_path(table: table.delete_prefix("fm_")), class: "text-primary hover:underline" %>
              <span class="text-gray-400">via</span>
              <span class="rounded bg-white px-2 py-0.5 font-mono text-xs text-gray-700"><%= config[:via] %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</section>

<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="border-primary/10 rounded-2xl border p-6 shadow-sm">
  <div class="space-y-6">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-primary font-display text-2xl font-semibold"><%= @record.name %></h1>
        <p class="text-sm text-gray-500"><%= @table_label %> &middot; FM ID: <%= @record.fm_id %> &middot; Key: <%= @record.fm_key_name %></p>
      </div>
      <%= link_to "Back to list", fm_archives_path(table: @table_key), class: button_classes(:primary_outline) %>
    </div>

    <% if @portal_records.any? %>
      <div class="rounded-xl bg-white p-6">
        <h2 class="mb-3 text-lg font-semibold">In the portal</h2>
        <div class="flex flex-wrap gap-2">
          <% @portal_records.each do |record| %>
            <%= filemaker_portal_link(record) %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="grid gap-6 lg:grid-cols-2">
      <% @record.grouped_data.each do |label, subgroups| %>
        <section class="<%= class_names("rounded-xl bg-white p-6", "lg:col-span-2": label.nil?, "lg:row-span-2": @record.class::TALL_GROUPS.include?(label)) %>">
          <% if label %>
            <h2 class="mb-1 text-lg font-semibold"><%= label %></h2>
          <% end %>
          <div class="space-y-4">
            <% subgroups.each do |sub_label, fields| %>
              <% if sub_label && @record.single_field_group?(sub_label) %>
                <div class="grid grid-cols-5 gap-4 rounded-lg border border-gray-200 px-4 py-3 text-sm">
                  <h3 class="col-span-2 font-semibold text-gray-700"><%= sub_label %></h3>
                  <span class="col-span-3 break-words text-gray-900"><%= fields.values.first %></span>
                </div>
              <% else %>
                <div class="<%= class_names("rounded-lg border border-gray-200 px-4 pt-3 pb-1": sub_label) %>">
                  <% if sub_label %>
                    <h3 class="text-sm font-semibold text-gray-700"><%= sub_label %></h3>
                  <% end %>
                  <%= render "fields", record: @record, fields: fields %>
                  <%= render "listed_records", owner: @record, records: @record.records_listed_under(sub_label) %>
                </div>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>

    <% if @backlinks.any? %>
      <div class="rounded-xl bg-white p-6">
        <h2 class="mb-1 text-lg font-semibold">Related Records</h2>
        <% if @record.class::PORTAL_COUNTERPARTS.any? %>
          <%= render "related_legend" %>
        <% end %>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          <% @backlinks.each do |label, info| %>
            <%= turbo_frame_tag "backlink_#{info[:table]}",
                  class: class_names("block min-w-0 overflow-x-auto rounded-lg border p-3",
                                     fm_related_table_highlight(@record, info[:table]) || "border-gray-200") do %>
              <h3 class="text-sm font-medium text-gray-500"><%= label %> (<%= number_with_delimiter(info[:records].total_entries) %>)</h3>
              <% if (counterpart = @record.portal_counterpart(info[:table])) %>
                <p class="text-xs text-gray-600">In the portal as <%= counterpart.downcase %></p>
              <% end %>
              <div class="mt-2 flex flex-wrap gap-1">
                <% info[:records].each do |record| %>
                  <%= link_to fm_archive_path(record.fm_id, table: info[:table].sub("fm_", "")),
                        class: "text-xs text-primary hover:underline bg-gray-50 px-2 py-1 rounded",
                        title: record.name, data: { turbo_frame: "_top" } do %>
                    <span class="font-mono"><%= record.fm_id %></span>
                    <% if record.name != record.fm_id %>
                      <span class="text-gray-700"><%= truncate(record.name, length: 40) %></span>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
              <% if info[:records].total_pages > 1 %>
                <div class="mt-3">
                  <%= tailwind_paginate info[:records], { renderer: FmArchivePaginationRenderer, param_name: info[:page_param], params: { id: @record.fm_id, table: @selected } } %>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @record.class::FIELD_GROUPS.any? %>
      <%= render "field_reference", record: @record %>
    <% end %>
  </div>
</div>

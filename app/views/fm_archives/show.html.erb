<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="border-primary/10 rounded-2xl border p-6 shadow-sm">
  <div class="space-y-6">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-primary font-display text-2xl font-semibold"><%= @record.class.name %></h1>
        <p class="text-sm text-gray-500">FM ID: <%= @record.fm_id %> &middot; Key: <%= @record.fm_key_name %></p>
      </div>
      <%= link_to "Back to list", fm_archives_path(table: @record.class.table_name.sub("fm_", "")), class: button_classes(:primary_outline) %>
    </div>

    <% if @portal_records.any? %>
      <div class="rounded-xl bg-white p-6">
        <h2 class="mb-3 text-lg font-semibold">In the portal</h2>
        <div class="flex flex-wrap gap-2">
          <% @portal_records.each do |record| %>
            <%= filemaker_portal_link(record) %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="grid gap-6 lg:grid-cols-2">
      <% @record.grouped_data.each do |label, fields| %>
        <section class="<%= class_names("rounded-xl bg-white p-6", "lg:col-span-2": label.nil?) %>">
          <% if label %>
            <h2 class="mb-1 text-lg font-semibold"><%= label %></h2>
          <% end %>
          <dl class="divide-y divide-gray-200">
            <% fields.each do |key, value| %>
              <div class="grid grid-cols-5 gap-4 py-3">
                <dt class="col-span-2 text-sm font-medium break-words text-gray-500"><%= key %></dt>
                <dd class="col-span-3 text-sm break-words text-gray-900">
                  <% link_target = @record.class::FM_LINKS[key] %>
                  <% if link_target && value.present? %>
                    <%= fm_archive_reference_link(value, link_target) %>
                  <% elsif link_target.nil? && value.present? && @record.class.const_defined?(:CONTEXT_LINK_MAP) && (ctx = @record.data["Context"]) && (ctx_target = @record.class::CONTEXT_LINK_MAP[ctx]) %>
                    <%= fm_archive_reference_link(value, ctx_target) %>
                  <% elsif link_target.nil? && value.present? && @record.class.const_defined?(:PREFIX_LINK_MAP) && (prefix_target = @record.class::PREFIX_LINK_MAP[value.to_s[0]]) %>
                    <%= fm_archive_reference_link(value, prefix_target) %>
                  <% else %>
                    <%= value %>
                  <% end %>
                </dd>
              </div>
            <% end %>
          </dl>
          <% if @record.is_a?(FmRolodex) && label == FmRolodex::PHONES_AND_ADDRESSES %>
            <%= render "contact_records", rolodex: @record.decorate, heading: "Phone numbers", records: @record.phone_numbers %>
            <%= render "contact_records", rolodex: @record.decorate, heading: "Addresses", records: @record.addresses %>
          <% end %>
        </section>
      <% end %>
    </div>

    <% if @backlinks.any? %>
      <div class="rounded-xl bg-white p-6">
        <h2 class="mb-4 text-lg font-semibold">Related Records</h2>
        <% @backlinks.each do |label, info| %>
          <%= turbo_frame_tag "backlink_#{info[:table]}", class: "block py-3 border-b border-gray-200 last:border-0" do %>
            <h3 class="mb-2 text-sm font-medium text-gray-500"><%= label %> (<%= info[:records].total_entries %>)</h3>
            <div class="flex flex-wrap gap-1">
              <% info[:records].each do |record| %>
                <%= link_to record.fm_id, fm_archive_path(record.fm_id, table: info[:table].sub("fm_", "")),
                      class: "text-xs font-mono text-primary hover:underline bg-gray-50 px-2 py-1 rounded",
                      data: { turbo_frame: "_top" } %>
              <% end %>
            </div>
            <% if info[:records].total_pages > 1 %>
              <div class="mt-3">
                <%= tailwind_paginate info[:records], { renderer: FmArchivePaginationRenderer, param_name: info[:page_param], params: { id: @record.fm_id, table: @selected } } %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @record.class::FIELD_GROUPS.any? %>
      <%= render "field_reference", record: @record %>
    <% end %>
  </div>
</div>

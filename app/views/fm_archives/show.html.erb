<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="border-primary/10 rounded-2xl border p-6 shadow-sm">
  <div class="space-y-6">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-primary font-display text-2xl font-semibold"><%= @record.class.name %></h1>
        <p class="text-sm text-gray-500">FM ID: <%= @record.fm_id %> &middot; Key: <%= @record.fm_key_name %></p>
      </div>
      <%= link_to "Back to list", fm_archives_path(table: @record.class.table_name.sub("fm_", "")), class: button_classes(:primary_outline) %>
    </div>

    <% if @portal_records.any? %>
      <div class="rounded-xl bg-white p-6">
        <h2 class="mb-3 text-lg font-semibold">In the portal</h2>
        <div class="flex flex-wrap gap-2">
          <% @portal_records.each do |record| %>
            <%= filemaker_portal_link(record) %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="grid gap-6 lg:grid-cols-2">
      <% @record.grouped_data.each do |label, subgroups| %>
        <section class="<%= class_names("rounded-xl bg-white p-6", "lg:col-span-2": label.nil?) %>">
          <% if label %>
            <h2 class="mb-1 text-lg font-semibold"><%= label %></h2>
          <% end %>
          <div class="space-y-4">
            <% subgroups.each do |sub_label, fields| %>
              <div class="<%= class_names("rounded-lg border border-gray-200 px-4 pt-3 pb-1": sub_label) %>">
                <% if sub_label %>
                  <h3 class="text-sm font-semibold text-gray-700"><%= sub_label %></h3>
                <% end %>
                <%= render "fields", record: @record, fields: fields %>
                <%= render "contact_records", owner: @record, records: @record.records_listed_under(sub_label) %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>

    <% if @backlinks.any? %>
      <div class="rounded-xl bg-white p-6">
        <h2 class="mb-4 text-lg font-semibold">Related Records</h2>
        <% @backlinks.each do |label, info| %>
          <%= turbo_frame_tag "backlink_#{info[:table]}", class: "block py-3 border-b border-gray-200 last:border-0" do %>
            <h3 class="mb-2 text-sm font-medium text-gray-500"><%= label %> (<%= info[:records].total_entries %>)</h3>
            <div class="flex flex-wrap gap-1">
              <% info[:records].each do |record| %>
                <%= link_to record.fm_id, fm_archive_path(record.fm_id, table: info[:table].sub("fm_", "")),
                      class: "text-xs font-mono text-primary hover:underline bg-gray-50 px-2 py-1 rounded",
                      data: { turbo_frame: "_top" } %>
              <% end %>
            </div>
            <% if info[:records].total_pages > 1 %>
              <div class="mt-3">
                <%= tailwind_paginate info[:records], { renderer: FmArchivePaginationRenderer, param_name: info[:page_param], params: { id: @record.fm_id, table: @selected } } %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @record.class::FIELD_GROUPS.any? %>
      <%= render "field_reference", record: @record %>
    <% end %>
  </div>
</div>

<% if records.any? %>
  <ul class="divide-y divide-gray-200 border-t border-gray-200">
    <% records.each do |record| %>
      <li class="grid grid-cols-5 gap-4 py-3 text-sm">
        <span class="col-span-2 font-medium break-words text-gray-500">
          <%= record.decorate.kind %>
          <%= fm_archive_id_tag(record) %>
          <% owner.decorate.contact_tags(record).each do |tag| %>
            <span class="ml-1 rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700"><%= tag %></span>
          <% end %>
        </span>
        <span class="col-span-3 break-words text-gray-900">
          <%= fm_archive_summary_tag(record) %>
        </span>
      </li>
    <% end %>
  </ul>
<% end %>

<% if records.any? %>
  <ul class="divide-y divide-gray-200 border-t border-gray-200">
    <% records.each do |record| %>
      <li class="grid grid-cols-5 gap-4 py-3 text-sm">
        <span class="col-span-2 font-medium break-words text-gray-500">
          <%= record.decorate.kind %>
          <% if record.persisted? %>
            <%= link_to record.fm_id, fm_archive_path(record.fm_id, table: record.class.table_name.delete_prefix("fm_")),
                        class: "ml-1 font-mono text-xs font-normal text-primary hover:underline" %>
          <% else %>
            <span class="ml-1 font-mono text-xs font-normal text-gray-400 line-through" title="No FM record found"><%= record.fm_id %></span>
          <% end %>
          <% owner.decorate.contact_tags(record).each do |tag| %>
            <span class="ml-1 rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700"><%= tag %></span>
          <% end %>
        </span>
        <span class="col-span-3 break-words text-gray-900">
          <% if record.persisted? %>
            <%= link_to record.decorate.summary.presence || record.name,
                        fm_archive_path(record.fm_id, table: record.class.table_name.delete_prefix("fm_")),
                        class: "text-primary hover:underline" %>
          <% else %>
            <span class="text-gray-500 italic">Not found in FM data</span>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>
<% end %>

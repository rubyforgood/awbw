<div class="bg-white shadow-sm rounded-xl p-4 hover:shadow-md transition">
  <%= link_to community_news_path(news), class: "block" do %>
    <h3 class="text-lg font-semibold text-gray-900"><%= news.title %></h3>
    <p class="text-gray-600 text-sm mt-1 line-clamp-3"><%#= strip_tags(news.body) %></p>
    <p class="text-xs text-gray-400 mt-2"><%#= news.created_at.to_date.to_s(:long) %></p>
  <% end %>
</div>

<div class="pl-4 pr-6 lg:pl-10 lg:pr-12 bg-gray-300 py-8 rounded-lg">
  <div data-controller="carousel" data-carousel-space-between-value="24" class="swiper">
    <!-- Slides -->
    <div class="swiper-wrapper">
      <% @featured_workshops.each do |workshop| %>
        <div class="swiper-slide rounded-xl overflow-hidden bg-white shadow-md" style="height: 320px;">
          <%= link_to workshop_path(workshop)  do %>
            <div class="h-24 w-full overflow-hidden">
              <img class="w-full h-full object-cover" src="<%= workshop.main_image_url %>" alt="workshop">
            </div>

            <!-- Content section -->
            <div class="p-4">
              <div class="text-lg font-semibold text-gray-800 mb-2">
                <%= workshop.windows_type.label if workshop.windows_type %> |
                <span class="pull-right"><%= workshop.date %></span>
              </div>

              <div class="text-gray-600 text-sm">
                <span class="text-lg font-semibold text-gray-800 mb-2"><%= workshop.title %></span>
                <p>
                  <%= workshop.title.length > 25 ? workshop.formatted_objective.truncate(75) : workshop.formatted_objective %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Navigation buttons -->

    <button
      class="
        swiper-button-prev-custom absolute top-1/2  w-12 h-12 text-primary bg-gray-100 text-2xl font-bold
        rounded-full flex items-center justify-center shadow-lg z-10
      "
    >
      &lt;
    </button>

    <button
      class="
        swiper-button-next-custom absolute top-1/2 right-2 w-12 h-12 text-primary bg-gray-100 text-2xl
        font-bold rounded-full flex items-center justify-center shadow-lg z-10
      "
    >
      &gt;
    </button>
  </div>
</div>

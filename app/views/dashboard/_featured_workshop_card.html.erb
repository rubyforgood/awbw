<%= link_to workshop_path(workshop), class: "
  block
  rounded-xl border border-gray-200 shadow-sm
  bg-white
  hover:shadow-md hover:bg-gray-50
  transition p-4
  cursor-pointer
" do %>
  <%= link_to workshop_path(workshop), class: "block" do %>
    <img src="<%= workshop.main_image_url %>"
         class="w-full h-48 object-cover"
         alt="<%= workshop.title %>">

    <div class="p-4">
      <h3 class="text-lg font-semibold text-gray-900"><%= workshop.title %></h3>
      <p class="text-gray-600 text-sm mt-1 line-clamp-2"><%= workshop.description %></p>
    </div>
  <% end %>
<% end %>

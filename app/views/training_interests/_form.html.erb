<% field_class = "w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-800 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
<% label_class = "block text-sm font-medium text-gray-700 mb-1" %>

<%= form_with model: @training_interest, class: "space-y-5" do |f| %>
  <% if @training_interest.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <ul class="list-disc list-inside space-y-1">
        <% @training_interest.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :person_id, "Person", class: label_class %>
    <%= f.select :person_id,
      options_for_select(Person.where(id: @training_interest.person_id).map { |p| [ p.full_name, p.id ] }, @training_interest.person_id),
      { include_blank: true, prompt: "Search for a person" },
      class: field_class,
      data: { controller: "remote-select", remote_select_model_value: "person" } %>
  </div>

  <div>
    <%= f.label :event_id, "Training (optional)", class: label_class %>
    <%= f.select :event_id,
      options_for_select(Event.where(id: @training_interest.event_id).map { |e| [ e.title, e.id ] }, @training_interest.event_id),
      { include_blank: "General — interest in future trainings" },
      class: field_class,
      data: { controller: "remote-select", remote_select_model_value: "event" } %>
    <p class="mt-1 text-xs text-gray-500">Leave blank for general interest in upcoming trainings.</p>
  </div>

  <div>
    <%= f.label :status, class: label_class %>
    <%= f.select :status,
      options_for_select(TrainingInterest::STATUSES.map { |s| [ TrainingInterest::STATUS_LABELS.fetch(s, s.humanize), s ] }, @training_interest.status),
      {},
      class: field_class %>
  </div>

  <div>
    <%= f.label :source, class: label_class %>
    <%= f.text_field :source, class: field_class, placeholder: "e.g. Facilitator Training registration, admin" %>
  </div>

  <div>
    <%= f.label :note, "Note (optional)", class: label_class %>
    <%= f.text_area :note, rows: 3, class: field_class %>
  </div>

  <div class="flex gap-2 justify-end">
    <%= link_to "Cancel", training_interests_path, class: "btn btn-utility-outline" %>
    <%= f.submit submit_label, class: "btn btn-primary" %>
  </div>
<% end %>

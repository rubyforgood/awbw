<% field_class = "w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-800 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
<% label_class = "block text-sm font-medium text-gray-700 mb-1" %>
<div class="mb-6 p-4 bg-white border border-gray-200 rounded-xl shadow-sm">
  <%= form_tag training_interests_path, method: :get, class: "space-y-4",
    data: { turbo_frame: "training_interests_results" }, autocomplete: "off" do %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="q" class="<%= label_class %>">Person</label>
        <%= text_field_tag :q, params[:q], class: field_class, placeholder: "Search by name or email" %>
      </div>
      <div>
        <label for="status" class="<%= label_class %>">Status</label>
        <%= select_tag :status,
          options_for_select(
            [ [ "All", "" ], [ "Open", "open" ], [ "Converted", "converted" ], [ "Closed", "closed" ], [ "General (no event)", "general" ] ],
            params[:status]),
          class: field_class %>
      </div>
    </div>
    <div class="flex gap-2 justify-end">
      <%= submit_tag "Search", class: "btn btn-primary" %>
      <%= link_to "Clear filters", training_interests_path, class: "btn btn-utility-outline" %>
    </div>
  <% end %>
</div>

<% content_for(:page_bg_class, "public") %>
<%= render "shared/public_welcome_banner" %>

<% subtitle = capture do %>
  Browse workshops, resources, and stories using our tagging system. For a more precise search, use <a href="#explore-by-combination" class="font-semibold text-blue-600 hover:text-blue-800">Explore by combination</a> to apply multiple filters at once.
<% end %>
<%= render layout: "shared/index_page",
           locals: { domain: :tags, eyebrow: "Browse", title: "Tags", subtitle: subtitle } do %>
  <div class="mb-10 w-full">

    <div class="space-y-6">
      <!-- SECTORS -->
      <section class="<%= DomainTheme.bg_class_for(:sectors, intensity: 100) %> border <%= DomainTheme.border_class_for(:sectors, intensity: 200) %> rounded-xl p-6">
        <div class="mb-5 flex items-start justify-between gap-6">
          <div>
            <h2 class="text-lg font-semibold text-slate-900">
              Sectors
            </h2>
            <p class="text-sm text-slate-600">
              Who this content is intended to support
            </p>
          </div>

          <% if allowed_to?(:index?, Sector) %>
            <div class="flex-shrink-0">
              <%= link_to "Manage sectors",
                          sectors_path,
                          class: "admin-only bg-blue-100 btn btn-secondary-outline whitespace-nowrap" %>
            </div>
          <% end %>
        </div>

        <%= render "tags/sectors" %>
      </section>

      <!-- CATEGORIES -->
      <section class="<%= DomainTheme.bg_class_for(:categories, intensity: 100) %> border <%= DomainTheme.border_class_for(:categories, intensity: 200) %> rounded-xl p-6">
        <div class="mb-5 flex items-start justify-between gap-6">
          <div>
            <h2 class="text-lg font-semibold text-stone-900">
              Categories
            </h2>
            <p class="text-sm text-stone-600">
              Themes and topics represented across content
            </p>
          </div>

          <% if allowed_to?(:index?, Category) %>
            <div class="flex-shrink-0">
              <%= link_to "Manage categories",
                          categories_path,
                          class: "admin-only bg-blue-100 btn btn-secondary-outline whitespace-nowrap" %>
            </div>
          <% end %>
        </div>

        <%= render "tags/categories" %>
      </section>

      <!-- STAFF TAGS (internal, admin-only) -->
      <% if allowed_to?(:index?, StaffTag) && @staff_tags.present? %>
        <section class="admin-only rounded-xl border border-blue-200 bg-blue-100 p-6">
          <div class="mb-5 flex items-start justify-between gap-6">
            <div>
              <h2 class="text-lg font-semibold text-slate-900">
                Staff tags
              </h2>
              <p class="text-sm text-slate-600">
                Internal only — pipelines, rosters, and outreach lists. Each links to the tagged people.
              </p>
            </div>

            <div class="flex-shrink-0">
              <%= link_to "Manage staff tags",
                          staff_tags_path,
                          class: "admin-only bg-blue-100 btn btn-secondary-outline whitespace-nowrap" %>
            </div>
          </div>

          <%= render "tags/staff_tags", return_to: "tags" %>
        </section>
      <% end %>
    </div>
  </div>
<% end %>

<%= render "taggings/explore_by_combination" %>

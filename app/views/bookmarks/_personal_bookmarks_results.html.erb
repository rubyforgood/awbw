<%= turbo_stream.replace("bookmarks_count", partial: "bookmarks_count") %>
<%
  sort_base = params.permit(:keyword, :bookmarkable_type, :windows_type, :user_id, :number_of_items_per_page).to_h.symbolize_keys
  # Clicking the active segment flips its direction; the arrow shows which way it runs.
  sort_href = ->(col) {
    personal_bookmarks_path(sort_base.merge(sort: col, direction: (@sort == col && @sort_direction == "desc") ? "asc" : "desc", page: nil))
  }
%>
<div class="<%= 'animate-fade blur-on-submit' if @bookmarks.any? %>">
  <div class="mb-6 flex justify-end">
    <%= render "shared/sort_strip", options: BookmarksController::SORT_OPTIONS, selected: @sort, domain: :bookmarks,
               href: sort_href, active_icon: (@sort_direction == "asc" ? "fa-arrow-up" : "fa-arrow-down"), link_data: { turbo_frame: "personal_bookmarks_results" } %>
  </div>

  <div class="my-6 border-b border-gray-300"></div>

  <% if @bookmarks.any? %>
    <div id="bookmarks-list" class="space-y-4">
      <% @bookmarks.each do |bookmark| %>
        <%= render "bookmarks/personal_row",
                   bookmark: bookmark,
                   link_route: polymorphic_path(bookmark.bookmarkable) %>
      <% end %>
    </div>

    <div class="mt-6 flex justify-center">
      <div class="pagination mt-6"><%= tailwind_paginate @bookmarks %></div>
    </div>
  <% else %>
    <p class="text-gray-600">Your search returned no results. Please try again.</p>
  <% end %>
</div>

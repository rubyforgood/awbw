<%= simple_form_for(@category_type) do |f| %>
  <div class="form-body space-y-6">
    <%= f.error_notification %>
    <%= render "shared/errors", resource: @category_type if @category_type.errors.any? %>

    <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-4">
      <div class="grid grid-cols-1 gap-6 md:col-span-3 md:grid-cols-2">
        <%= f.input :name,
                    label: "Name",
                    input_html: { class: "form-control" },
                    required: true %>
        <%= f.input :display_text,
                    label: "Display Text",
                    hint: "For display on story idea form",
                    input_html: { class: "form-control" } %>
      </div>

      <div class="admin-only mt-6 rounded bg-blue-100 p-3 md:mt-0">
        <%= render "shared/visibility_info", flags: %i[category_type_published story_specific profile_specific] %>
        <div class="flex flex-col items-start gap-4">
          <%= visibility_flag_input f, :published,
                      definition_key: :category_type_published,
                      input_html: { class: "h-4 w-4" },
                      wrapper_html: { class: "mb-0" } %>
          <%= visibility_flag_input f, :story_specific,
                      input_html: { class: "h-4 w-4" },
                      wrapper_html: { class: "mb-0" } %>
          <%= visibility_flag_input f, :profile_specific,
                      input_html: { class: "h-4 w-4" },
                      wrapper_html: { class: "mb-0" } %>
        </div>
      </div>
    </div>

    <div class="action-buttons mt-8 flex justify-center gap-3">
      <% if allowed_to?(:destroy?, f.object) %>
        <%= link_to "Delete", @category_type, class: button_classes(:danger_outline),
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete?" } %>
      <% end %>
      <%= link_to "Cancel", category_types_path, class: button_classes(:secondary_outline) %>
      <%= f.button :submit, class: button_classes(:primary) %>
    </div>
  </div>
<% end %>

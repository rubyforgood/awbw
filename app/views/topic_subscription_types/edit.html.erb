<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<div class="border-primary/10 mx-auto max-w-2xl rounded-2xl border bg-white p-6 shadow-sm">
  <div class="mb-6">
    <%= link_to "← Subscription topics", topic_subscription_types_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
  </div>
  <h1 class="text-primary mb-6 font-display text-2xl font-semibold">Edit topic</h1>
  <%= render "form", submit_label: "Save changes" %>

  <%# Archive/restore and delete moved off the index — the topic's actions live on
      its own page now. Delete is only offered when nothing depends on the topic. %>
  <div class="mt-8 border-t border-gray-200 pt-6">
    <h2 class="text-sm font-semibold text-gray-700 mb-3">Actions</h2>
    <div class="flex flex-wrap gap-2">
      <% if @topic_subscription_type.archived? %>
        <%= button_to unarchive_topic_subscription_type_path(@topic_subscription_type), method: :patch,
              class: button_classes(:utility_outline, extra: "inline-flex items-center gap-1.5") do %>
          <i class="fa-solid fa-box-open"></i>
          Restore
        <% end %>
      <% else %>
        <%= button_to archive_topic_subscription_type_path(@topic_subscription_type), method: :patch,
              class: button_classes(:utility_outline, extra: "inline-flex items-center gap-1.5") do %>
          <i class="fa-solid fa-box-archive"></i>
          Archive
        <% end %>
      <% end %>

      <% if @topic_subscription_type.topic_subscriptions.none? %>
        <%= button_to topic_subscription_type_path(@topic_subscription_type), method: :delete,
              class: button_classes(:danger_outline, extra: "inline-flex items-center gap-1.5"),
              data: { turbo_confirm: "Delete this topic?" } do %>
          <i class="fa-solid fa-trash-can"></i>
          Delete
        <% end %>
      <% end %>
    </div>
    <% if @topic_subscription_type.topic_subscriptions.any? %>
      <p class="mt-2 text-xs text-gray-500">Topics with subscriptions can't be deleted — archive to retire without losing them.</p>
    <% end %>
  </div>
  <%= render "shared/audit_info", resource: @topic_subscription_type %>
  <% if allowed_to?(:index?, with: Admin::AhoyActivityPolicy) %>
    <div class="mt-4 flex justify-end">
      <%= render "application/activity_log", record: @topic_subscription_type %>
    </div>
  <% end %>
</div>

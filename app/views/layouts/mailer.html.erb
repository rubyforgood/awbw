<!doctype html>
<html
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!--[if !mso]>
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <![endif]-->

  <!--[if mso]>
  <xml>
    <o:OfficeDocumentSettings>
      <o:AllowPNG/>
      <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
  </xml>
  <![endif]-->

  <style>
      body {
          margin: 0;
          padding: 0;
          background-color: #f9fafb;
          font-family: Arial, Helvetica, sans-serif;
          color: #333;
      }

      .container {
          max-width: 600px;
          background-color: #ffffff;
          padding: 24px;
          border-radius: 8px;
      }

      h1 { font-size: 22px; margin-bottom: 12px; }
      p  { font-size: 14px; line-height: 1.5; margin: 8px 0; }

      .button {
          display: inline-block;
          padding: 10px 16px;
          background-color: #2563eb;
          color: #ffffff !important;
          text-decoration: none;
          border-radius: 6px;
          font-weight: bold;
      }

      .footer {
          margin-top: 32px;
          font-size: 12px;
          color: #6b7280;
      }
  </style>
</head>

<body>
<table width="100%" cellpadding="0" cellspacing="0" bgcolor="#f9fafb">
  <tr>
    <td align="center">

      <!--[if mso | IE]>
      <table width="600" align="center"><tr><td>
      <![endif]-->

      <div class="container">

        <!-- LOGO -->
        <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
          <tr>
            <td align="center">
              <a href="<%= ENV.fetch("APP_HOST", "#") %>" target="_blank">
                <img
                  src="<%= asset_url("logo-color.png") %>"
                  alt="<%= @organization_name || "AWBW" %>"
                  width="160"
                  style="display:block;border:0;outline:none;text-decoration:none;"
                  />
              </a>
            </td>
          </tr>
        </table>

        <%= yield %>

        <div class="footer">
          This is an automated message from <%= @organization_name || "AWBW" %>
        </div>
      </div>

      <!--[if mso | IE]>
      </td></tr></table>
      <![endif]-->

    </td>
  </tr>
</table>

<% if content_for?(:fallback_url) %>
  <div style="max-width:600px;margin:16px auto;font-size:12px;color:#4b5563;">
    <p>If the button above does not work, copy and paste this URL:</p>
    <p><%= yield :fallback_url %></p>
  </div>
<% end %>
</body>
</html>

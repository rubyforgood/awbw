<% width_class = local_assigns.fetch(:width_class, "w-full") %>
<% if user.person %>
  <% cache [user.person, "edit_button", width_class] do %>
    <%= person_edit_button(user.person, width_class: width_class, data: { turbo_frame: "_top" }) %>
  <% end %>
<% else %>
  <%= link_to "Create person",
              new_person_path(user_id: user.id),
              data: { turbo_frame: "_top" },
              class: button_classes(:warning) %>
<% end %>

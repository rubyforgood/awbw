</div>

<script type="module">
  import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs";
  mermaid.initialize({
    startOnLoad: true,
    flowchart: {
      useMaxWidth: true,
      htmlLabels: true,
      curve: "basis",
      padding: 16,
      nodeSpacing: 40,
      rankSpacing: 50
    },
    securityLevel: "loose"
  });

  await mermaid.run();

  document.querySelectorAll(".edgeLabel").forEach(label => {
    const text = label.textContent.trim();
    if (text.startsWith("No")) {
      const rect = label.querySelector("rect, .label-container");
      const span = label.querySelector("span, p, foreignObject div");
      if (rect) {
        rect.setAttribute("fill", "#fee2e2");
        rect.setAttribute("stroke", "#fca5a5");
      }
      if (span) {
        span.style.background = "#fee2e2";
      }
      label.style.background = "#fee2e2";
    }
  });
</script>

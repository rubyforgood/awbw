<%= turbo_frame_tag :users_results do %>
  <% sort_base = params.permit(:search, :access, :confirmed, :super_user, :invited, :authenticated, :number_of_items_per_page).to_h.symbolize_keys %>
  <% sort_link = sort_header_link(frame: "users_results", path: ->(p) { users_path(p) }, base: sort_base) %>
  <% invite_params = params.permit(:search, :super_user, :access, :confirmed, :sort, :direction, :page, :number_of_items_per_page).to_h.symbolize_keys %>
  <%= turbo_stream.replace("users_count", partial: "users_count") %>

  <div class="animate-fade blur-on-submit">
    <% if @users.any? %>
      <!-- Small screens: one card per user -->
      <div class="rounded border border-gray-200 bg-white lg:hidden">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-gray-200 bg-gray-100 px-4 py-2 text-sm font-semibold">
          <span class="text-gray-500">Sort by</span>
          <% [ %w[email Email], %w[person Person], %w[confirmed Confirmed], %w[access Access], %w[admin Admin] ].each do |column, label| %>
            <%= sort_link.call(column, label) %>
          <% end %>
        </div>

        <ul class="divide-y divide-gray-200">
          <% @users.each do |user| %>
            <li class="space-y-3 p-4">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 pt-1 text-sm font-semibold wrap-anywhere text-gray-800"><%= render "users/email", user: user %></div>
                <div class="flex shrink-0 gap-2"><%= render "users/row_actions", user: user %></div>
              </div>

              <%= render "users/person_cell", user: user %>

              <dl class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
                <div class="flex items-center gap-2">
                  <dt class="text-gray-500">Confirmed</dt>
                  <dd><%= render "users/confirmed_status", user: user, invite_params: invite_params %></dd>
                </div>
                <div class="flex items-center gap-2">
                  <dt class="text-gray-500">Access</dt>
                  <dd><%= render "users/access_status", user: user %></dd>
                </div>
                <div class="flex items-center gap-2">
                  <dt class="text-gray-500">Admin</dt>
                  <dd><%= render "users/admin_status", user: user %></dd>
                </div>
              </dl>
            </li>
          <% end %>
        </ul>
      </div>

      <!-- Large screens: table -->
      <div class="hidden overflow-x-auto rounded bg-white lg:block">
        <table class="w-full border-collapse border border-gray-200">
          <thead class="bg-gray-100">
          <tr>
            <th class="w-1/3 px-4 py-2 text-left text-sm font-semibold text-gray-700"><%= sort_link.call("email", "Email") %></th>
            <th class="w-1/6 px-4 py-2 text-left text-sm font-semibold text-gray-700"><%= sort_link.call("person", "Person") %></th>
            <th class="w-[60px] px-4 py-2 text-center text-sm font-semibold text-gray-700"><%= sort_link.call("confirmed", "Confirmed") %></th>
            <th class="w-[60px] px-4 py-2 text-center text-sm font-semibold text-gray-700"><%= sort_link.call("access", "Access") %></th>
            <th class="w-[60px] px-4 py-2 text-center text-sm font-semibold text-gray-700"><%= sort_link.call("admin", "Admin") %></th>
            <th class="w-[80px] px-4 py-2 text-center text-sm font-semibold text-gray-700">Actions</th>
          </tr>
          </thead>

          <tbody class="divide-y divide-gray-200">
          <% @users.each do |user| %>
            <tr class="transition-colors duration-150 hover:bg-gray-50">
              <td class="px-4 py-2 text-sm font-semibold wrap-anywhere text-gray-800"><%= render "users/email", user: user %></td>
              <td class="px-4 py-2 text-left"><%= render "users/person_cell", user: user %></td>
              <td class="px-4 py-2 text-center"><%= render "users/confirmed_status", user: user, invite_params: invite_params %></td>
              <td class="px-4 py-2 text-center"><%= render "users/access_status", user: user %></td>
              <td class="px-4 py-2 text-center"><%= render "users/admin_status", user: user %></td>
              <td class="px-4 py-2">
                <div class="flex justify-center gap-2"><%= render "users/row_actions", user: user %></div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="rounded bg-white py-6 text-center text-gray-500">
        No <%= User.model_name.human.pluralize.downcase %> found.
      </p>
    <% end %>
  </div>

  <!-- Pagination -->
  <div class="mt-6 flex justify-center">
    <div class="pagination">
      <%= tailwind_paginate @users %>
    </div>
  </div>
<% end %>

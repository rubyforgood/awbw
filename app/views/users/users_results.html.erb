<%= turbo_frame_tag :users_results do %>
  <%= turbo_stream.replace("users_count", partial: "users_count") %>

  <div class="animate-fade overflow-x-auto rounded bg-white blur-on-submit">
    <% if @users.any? %>
      <table class="w-full border-collapse border border-gray-200">
        <thead class="bg-gray-100">
        <tr>
          <th class="w-1/3 px-4 py-2 text-left text-sm font-semibold text-gray-700">Email</th>
          <th class="w-1/6 px-4 py-2 text-left text-sm font-semibold text-gray-700">Person</th>
          <th class="w-[60px] px-4 py-2 text-center text-sm font-semibold text-gray-700">Confirmed</th>
          <th class="w-[60px] px-4 py-2 text-center text-sm font-semibold text-gray-700">Access</th>
          <th class="w-[60px] px-4 py-2 text-center text-sm font-semibold text-gray-700">Admin</th>
          <th class="w-[80px] px-4 py-2 text-center text-sm font-semibold text-gray-700">Actions</th>
        </tr>
        </thead>

        <tbody class="divide-y divide-gray-200">
        <% @users.each do |user| %>
          <tr class="transition-colors duration-150 hover:bg-gray-50">
            <!-- Email -->
            <td class="px-4 py-2 font-semibold break-words text-gray-800"><!--email_off--><%= user.email %><!--email_on--></td>

            <!-- Person -->
            <td class="px-4 py-2 text-left">
              <% if user.person %>
                <% cache [user.person, "edit_button"] do %>
                  <% show_email = user.person.profile_show_email? || allowed_to?(:manage?, Person) %>
                  <%= person_edit_button(user.person, subtitle: (user.person.preferred_email if show_email)) %>
                <% end %>
              <% else %>
                <%= link_to "Create person",
                            new_person_path(user_id: user.id),
                            data: { turbo_frame: "_top" },
                            class: button_classes(:warning) %>
              <% end %>
            </td>

            <!-- Confirmed -->
            <td class="px-4 py-2 text-center">
              <%= render "users/confirmed_status", user: user, invite_params: {
                search: params[:search],
                super_user: params[:super_user],
                access: params[:access],
                page: params[:page],
                number_of_items_per_page: params[:number_of_items_per_page]
              } %>
            </td>

            <!-- Access -->
            <td class="px-4 py-2 text-center">
              <% if user.inactive? %>
                <span class="fa fa-ban text-red-500"></span>
              <% end %>
              <% if user.locked_at.present? %>
                <%
                  lock_info = "Locked #{l(user.locked_at, format: :long)}"
                  if user.failed_attempts >= Devise.maximum_attempts
                    lock_info += " (too many failed login attempts)"
                  elsif user.updated_by.present?
                    lock_info += " by #{user.updated_by.name}"
                  end
                %>
                <i class="fa-solid fa-lock text-red-500" title="<%= lock_info %>"></i>
              <% end %>
              <% if user.confirmed_at.nil? %>
                <i class="fa-solid fa-lock text-red-500" title="Unconfirmed — cannot log in"></i>
              <% end %>
              <% if !user.inactive? && !user.locked_at.present? && user.confirmed_at.present? %>
                <% created_info = user.created_at.present? ? "Created #{l(user.created_at, format: :long)}" : ""
                  created_info += " by #{user.created_by.name}" if user.created_by.present? %>
                <span class="fa fa-check-circle text-gray-300" title="<%= created_info %>"></span>
              <% end %>
            </td>

            <!-- Admin -->
            <td class="px-4 py-2 text-center">
              <% if user.super_user? %>
                <i class="fa-solid fa-user-shield text-blue-600" title="<%= "Granted at #{l(user.updated_at, format: :long)}" if user.updated_at.present? %><%= " by #{user.updated_by.name}" if user.updated_by.present? %>"></i>
              <% else %>
                <span>--</span>
              <% end %>
            </td>

            <!-- Actions -->
            <td class="justify-right flex gap-2 px-4 py-2">
              <%= link_to "Edit", edit_user_path(user), data: { turbo_frame: "_top" }, class: button_classes(:secondary_outline, extra: "admin-only bg-blue-100") %>
              <%= link_to "View", user_path(user), data: { turbo_frame: "_top" }, class: button_classes(:secondary_outline, extra: "admin-only bg-blue-100") %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="py-6 text-center text-gray-500">
        No <%= User.model_name.human.pluralize.downcase %> found.
      </p>
    <% end %>
  </div>

  <!-- Pagination -->
  <div class="mt-6 flex justify-center">
    <div class="pagination">
      <%= tailwind_paginate @users %>
    </div>
  </div>
<% end %>

<div class="min-h-screen py-10">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-lg sm:p-8">
      <div class="mb-6 flex items-center">
        <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-yellow-100">
          <svg class="h-6 w-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
        <h1 class="ml-4 text-xl font-semibold text-gray-900">Possible duplicate user</h1>
      </div>

      <p class="mb-2 text-sm text-gray-600">
        Checking email:
        <span class="font-medium text-gray-900"><%= @email %></span>
      </p>

      <p class="mb-4 text-sm text-gray-500">
        We found existing records in the system with this email.
      </p>

      <ul class="mb-6 divide-y divide-gray-200 rounded-lg border border-gray-200">
        <% @duplicates.each do |dup| %>
          <li class="px-4 py-3">
            <div class="flex flex-wrap items-center gap-2">
              <% if dup[:type] == "user" %>
              <span class="text-2xs font-semibold text-gray-400 uppercase">USER EMAIL</span>
                <%= link_to dup[:email], user_path(dup[:id]), target: "_blank",
                            class: "text-gray-700 hover:text-blue-600 font-medium" %>
                <span class="text-2xs rounded bg-red-100 px-1.5 py-0.5 font-medium text-red-700">existing user</span>
              <% else %>
                <span class="text-2xs font-semibold text-gray-400 uppercase">PERSON <%= dup[:email_field]&.upcase || "PRIMARY" %> EMAIL</span>
                <%= link_to dup[:email], person_path(dup[:id]), target: "_blank",
                            class: "text-gray-700 hover:text-blue-600 font-medium" %>
                <% if dup[:has_user] %>
                  <span class="text-2xs rounded bg-gray-100 px-1.5 py-0.5 font-medium text-gray-700">user email: <%= dup[:user_email] %></span>
                <% else %>
                  <span class="text-2xs rounded bg-gray-100 px-1.5 py-0.5 font-medium text-gray-700">no user</span>
                <% end %>
              <% end %>
            </div>
            <% if dup[:type] == "user" && dup[:person_id].present? %>
              <div class="mt-0.5 flex items-center gap-2">
                <span class="text-2xs w-12 font-semibold text-gray-400 uppercase">PERSON</span>
                <%= link_to dup[:name], person_path(dup[:person_id]), target: "_blank",
                            class: "text-gray-500 hover:text-blue-600 text-xs" %>
              </div>
            <% elsif dup[:type] == "person" %>
              <div class="mt-0.5 flex items-center gap-2">
                <span class="text-2xs w-12 font-semibold text-gray-400 uppercase">PERSON</span>
                <%= link_to dup[:name], person_path(dup[:id]), target: "_blank",
                            class: "text-gray-500 hover:text-blue-600 text-xs" %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>

      <div class="flex flex-col items-center gap-3">

        <% shareable_url = check_duplicates_users_url(email: @email, person_id: @person_id) %>
        <%= mail_to "",
              "Ask a colleague",
              subject: "Possible duplicate user: #{@email}",
              body: "I'm trying to add a new user and found a possible duplicate. Can you take a look?\n\n#{shareable_url}",
              class: "text-sm text-gray-500 hover:text-blue-600 underline" %>
      </div>
    </div>
  </div>
</div>

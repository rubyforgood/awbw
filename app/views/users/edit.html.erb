<div class="min-h-screen py-8">
  <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8">
    <div class="admin-only bg-blue-100 rounded p-6">
      <div class="max-w-7xl mx-auto bg-white border border-gray-200 rounded-xl shadow-lg hover:shadow-xl
        transition-shadow duration-200 p-6" data-controller="toggle-lock">
        <div class="space-y-6">
          <!-- Header -->
          <div class="flex items-center justify-between mb-6">
            <h1 class="text-2xl font-semibold text-gray-900">
              Edit <%= @user.class.model_name.human %>
              <i class="fa-solid fa-lock text-red-500" data-toggle-lock-target="icon"
                 style="<%= 'display:none' unless @user.locked_at.present? %>"></i>
            </h1>

            <div class="flex space-x-2">
              <% if @user.person %>
                <%= link_to "Person profile",
                            person_path(@user.person),
                            class: "btn btn-secondary-outline mr-2" %>
              <% else %>
                <div class="admin-only bg-blue-100 p-2 mr-2">
                  No person!
                  <%= link_to "Create person",
                              new_person_path(user_id: @user.id),
                              class: "btn btn-warning px-2 py-1" %>
                </div>
              <% end %>
              <%= button_to "Reset password",
                            send_reset_password_instructions_user_path(@user),
                            method: :post,
                            class: "btn btn-secondary-outline" %>
              <% unless @user.confirmed_at.present? %>
                <%= button_to "Resend Invite",
                              send_welcome_instructions_user_path(@user),
                              method: :post,
                              class: "btn btn-secondary-outline" %>
              <% end %>
              <% if current_user == @user %>
                <%= link_to "Change password",
                            change_password_path,
                            class: "btn btn-secondary-outline" %>
              <% end %>
              <%= link_to "Users",
                          users_path,
                          class: "btn btn-secondary-outline" %>
              <%= link_to "View",
                          user_path(@user),
                          class: "btn btn-secondary-outline" %>
            </div>
          </div>

          <div class="border-b border-gray-300 mb-6"></div>

          <div class="space-y-6">
            <div class="mt-4">
              <%= render "form", user: @user %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

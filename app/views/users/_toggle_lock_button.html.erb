<div id="toggle_lock_button">
  <% if user.persisted? %>
    <% button_class = if user.locked_at.present?
                        button_classes(nil, extra: "border border-orange-600 bg-orange-600 text-white hover:bg-orange-700")
                      else
                        button_classes(:secondary_outline)
                      end %>
    <button type="button"
            data-controller="toggle-lock"
            data-toggle-lock-user-id-value="<%= user.id %>"
            data-action="click->toggle-lock#toggle"
            class="<%= button_class %>">
      <%= user.locked_at.present? ? "Unlock account" : "Lock account" %>
    </button>
  <% end %>
</div>

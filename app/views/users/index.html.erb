<div class="min-h-screen py-8">
  <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8">
    <div class="admin-only bg-blue-100 rounded p-6">
      <div class="max-w-7xl mx-auto bg-white border border-gray-200 rounded-xl shadow-lg hover:shadow-xl
        transition-shadow duration-200 p-6">
      <div class="space-y-6">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
          <h1 class="text-2xl font-semibold text-gray-900">
            <%= User.model_name.human.pluralize %> (<%= @users_count %>)
          </h1>
          <div class="flex gap-2">
            <% if allowed_to?(:new?, User) %>
              <%= link_to "New #{User.model_name.human.downcase}",
                          new_user_path,
                          class: "admin-only bg-blue-100 btn btn-primary-outline" %>
            <% end %>
          </div>
        </div>

        <!-- Filter form -->
        <%= render "search_boxes" %>

        <div class="overflow-x-auto">
          <table class="w-full border-collapse border border-gray-200">
            <thead class="bg-gray-100">
            <tr>
              <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700 w-1/6">Name</th>
              <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700 w-1/3">Email</th>
              <th class="px-4 py-2 text-center text-sm font-semibold text-gray-700 w-[60px]">Confirmed</th>
              <th class="px-4 py-2 text-center text-sm font-semibold text-gray-700 w-[60px]">Access</th>
              <th class="px-4 py-2 text-center text-sm font-semibold text-gray-700 w-[60px]">Admin</th>
              <th class="px-4 py-2 text-center text-sm font-semibold text-gray-700 w-[80px]">Actions</th>
            </tr>
            </thead>

            <tbody class="divide-y divide-gray-200">
            <% @users.each do |user| %>
              <tr class="hover:bg-gray-50 transition-colors duration-150">
                <!-- Avatar -->
                <td class="px-4 py-2 text-left">
                  <% if user.person %>
                    <% cache [user.person, "profile_button"] do %>
                      <%= person_profile_button(user.person) %>
                    <% end %>
                  <% else %>
                    <%= link_to "Create person",
                                new_person_path(user_id: user.id),
                                class: "btn btn-warning" %>
                  <% end %>
                </td>

                <!-- Email -->
                <td class="px-4 py-2 text-sm text-gray-800 break-words"><%= user.email %></td>

                <!-- Confirmed -->
                <td class="px-4 py-2 text-center">
                  <% if user.confirmed_at.present? %>
                    <span class="fa fa-check-circle text-green-500" title="Confirmed <%= l(user.confirmed_at, format: :long) %>"></span>
                  <% elsif user.welcome_instructions_sent_at.present? %>
                    <% sent_info = "Confirmation instructions sent #{l(user.welcome_instructions_sent_at, format: :long)}"
                       sent_info += " by #{user.updated_by.name}" if user.updated_by.present? %>
                    <i class="fa-solid fa-clock text-warning" title="<%= sent_info %>"></i>
                  <% else %>
                    <%= link_to "Invite",
                                send_welcome_instructions_user_path(user,
                                                                    search: params[:search],
                                                                    super_user: params[:super_user],
                                                                    access: params[:access],
                                                                    page: params[:page],
                                                                    number_of_items_per_page:
                                                                      params[:number_of_items_per_page]),
                                method: :post,
                                class: "btn btn-secondary-outline",
                                data: { turbo: false } %>
                  <% end %>
                  <% if user.unconfirmed_email.present? %>
                    <i class="fa-solid fa-triangle-exclamation text-warning" title="Email change pending: <%= user.unconfirmed_email %>"></i>
                  <% end %>
                </td>

                <!-- Access -->
                <td class="px-4 py-2 text-center">
                  <% if user.inactive? %>
                    <span class="fa fa-ban text-red-500"></span>
                  <% end %>
                  <% if user.locked_at.present? %>
                    <%
                      lock_info = "Locked #{l(user.locked_at, format: :long)}"
                      if user.failed_attempts >= Devise.maximum_attempts
                        lock_info += " (too many failed login attempts)"
                      elsif user.updated_by.present?
                        lock_info += " by #{user.updated_by.name}"
                      end
                    %>
                    <i class="fa-solid fa-lock text-red-500" title="<%= lock_info %>"></i>
                  <% end %>
                  <% if user.confirmed_at.nil? %>
                    <i class="fa-solid fa-lock text-red-500" title="Unconfirmed — cannot log in"></i>
                  <% end %>
                  <% if !user.inactive? && !user.locked_at.present? && user.confirmed_at.present? %>
                    <% created_info = "Created #{l(user.created_at, format: :long)}" if user.created_at.present?
                       created_info += " by #{user.created_by.name}" if user.created_by.present? %>
                    <span class="fa fa-check-circle text-gray-300" title="<%= created_info %>"></span>
                  <% end %>
                </td>

                <!-- Admin -->
                <td class="px-4 py-2 text-center">
                  <% if user.super_user? %>
                    <i class="fa-solid fa-user-shield text-blue-600" title="<%= "Granted at #{l(user.updated_at, format: :long)}" if user.updated_at.present? %><%= " by #{user.updated_by.name}" if user.updated_by.present? %>"></i>
                  <% else %>
                    <span>--</span>
                  <% end %>
                </td>

                <!-- Actions -->
                <td class="px-4 py-2 flex justify-right gap-2">
                  <%= link_to "Edit", edit_user_path(user), class: "btn btn-secondary-outline" %>
                  <%= link_to "View", user_path(user), class: "btn btn-secondary-outline" %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>

        <!-- Empty state -->
        <% unless @users.any? %>
          <p class="text-gray-500 text-center py-6">
            No <%= User.model_name.human.pluralize %> found.
          </p>
        <% end %>

        <!-- Pagination -->
        <div class="mt-6 flex justify-center">
          <div class="pagination">
            <%= tailwind_paginate @users %>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>
</div>

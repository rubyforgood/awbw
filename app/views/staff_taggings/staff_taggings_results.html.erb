<%= turbo_frame_tag :staff_taggings_results do %>
  <%= turbo_stream.replace("staff_taggings_count", partial: "staff_taggings_count") %>

  <div class="animate-fade overflow-hidden rounded-xl bg-white blur-on-submit">
    <% if @staff_taggings.any? %>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse border border-gray-200">
          <thead class="bg-gray-100">
            <tr>
              <th class="w-1/3 px-4 py-2 text-left text-sm font-semibold text-gray-700">Person</th>
              <th class="w-1/4 px-4 py-2 text-left text-sm font-semibold text-gray-700">Staff tag</th>
              <th class="w-1/4 px-4 py-2 text-left text-sm font-semibold text-gray-700">Tagged</th>
              <th class="w-[120px] px-4 py-2 text-center text-sm font-semibold text-gray-700">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @staff_taggings.each do |tagging| %>
              <% person = tagging.staff_taggable %>
              <tr class="transition-colors duration-150 hover:bg-gray-50">
                <td class="px-4 py-2">
                  <% if person && allowed_to?(:show?, person) %>
                    <%= link_to person.name, polymorphic_path(person),
                                data: { turbo_frame: "_top" },
                                class: "font-semibold #{DomainTheme.text_class_for(:people)} hover:underline" %>
                  <% else %>
                    <span class="font-semibold"><%= person&.name %></span>
                  <% end %>
                  <% if person.respond_to?(:preferred_email) && person.preferred_email.present? %>
                    <div class="text-xs text-gray-500"><!--email_off--><%= person.preferred_email %><!--email_on--></div>
                  <% end %>
                </td>
                <td class="px-4 py-2 text-sm text-gray-800">
                  <%= link_to tagging.staff_tag.name, staff_tag_path(tagging.staff_tag),
                              data: { turbo_frame: "_top" },
                              class: "font-medium text-gray-900 hover:underline" %>
                </td>
                <td class="px-4 py-2 text-sm text-gray-600">
                  <% if tagging.created_by&.person %>by <%= tagging.created_by.full_name %><br><% end %>
                  on <%= tagging.created_at.strftime("%b %-d, %Y") %>
                </td>
                <td class="px-4 py-2 text-center whitespace-nowrap">
                  <%= link_to "Edit", edit_staff_tagging_path(tagging, return_to: "staff_taggings"),
                          data: { turbo_frame: "_top" },
                          class: "admin-only bg-blue-100 btn btn-secondary-outline px-2.5 py-1 text-xs" %>
                  <%= button_to "Remove", staff_tagging_path(tagging), method: :delete,
                          form: { data: { turbo_confirm: "Remove this tag from #{person&.name}?", turbo_frame: "_top" } },
                          class: "admin-only bg-blue-100 btn btn-danger-outline px-2.5 py-1 text-xs" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-6 text-center text-gray-500">
        No staff taggings found.
      </p>
    <% end %>
  </div>

  <!-- Pagination -->
  <div class="mt-6 flex justify-center">
    <div class="pagination">
      <%= tailwind_paginate @staff_taggings %>
    </div>
  </div>
<% end %>

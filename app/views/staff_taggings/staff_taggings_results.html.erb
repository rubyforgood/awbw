<% sort_base = params.permit(:query, :content, :number_of_items_per_page, :marked, staff_tag_ids: []).to_h.symbolize_keys %>
<% sort_link = sort_header_link(frame: "staff_taggings_results", path: ->(p) { staff_taggings_path(p) }, base: sort_base) %>
<%= turbo_frame_tag :staff_taggings_results do %>
  <%= turbo_stream.replace("staff_taggings_count", partial: "staff_taggings_count") %>

  <div class="animate-fade overflow-hidden rounded-xl bg-white blur-on-submit">
    <% if @staff_taggings.any? %>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse border border-gray-200">
          <thead class="bg-gray-100">
            <tr>
              <th class="w-1/4 px-4 py-2 text-left text-sm font-semibold text-gray-700"><%= sort_link.call("person", "Person") %></th>
              <th class="w-1/4 px-4 py-2 text-left text-sm font-semibold text-gray-700"><%= sort_link.call("staff_tag", "Staff tag") %></th>
              <th class="w-1/4 px-4 py-2 text-left text-sm font-semibold text-gray-700"><%= sort_link.call("marked", "Mark") %></th>
              <th class="w-1/4 px-4 py-2 text-left text-sm font-semibold text-gray-700"><%= sort_link.call("created_at", "Tagged") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @staff_taggings.each do |tagging| %>
              <% person = tagging.staff_taggable %>
              <tr class="transition-colors duration-150 hover:bg-gray-50">
                <td class="px-4 py-2 text-sm">
                  <%# The person card is itself the link to edit this tagging, mirroring the
                      topic subscriptions index. Deliberately grey (not the people tint) so it
                      doesn't read as a link to the person's profile. Carries return_to so the
                      edit page's eyebrow, Cancel, and post-save redirect return to this list. %>
                  <%= link_to edit_staff_tagging_path(tagging, return_to: "staff_taggings"),
                              title: [ person&.name, person.try(:preferred_email) ].compact_blank.join(" — "),
                              class: "group flex w-56 max-w-full items-center gap-2 overflow-hidden rounded-lg border border-gray-300 bg-gray-100 px-2 py-1 leading-tight text-gray-700 shadow-sm transition-colors duration-200 hover:bg-gray-200",
                              data: { turbo_frame: "_top", turbo_prefetch: false } do %>
                    <i class="fa-solid fa-user-tag flex-shrink-0 text-gray-500"></i>
                    <div class="flex min-w-0 flex-col justify-center">
                      <span class="truncate text-xs font-semibold"><%= truncate(person&.name.to_s, length: 30) %></span>
                      <% if person.try(:preferred_email).present? %>
                        <!--email_off--><span class="truncate text-xs font-normal text-gray-500"><%= person.preferred_email %></span><!--email_on-->
                      <% end %>
                    </div>
                  <% end %>
                </td>
                <td class="px-4 py-2 text-sm text-gray-800">
                  <%= link_to tagging.staff_tag.name, staff_tag_path(tagging.staff_tag),
                              data: { turbo_frame: "_top" },
                              class: "font-medium text-gray-900 hover:underline" %>
                </td>
                <td class="px-4 py-2 text-sm">
                  <%= marked_indicator(tagging.marked, tagging.staff_tag&.mark_label) %>
                </td>
                <td class="px-4 py-2 text-sm text-gray-600">
                  <% if tagging.created_by&.person %>by <%= tagging.created_by.full_name %><br><% end %>
                  on <%= tagging.created_at.strftime("%b %-d, %Y") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-6 text-center text-gray-500">
        No staff taggings found.
      </p>
    <% end %>
  </div>

  <!-- Pagination -->
  <div class="mt-6 flex justify-center">
    <div class="pagination">
      <%= tailwind_paginate @staff_taggings %>
    </div>
  </div>
<% end %>

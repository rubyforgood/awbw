<%= form_tag(staff_taggings_path, method: :get,
  data: { controller: "collection", turbo_frame: "staff_taggings_results" },
  autocomplete: "off",
  class: "space-y-4") do |f| %>
  <div class="flex flex-col gap-4 md:flex-row md:flex-wrap md:items-end">
    <!-- Person or organization name -->
    <div class="w-full md:flex-1">
      <%= label_tag :query, "Person or organization name", class: search_label_class %>
      <div class="relative">
        <%= text_field_tag :query, params[:query],
                           class: search_field_class(extra: "pr-10"),
                           placeholder: "" %>
        <%= render "shared/search_submit" %>
      </div>
    </div>

    <!-- Staff tag -->
    <%= render "events/filter_select", param: :staff_tag_ids, label: "Staff tag",
          options: StaffTag.published.ordered.map { |t| [ t.name, t.id ] },
          selected: params[:staff_tag_ids], blank: "Any tag",
          field_class: search_field_class, wrapper_class: "w-full md:w-64",
          hint: link_to("Manage staff tags", staff_tags_path, class: eyebrow_link_class, target: "_blank", rel: "noopener") %>

    <!-- Clear filters -->
    <div class="w-full md:ml-auto md:w-auto">
      <%= render "shared/search_clear", url: staff_taggings_path %>
    </div>
  </div>
<% end %>

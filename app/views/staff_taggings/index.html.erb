<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="mx-auto max-w-7xl <%= DomainTheme.bg_class_for(:people) %> border-primary/10 rounded-2xl border p-6 shadow-sm">
  <div class="w-full">
    <div class="mb-4">
      <%= link_to "← Staff tags", staff_tags_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
    </div>
    <div class="mb-6 flex items-start justify-between">
      <div id="staff_taggings_count" class="pr-6">
        <h2 class="mb-2 text-2xl font-semibold">Staff taggings</h2>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-2 text-right">
        <% if allowed_to?(:index?, Person) %>
          <%= link_to "People", people_path,
                      class: "admin-only bg-blue-100 text-sm #{eyebrow_link_class} px-2 py-1" %>
        <% end %>
        <% if allowed_to?(:index?, TopicSubscription) %>
          <%= link_to "Topic subscriptions", topic_subscriptions_path,
                      class: "admin-only bg-blue-100 text-sm #{eyebrow_link_class} px-2 py-1" %>
        <% end %>
        <% if allowed_to?(:new?, StaffTagging) %>
          <%= link_to "New tagging", new_staff_tagging_path,
                      class: button_classes(:primary_outline, extra: "admin-only bg-blue-100") %>
        <% end %>
      </div>
    </div>
    <p class="mb-4 max-w-2xl text-sm text-gray-600">
      Every person carrying a staff tag. Filter by tag, search by person or
      organization name, or search comments &amp; communications content.
    </p>
    <%= render "search_boxes" %>

    <% result_src = staff_taggings_path + "?" + request.query_string %>

    <%= turbo_frame_tag :staff_taggings_results, src: result_src, data: {turbo: "temporary"} do %>
      <%= render "results_skeleton" %>
    <% end %>
  </div>
</div>

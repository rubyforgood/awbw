<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="max-w-2xl mx-auto <%= DomainTheme.bg_class_for(:events) %> border border-gray-200 rounded-xl shadow p-6">
  <div class="mb-6">
    <%= link_to "← Manage registrants", manage_event_path(@event_registration.event), class: "text-sm text-gray-500 hover:text-gray-700 mb-2 inline-block" %>
    <h1 class="text-2xl font-semibold text-gray-900">Scholarship</h1>
    <p class="text-gray-600 mt-1">
      <%= @event_registration.registrant.full_name %> —
      <%= @event_registration.event.title %>
    </p>
  </div>

  <%= form_with model: [@event_registration, @scholarship], class: "space-y-6" do |f| %>
    <%= render "form", f: f %>
  <% end %>

  <div class="mt-8 pt-6 border-t border-gray-200">
    <h2 class="text-sm font-medium text-gray-700 mb-3">Allocation</h2>
    <% if @scholarship.allocated? %>
      <div class="rounded-lg bg-green-50 border border-green-200 px-4 py-3 flex items-center justify-between">
        <span class="text-sm text-green-700">
          Allocated $<%= "%.2f" % (@scholarship.allocations.sum(:amount).to_f / 100) %>
        </span>
      </div>
    <% elsif @scholarship.can_allocate? %>
      <div class="rounded-lg bg-blue-50 border border-blue-200 px-4 py-3 flex items-center justify-between">
        <span class="text-sm text-blue-700">
          Ready to allocate $<%= "%.2f" % [@scholarship.amount_cents.to_f / 100, @event_registration.remaining_cost.to_f / 100].min %>
        </span>
        <%= button_to "Allocate", allocate_event_registration_scholarship_path(@event_registration, @scholarship),
                      method: :post, class: "btn btn-primary text-sm" %>
      </div>
    <% else %>
      <div class="rounded-lg bg-gray-50 border border-gray-200 px-4 py-3">
        <span class="text-sm text-gray-500">
          <% if @scholarship.amount_cents.to_i == 0 %>
            Set a scholarship amount and complete tasks to allocate.
          <% else %>
            Complete tasks to allocate.
          <% end %>
        </span>
      </div>
    <% end %>
  </div>

  <div class="mt-8 pt-6 border-t border-gray-200">
    <%= button_to "Remove scholarship", [@event_registration, @scholarship],
                  method: :delete,
                  class: "text-sm text-red-600 underline",
                  data: { turbo_confirm: "Remove this scholarship? This will also delete its allocation." } %>
  </div>
</div>

<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<div class="max-w-2xl mx-auto <%= DomainTheme.bg_class_for(:events) %> border border-gray-200 rounded-xl shadow p-6">
  <div class="mb-6">
    <% if @allocatable.respond_to?(:event) %>
      <%= link_to "← Manage registrants", manage_event_path(@allocatable.event), class: "text-sm text-gray-500 hover:text-gray-700 mb-2 inline-block" %>
    <% end %>
    <h1 class="text-2xl font-semibold text-gray-900">Scholarship</h1>
    <% if @allocatable.respond_to?(:registrant) %>
      <p class="text-gray-600 mt-1"><%= @allocatable.registrant.full_name %> — <%= @allocatable.event.title %></p>
    <% end %>
  </div>

  <%= form_with model: @scholarship, class: "space-y-6" do |f| %>
    <%= render "form", f: f %>
  <% end %>

  <div class="mt-8 pt-6 border-t border-gray-200">
    <%= button_to "Remove scholarship", @scholarship,
                  method: :delete,
                  class: "text-sm text-red-600 underline",
                  data: { turbo_confirm: "Remove this scholarship?" } %>
  </div>
</div>

<% if @allocatable.respond_to?(:event) %>
  <dl class="grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2">
    <div>
      <dt class="text-sm font-medium text-gray-500">Event cost</dt>
      <dd class="mt-1 text-sm text-gray-900">$<%= "%.2f" % (@allocatable.event.cost_cents.to_f / 100) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Total allocated</dt>
      <dd class="mt-1 text-sm text-gray-900">$<%= "%.2f" % (@allocatable.allocations_sum.to_f / 100) %></dd>
    </div>
  </dl>
<% end %>

<div>
  <%= f.label :amount_dollars, "Scholarship amount", class: "block text-sm font-medium text-gray-700 mb-1" %>
  <div class="relative">
    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-sm">$</span>
    <%= f.number_field :amount_dollars, step: 0.01, class: "pl-7 w-48 form-input" %>
  </div>
</div>

<div>
  <label class="inline-flex items-center gap-2">
    <%= f.check_box :tasks_completed, class: "toggle" %>
    <span class="text-sm text-gray-700">Tasks completed</span>
  </label>
</div>

<div class="flex items-center gap-3">
  <%= f.submit f.object.persisted? ? "Update" : "Create", class: "btn btn-primary" %>
</div>

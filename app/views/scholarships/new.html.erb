<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="max-w-2xl mx-auto <%= DomainTheme.bg_class_for(:events) %> border border-gray-200 rounded-xl shadow p-6">
  <div class="mb-6">
    <%= link_to "← Manage registrants", manage_event_path(@event_registration.event), class: "text-sm text-gray-500 hover:text-gray-700 mb-2 inline-block" %>
    <h1 class="text-2xl font-semibold text-gray-900">New Scholarship</h1>
    <p class="text-gray-600 mt-1">
      <%= @event_registration.registrant.full_name %> —
      <%= @event_registration.event.title %>
    </p>
  </div>

  <%= form_with model: [@event_registration, @scholarship], class: "space-y-6" do |f| %>
    <%= render "form", f: f %>
  <% end %>
</div>

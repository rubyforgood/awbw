<div class="inline-flex items-center gap-2
            rounded-md border border-gray-300 hover:border-gray-400
            <%= DomainTheme.bg_class_for(:event_registrations) %> hover:bg-blue-200
            text-gray-700 px-3 py-1 text-sm font-medium transition"
     data-payment-registrations-target="item">
  <input type="hidden" name="payment[event_registration_ids][]" value="<%= event_registration.id %>">
  <span><%= event_registration.registrant&.full_name %> &mdash; <%= event_registration.event&.title %></span>
  <button type="button"
          class="ml-1.5 text-gray-400 hover:text-gray-600 font-bold text-xs transition"
          data-action="click->payment-registrations#removeItem">✖</button>
</div>

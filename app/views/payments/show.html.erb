<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<% form_submission = @payment.form_submission %>
<% submission_event = form_submission&.resolved_event %>
<% bulk_payment_event = submission_event if params[:return_to] == "bulk_payments" %>
<% payment_type_label = @payment.type.underscore.titleize.gsub(" Payment", "").gsub("External Processor", "Stripe") %>
<% additional_designation = @payment.form_additional_designation %>
<% receipt_url = @payment.metadata&.dig("stripe_charge", "receipt_url") %>
<% label_class = "text-xs font-medium tracking-wide text-gray-400 uppercase" %>
<% section_icon_class = "flex h-8 w-8 shrink-0 items-center justify-center rounded-lg #{DomainTheme.bg_class_for(:payments, intensity: 100)} #{DomainTheme.text_class_for(:payments, intensity: 600)}" %>

<div class="mx-auto max-w-3xl <%= DomainTheme.bg_class_for(:payments) %> border-primary/10 rounded-2xl border p-4 shadow-sm sm:p-6">
  <div class="mb-4">
    <% if bulk_payment_event %>
      <%= link_to "← Bulk payments", bulk_payments_return_path(bulk_payment_event), class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
    <% else %>
      <%= link_to "← Payments", payments_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
    <% end %>
  </div>

  <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-primary font-display text-2xl font-bold">Payment</h1>
      <p class="mt-1 text-sm text-gray-600">
        <%= payment_type_label %> · <%= dollars_from_cents(@payment.amount_cents) %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "Edit", edit_payment_path(@payment), class: button_classes(:secondary_outline, size: :sm) %>
      <% if @payment.amount_cents_remaining > 0 %>
        <%= link_to "Allocate", new_allocation_path(source_sgid: @payment.to_sgid.to_s, return_to: params[:return_to], expand: params[:expand]), class: button_classes(:primary, size: :sm) %>
        <% if @payment.is_a?(ExternalProcessorPayment) && @payment.pay_charge_id.blank? %>
          <span class="flex items-center gap-1 text-sm text-gray-400 italic">
            <i class="fa-solid fa-info-circle"></i>
            Must be refunded via the Stripe Dashboard
          </span>
        <% else %>
          <%= link_to "Refund", new_refund_path(payment_sgid: @payment.to_sgid.to_s), class: button_classes(:warning, size: :sm) %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @payment.is_a?(ExternalProcessorPayment) && @payment.amount_cents_remaining.to_i.positive? %>
    <div class="mb-5 flex flex-wrap items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
      <% if @payment.reconciliation_acknowledged_at.present? %>
        <span>
          Credit acknowledged on <%= @payment.reconciliation_acknowledged_at.strftime("%b %-d, %Y") %>
        </span>
        <%= button_to "Remove acknowledgement",
              payment_reconciliation_acknowledgement_path(@payment),
              method: :delete,
              class: button_classes(:secondary_outline, size: :sm),
              title: "Shows this credit in Data Health again." %>
      <% else %>
        <%= button_to "Acknowledge credit",
              payment_reconciliation_acknowledgement_path(@payment),
              class: button_classes(:secondary_outline, size: :sm),
              title: "Hides this credit from Data Health. The payment and remaining amount stay unchanged. Remove the acknowledgement to show it again." %>
      <% end %>
    </div>
  <% end %>

  <div class="space-y-6">
    <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="flex items-center gap-3 border-b border-gray-100 px-4 py-3">
        <span class="<%= section_icon_class %>"><i class="fa-solid fa-money-check-dollar"></i></span>
        <h2 class="text-sm font-semibold text-gray-700">Details</h2>
      </div>

      <dl class="grid grid-cols-1 gap-px bg-gray-100 sm:grid-cols-2">
        <%# Half-width fields; an odd last one spans the row so the grid has no gap. %>
        <% details = [
             [ "Type", payment_type_label, :emphasis ],
             [ "Amount", dollars_from_cents(@payment.amount_cents), :emphasis ],
             [ "Created", @payment.created_at.strftime("%B %d, %Y at %I:%M %p") ],
             [ "Amount remaining to allocate", dollars_from_cents(@payment.amount_cents_remaining) ],
             *[ [ "Payer", @payment.payer ], [ "Additional designation", additional_designation ] ].filter_map { |label, party|
               [ label, party.is_a?(Organization) ? organization_profile_button(party) : person_profile_button(party) ] if party
             },
             ([ "Form submission", form_submission_show_button(form_submission) ] if form_submission),
             ([ "Event", event_show_button(submission_event, subtitle: submission_event.start_date&.strftime("%b %-d, %Y")) ] if submission_event),
             ([ "Check number", @payment.check_number ] if @payment.check_number.present?),
             ([ "Memo", tag.span(@payment.memo, class: "whitespace-pre-line") ] if @payment.memo.present?),
             ([ "Pay charge ID", @payment.pay_charge_id ] if @payment.pay_charge_id.present?),
             ([ "Stripe receipt", link_to(receipt_url, target: "_blank", rel: "noopener", class: "text-primary hover:text-primary-dark inline-flex items-center gap-1 underline") { safe_join([ "View receipt", tag.i(class: "fa-solid fa-arrow-up-right-from-square h-3 w-3") ], " ") } ] if receipt_url.present?),
             ([ "FileMaker codes", filemaker_code_links(@payment, link_class: "text-primary hover:underline") || @payment.filemaker_code ] if @payment.filemaker_codes.any?)
           ].compact %>
        <% details.each_with_index do |(label, value, emphasis), index| %>
          <div class="bg-white px-4 py-3 <%= "sm:col-span-2" if details.size.odd? && index == details.size - 1 %>">
            <dt class="<%= label_class %>"><%= label %></dt>
            <dd class="mt-1 min-w-0 <%= emphasis ? "text-2xl font-bold text-gray-900" : "text-sm text-gray-900" %> tabular-nums"><%= value %></dd>
          </div>
        <% end %>
        <% if @payment.metadata.present? %>
          <div class="bg-white px-4 py-3 sm:col-span-2">
            <div data-controller="dropdown" class="relative">
              <button type="button"
                      data-action="dropdown#toggle"
                      data-dropdown-payload-param='[{"payment-metadata-<%= @payment.id %>":"hidden"}]'
                      class="inline-flex items-center gap-1.5 <%= label_class %> cursor-pointer hover:text-gray-600">
                Metadata
                <i class="fa-solid fa-chevron-down h-3 w-3"></i>
              </button>
              <div id="payment-metadata-<%= @payment.id %>"
                   data-dropdown-target="content"
                   class="mt-2 hidden max-w-full rounded-lg border border-gray-200 bg-gray-50 p-4 font-mono text-xs break-words whitespace-pre-wrap text-gray-800">
                <%= JSON.pretty_generate(@payment.metadata) %>
              </div>
            </div>
          </div>
        <% end %>
      </dl>
    </section>

    <%# Read view of the payment's comments and communications, newest first, using
        the combined feed's rows (editable inline there and here); new ones are added
        on the edit page. %>
    <% feed_comments = allowed_to?(:manage?, Comment) ? @payment.comments.to_a : [] %>
    <% feed_communications = authorized_scope(@payment.communications_scope, with: NotificationPolicy).to_a %>
    <% feed_entries = FeedRecordPreloader.new((feed_comments + feed_communications).sort_by(&:created_at).reverse).call %>
    <section id="payment-comments" class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm"
             data-controller="expandable-cards"
             data-action="expandable-card:measured->expandable-cards#refresh"
             data-expandable-cards-expandable-card-outlet="#payment-comments [data-controller~='expandable-card']"
             data-expandable-cards-expanded-value="false"
             data-expandable-cards-expanded-label-value="<%= t("communications.collapse_all") %>"
             data-expandable-cards-collapsed-label-value="<%= t("communications.expand_all") %>">
      <div class="flex items-center gap-3 border-b border-gray-100 px-4 py-3">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg <%= DomainTheme.bg_class_for(:notifications, intensity: 100) %> <%= DomainTheme.text_class_for(:notifications, intensity: 600) %>">
          <i class="fa-solid fa-comments"></i>
        </span>
        <h2 class="text-sm font-semibold text-gray-700"><%= t("communications.section_title") %></h2>
        <% if feed_entries.any? %>
          <span class="hidden" data-expandable-cards-target="toggle">
            <%= render "comments_and_communications/expand_all_button", expanded: false %>
          </span>
        <% end %>
        <%= link_to edit_payment_path(@payment, anchor: "comments-section"), class: "ml-auto inline-flex items-center gap-1 text-sm #{eyebrow_link_class}" do %>
          <i class="fa-solid fa-plus text-xs"></i> Add
        <% end %>
      </div>
      <div class="flex flex-col gap-2 p-4">
        <% if feed_entries.any? %>
          <% feed_entries.each do |entry| %>
            <%= render "comments_and_communications/entry_row", entry: entry, person: @payment.person, source_chip: false %>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-500"><%= t("communications.section_none") %></p>
        <% end %>
      </div>
    </section>

    <% if @allocations.any? %>
      <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="flex items-center gap-3 border-b border-gray-100 px-4 py-3">
          <span class="<%= section_icon_class %>"><i class="fa-solid fa-arrow-right-arrow-left"></i></span>
          <h2 class="text-sm font-semibold text-gray-700">Allocations</h2>
        </div>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Allocated to</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date/Time</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @allocations.each do |allocation| %>
              <% row_class = if allocation.amount.to_i < 0
                  'bg-red-50'
                elsif allocation.reverted_id.present?
                  'bg-gray-100 border border-gray-300 opacity-60'
                end %>
              <tr class="<%= row_class %>">
                <td class="px-4 py-3 text-sm text-gray-900">
                  <%= link_to allocations_path(allocatable_sgid: allocation.allocatable.to_sgid.to_s), class: "text-primary hover:underline" do %>
                    <% if allocation.allocatable_type == "EventRegistration" && allocation.allocatable.present? %>
                      <%= allocation.allocatable.registrant.full_name %>
                      -
                      <%= allocation.allocatable.event.title %>
                    <% else %>
                      <%= allocation.allocatable_type.underscore.titleize %>
                    <% end %>
                  <% end %>
                </td>

                <td class="px-4 py-3 text-sm text-gray-900 tabular-nums"><%= dollars_from_cents(allocation.amount) %></td>
                <td class="px-4 py-3 text-sm text-gray-500"><%= allocation.created_at.strftime("%B %d, %Y at %I:%M %p") %></td>

                <td class="px-4 py-3 text-right text-sm font-medium">
                  <% unless allocation.reverted? || allocation.amount.to_i < 0 %>
                    <%= button_to "revert", revert_allocation_path(allocation, return_to: params[:return_to], expand: params[:expand]), method: :post, class: "cursor-pointer text-danger hover:text-danger-dark", data: { turbo_confirm: "are you sure you want to revert this allocation?" } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    <% end %>

    <% if @refunds.any? %>
      <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="flex items-center gap-3 border-b border-gray-100 px-4 py-3">
          <span class="<%= section_icon_class %>"><i class="fa-solid fa-rotate-left"></i></span>
          <h2 class="text-sm font-semibold text-gray-700">Refunds</h2>
        </div>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Recipient</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Method</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date/Time</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @refunds.each do |refund| %>
              <tr>
                <td class="px-4 py-3 text-sm text-gray-900">
                  <% if refund.recipient.present? %>
                    <%= person_name(refund.recipient) %>
                  <% else %>
                    <%= refund.recipient_type.underscore.titleize %>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-sm text-gray-900"><%= refund.method.titleize %></td>
                <td class="px-4 py-3 text-sm text-gray-900 tabular-nums"><%= dollars_from_cents(refund.amount_cents) %></td>
                <td class="px-4 py-3 text-sm text-gray-500"><%= refund.created_at.strftime("%B %d, %Y at %I:%M %p") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    <% end %>
  </div>

  <div class="mt-6">
    <%= render "papertrail_versions", record: @payment, label: "Version history" %>
  </div>

  <%= render "shared/audit_info", resource: @payment %>
  <% if allowed_to?(:index?, with: Admin::AhoyActivityPolicy) %>
    <div class="mt-4 flex justify-end">
      <%= render "application/activity_log", record: @payment %>
    </div>
  <% end %>
</div>

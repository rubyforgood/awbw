<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<div class="mx-auto max-w-6xl">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <span class="hidden h-10 w-10 shrink-0 items-center justify-center rounded-xl shadow-sm sm:flex <%= DomainTheme.bg_class_for(:payments, intensity: 100) %> <%= DomainTheme.text_class_for(:payments, intensity: 700) %>">
        <i class="fa-solid fa-money-check-dollar text-lg" aria-hidden="true"></i>
      </span>
      <h1 class="text-primary font-display text-2xl font-bold">Payments</h1>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to new_payment_path(type: "CashPayment"), class: button_classes(:secondary_outline, size: :sm, extra: "inline-flex items-center gap-1.5") do %>
        <i class="fa-solid fa-plus"></i> Cash payment
      <% end %>
      <%= link_to new_payment_path(type: "CheckPayment"), class: button_classes(:secondary_outline, size: :sm, extra: "inline-flex items-center gap-1.5") do %>
        <i class="fa-solid fa-plus"></i> Check payment
      <% end %>
      <%= link_to new_checkout_link_payments_path, class: button_classes(:secondary_outline, size: :sm, extra: "inline-flex items-center gap-1.5") do %>
        <i class="fa-brands fa-stripe-s"></i> Generate Stripe link
      <% end %>
    </div>
  </div>

  <%= render 'search_boxes' %>
  <% result_src = payments_path + "?" + request.query_string %>

  <%= turbo_frame_tag :payments_results, src: result_src, data: { turbo: "temporary" } do %>
    <%= render "results_skeleton" %>
  <% end %>
</div>

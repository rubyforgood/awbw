<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<% payment_type_label = @payment.type.to_s.underscore.titleize.gsub(" Payment", "").gsub("External Processor", "Stripe").downcase %>
<div id="payment-form" class="mx-auto max-w-2xl <%= DomainTheme.bg_class_for(:payments) %> border-primary/10 rounded-2xl border p-4 shadow-sm sm:p-6">
  <div class="mb-4">
    <%= link_to "← Payments", payments_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
  </div>
  <h1 class="text-primary mb-6 font-display text-2xl font-bold">New <%= payment_type_label.presence || "payment" %></h1>

  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <%= simple_form_for @payment, as: :payment, url: payments_path do |f| %>
      <%= f.input :type, as: :hidden %>

      <% payer_label_data = @payment.selected_payer&.compound_search_label %>
      <% designation_label_data = @payment.selected_additional_designation&.compound_search_label %>

      <div class="space-y-4">
        <%= f.input :payer_sgid,
          collection: payer_label_data ? [[payer_label_data[:label], payer_label_data[:id]]] : [],
          selected: payer_label_data&.dig(:id),
          required: true,
          input_html: {
            class: "bg-white",
            data: {
              controller: "remote-select",
              remote_select_model_value: "person_or_organization"
            }
          },
          prompt: "Search people and organizations",
          label: "Payer",
          hint: "Whose account is the money coming from?" %>

        <%= f.input :additional_designation_sgid,
          collection: designation_label_data ? [[designation_label_data[:label], designation_label_data[:id]]] : [],
          selected: designation_label_data&.dig(:id),
          include_blank: true,
          input_html: {
            class: "bg-white",
            data: {
              controller: "remote-select",
              remote_select_model_value: "person_or_organization"
            }
          },
          prompt: "Search people and organizations",
          label: "Additional designation",
          hint: "Optional. If the payer is an organization, pick the person; if the payer is a person, pick their organization." %>

        <div class="grid grid-cols-1 items-start gap-4 sm:grid-cols-2">
          <%= f.input :amount_dollars, label: "Amount ($)", required: true, input_html: { min: 0, step: 0.01, placeholder: "0.00", data: { controller: "currency-input", action: "currency-input#format" } } %>
        </div>
        <%= f.input :currency, as: :hidden, input_html: { value: "usd" } %>
        <% if @payment.type == "CheckPayment" %>
          <div class="grid grid-cols-1 items-start gap-4 sm:grid-cols-2">
            <%= f.input :check_number, hint: "Digits only. Leave off \"Check #\".", input_html: { class: "bg-white", placeholder: "1234" } %>
            <%= f.input :memo, label: "Memo", hint: "Copy the check's memo line.", input_html: { class: "bg-white", placeholder: "Memo line on the check" } %>
          </div>
        <% end %>
      </div>

      <div class="mt-6">
        <%= render "shared/comments_and_communications", f: f, view_all_person: @payment.person %>
      </div>

      <div class="action-buttons mt-8 flex justify-center gap-3">
        <%= link_to "Cancel", payments_path, class: button_classes(:secondary_outline) %>
        <%= f.button :submit, "Submit", class: button_classes(:primary) %>
      </div>
    <% end %>
  </div>
</div>

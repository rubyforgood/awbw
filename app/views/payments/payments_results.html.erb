<%= turbo_frame_tag :payments_results do %>
  <% count, total_cents, unallocated_cents = @totals %>
  <%# Totals span every payment matching the filters, not just this page. %>
  <div class="mb-3 flex flex-wrap items-baseline gap-x-6 gap-y-1 px-1 text-sm text-gray-600">
    <span><span class="font-semibold text-gray-900"><%= number_with_delimiter(count.to_i) %></span> <%= "payment".pluralize(count.to_i) %></span>
    <span>Total <span class="text-lg font-bold text-gray-900 tabular-nums"><%= dollars_from_cents(total_cents.to_i) %></span></span>
    <span>Unallocated <span class="font-semibold tabular-nums <%= unallocated_cents.to_i.positive? ? "text-amber-700" : "text-gray-900" %>"><%= dollars_from_cents(unallocated_cents.to_i) %></span></span>
  </div>
  <% if @payments.any? %>
    <div class="border-primary/10 animate-fade overflow-x-auto rounded-2xl border bg-white shadow-sm blur-on-submit">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium tracking-wider text-gray-500 uppercase">Type</th>
            <th class="px-6 py-3 text-left text-xs font-medium tracking-wider text-gray-500 uppercase">Payer</th>
            <th class="px-6 py-3 text-left text-xs font-medium tracking-wider text-gray-500 uppercase">Amount</th>
            <th class="px-6 py-3 text-left text-xs font-medium tracking-wider text-gray-500 uppercase">Unallocated</th>
            <th class="px-6 py-3 text-left text-xs font-medium tracking-wider text-gray-500 uppercase">Created</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% type_badges = {
             "CashPayment" => [ "Cash", "bg-green-50 text-green-800 border-green-200", "fa-solid fa-money-bill" ],
             "CheckPayment" => [ "Check", "bg-sky-50 text-sky-800 border-sky-200", "fa-solid fa-money-check" ],
             "ExternalProcessorPayment" => [ "Stripe", "bg-violet-50 text-violet-800 border-violet-200", "fa-brands fa-stripe-s" ]
           } %>
          <% @payments.each do |payment| %>
            <% label, classes, icon = type_badges.fetch(payment.type) { [ payment.type.to_s.titleize, "bg-gray-50 text-gray-700 border-gray-200", nil ] } %>
            <% payer = payment.payer %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-2 text-sm whitespace-nowrap"><%= render "shared/badge", label: label, classes: classes, icon: icon %></td>
              <td class="px-6 py-2 text-sm">
                <div class="flex items-center gap-2 text-gray-900">
                  <i class="fa-solid <%= payer.is_a?(Organization) ? "fa-building" : "fa-user" %> shrink-0 text-xs text-gray-400"></i>
                  <span class="font-medium"><%= person_name(payer).presence || "Unknown payer" %></span>
                </div>
              </td>
              <td class="px-6 py-2 text-sm whitespace-nowrap">
                <%# The amount card opens the payment, like the record cards on other indexes. %>
                <%= link_to payment_path(payment),
                      class: "inline-flex w-28 items-center justify-between gap-1.5 rounded-md border px-2 py-0.5 text-sm font-semibold tabular-nums transition-colors duration-200 #{DomainTheme.border_class_for(:payments)} #{DomainTheme.bg_class_for(:payments, intensity: 100)} #{DomainTheme.bg_class_for(:payments, intensity: 100, hover: true)} #{DomainTheme.text_class_for(:payments, intensity: 800)}",
                      data: { turbo_frame: "_top", turbo_prefetch: false } do %>
                  <%= dollars_from_cents(payment.amount_cents) %>
                  <i class="fa-solid fa-chevron-right text-2xs opacity-60"></i>
                <% end %>
              </td>
              <td class="px-6 py-2 text-sm whitespace-nowrap tabular-nums <%= payment.amount_cents_remaining.to_i.positive? ? "font-medium text-amber-700" : "text-gray-400" %>"><%= dollars_from_cents(payment.amount_cents_remaining) %></td>
              <td class="px-6 py-2 text-sm whitespace-nowrap text-gray-500"><%= payment.created_at.strftime("%b %-d, %Y · %-l:%M %p") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="py-6 text-center text-gray-500">There are no payments that match your search. Please try again.</p>
  <% end %>
  <div class="pagination mt-6 flex justify-center"><%= tailwind_paginate @payments %></div>
<% end %>

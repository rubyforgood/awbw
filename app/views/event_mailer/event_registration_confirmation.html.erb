<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
      body {
          margin: 0;
          padding: 0;
          background-color: #f9fafb;
          font-family: Arial, Helvetica, sans-serif;
          color: #333;
      }

      .container {
          max-width: 600px;
          margin: 0 auto;
          background-color: #ffffff;
          padding: 24px;
          border-radius: 8px;
      }

      .logo {
          text-align: center;
          margin-bottom: 24px;
      }

      .logo img {
          max-width: 180px;
          height: auto;
      }

      h1 {
          font-size: 22px;
          margin-bottom: 12px;
          color: #1f2937;
      }

      p {
          font-size: 14px;
          line-height: 1.5;
          margin: 8px 0;
      }

      .event-box {
          background-color: #f3f4f6;
          border-radius: 6px;
          padding: 12px;
          margin: 16px 0;
      }

      .button {
          display: inline-block;
          margin-top: 16px;
          padding: 10px 16px;
          background-color: #2563eb;
          color: #ffffff !important;
          text-decoration: none;
          border-radius: 6px;
          font-weight: bold;
      }

      .footer {
          margin-top: 32px;
          font-size: 12px;
          color: #6b7280;
      }
  </style>
</head>

<body>
<div class="container">
  <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
    <tr>
      <td align="center">
        <a href="<%= ENV.fetch("APP_HOST") %>" target="_blank">
          <img
            src="<%= asset_url("logo-color.png") %>"
            alt="<%= @organization_name %>"
            width="160"
            style="display: block; margin-bottom: 32px;"
            />
        </a>
      </td>
    </tr>
  </table>

  <h1>Event registration confirmed</h1>

  <p>
    Hello <strong><%= @user.full_name %></strong>,
  </p>

  <p>
    This message confirms your registration for the following event:
  </p>

  <div class="event-box">
    <p><strong><%= @event.title %></strong></p>
    <p><%= @event.times(display_day: true, display_date: true) %></p>

    <% if @event.labelled_cost.present? %>
      <p><%= @event.labelled_cost %></p>
    <% end %>
  </div>

  <% if @event.detail.present? %>
    <p>
      <strong>Event details:</strong><br>
      <%= simple_format(@event.detail) %>
    </p>
  <% end %>

  <p>
    You can view the event page for updates, directions, or calendar links:
  </p>

  <p>
    <a href="<%= @event_url %>" class="button">View event</a>
  </p>

  <% if @event.registration_close_date %>
    <p>
      Registration closes on
      <%= @event.registration_close_date.strftime("%A, %B %-d, %Y at %-l:%M %p %Z") %>.
    </p>
  <% end %>

  <div class="footer">
    <p>
      This is an automated confirmation from <%= @organization_name %>.
      If you did not expect this message, you may ignore it.
    </p>
  </div>

</div>
</body>
</html>

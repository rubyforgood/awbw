<%= simple_form_for(@staff_tag) do |f| %>
  <div class="form-body space-y-6">
    <%= f.error_notification %>
    <%= render "shared/errors", resource: @staff_tag if @staff_tag.errors.any? %>

    <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-4">
      <div class="space-y-6 md:col-span-3">
        <%= f.input :name,
                    label: "Name",
                    hint: "Short, admin-facing label (e.g. \"Potential future trainer\").",
                    input_html: { class: "form-control" },
                    required: true %>
        <%= f.input :description,
                    label: "Description",
                    hint: "Optional note on what this tag means and how it's used.",
                    input_html: { class: "form-control", rows: 3 },
                    as: :text %>
      </div>

      <div class="admin-only mt-6 rounded bg-blue-100 p-3 md:mt-0">
        <%= render "shared/visibility_info", flags: %i[staff_tag_published] %>
        <div class="grid grid-cols-1 items-center">
          <%= visibility_flag_input f, :published, definition_key: :staff_tag_published %>
        </div>
      </div>
    </div>

    <div class="action-buttons mt-8 flex flex-wrap justify-center gap-3">
      <% if allowed_to?(:destroy?, f.object) %>
        <%= link_to "Delete", @staff_tag, class: "btn btn-danger-outline",
                    data: { turbo_method: :delete, turbo_confirm: "Delete this staff tag? Unpublish it instead if it's still in use." } %>
      <% end %>
      <%= link_to "Cancel", staff_tags_path, class: "btn btn-secondary-outline" %>
      <%= f.button :submit, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>

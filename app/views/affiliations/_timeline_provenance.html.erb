<%# The "What" cell when the minting registration is not a facilitator training. %>
<% if registration.event %>
  <%= link_to registration.event.title, event_path(registration.event),
        target: "_blank", rel: "noopener", class: "font-medium text-gray-800 hover:underline hover:text-blue-700" %>
  <span class="text-xs whitespace-nowrap text-gray-500"><%= registration.event.start_date&.in_time_zone&.strftime("%b %Y") %></span>
<% end %>
<p class="text-xs text-gray-500">
  Minted by
  <%= link_to (registration.registrant&.full_name.presence || "a registration"),
        edit_event_registration_path(registration), target: "_blank", rel: "noopener", class: "underline" %>,
  which is not a facilitator training — so it confers no facilitator status.
</p>

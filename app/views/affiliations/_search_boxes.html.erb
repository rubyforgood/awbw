<% field_class = search_field_class %>
<% yes_no = Affiliation::INDEX_YES_NO.to_a %>
<%= form_tag(affiliations_path, method: :get,
  data: { controller: "collection", turbo_frame: "affiliations_results" },
  autocomplete: "off",
  class: "mb-6 space-y-3 rounded-lg border border-gray-200 bg-gray-50 p-4") do %>
  <div class="flex items-center gap-2 text-gray-600">
    <i class="fa-solid fa-filter text-xs"></i>
    <span class="text-xs font-semibold tracking-wide uppercase">Filter</span>
  </div>
  <%= hidden_field_tag :person_id, params[:person_id] if params[:person_id].present? %>
  <%= hidden_field_tag :organization_id, params[:organization_id] if params[:organization_id].present? %>
  <div class="flex flex-col gap-4 md:flex-row md:flex-wrap md:items-start">
    <%= render "shared/filter_text", param: :query, label: "Person or organization name", submit: true,
          wrapper_class: "w-full md:flex-1 md:min-w-[220px]" %>
    <%= render "shared/filter_text", param: :comment_text, label: "Comments contain", submit: true,
          tooltip: "Searches comment text and topics, e.g. \"FileMaker import\" or \"stand-in\"",
          wrapper_class: "w-full md:flex-1 md:min-w-[220px]" %>
    <%= render "shared/filter_text", param: :filemaker_code, label: "FileMaker code", wrapper_class: "w-full md:w-36" %>
  </div>
  <div class="flex flex-col gap-4 md:flex-row md:flex-wrap md:items-start">
    <%= render "shared/filter_select", param: :kind, label: "Kind", options: Affiliation::INDEX_KINDS.to_a,
          selected: params[:kind], blank: "FA & JA", field_class: field_class, wrapper_class: "w-full md:w-40" %>
    <%= render "shared/filter_select", param: :status, label: "Status", options: Affiliation::INDEX_STATUSES,
          selected: params[:status], blank: "Any status", field_class: field_class, wrapper_class: "w-full md:w-44" %>
    <%= render "shared/filter_select", param: :source, label: "Where it came from", options: Affiliation::INDEX_SOURCES.to_a,
          selected: params[:source], blank: "Anywhere", field_class: field_class, wrapper_class: "w-full md:w-52" %>
    <%= render "shared/filter_select", param: :registrations, label: "Person has registrations", options: yes_no,
          selected: params[:registrations], blank: "With or without", field_class: field_class, wrapper_class: "w-full md:w-44" %>
    <%= render "shared/filter_select", param: :trained_at, label: "Trained at",
          options: Affiliation.training_event_choices.map { |event| [ [ event.start_date&.strftime("%Y-%m-%d"), event.decorate.compact_label ].compact.join(" · "), event.id ] },
          selected: params[:trained_at], blank: "Any event", field_class: field_class, wrapper_class: "w-full md:w-64",
          hint: "The affiliation's linked event, else the person's facilitator trainings" %>
    <%= render "shared/filter_select", param: :address, label: "Org address", options: yes_no,
          selected: params[:address], blank: "With or without", field_class: field_class, wrapper_class: "w-full md:w-36" %>
    <%= render "shared/filter_select", param: :comments, label: "Has comments", options: yes_no,
          selected: params[:comments], blank: "With or without", field_class: field_class, wrapper_class: "w-full md:w-36" %>
    <%= render "shared/filter_select", param: :primary, label: "Primary contact", options: yes_no,
          selected: params[:primary], blank: "Either", field_class: field_class, wrapper_class: "w-full md:w-32" %>
    <%= render "shared/filter_text", param: :start_year, label: "Start year", placeholder: "YYYY",
          wrapper_class: "w-full md:w-24", input_options: { inputmode: "numeric", maxlength: 4 } %>
    <%= render "shared/filter_text", param: :end_year, label: "End year", placeholder: "YYYY",
          wrapper_class: "w-full md:w-24", input_options: { inputmode: "numeric", maxlength: 4 } %>
    <div class="w-full md:ml-auto md:w-auto">
      <span class="<%= search_label_class(extra: "invisible") %>" aria-hidden="true">Clear</span>
      <%= render "shared/search_clear", url: affiliations_path %>
    </div>
  </div>
<% end %>

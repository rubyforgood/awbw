      <div class="h-6 w-52 rounded bg-gray-200"></div>
      <div class="h-6 w-28 rounded bg-gray-200"></div>
      <div class="h-6 w-36 rounded bg-gray-200"></div>
      <div class="h-6 w-36 rounded bg-gray-200"></div>
    </div>
  <% end %>
</div>

<% if person.decorate.multiple_unlocked_memberships? %>
  <div class="admin-only mb-4 rounded-lg border border-yellow-200 bg-yellow-50 p-4">
    <div class="flex items-start gap-3">
      <div class="flex-shrink-0 pt-0.5">
        <i class="fa-solid fa-triangle-exclamation text-yellow-600"></i>
      </div>
      <div class="flex-1">
        <h3 class="text-sm font-medium text-yellow-800">Multiple memberships</h3>
        <p class="mt-1 text-sm text-yellow-700">
          This person has <%= pluralize(person.decorate.unlocked_membership_count, "unlocked membership") %>. A person should have one current membership — the extras are usually a leftover from a merge. Old memberships are locked automatically when a new one is created.
          <%= link_to "Review memberships", person_memberships_path(person), class: "underline hover:text-yellow-900" %>
        </p>
      </div>
    </div>
  </div>
<% end %>

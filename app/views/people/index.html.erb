<% content_for(:page_bg_class, "admin-or-auth") %>
<div class="border-primary/10 bg-brand-cream mx-auto max-w-7xl overflow-hidden rounded-2xl border shadow-sm">
  <!-- Rainbow accent strip (AWBW brand) -->
  <div class="h-1.5 w-full bg-[linear-gradient(to_right,#4e8324,#d56027,#e0b528,#9b2c5e,#24479e,#3aa0a0)]"></div>
  <div class="w-full p-6">
    <% back_label, back_path =
         case params[:return_to]
         when "staff_tags"
           [ "Staff tags", staff_tags_path ]
         when "staff_tag"
           staff_tag = StaffTag.find_by(id: params[:staff_tag_ids]) if allowed_to?(:index?, StaffTag)
           [ staff_tag&.name || "Staff tags", staff_tag ? staff_tag_path(staff_tag) : staff_tags_path ]
         when "tags"
           [ "Tags", tags_path ]
         when "taggings"
           [ "Taggings", taggings_path ]
         end %>
    <% if back_path %>
      <div class="mb-4">
        <%= link_to "← #{back_label}", back_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
      </div>
    <% end %>
    <div class="mb-6 flex items-start justify-between">
      <div class="pr-6">
        <span class="text-2xs font-semibold tracking-widest uppercase <%= DomainTheme.text_class_for(:people, intensity: 700) %>">Directory</span>
        <div id="people_count">
          <h1 class="text-primary font-display text-3xl">People</h1>
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-2 text-right">
        <% if allowed_to?(:index?, TopicSubscription) %>
          <%= link_to "Subscriptions", topic_subscriptions_path,
                      class: "admin-only bg-blue-100 text-sm #{eyebrow_link_class} px-2 py-1" %>
        <% end %>
        <% if allowed_to?(:index?, Person) %>
          <%= link_to "Email addresses", email_addresses_people_path(request.query_parameters),
                      class: "admin-only bg-blue-100 text-sm #{eyebrow_link_class} px-2 py-1" %>
        <% end %>
        <% if allowed_to?(:new?, Person) %>
          <%= link_to "New Person",
                      new_person_path,
                      class: "admin-only bg-blue-100 btn btn-primary-outline" %>
        <% end %>
      </div>
    </div>
    <%= render "search_boxes" %>

    <% result_src = people_path + "?" + request.query_string %>

    <%= turbo_frame_tag :people_results, src: result_src, data: {turbo: "temporary"} do %>
      <%= render "results_skeleton" %>
    <% end %>
  </div>
</div>

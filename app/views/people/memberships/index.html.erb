<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<% has_card = @person.payment_processor&.payment_methods&.exists? || false %>
<% offer_new_membership = @memberships.none? { |membership| !membership.locked? && (membership.active? || membership.upcoming?) } %>

<div class="border-primary/10 mx-auto max-w-3xl rounded-2xl border bg-white p-4 shadow-sm sm:p-6">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
    <%= link_to person_path(@person), class: "text-sm #{eyebrow_link_class} px-2 py-1" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i>
      <%= @person.full_name %>
    <% end %>

    <%= link_to "All memberships", memberships_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
  </div>

  <div class="mb-6 flex flex-wrap items-end justify-between gap-2">
    <div>
      <h1 class="text-primary mb-1 font-display text-2xl font-bold">Memberships</h1>
      <p class="text-sm text-gray-500"><%= @person.full_name %></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <% if @person.autopay_on? %>
        <%= button_to "Turn off autopay", person_autopay_path(@person, autopay_on: "0"),
              method: :patch, class: button_classes(:secondary_outline, size: :sm),
              data: { turbo_confirm: "Turn off automatic card payments for #{@person.full_name}?" } %>
      <% end %>

      <% if offer_new_membership %>
        <%= link_to new_person_membership_path(@person), class: button_classes(:primary, extra: "inline-flex items-center gap-1.5") do %>
          <i class="fa-solid fa-plus text-xs"></i>
          New membership
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @memberships.none? %>
    <p class="text-gray-500 italic">No membership yet.</p>
  <% else %>
    <div class="space-y-4">
      <% @memberships.each do |membership| %>
        <div class="border-primary/10 flex flex-wrap items-center justify-between gap-3 rounded-2xl border p-4">
          <div>
            <div class="mb-1 flex flex-wrap items-center gap-2">
              <%= render "memberships/status_badge", membership: membership %>
              <%= render "shared/badge", label: membership.payment_label, classes: membership.payment_classes %>
              <%= render "shared/badge",
                    label: "Autopay: #{membership.autopay_label(has_card: has_card)}",
                    classes: membership.autopay_classes(has_card: has_card) %>
              <% if membership.locked? %>
                <%= render "shared/badge", label: "Locked", classes: "bg-gray-100 text-gray-600 border-gray-300" %>
              <% end %>
            </div>

            <div class="flex flex-wrap gap-x-6 gap-y-1 text-xs">
              <span class="text-gray-600">Cost: <span class="font-medium text-gray-800"><%= membership.cost_label %></span></span>
              <span class="text-gray-600">Renewal: <span class="font-medium text-gray-800"><%= membership.auto_renewal_label %></span></span>
              <% if membership.period_label.present? %>
                <span class="text-gray-600">Term: <span class="font-medium text-gray-800"><%= membership.period_label %></span></span>
              <% end %>
            </div>
          </div>

          <%= link_to "View membership", membership_path(membership), class: button_classes(:secondary_outline, size: :sm) %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<div class="border-primary/10 mx-auto max-w-2xl rounded-2xl border bg-white p-4 shadow-sm sm:p-6">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
    <%= link_to person_memberships_path(@person), class: "text-sm #{eyebrow_link_class} px-2 py-1" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> Membership
    <% end %>
  </div>

  <h1 class="text-primary mb-1 font-display text-2xl font-bold">New membership</h1>
  <p class="mb-6 text-sm text-gray-500"><%= @person.full_name %></p>

  <% if @errors.present? %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <%= @errors.to_sentence %>
    </div>
  <% end %>

  <%= simple_form_for @membership, url: person_memberships_path(@person) do |f| %>
    <%= f.input :start_date,
          as: :date,
          html5: true,
          label: "Starts",
          hint: "The term runs 12 months from this date. Its first invoice is created at the same time.",
          input_html: { class: "bg-white" } %>

    <%= f.input :cost_dollars,
          label: "Locked price ($ per year)",
          required: false,
          hint: "Leave blank for the standard cost (#{dollars_from_cents(Membership.annual_cost_cents)}). Applies to future invoices.",
          input_html: { min: 0, step: 0.01, placeholder: "Standard", class: "bg-white" } %>

    <%= f.input :first_invoice_cost_dollars,
          label: "First invoice ($)",
          required: false,
          hint: "Enter 0 for a free first year. Blank uses the locked or standard price.",
          input_html: { min: 0, step: 0.01, class: "bg-white" } %>

    <div class="mt-6 flex items-center gap-3 border-t border-gray-200 pt-6">
      <div class="ml-auto flex items-center gap-3">
        <%= link_to "Cancel", person_memberships_path(@person), class: button_classes(:secondary_outline) %>
        <%= f.button :submit, "Create membership", class: button_classes(:primary) %>
      </div>
    </div>
  <% end %>
</div>

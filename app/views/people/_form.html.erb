<%= simple_form_for @person, html: { multipart: true, class: "space-y-4",
                                          data: { controller: "dirty-form affiliation-dates affiliation-facilitator-warning",
                                                  affiliation_dates_member_since_value: @person.member_since&.strftime("%Y-%m-%d") || "" } } do |f| %>
  <%= render 'shared/errors', resource: @person if @person.errors.any? %>
  <%= render "duplicate_people_warning" %>

  <%= f.hidden_field :created_by_id, value: current_user&.id unless f.object.persisted? %>
  <%= f.hidden_field :updated_by_id, value: current_user&.id %>
  <% user_id = @user&.id || @person&.user&.id %>
  <%= hidden_field_tag :user_id, user_id if user_id %>

  <%# Carry the origin context through the save so #update can return the admin
      to where they came from (e.g. the registration org-linking page). %>
  <% if params[:return_to] == "registration_link" && params[:event_registration_id].present? %>
    <%= hidden_field_tag :return_to, "registration_link" %>
    <%= hidden_field_tag :event_registration_id, params[:event_registration_id] %>
    <%= hidden_field_tag :link_org_return_to, params[:link_org_return_to] if params[:link_org_return_to].present? %>
  <% end %>
  <% card_class = "rounded-lg border border-gray-200 bg-gray-50 p-4 shadow-sm" %>
  <% heading_class = "mb-3 font-semibold text-gray-700" %>

  <div class="flex flex-col gap-4 md:flex-row md:flex-wrap md:items-start"><%= f.input :first_name, wrapper_html: { class: "w-full md:w-auto md:flex-1 md:basis-36" }, input_html: { value: f.object.first_name || @user&.first_name, class: "w-full" } %><%= f.input :legal_first_name, label: "Legal first name", hint: "If different from first name", wrapper_html: { class: "w-full md:w-auto md:flex-1 md:basis-44" }, input_html: { class: "w-full" } %><%= f.input :last_name, wrapper_html: { class: "w-full md:w-auto md:flex-1 md:basis-36" }, input_html: { value: f.object.last_name || @user&.last_name, class: "w-full" } %><%= f.input :pronunciation, hint: "e.g. AHN-dray-ah", wrapper_html: { class: "w-full md:w-auto md:flex-1 md:basis-36" }, input_html: { class: "w-full" } %><%= f.input :pronouns, wrapper_html: { class: "w-full md:w-28 md:flex-none" }, input_html: { class: "w-full" } %><div class="w-full md:ml-auto md:w-auto"><%= render "shared/form_image_field", f: f, field_name: :avatar, compact: true %></div></div>

  <div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-2">
    <div id="emails" class="emails <%= card_class %> scroll-mt-4">
      <h3 class="<%= heading_class %>">Emails</h3>
      <% if allowed_to?(:manage?, Person) %>
        <div class="grid grid-cols-1 gap-x-4 sm:grid-cols-2">
          <% if f.object.user %>
            <div class="mb-4">
              <label class="mb-1 block text-md font-medium text-gray-700">Primary email</label>
              <span class="font-medium text-gray-900"><%= f.object.user.email %></span>
              <%= render "people/pending_email_change_badge", person: f.object %>
              <p class="mt-1 text-sm text-gray-500">
                Edit on <%= link_to "user account", edit_user_path(f.object.user), class: "underline" %>
              </p>
            </div>
          <% else %>
            <%= f.input :email, label: "Primary email" %>
          <% end %>

          <%= f.input :email_type,
                      label: "Primary email type",
                      as: :select,
                      collection: Person::CONTACT_TYPES.compact.map { |type| [type.to_s.humanize, type] },
                      selected: f.object.email_type || f.object.user&.email_type,
                      include_blank: true %>

          <%= f.input :email_2, label: "Secondary email" %>

          <%= f.input :email_2_type,
                      label: "Secondary email type",
                      as: :select,
                      collection: Person::CONTACT_TYPES.compact.map { |type| [type.to_s.humanize, type] },
                      include_blank: true %>
        </div>
      <% else %>
        <%= render "people/owner_emails", f: f %>
      <% end %>
    </div>

    <div class="phones <%= card_class %> scroll-mt-4" id="phones">
      <h3 class="<%= heading_class %>">Phones</h3>
      <% if @person.best_time_to_call.present? || params[:admin] == "true" %>
        <%= f.input :best_time_to_call %>
      <% end %>

      <%= f.simple_fields_for :contact_methods do |f| %>
        <%= render "contact_methods/contact_method_fields", f: f %>
      <% end %>

      <%= link_to_add_association "➕ Add phone",
                                  f,
                                  :contact_methods,
                                  partial: "contact_methods/contact_method_fields",
                                  class: button_classes(:secondary_outline) %>
    </div>
  </div>

  <div class="addresses scroll-mt-4 rounded-lg border border-gray-200 bg-yellow-50 p-4 shadow-sm" id="addresses">
    <h3 class="<%= heading_class %>">Mailing addresses</h3>
    <%= f.simple_fields_for :addresses do |f| %>
      <%= render "addresses/address_fields", f: f %>
    <% end %>

    <%= link_to_add_association "➕ Add address",
                                f,
                                :addresses,
                                class: button_classes(:secondary_outline) %>
  </div>

  <!-- Sectors + Age ranges (split width; both wrap their chips) -->
  <%# Tells the controller which category types this form edits via category_ids
      (workshop settings); saving replaces only those and preserves any other type
      the form never shows. Age ranges are edited as nested attributes, separately. %>
  <%= hidden_field_tag "person[category_ids][]", "" %>
  <%# Always submit the managed_category_type_ids key (blank included) so
      assign_associations takes the preserve branch even when there are no managed
      types — otherwise the key vanishes and it replaces categories, dropping the
      person's age ranges and other-type taggings. %>
  <%= hidden_field_tag "person[managed_category_type_ids][]", "" %>
  <% (@managed_category_type_ids || []).each do |type_id| %>
    <%= hidden_field_tag "person[managed_category_type_ids][]", type_id %>
  <% end %>
  <div class="flex flex-wrap gap-4 items-stretch">
    <!-- Sectors -->
    <div class="form-group flex min-w-[20rem] flex-1 flex-col rounded-lg border border-gray-200 <%= DomainTheme.bg_class_for(:sectors) %> p-4 shadow-sm">
      <h3 class="<%= heading_class %>"><%= allowed_to?(:manage?, Person) ? "Sectors" : "Sectors you work in" %></h3>
      <div class="flex flex-1 flex-wrap content-start items-center gap-2"
           data-controller="primary-tag"
           data-primary-tag-primary-class="border-lime-500 bg-lime-100"
           data-primary-tag-default-class="border-gray-300 bg-white">
        <% sectors_owner = f.object.respond_to?(:object) ? f.object.object : f.object %>
        <%# "Other" is never a real sector tag (it's captured as an OtherResponse),
            so drop any stray legacy tagging from the editable list. %>
        <% editable_sector_items = sectors_owner.sectorable_items_ordered.reject { |item| item.sector&.name == Sector::OTHER_SECTOR_NAME } %>
        <%= f.simple_fields_for :sectorable_items, editable_sector_items do |sfi| %>
          <%= render "shared/sectorable_item_fields", f: sfi, show_person_flags: true %>
        <% end %>

        <%= link_to_add_association "➕ Add Sector",
                                    f,
                                    :sectorable_items,
                                    partial: "shared/sectorable_item_fields",
                                    render_options: {
                                      locals: { collection: (@sectors_collection || [])
                                        .reject { |_, id| (@current_sector_ids || []).include?(id) },
                                                show_person_flags: true } },
                                    class: button_classes(:secondary_outline) %>
        <%= render "people/other_sector_responses", responses: @person.other_sector_responses, dismissable: true, curatable: true, return_to: "person_edit" %>
      </div>
    </div>

    <!-- Age ranges -->
    <% if @age_ranges_collection.present? %>
      <div class="form-group flex min-w-[20rem] flex-1 flex-col rounded-lg border border-gray-200 bg-gray-50 p-4 shadow-sm">
        <h3 class="<%= heading_class %>">Age ranges</h3>
        <div class="flex flex-1 flex-wrap content-start items-center gap-2"
             data-controller="primary-tag"
             data-primary-tag-primary-class="border-amber-300 bg-amber-50"
             data-primary-tag-default-class="border-gray-300 bg-white">
          <% age_owner = f.object.respond_to?(:object) ? f.object.object : f.object %>
          <%= f.simple_fields_for :age_range_categorizable_items, age_owner.age_range_items_ordered do |afi| %>
            <%= render "shared/age_range_item_fields", f: afi %>
          <% end %>

          <%= link_to_add_association "➕ Add age range",
                                      f,
                                      :age_range_categorizable_items,
                                      partial: "shared/age_range_item_fields",
                                      render_options: {
                                        locals: { collection: (@age_ranges_collection || [])
                                          .reject { |_, id| (@current_age_range_category_ids || []).include?(id) } } },
                                      class: button_classes(:secondary_outline) %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Staff tags (internal, admin-only) -->
  <% if allowed_to?(:manage?, StaffTag) %>
    <% staff_owner = f.object.respond_to?(:object) ? f.object.object : f.object %>
    <div class="form-group admin-only space-y-2 rounded-lg bg-blue-100 p-4">
      <div class="flex items-baseline justify-between">
        <h3 class="font-semibold text-gray-700">Staff tags</h3>
        <%= link_to "Manage tags", staff_tags_path, class: "text-sm #{eyebrow_link_class}", target: "_blank", rel: "noopener" %>
      </div>
      <p class="text-xs text-gray-500">Internal only — pipelines, rosters, and outreach lists. Never shown publicly.</p>
      <div class="flex flex-wrap content-start items-center gap-2 pt-1">
        <%= f.simple_fields_for :staff_taggings, staff_owner.staff_taggings do |sfi| %>
          <%= render "people/staff_tag_item_fields", f: sfi %>
        <% end %>

        <%= link_to_add_association "➕ Add staff tag",
                                    f,
                                    :staff_taggings,
                                    partial: "people/staff_tag_item_fields",
                                    render_options: {
                                      locals: { collection: (@staff_tags_collection || [])
                                        .reject { |_, id| (@current_staff_tag_ids || []).include?(id) } } },
                                    class: button_classes(:secondary_outline) %>
      </div>
    </div>
  <% end %>

  <!-- Profile-specific Categories (other than age ranges) -->
  <% other_category_types = (@person_categories_grouped || {}).reject { |type, _| type.name == "AgeRange" } %>
  <% if other_category_types.present? %>
    <div class="form-group space-y-4">
      <% other_category_types.each do |type, cats| %>
        <div class="<%= card_class %>">
          <% select_id = "person_category_ids_type_#{type.id}" %>
          <%= label_tag select_id, type.display_label, class: "block #{heading_class}" %>
          <div data-controller="searchable-checkbox">
            <%= select_tag "person[category_ids][]",
                           options_from_collection_for_select(cats, :id, :name, @selected_category_ids || @person.category_ids),
                           id: select_id,
                           multiple: true,
                           class: "w-full rounded-lg border border-gray-300 bg-white",
                           data: { searchable_checkbox_target: "select", placeholder: "Add #{type.display_label.downcase}…" } %>
          </div>
        </div>
      <% end %>
      <% workshop_other = @person.other_workshop_setting_responses %>
      <% if workshop_other.any? %>
        <div class="flex flex-wrap gap-2">
          <%= render "people/other_responses", responses: workshop_other %>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Organization Affiliations -->
  <% person = f.object.respond_to?(:object) ? f.object.object : f.object %>
  <% decorated = person.decorate %>
  <% if allowed_to?(:manage?, Person) %>
    <div id="affiliations" class="form-group admin-only scroll-mt-4 rounded-lg border border-gray-200 bg-blue-50 p-4 shadow-sm">
      <h3 class="<%= heading_class %>">
        Affiliations<span class="text-sm font-normal text-gray-500"> (only editable by admins)</span>
      </h3>

      <% if params[:admin].present? %>
        <div class="admin-only mb-4 rounded-lg bg-blue-100 p-4">
          <%= f.input :member_since,
                      as: :date,
                      discard_day: true,
                      start_year: 1991,
                      end_year: Time.current.year,
                      prompt: { month: "Select Month", year: "Select Year" },
                      order: [:month, :year],
                      label: "Member since (override)",
                      hint: "Pick January if you only know the year",
                      wrapper_html: { class: "flex flex-wrap gap-2 items-end" },
                      label_html: { class: "w-full" },
                      hint_html: { class: "w-full" },
                      input_html: {
                        class: "flex-1 rounded-md border-gray-300 shadow-sm admin-only bg-blue-100 border-blue-200
                        focus:border-blue-500 focus:ring focus:ring-blue-200 focus:ring-opacity-50"
                      } %>
        </div>
      <% end %>
      <div class="mb-3 flex flex-col gap-6 md:flex-row">
        <div class="relative shrink-0">
          <div class="group/fac relative inline-block cursor-help">
            <label class="mb-1 inline-flex items-center gap-1 text-md font-medium text-gray-700">
              Facilitator since <i class="fa-solid fa-circle-info text-xs text-gray-400"></i>
            </label>
            <div class="absolute bottom-full left-0 z-50 mb-1 hidden w-64 rounded-lg bg-blue-100 p-3 text-xs whitespace-normal text-gray-700 shadow-lg ring-1 ring-blue-200 group-hover/fac:block">
              <% facilitator_start = person.affiliations.facilitators.minimum(:start_date) %>
              <% if facilitator_start.nil? && person.member_since.present? %>
                <p>Earliest start date from affiliations with 'facilitator' somewhere in the title.<br><br><span class="font-medium text-amber-700">⚠ Currently showing the legacy member_since value (<%= person.member_since.strftime('%b %Y') %>) because no Facilitator affiliation has a start date. Add a start date to a Facilitator affiliation to stop using the legacy value.</span></p>
              <% else %>
                <p>Earliest start date from affiliations with 'facilitator' somewhere in the title. Edit affiliation records to change this date.</p>
                <% if decorated.member_since_earlier_than_facilitator_affiliations? %>
                  <p class="mt-2 font-medium text-amber-700">⚠ Member since (<%= person.member_since.strftime('%b %Y') %>) is earlier than any Facilitator affiliation. Create an affiliation with that start date to reflect it on the profile.</p>
                <% elsif decorated.member_since_differs_from_facilitator_affiliations? %>
                  <p class="mt-2 text-gray-500"><i class="fa-solid fa-circle-info mr-1"></i>Member since (<%= person.member_since.strftime('%b %Y') %>) differs from the earliest Facilitator affiliation start date.</p>
                <% end %>
              <% end %>
            </div>
          </div>
          <div class="pt-1">
            <span class="font-medium text-gray-900" data-affiliation-dates-target="facilitatorSince"><%= decorated.facilitator_since_range %></span>
            <% member_since_earlier = decorated.member_since_earlier_than_facilitator_affiliations? %>
            <% member_since_differs = !member_since_earlier && decorated.member_since_differs_from_facilitator_affiliations? %>
            <p class="mt-1 text-xs <%= member_since_earlier ? "text-amber-700" : member_since_differs ? "text-gray-500" : "hidden" %>"
               data-affiliation-dates-target="memberSinceFlag">
              <% if member_since_earlier %>
                ⚠ Earlier date on file: <%= person.member_since.strftime("%b %Y") %>
              <% elsif member_since_differs %>
                <i class="fa-solid fa-circle-info mr-1"></i>Different date on file: <%= person.member_since.strftime("%b %Y") %>
              <% end %>
            </p>
            <div class="mt-1 <%= "hidden" unless decorated.affiliated_since_note %>" data-affiliation-dates-target="affiliatedNote">
              <span class="group/aff relative inline-flex cursor-help items-center gap-1">
                <span class="text-xs text-gray-500" data-affiliation-dates-target="affiliatedNoteText"><%= decorated.affiliated_since_note %></span>
                <i class="fa-solid fa-circle-info text-xs text-gray-400"></i>
                <div class="absolute bottom-full left-0 z-50 mb-1 hidden w-64 rounded-lg bg-blue-100 p-3 text-xs whitespace-normal text-gray-700 shadow-lg ring-1 ring-blue-200 group-hover/aff:block">
                  <p>The earliest date this person was affiliated with any organization, in any role. Shown only when it's earlier than the facilitator start — otherwise the two dates are the same.</p>
                </div>
              </span>
            </div>
          </div>
        </div>
      </div>
      <%= render "affiliations/editor", f: f, label: "Organization", scope: "person",
            add_class: button_classes(:secondary_outline, extra: "admin-only bg-blue-100") %>

      <%# Sending an agreement form is affiliation work — it's how a new job or
          reinstatement starts — so it lives here, collapsed. %>
      <% if person.persisted? && allowed_to?(:send_form_link?, person) %>
        <%= render "agreement_form_links", person: person %>
      <% end %>
    </div>
  <% else %>
    <%= render "people/owner_affiliations", f: f %>
  <% end %>

  <div class="grid grid-cols-1 items-stretch gap-4 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
    <div class="form-group <%= card_class %>">
      <h3 class="<%= heading_class %>">Background</h3>
      <%# Shout-out text is edited on the registration's "Shout out" section, not here. %>
      <%= f.input :bio,
                  wrapper_html: { class: "w-full" },
                  as: :text,
                  input_html: {
                    rows: 3,
                    maxlength: 1650,
                    class: "w-full rounded-md border-gray-300 shadow-sm
                        focus:border-blue-500 focus:ring focus:ring-blue-200 focus:ring-opacity-50"
                  },
                  hint: "Maximum 250 characters" %>
    </div>

    <div class="<%= card_class %>">
      <div class="w-full sm:w-56">
        <%= f.input :date_of_birth,
                    label: "Birthday",
                    as: :date,
                    discard_year: true,
                    order: [:month, :day],
                    prompt: { month: "Month", day: "Day" },
                    hint: "Month and day only",
                    wrapper_html: { class: "flex flex-wrap gap-x-2 items-end" },
                    label_html: { class: "w-full" },
                    hint_html: { class: "w-full" },
                    input_html: {
                      class: "flex-1 rounded-md border-gray-300 shadow-sm
                      focus:border-blue-500 focus:ring focus:ring-blue-200 focus:ring-opacity-50"
                    } %>
      </div>

      <% if f.object.user %>
        <%= f.fields_for :user do |user_form| %>
          <%= user_form.input :time_zone,
                              as: :select,
                              collection: us_time_zone_fundamentals,
                              selected: user_form.object.time_zone.presence || "Pacific Time (US & Canada)",
                              include_blank: false,
                              hint: timezone_visibility_hint(user_form.object),
                              input_html: { class: "w-full" } %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if allowed_to?(:manage?, Person) %>
    <div class="admin-only grid grid-cols-1 items-start gap-x-6 rounded-lg border border-gray-200 bg-blue-100 p-4 shadow-sm sm:grid-cols-2 lg:grid-cols-4">
      <%= f.input :racial_ethnic_identity,
                  label: "Racial/ethnic identity",
                  input_html: { class: "w-full" } %>

      <%= f.input :filemaker_code,
                  label: "FileMaker code",
                  hint: filemaker_code_hint(f.object),
                  input_html: { class: "w-full" } %>

      <% if person.persisted? %>
        <div class="mb-4">
          <div class="mb-1 block font-medium text-gray-700">Mailing list</div>
          <%= link_to decorated.news_subscriptions_path,
                      class: "inline-flex items-center gap-1.5 text-sm #{DomainTheme.text_class_for(:topic_subscriptions, intensity: 700)} #{DomainTheme.text_class_for(:topic_subscriptions, intensity: 800, hover: true)}" do %>
            <i class="fa-solid fa-envelope-open-text"></i>
            News subscriptions
          <% end %>
          <p class="mt-1 text-xs text-gray-500">Mailing-list interest is tracked in topic subscriptions.</p>
        </div>
      <% end %>

      <%= f.input :blog_contributor,
                  as: :boolean,
                  label: "Blog contributor",
                  hint: "Adds a badge to their profile." %>
    </div>
  <% end %>

  <div id="professional-licenses" class="form-group <%= card_class %> scroll-mt-4">
    <h3 class="mb-1 font-semibold text-gray-700">Professional licenses</h3>
    <p class="mb-3 text-sm text-gray-500">Used for continuing-education credit. Once a license has CE registrations it can't be removed, and only an admin can edit it.</p>
    <%= f.simple_fields_for :professional_licenses do |license_form| %>
      <%= render "professional_licenses/professional_license_fields", f: license_form %>
    <% end %>
    <%= link_to_add_association "➕ Add license",
                                f,
                                :professional_licenses,
                                partial: "professional_licenses/professional_license_fields",
                                class: button_classes(:secondary_outline) %>
  </div>

  <div class="profile-preferences-section <%= card_class %>">
    <h3 class="<%= heading_class %>">Social media links</h3>
    <div class="grid grid-cols-1 gap-x-4 sm:grid-cols-2 lg:grid-cols-5">
      <%= f.input :linked_in_url, label: "LinkedIn" %>
      <%= f.input :facebook_url, label: "Facebook" %>
      <%= f.input :instagram_url, label: "Instagram" %>
      <%= f.input :youtube_url, label: "YouTube" %>
      <%= f.input :twitter_url, label: "X (Twitter)" %>
    </div>
  </div>

  <div id="profile-preferences" class="profile-preferences-section <%= card_class %> scroll-mt-4">
    <h3 class="mb-1 font-semibold text-gray-700">Profile display preferences</h3>
    <p class="mb-3 text-sm text-gray-500">
      Updating these preferences applies to how you show up sitewide: stories, workshop variations, the people index, and more.
    </p>

    <div class="grid grid-cols-1 gap-x-6 md:grid-cols-[auto_1fr_1fr]">
      <%= f.input :profile_is_searchable,
                  hint: ("Findable on " + (link_to "people index",
                                                  people_path,
                                                  class: "underline")).html_safe %>

      <%= f.input :display_name_preference,
                  as: :select,
                  collection: Person::DISPLAY_NAME_PREFERENCE_LABELS.invert.to_a,
                  hint: "Sitewide (People/Profile, Stories, Workshop Variations, etc)",
                  selected: f.object.display_name_preference || "full_name" %>

      <%= f.input :anonymous_contributions,
                  label: "Contribute anonymously",
                  hint: "Hides your name on content, but not People/Profile" %>
    </div>

    <% toggle_wrapper = { class: "mb-0!" } %>
    <div class="grid grid-cols-2 gap-x-4 gap-y-2 md:grid-cols-3 lg:grid-cols-5">
      <%= f.input :profile_show_credentials, label: "Show credentials", wrapper_html: toggle_wrapper %>
      <%= f.input :profile_show_pronouns, label: "Show pronouns", wrapper_html: toggle_wrapper %>
      <%= f.input :profile_show_email, label: "Show email", wrapper_html: toggle_wrapper %>
      <%= f.input :profile_show_phone, label: "Show phone", wrapper_html: toggle_wrapper %>
      <%= f.input :profile_show_social_media, label: "Show social media", wrapper_html: toggle_wrapper %>
      <%= f.input :profile_show_bio, label: "Show bio", wrapper_html: toggle_wrapper %>
      <%= f.input :profile_show_member_since, label: "Show facilitator since", wrapper_html: toggle_wrapper %>
      <%= f.input :profile_show_affiliations, label: "Show affiliations", wrapper_html: toggle_wrapper %>
      <%= f.input :profile_show_sectors, label: "Show sectors", wrapper_html: toggle_wrapper %>
      <%= f.input :profile_show_age_ranges, label: "Show age ranges", wrapper_html: toggle_wrapper %>
      <%# Registrations first, then the rest alphabetically by label. %>
      <%= f.input :profile_show_events_registered, label: "Show registrations", wrapper_html: toggle_wrapper %>
      <%= f.input :profile_show_resources, label: "Show resources", wrapper_html: toggle_wrapper %>
      <%= f.input :profile_show_stories, label: "Show stories", wrapper_html: toggle_wrapper %>
      <%= f.input :profile_show_workshop_variations, label: "Show workshop variations", wrapper_html: toggle_wrapper %>
      <%= f.input :profile_show_workshops, label: "Show workshops", wrapper_html: toggle_wrapper %>
    </div>
  </div>

  <% if f.object.persisted? %>
    <%# Combined comments & communications — comment bodies/controls are admin-only
        and communication subjects are visible to the person (gated in the partial). %>
    <%= render "shared/comments_and_communications", f: f, view_all_person: @person, comms_title: t("communications.portal_title") %>
  <% end %>

  <% if params[:admin] && allowed_to?(:manage?, Person) %>
    <div class="admin-only bg-blue-100">
      <%= f.input :notes,
                  as: :text,
                  label: "Internal notes",
                  input_html: {
                    rows: 3,
                    class: "rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-200"
                  } %>
    </div>
  <% end %>

  <div class="action-buttons flex justify-center gap-3 pt-2">
    <% if allowed_to?(:destroy?, f.object) %>
      <%= link_to "Delete", @person, class: button_classes(:danger_outline),
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete?" } %>
    <% end %>

    <%= link_to "Cancel", people_path, class: button_classes(:secondary_outline),
                data: { action: "click->dirty-form#confirmCancel" } %>
    <%= f.button :submit, class: button_classes(:primary) %>
  </div>

  <% if f.object.persisted? && !allowed_to?(:manage?, Person) %>
    <% pending_other = f.object.profile_change_requests.pending.find_by(field: ProfileChangeRequest::OTHER_FIELD) %>
    <p class="text-center text-gray-700">
      Can't change something here?
      <%= link_to (pending_other ? "See your request" : "Ask AWBW staff to change it"),
                  new_profile_change_request_path(person_id: f.object, field: ProfileChangeRequest::OTHER_FIELD),
                  target: "_blank", rel: "noopener", class: "font-medium text-blue-600 underline hover:text-blue-800" %>
      <%= render "people/pending_request_icon", request: pending_other if pending_other %>
    </p>
  <% end %>
<% end %>

<% if allowed_to?(:manage?, Person) %>
  <div class="nested-fields flex flex-col sm:flex-row gap-4 items-start mb-4 rounded-lg border p-3 <%= f.object.inactive? ? 'bg-gray-100 border-gray-300 opacity-60' : 'bg-white border-gray-200' %>"
       data-controller="inactive-toggle"
       data-action="change->inactive-toggle#toggle">
    <div class="w-full sm:w-1/3">
      <%= f.input :organization_id,
                  as: :select,
                  label: "Organization",
                  collection: @organizations_array,
                  selected: f.object.organization_id,
                  input_html: {
                    class: "block w-full rounded-md border-gray-300 focus:ring-blue-500 focus:border-blue-500"
                  },
                  required: true,
                  error: "Organization can't be blank" %>
    </div>

    <div class="w-full sm:w-1/3">
      <%= f.input :title,
                  as: :text,
                  input_html: {
                    rows: 1,
                    value: f.object.title || f.object.position || "FACILITATOR",
                  } %>
    </div>

    <div class="w-full sm:w-1/3 flex items-center justify-between py-3 gap-4">
      <div class="flex items-center pt-6 space-x-2"><%= f.input :inactive,
                    as: :boolean,
                    label: "Inactive",
                    wrapper_html: { class: "m-0 p-0" },
                    label_html: { class: "text-sm font-medium text-gray-700 mb-0" },
                    input_html: { class: "h-4 w-4 text-blue-600 border-gray-300 rounded" } %></div>

      <%= link_to_remove_association "Remove",
                                     f,
                                     class: "text-sm text-gray-400 hover:text-red-600 underline whitespace-nowrap" %>
    </div>
  </div>
<% else %>
  <div class="ps-6 mb-4">
    <li><%= f.object.organization&.name %> (<%= f.object.title || f.object.position %>)</li>
  </div>
<% end %>

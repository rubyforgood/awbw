<% first_log = logs.first %>
<div class="h-full bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md
            transition-all overflow-hidden">
  <div class="px-4 pt-4 pb-3">
    <!-- TITLE (links to grouped page) -->
    <%= link_to workshop_logs_person_path(person, workshop_key: workshop_key),
                data: { turbo_frame: "_top" },
                class: "text-sm font-semibold text-gray-900 leading-tight hover:underline" do %>
      <%= first_log.workshop_title.presence || "Workshop Log ##{first_log.id}" %>
    <% end %>

    <!-- WINDOWS TYPE -->
    <% if first_log.windows_type_name.present? %>
      <div class="text-xs text-gray-500 mb-3 mt-1"><%= first_log.windows_type_name %></div>
    <% end %>

    <!-- COLUMN HEADERS -->
    <div class="grid grid-cols-5 gap-2 mb-1 mt-3">
      <div class="px-2.5 text-center text-xs font-medium text-gray-400">Date</div>
      <div class="px-2.5 text-center text-xs font-medium text-gray-400">Total</div>
      <div class="px-2.5 text-center text-xs font-medium text-gray-400">Adults</div>
      <div class="px-2.5 text-center text-xs font-medium text-gray-400">Teens</div>
      <div class="px-2.5 text-center text-xs font-medium text-gray-400">Children</div>
    </div>

    <!-- DATE ROWS -->
    <% logs.each do |log| %>
      <%= render "people/sections/workshop_log_date_row", workshop_log: log %>
    <% end %>
  </div>
</div>

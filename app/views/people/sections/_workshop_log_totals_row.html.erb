<% show_actions = local_assigns.fetch(:show_actions, false) %>
<div class="<%= show_actions ? "flex items-center gap-2" : "" %> mb-1">
  <div class="grid grid-cols-5 gap-2 <%= show_actions ? "flex-1 min-w-0" : "" %>">
    <div class="rounded-lg py-2 px-2.5 text-center">
      <div class="text-xs font-medium text-gray-500">Total</div>
    </div>
    <div class="bg-purple-200 rounded-lg py-2 px-2.5 text-center">
      <div class="text-sm font-bold text-gray-800"><%= logs.sum(&:total_attendance) %></div>
    </div>
    <div class="bg-purple-100 rounded-lg py-2 px-2.5 text-center">
      <div class="text-sm font-bold text-gray-800"><%= logs.sum { |l| l.adults_first_time + l.adults_ongoing } %></div>
    </div>
    <div class="bg-purple-100 rounded-lg py-2 px-2.5 text-center">
      <div class="text-sm font-bold text-gray-800"><%= logs.sum { |l| l.teens_first_time + l.teens_ongoing } %></div>
    </div>
    <div class="bg-purple-100 rounded-lg py-2 px-2.5 text-center">
      <div class="text-sm font-bold text-gray-800"><%= logs.sum { |l| l.children_first_time + l.children_ongoing } %></div>
    </div>
  </div>
  <% if show_actions %>
    <div class="shrink-0 w-20"></div>
  <% end %>
</div>

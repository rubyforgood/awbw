<%= turbo_frame_tag "person_organization_people_section" do %>
  <% if organization_people.any? %>
    <ul class="space-y-2 blur-on-submit">
      <% organization_people.each do |op| %>
        <li>
          <% if op.title.present? || op.position.present? %>
            <span class="text-gray-600"><%= op.title.presence || op.position.humanize %> - </span>
          <% end %>
          <%= link_to op.organization.name, organization_path(op.organization),
                      class: "text-blue-600 hover:underline font-medium" %>
        </li>
      <% end %>
    </ul>
    <div class="mt-6 flex justify-center">
      <%= tailwind_paginate organization_people, params: { section: "organization_people" } %>
    </div>
  <% else %>
    <p class="text-gray-500 italic">No affiliations listed.</p>
  <% end %>
<% end %>

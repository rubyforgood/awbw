<%= turbo_frame_tag "person_workshop_logs_section" do %>
  <% if workshop_logs.any? %>
    <% all_logs = person.user&.workshop_logs || WorkshopLog.none %>
    <div class="flex flex-wrap items-center gap-3 mb-4 text-sm text-gray-600">
      <span class="font-semibold text-gray-800">
        Total participants: <%= all_logs.sum(:children_first_time) + all_logs.sum(:children_ongoing) +
                   all_logs.sum(:teens_first_time) + all_logs.sum(:teens_ongoing) +
                   all_logs.sum(:adults_first_time) + all_logs.sum(:adults_ongoing) %>
      </span>
      <span>Adults: <%= all_logs.sum(:adults_first_time) + all_logs.sum(:adults_ongoing) %></span>
      <span>Teens: <%= all_logs.sum(:teens_first_time) + all_logs.sum(:teens_ongoing) %></span>
      <span>Children: <%= all_logs.sum(:children_first_time) + all_logs.sum(:children_ongoing) %></span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 blur-on-submit">
      <% workshop_logs.each do |workshop_log| %>
        <%= render "people/sections/workshop_log_card", workshop_log: workshop_log %>
      <% end %>
    </div>
    <div class="mt-6 flex justify-center">
      <%= tailwind_paginate workshop_logs, params: { section: "workshop_logs" } %>
    </div>
  <% else %>
    <p class="text-gray-500 italic">No workshops logged yet.</p>
  <% end %>
<% end %>

<%# locals: (person:, anchor:, label: "Edit") %>
<% pill_class = "inline-flex items-center gap-1.5 rounded-full border border-gray-300 bg-white px-3 py-1 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" %>
<% if anchor == "affiliations" && allowed_to?(:edit_own_profile?, person) && !allowed_to?(:manage?, Person) %>
  <%= link_to new_profile_change_request_path(person_id: person, field: "affiliation"), class: pill_class do %>
    <i class="fa-solid fa-comment"></i> Ask for a change
  <% end %>
<% elsif allowed_to?(:edit?, person) %>
  <%= link_to (allowed_to?(:edit_own_profile?, person) ? details_person_path(person, anchor: anchor) : edit_person_path(person, anchor: anchor)), class: pill_class do %>
    <i class="fa-solid fa-pen text-xs"></i> <%= label %>
  <% end %>
<% end %>

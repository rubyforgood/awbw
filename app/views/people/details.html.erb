<% content_for(:page_bg_class, "admin-or-owner") %>
<% card_class = "border-primary/10 scroll-mt-4 rounded-2xl border bg-white p-5 shadow-sm sm:p-6" %>
<% heading_class = "mb-4 font-display text-2xl text-gray-900" %>
<% input_class = "w-full text-lg" %>
<div class="mx-auto w-full max-w-4xl px-4 py-6">
  <div class="mb-2">
    <%= link_to person_path(@person), class: "text-sm #{eyebrow_link_class}" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> Back to my profile
    <% end %>
  </div>
  <h1 class="text-primary font-display text-3xl font-semibold">Edit my data</h1>
  <p class="mt-2 text-lg text-gray-700">
    Change anything below, then click <strong>Save</strong>.
  </p>
  <%= simple_form_for @person, html: { multipart: true, class: "mt-6 space-y-6", data: { controller: "dirty-form" } } do |f| %>
    <%= hidden_field_tag :return_to, "details" %>
    <%= render "shared/errors", resource: @person if @person.errors.any? %>
    <div id="photo" class="<%= card_class %>">
      <h2 class="<%= heading_class %>">Your photo</h2>
      <%= render "shared/form_image_field", f: f, field_name: :avatar, label: "Photo", rounded: true %>
    </div>
    <div id="name" class="<%= card_class %>">
      <h2 class="<%= heading_class %>">Your name & pronouns</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <%= f.input :first_name, label: "First name", input_html: { class: input_class } %>
        <%= f.input :last_name, label: "Last name", input_html: { class: input_class } %>
        <%= f.input :pronunciation, label: "How to say your name", hint: "For example: Oom-BEAR-toh", input_html: { class: input_class } %>
        <%= f.input :legal_first_name, label: "Legal first name", hint: "Only if it's different from your first name", input_html: { class: input_class } %>
        <%= f.input :pronouns, label: "Pronouns", hint: "For example: she/her, he/him, they/them", input_html: { class: input_class } %>
      </div>
    </div>
    <div id="emails" class="<%= card_class %>">
      <h2 class="mb-1 font-display text-2xl text-gray-900">Emails</h2>
      <p class="mb-4 text-gray-600">AWBW staff change your email addresses for you. You can pick each one's type.</p>
      <% pending_email_requests = @person.profile_change_requests.pending.where(field: ProfileChangeRequest::EMAIL_FIELDS).index_by(&:field) %>
      <% emails = [
           { field: "primary_email", label: "Primary email", address: @person.user&.email || @person.email, type_attribute: :email_type,
             type_selected: @person.email_type || @person.user&.email_type },
           { field: "secondary_email", label: "Secondary email", address: @person.email_2, type_attribute: :email_2_type,
             type_selected: @person.email_2_type }
         ] %>
      <div class="divide-y divide-gray-100">
        <% emails.each do |email| %>
          <% pending = pending_email_requests[email[:field]] %>
          <div class="grid grid-cols-1 items-start gap-4 py-4 first:pt-0 last:pb-0 sm:grid-cols-[minmax(0,24rem)_12rem] sm:gap-8">
            <div>
              <p class="text-sm font-medium text-gray-700"><%= email[:label] %></p>
              <% if email[:address].present? %>
                <!--email_off--><p class="text-lg font-medium break-all text-gray-900"><%= email[:address] %></p><!--email_on-->
              <% else %>
                <p class="text-lg text-gray-500 italic">None yet</p>
              <% end %>
              <div class="mt-2 flex flex-wrap items-center gap-3">
                <%= link_to new_profile_change_request_path(person_id: @person, field: email[:field], return_to: "details"),
                            target: "_blank", rel: "noopener",
                            class: button_classes(:secondary_outline, size: :sm) do %>
                  <%= pending ? "See your request" : (email[:address].present? ? "Request a change" : "Add a #{email[:label].downcase}") %>
                  <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                <% end %>
                <% if pending %>
                  <span class="inline-flex items-center gap-1 text-sm text-amber-800"><i class="fa-solid fa-clock"></i> Change to <%= pending.requested_value %> requested</span>
                <% end %>
              </div>
            </div>
            <% if email[:address].present? %>
              <%= f.input email[:type_attribute], label: "Type",
                          collection: Person::CONTACT_TYPES.compact.map { |type| [ type.to_s.humanize, type ] },
                          selected: email[:type_selected], include_blank: true, input_html: { class: input_class } %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <div id="bio" class="<%= card_class %>">
      <h2 class="<%= heading_class %>">About you</h2>
      <%= f.input :bio, as: :text, label: "Bio", hint: "A few sentences about you and your work.",
                  input_html: { rows: 5, maxlength: 1650, class: input_class } %>
      <%= f.input :date_of_birth, label: "Birthday", as: :date, html5: true,
                  hint: "Only AWBW staff see this. Your profile never shows the year.",
                  wrapper_html: { class: "mt-4 sm:w-64" }, input_html: { class: input_class } %>
      <% if @person.user %>
        <%= f.fields_for :user do |user_form| %>
          <%= user_form.input :time_zone, label: "Your time zone", collection: us_time_zone_fundamentals,
                              selected: user_form.object.time_zone.presence || "Pacific Time (US & Canada)", include_blank: false,
                              hint: "Dates and times show in this time zone.", wrapper_html: { class: "mt-4 sm:w-96" }, input_html: { class: input_class } %>
        <% end %>
      <% end %>
    </div>
    <div id="phones" class="<%= card_class %>">
      <h2 class="mb-1 font-display text-2xl text-gray-900">Phones</h2>
      <% phones = @person.contact_methods.reject(&:inactive?) %>
      <p class="mb-4 text-gray-600">Tap the <i class="fa-solid fa-star text-amber-400"></i> star on the number we should call first.</p>
      <% no_main_phone = phones.none?(&:primary?) %>
      <div class="grid grid-cols-1 items-start gap-4 sm:grid-cols-[minmax(0,1fr)_16rem]">
      <div class="space-y-4" data-controller="primary-tag" data-primary-tag-primary-class="bg-brand-cream">
        <%= f.simple_fields_for :contact_methods, phones do |phone| %>
          <%= render "people/details_phone_fields", f: phone, main_by_default: no_main_phone && phone.index.zero? %>
        <% end %>
        <%= render "people/add_more_chain", f: f, association: :contact_methods, fields_partial: "people/details_phone_fields",
                   build: -> { ContactMethod.new(kind: "phone") }, label: phones.any? ? "Add another phone" : "Add a phone",
                   next_label: "Add another phone", first_locals: { main_by_default: phones.empty? } %>
      </div>
      <%= f.input :best_time_to_call, label: "Best time to call", hint: "For example: weekday mornings", input_html: { class: input_class } %>
      </div>
    </div>
    <div id="addresses" class="<%= card_class %>">
      <h2 class="mb-1 font-display text-2xl text-gray-900">Mailing addresses</h2>
      <% addresses = @person.addresses.reject(&:inactive?) %>
      <p class="mb-4 text-gray-600">Tap the <i class="fa-solid fa-star text-amber-400"></i> star on the address we should mail things to.</p>
      <div class="space-y-4" data-controller="primary-tag" data-primary-tag-primary-class="bg-brand-cream">
        <%= f.simple_fields_for :addresses, addresses do |address| %>
          <%= render "people/details_address_fields", f: address %>
        <% end %>
        <%= render "people/add_more_chain", f: f, association: :addresses, fields_partial: "people/details_address_fields",
                   build: -> { Address.new }, label: addresses.any? ? "Add another address" : "Add an address",
                   next_label: "Add another address", first_locals: { main_by_default: addresses.empty? } %>
      </div>
    </div>
    <div id="social" class="<%= card_class %>">
      <h2 class="<%= heading_class %>">Social media</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <%= f.input :linked_in_url, label: "LinkedIn", placeholder: "https://", input_html: { class: input_class } %>
        <%= f.input :instagram_url, label: "Instagram", placeholder: "https://", input_html: { class: input_class } %>
        <%= f.input :facebook_url, label: "Facebook", placeholder: "https://", input_html: { class: input_class } %>
        <%= f.input :youtube_url, label: "YouTube", placeholder: "https://", input_html: { class: input_class } %>
        <%= f.input :twitter_url, label: "X (Twitter)", placeholder: "https://", input_html: { class: input_class } %>
      </div>
    </div>
    <div id="affiliations" class="<%= card_class %>">
      <h2 class="mb-1 font-display text-2xl text-gray-900">Affiliations</h2>
      <p class="mb-4 text-gray-600">AWBW staff keep your organizations up to date. Tell us what's different and we'll change it.</p>
      <% affiliations = @person.affiliations.select(&:organization).sort_by { |a| [ a.active? ? 0 : 1, a.organization.name.downcase ] } %>
      <% pending_affiliation_requests = @person.profile_change_requests.pending.where(field: "affiliation").index_by(&:affiliation_id) %>
      <div class="divide-y divide-gray-100">
        <% affiliations.group_by(&:organization).each do |organization, org_affiliations| %>
          <div class="py-4 first:pt-0">
            <p class="text-lg font-medium text-gray-900"><%= organization.name %></p>
            <div class="mt-2 space-y-3 border-l-2 border-gray-100 pl-4">
              <% org_affiliations.each do |affiliation| %>
                <% decorated = affiliation.decorate %>
                <% pending = pending_affiliation_requests[affiliation.id] %>
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                  <div class="min-w-0">
                    <p class="text-gray-800"><%= decorated.display_title %></p>
                    <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-gray-500"><%= decorated.status_badge %> <%= decorated.period_label %></p>
                  </div>
                  <div class="flex shrink-0 flex-col items-start gap-1 sm:items-end">
                    <%= link_to (pending ? edit_profile_change_request_path(pending, return_to: "details") : new_profile_change_request_path(person_id: @person, field: "affiliation", affiliation_id: affiliation.id, return_to: "details")),
                                target: "_blank", rel: "noopener", class: button_classes(:secondary_outline, size: :sm) do %>
                      <%= pending ? "See your request" : "Request a change" %> <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                    <% end %>
                    <% if pending %>
                      <span class="inline-flex items-center gap-1 text-sm text-amber-800"><i class="fa-solid fa-clock"></i> Change requested</span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <% if affiliations.empty? %>
        <p class="mb-4 text-gray-500 italic">No organizations yet.</p>
      <% end %>
      <%= link_to new_profile_change_request_path(person_id: @person, field: "affiliation", add: 1, return_to: "details"),
                  target: "_blank", rel: "noopener", class: button_classes(:secondary_outline, extra: "mt-4") do %>
        <i class="fa-solid fa-plus"></i> Add an organization <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
      <% end %>
    </div>
    <div id="sectors" class="<%= card_class %>">
      <h2 class="mb-1 font-display text-2xl text-gray-900">Sectors you work in</h2>
      <p class="mb-4 text-gray-600">Turn on every one that fits. Then tap the <i class="fa-solid fa-star text-amber-400"></i> star next to your main one.</p>
      <% items_by_sector = @person.sectorable_items.index_by(&:sector_id) %>
      <div class="grid grid-cols-1 gap-x-6 sm:grid-cols-2" data-controller="primary-tag" data-primary-tag-primary-class="bg-brand-cream">
        <% @sectors_collection.each_with_index do |(name, sector_id), index| %>
          <% existing = items_by_sector[sector_id] %>
          <%= f.fields_for :sectorable_items, existing || SectorableItem.new(sector_id: sector_id), child_index: index do |sector| %>
            <%= sector.hidden_field :sector_id %>
            <div class="rounded-lg border-b border-gray-100" data-primary-tag-target="chip">
              <%= render "people/switch_row", f: sector, attribute: :_destroy, label: name, on_text: nil,
                         checked: existing.present? && !existing.marked_for_destruction?, checked_value: "0", unchecked_value: "1",
                         leading: render("people/main_star", f: sector, kind: "sector"),
                         input_data: { primary_tag_target: "member", action: "primary-tag#selectMember" } %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
    <% if @age_ranges_collection.present? %>
      <div id="age-ranges" class="<%= card_class %>">
        <h2 class="mb-1 font-display text-2xl text-gray-900">Ages you work with</h2>
        <p class="mb-4 text-gray-600">Turn on every one that fits. Then tap the <i class="fa-solid fa-star text-amber-400"></i> star next to your main one.</p>
        <% items_by_category = @person.age_range_categorizable_items.index_by(&:category_id) %>
        <div class="grid grid-cols-1 gap-x-6 sm:grid-cols-2" data-controller="primary-tag" data-primary-tag-primary-class="bg-brand-cream">
          <% @age_ranges_collection.each_with_index do |(name, category_id), index| %>
            <% existing = items_by_category[category_id] %>
            <%= f.fields_for :age_range_categorizable_items, existing || CategorizableItem.new(category_id: category_id), child_index: index do |age| %>
              <%= age.hidden_field :category_id %>
              <div class="rounded-lg border-b border-gray-100" data-primary-tag-target="chip">
                <%= render "people/switch_row", f: age, attribute: :_destroy, label: name, on_text: nil,
                           checked: existing.present? && !existing.marked_for_destruction?, checked_value: "0", unchecked_value: "1",
                           leading: render("people/main_star", f: age, kind: "age range"),
                           input_data: { primary_tag_target: "member", action: "primary-tag#selectMember" } %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
    <% program_setting_types = (@person_categories_grouped || {}).reject { |type, _| type.name == AgeGroupTaggable::AGE_RANGE_CATEGORY_TYPE } %>
    <% if program_setting_types.present? %>
      <%= hidden_field_tag "person[category_ids][]", "" %>
      <%= hidden_field_tag "person[managed_category_type_ids][]", "" %>
      <% @managed_category_type_ids.each do |type_id| %>
        <%= hidden_field_tag "person[managed_category_type_ids][]", type_id %>
      <% end %>
      <% program_setting_types.each do |type, categories| %>
        <div class="<%= card_class %>">
          <h2 class="mb-1 font-display text-2xl text-gray-900"><%= type.display_label %></h2>
          <p class="mb-4 text-gray-600">Turn on every one that fits.</p>
          <div class="grid grid-cols-1 gap-x-6 sm:grid-cols-2">
            <% categories.each do |category| %>
              <div class="border-b border-gray-100">
                <%= render "people/switch_row", label: category.name, on_text: nil,
                           input: check_box_tag("person[category_ids][]", category.id, @selected_category_ids.include?(category.id),
                                                id: "person_category_ids_#{category.id}", class: "peer sr-only") %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
    <div id="professional-licenses" class="<%= card_class %>">
      <h2 class="mb-1 font-display text-2xl text-gray-900">Professional licenses</h2>
      <p class="mb-4 text-gray-600">Used for continuing education credit.</p>
      <div class="space-y-6">
        <% @person.professional_licenses.each_with_index do |license, index| %>
          <% if allowed_to?(:edit?, license) %>
            <%= f.simple_fields_for :professional_licenses, license, child_index: index do |lf| %>
              <%= render "people/details_license_fields", f: lf %>
            <% end %>
          <% else %>
            <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
              <p class="text-lg text-gray-800">
                <%= [ license.kind, license.number, license.issuing_state ].compact_blank.join(" · ") %>
                <% if license.expires_on %><span class="text-gray-600">· expires <%= license.expires_on.to_fs(:long) %></span><% end %>
              </p>
              <p class="mt-1 text-sm text-gray-600">This license has continuing education credits, so only AWBW staff can change it.</p>
            </div>
          <% end %>
        <% end %>
        <%= render "people/add_more_chain", f: f, association: :professional_licenses, fields_partial: "people/details_license_fields",
                   build: -> { ProfessionalLicense.new }, label: @person.professional_licenses.any? ? "Add another license" : "Add a license",
                   next_label: "Add another license" %>
      </div>
    </div>
    <div class="sticky bottom-0 z-10 -mx-4 flex items-center justify-end gap-3 border-t border-gray-200 bg-white/95 py-4 pr-20 pl-4 backdrop-blur sm:pr-4">
      <%= link_to "Cancel", person_path(@person), class: button_classes(:secondary_outline), data: { action: "click->dirty-form#confirmCancel" } %>
      <%= f.button :submit, "Save", class: button_classes(:primary, extra: "px-10 text-lg") %>
    </div>
  <% end %>
  <p class="mt-6 text-center text-lg text-gray-700">
    Can't change something here?
    <%= link_to "Ask AWBW staff to change it", new_profile_change_request_path(person_id: @person, field: ProfileChangeRequest::OTHER_FIELD),
                class: "font-medium text-blue-600 underline hover:text-blue-800" %>
  </p>
</div>

<%# locals: (f:, attribute:, label:, on_text: "Shown", off_text: "Hidden", checked: nil, checked_value: "1", unchecked_value: "0", badge: nil) %>
<label class="flex cursor-pointer items-center justify-between gap-4 rounded-lg px-3 py-3 select-none hover:bg-gray-50">
  <span class="flex min-w-0 items-center gap-2 text-lg text-gray-800"><%= label %><%= badge %></span>
  <span class="flex shrink-0 items-center gap-3">
    <%= f.check_box attribute, { checked: checked, class: "peer sr-only" }.compact, checked_value, unchecked_value %>
    <% if on_text %>
      <span class="w-14 text-right text-sm text-gray-400 peer-checked:hidden"><%= off_text %></span>
      <span class="hidden w-14 text-right text-sm font-medium text-green-700 peer-checked:inline"><%= on_text %></span>
    <% end %>
    <span class="relative h-7 w-12 rounded-full bg-gray-300 transition-colors peer-checked:bg-green-600 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-200 after:absolute after:top-0.5 after:left-0.5 after:h-6 after:w-6 after:rounded-full after:bg-white after:shadow after:transition-transform after:content-[''] peer-checked:after:translate-x-5"></span>
  </span>
</label>

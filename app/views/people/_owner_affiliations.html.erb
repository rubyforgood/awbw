<%# locals: (f:) %>
<% person = f.object %>
<% affiliations = person.affiliations.select(&:organization).sort_by { |a| a.organization.name.downcase } %>
<% active_affiliations, inactive_affiliations = affiliations.partition(&:active?) %>
<% pending_requests = person.profile_change_requests.pending.where(field: "affiliation").index_by(&:affiliation_id) %>
<% tab_base = "cursor-pointer select-none rounded-md px-3 py-1 text-gray-500 transition-colors hover:text-gray-700" %>
<div id="affiliations" class="form-group group/owneraff scroll-mt-4 rounded-lg border border-gray-200 bg-gray-50 p-4 shadow-sm">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <h3 class="font-semibold text-gray-700">Affiliations</h3>
    <% if affiliations.any? %>
      <nav class="inline-flex rounded-lg bg-gray-100 p-0.5 text-sm font-medium">
        <input type="radio" id="owner-aff-tab-active" name="owner_affiliation_tab" form="owner_affiliation_tab_none"
               checked class="peer/active sr-only">
        <input type="radio" id="owner-aff-tab-inactive" name="owner_affiliation_tab" form="owner_affiliation_tab_none"
               class="peer/inactive sr-only">
        <label for="owner-aff-tab-active"
               class="<%= tab_base %> peer-checked/active:bg-white peer-checked/active:text-gray-800 peer-checked/active:shadow-sm">
          Active <span class="text-gray-400"><%= active_affiliations.size %></span>
        </label>
        <label for="owner-aff-tab-inactive"
               class="<%= tab_base %> peer-checked/inactive:bg-white peer-checked/inactive:text-gray-800 peer-checked/inactive:shadow-sm">
          Inactive <span class="text-gray-400"><%= inactive_affiliations.size %></span>
        </label>
      </nav>
    <% end %>
  </div>
  <div class="group-has-[#owner-aff-tab-inactive:checked]/owneraff:hidden">
    <%= render "people/owner_affiliation_rows", person: person, affiliations: active_affiliations, pending_requests: pending_requests,
                                                empty_label: affiliations.any? ? "No active affiliations." : "No organizations yet." %>
  </div>
  <div class="hidden group-has-[#owner-aff-tab-inactive:checked]/owneraff:block">
    <%= render "people/owner_affiliation_rows", person: person, affiliations: inactive_affiliations, pending_requests: pending_requests,
                                                empty_label: "No inactive affiliations." %>
  </div>
  <%= link_to new_profile_change_request_path(person_id: person, field: "affiliation", add: 1),
              target: "_blank", rel: "noopener", class: button_classes(:secondary_outline, size: :sm, extra: "mt-3") do %>
    <i class="fa-solid fa-plus"></i> Add an organization <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
  <% end %>
</div>

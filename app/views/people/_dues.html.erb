<div class="admin-only bg-blue-100 border border-blue-200 rounded-lg shadow-sm">
  <div class="section-header flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-6 sm:px-7 py-3 border-b border-blue-200">
    <h2 class="text-xl font-semibold text-gray-800">Dues</h2>
    <%= link_to "All dues", dues_registrations_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <div class="section-content px-3 sm:px-4 py-4 space-y-6">
    <% if subscriptions.none? %>
      <p class="text-gray-500 italic px-3">No dues subscription yet.</p>
    <% end %>

    <% subscriptions.each do |subscription| %>
      <div class="px-3">
        <div class="flex flex-wrap gap-x-6 gap-y-1 mb-3 text-sm">
          <span class="text-gray-600">Rate: <span class="font-medium text-gray-800"><%= subscription.rate_label %></span></span>
          <span class="text-gray-600">Subscription: <span class="font-medium text-gray-800"><%= subscription.status_label %></span></span>
        </div>

        <% years = subscription.dues_registrations %>

        <% if years.empty? %>
          <p class="text-gray-500 italic">No dues years yet.</p>
        <% else %>
          <ul class="space-y-2">
            <% years.each do |year| %>
              <% term = year.decorate %>
              <% badge = term.status_badge %>
              <li class="bg-white border border-gray-200 rounded-lg px-3 py-2 flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
                <div>
                  <span class="block text-sm font-medium text-gray-800"><%= term.term_range %></span>
                  <span class="block text-xs text-gray-500">
                    <%= term.cost %> billed<% unless term.comped? %> &middot; <%= term.paid %> paid<% end %>
                  </span>
                </div>
                <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium <%= badge.classes %>">
                  <i class="<%= badge.icon %>"></i>
                  <%= badge.label %>
                </span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

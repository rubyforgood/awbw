<div class="user-only bg-amber-100 border border-amber-200 rounded-lg shadow-sm">
  <div class="section-header flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-6 sm:px-7 py-3 border-b border-amber-200">
    <h2 class="text-xl font-semibold text-gray-800">Annual dues</h2>
    <span class="text-sm text-amber-700 italic">Only visible to you</span>
  </div>

  <div class="section-content px-3 sm:px-4 py-4">
    <% if subscription&.current_year %>
      <ul class="mb-4">
        <%= render "dues_registrations/year_row", year: subscription.current_year %>
      </ul>
    <% end %>

    <div class="px-3">
      <% if autopay %>
        <p class="text-sm text-gray-700">Your annual dues renew automatically on the card you have on file.</p>
      <% else %>
        <p class="mb-3 text-sm text-gray-700">
          Set up annual dues to renew automatically each year at
          <%= dollars_from_cents(subscription&.cost_cents || Dues::ANNUAL_COST_CENTS) %>.
        </p>
        <%# Turbo can't follow the cross-origin redirect to Stripe Checkout. %>
        <%= button_to "Set up annual dues", dues_checkouts_path,
                      class: "btn btn-primary",
                      data: { turbo: false } %>
      <% end %>
    </div>
  </div>
</div>

<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="mx-auto max-w-lg">
  <%= link_to person_path(@person), class: "mb-3 inline-flex items-center gap-1 text-sm #{eyebrow_link_class} px-2 py-1" do %>
    <i class="fa-solid fa-arrow-left text-xs"></i>
    <%= person_name(@person) %>
  <% end %>

  <div class="border-primary/10 overflow-hidden rounded-2xl border bg-white shadow-sm">
    <%= render "people/recaps/content", recap: @recap %>
  </div>
</div>

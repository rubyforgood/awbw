<%# Admin hover card for a person chip: when they first affiliated, each active
    facilitator affiliation's org, org status, and dates, their latest
    facilitator trainings with attendance, then their membership status. One
    grid, so every status pill shares the left column's width. Shown by a
    `group/person` ancestor. Locals: person. Optional: header (name + email on
    top, for chips too small to show them). %>
<% person = person.decorate %>
<% affiliated_since = person.affiliated_since_date %>
<% facilitations = person.active_facilitator_affiliations %>
<% trainings = person.recent_facilitator_training_registrations %>
<% pill_cell = "flex self-start *:w-full *:justify-center" %>
<% heading = "col-span-2 mt-3 text-xs font-semibold tracking-wide text-gray-500 uppercase" %>
<% empty = "col-span-2 mt-1 text-gray-500" %>
<span class="absolute top-full left-0 z-20 mt-1 hidden w-88 grid-cols-[auto_1fr] gap-x-2 rounded-md border border-gray-200 bg-white p-3 text-left font-sans text-sm font-normal text-gray-700 shadow-lg group-focus-within/person:grid group-hover/person:grid">
  <% if local_assigns[:header] %>
    <span class="col-span-2 font-semibold text-gray-900"><%= person.full_name %></span>
    <span class="col-span-2 mb-2 text-xs text-gray-500"><!--email_off--><%= person.preferred_email %><!--email_on--></span>
  <% end %>
  <span class="col-span-2 text-gray-500">
    <%= affiliated_since ? "Affiliated since #{affiliated_since.strftime('%B %Y')}" : "No affiliation dates recorded" %>
  </span>
  <% if facilitations.any? %>
    <% facilitations.each do |affiliation| %>
      <% affiliation = affiliation.decorate %>
      <span class="<%= pill_cell %> mt-2"><%= affiliation.organization.decorate.organization_status_chip(admin: true) %></span>
      <span class="mt-1.5 min-w-0">
        <span class="block font-medium text-gray-900"><%= affiliation.organization.name %></span>
        <span class="block text-xs text-gray-500"><%= affiliation.period_note %></span>
      </span>
    <% end %>
  <% else %>
    <span class="<%= empty %> mt-1.5">No active facilitator affiliation</span>
  <% end %>
  <span class="<%= heading %>">Facilitator trainings</span>
  <% if trainings.any? %>
    <% trainings.each do |registration| %>
      <% registration = registration.decorate %>
      <span class="<%= pill_cell %> mt-2"><%= render "shared/badge", **registration.attendance_status_badge %></span>
      <%# An on-demand training spans its year, so the year stands in for a date range. %>
      <span class="mt-1.5 min-w-0 font-medium text-gray-900">
        <%= registration.event.on_demand? ? "On-demand #{registration.event.start_date&.in_time_zone&.year}" : registration.event.decorate.short_date_range %>
      </span>
    <% end %>
  <% else %>
    <span class="<%= empty %>">None</span>
  <% end %>
  <% if Membership.enabled? %>
    <% membership = person.latest_membership %>
    <% invoice = membership&.current_invoice&.decorate %>
    <span class="<%= heading %>">Membership</span>
    <% if membership %>
      <span class="<%= pill_cell %> mt-2"><% if invoice %><%= render "shared/badge", **invoice.status_badge.to_h %><% end %></span>
      <span class="mt-1.5 min-w-0">
        <span class="block font-medium text-gray-900"><%= membership.status_label %></span>
        <% if invoice %><span class="block text-xs text-gray-500"><%= invoice.period_range %></span><% end %>
      </span>
    <% else %>
      <span class="<%= empty %>">None</span>
    <% end %>
  <% end %>
</span>

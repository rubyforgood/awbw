<%# Admin hover card for a person chip: when they first affiliated, each active
    facilitator affiliation's org, org status, and dates, and their latest
    facilitator trainings with attendance, then their membership status. Shown
    by a `group/person` ancestor.
    Locals: person. Optional: header (name + email on top, for chips too small
    to show them). %>
<% person = person.decorate %>
<% affiliated_since = person.affiliated_since_date %>
<% facilitations = person.active_facilitator_affiliations %>
<% trainings = person.recent_facilitator_training_registrations %>
<span class="absolute top-full left-0 z-20 mt-1 hidden w-80 rounded-md border border-gray-200 bg-white p-3 text-left font-sans text-sm font-normal text-gray-700 shadow-lg group-focus-within/person:block group-hover/person:block">
  <% if local_assigns[:header] %>
    <span class="block font-semibold text-gray-900"><%= person.full_name %></span>
    <span class="mb-2 block text-xs text-gray-500"><!--email_off--><%= person.preferred_email %><!--email_on--></span>
  <% end %>
  <span class="block text-gray-500">
    <%= affiliated_since ? "Affiliated since #{affiliated_since.strftime('%B %Y')}" : "No affiliation dates recorded" %>
  </span>
  <% if facilitations.any? %>
    <% facilitations.each do |affiliation| %>
      <% affiliation = affiliation.decorate %>
      <span class="mt-1.5 block">
        <span class="flex flex-wrap items-center gap-1.5">
          <span class="font-medium text-gray-900"><%= affiliation.organization.name %></span>
          <%= affiliation.organization.decorate.organization_status_chip(admin: true) %>
        </span>
        <span class="block text-xs text-gray-500"><%= affiliation.period_note %></span>
      </span>
    <% end %>
  <% else %>
    <span class="mt-1.5 block text-gray-500">No active facilitator affiliation</span>
  <% end %>
  <span class="mt-3 block text-xs font-semibold tracking-wide text-gray-500 uppercase">Facilitator trainings</span>
  <% if trainings.any? %>
    <% trainings.each do |registration| %>
      <% registration = registration.decorate %>
      <span class="mt-1.5 block">
        <span class="flex flex-wrap items-center gap-1.5">
          <span class="font-medium text-gray-900"><%= registration.event.decorate.short_date_range %></span>
          <%= render "shared/badge", **registration.attendance_status_badge %>
        </span>
        <span class="block text-xs text-gray-500"><%= registration.event.title %></span>
      </span>
    <% end %>
  <% else %>
    <span class="mt-1 block text-gray-500">None</span>
  <% end %>
  <% if Membership.enabled? %>
    <% membership = person.latest_membership %>
    <% invoice = membership&.current_invoice&.decorate %>
    <span class="mt-3 block text-xs font-semibold tracking-wide text-gray-500 uppercase">Membership</span>
    <% if membership %>
      <span class="mt-1.5 block">
        <span class="flex flex-wrap items-center gap-1.5">
          <span class="font-medium text-gray-900"><%= membership.status_label %></span>
          <% if invoice %><%= render "shared/badge", **invoice.status_badge.to_h %><% end %>
        </span>
        <% if invoice %><span class="block text-xs text-gray-500"><%= invoice.period_range %></span><% end %>
      </span>
    <% else %>
      <span class="mt-1 block text-gray-500">None</span>
    <% end %>
  <% end %>
</span>

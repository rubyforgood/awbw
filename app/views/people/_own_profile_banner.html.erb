<%# locals: (person:) %>
<% pending_requests = person.profile_change_requests.pending.newest_first.includes(affiliation: :organization).decorate %>
<div id="own-profile" class="border-primary/10 mb-4 rounded-2xl border bg-white p-5 shadow-sm sm:p-6">
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div class="space-y-1 text-base text-gray-700">
      <h2 class="text-primary font-display text-2xl font-semibold">This is your profile</h2>
      <p>To update your details, click <strong>Edit my profile</strong>.</p>
      <p>AWBW staff keep your email and organizations up to date. Use the buttons below to ask us for a change, or for anything you can't change yourself.</p>
    </div>
    <%= link_to edit_person_path(person),
                  class: "text-primary inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-brand-yellow-400 px-6 py-3 text-lg font-semibold shadow-sm transition hover:bg-brand-yellow-500" do %>
      <i class="fa-solid fa-pen"></i> Edit my profile
    <% end %>
  </div>
  <div class="mt-4 flex flex-wrap gap-3">
    <%= link_to new_profile_change_request_path(person_id: person, field: "primary_email"), class: button_classes(:secondary_outline) do %>
      <i class="fa-solid fa-envelope"></i> Change my email
    <% end %>
    <%= link_to new_profile_change_request_path(person_id: person, field: "affiliation"), class: button_classes(:secondary_outline) do %>
      <i class="fa-solid fa-building"></i> Change my organizations
    <% end %>
    <%= link_to new_profile_change_request_path(person_id: person, field: ProfileChangeRequest::OTHER_FIELD), class: button_classes(:secondary_outline) do %>
      <i class="fa-solid fa-comment"></i> Ask for another change
    <% end %>
    <%= link_to visibility_person_path(person), class: button_classes(:secondary_outline) do %>
      <i class="fa-solid fa-eye-slash"></i> Choose what others see
    <% end %>
  </div>
  <% if pending_requests.any? %>
    <div class="mt-4 rounded-xl border border-amber-300 bg-amber-50 p-4 text-amber-900">
      <p class="font-semibold"><i class="fa-solid fa-clock"></i> AWBW staff are looking at your request</p>
      <ul class="mt-2 space-y-1">
        <% pending_requests.each do |request| %>
          <li>
            <%= request.requester_summary %> · sent <%= request.requested_on %>
            <%= link_to "See or change it", edit_profile_change_request_path(request), class: "ms-2 font-medium underline" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>

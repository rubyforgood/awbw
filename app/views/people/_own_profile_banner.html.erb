<%# locals: (person:, pending_requests:) %>
<div id="own-profile" class="border-primary/10 mb-4 rounded-2xl border bg-white p-5 shadow-sm sm:p-6">
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div class="space-y-1 text-base text-gray-700">
      <h2 class="text-primary font-display text-2xl font-semibold">This is your profile</h2>
      <p>To update your details, click <strong>Edit my data</strong>.</p>
    </div>
    <%= link_to edit_person_path(person),
                  class: "text-primary inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-brand-yellow-400 px-6 py-3 text-lg font-semibold shadow-sm transition hover:bg-brand-yellow-500" do %>
      <i class="fa-solid fa-pen"></i> Edit my data
    <% end %>
  </div>
  <% if pending_requests.any? %>
    <div class="border-primary/10 bg-brand-cream mt-4 rounded-xl border p-4 text-gray-800">
      <p class="text-primary font-semibold"><i class="fa-solid fa-clock"></i> AWBW staff are reviewing your <%= "update".pluralize(pending_requests.size) %></p>
      <ul class="mt-2 space-y-2">
        <% pending_requests.each do |request| %>
          <li>
            <%= request.requester_summary %> · submitted <%= request.requested_on %>
            <%= link_to "View or edit", edit_profile_change_request_path(request), class: "ms-2 font-semibold underline" %>
            <% if request.field == "primary_email" %>
              <p class="text-sm text-gray-600">Your current email stays active until we confirm the change.</p>
            <% end %>
          </li>
        <% end %>
      </ul>
      <p class="mt-2 text-sm text-gray-600">We'll confirm within 2–3 business days.</p>
    </div>
  <% end %>
</div>

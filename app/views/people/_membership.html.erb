<%# Collapses to the membership's status and cost, like the other form sections.
    Read-only — memberships are managed on their own page, linked from inside. %>
<% summary = membership.blank? ? "No membership yet." : "#{membership.status_label} · #{membership.cost_label}" %>
<details class="admin-only group rounded-lg border border-blue-200 bg-blue-100 shadow-sm">
  <summary class="section-header flex cursor-pointer list-none items-center gap-3 px-6 py-3 sm:px-7 [&::-webkit-details-marker]:hidden">
    <h2 class="text-sm font-semibold text-gray-700">Membership</h2>
    <span class="text-sm text-gray-600"><%= summary %></span>
    <i class="fa-solid fa-chevron-down ml-auto text-xs text-gray-400 transition-transform group-open:rotate-180"></i>
  </summary>

  <div class="section-content border-t border-blue-200 px-3 py-4 sm:px-4">
    <div class="mb-3 flex justify-end px-3">
      <%= link_to "Manage membership", person_memberships_path(person), class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
    </div>

    <% if membership.blank? %>
      <p class="px-3 text-gray-500 italic">No membership yet.</p>
    <% else %>
      <div class="px-3">
        <div class="mb-3 flex flex-wrap gap-x-6 gap-y-1 text-sm">
          <span class="text-gray-600">Cost: <span class="font-medium text-gray-800"><%= membership.cost_label %></span></span>
          <span class="text-gray-600">Status: <span class="font-medium text-gray-800"><%= membership.status_label %></span></span>
        </div>

        <% if membership.current_invoice.blank? %>
          <p class="text-gray-500 italic">No membership invoices yet.</p>
        <% else %>
          <ul>
            <%= render "membership_invoices/invoice_row", invoice: membership.current_invoice %>
          </ul>
        <% end %>
      </div>
    <% end %>
  </div>
</details>

<% email = person.profile_email %>
<% email_type = person.email_type.presence || person.user&.email_type %>
<span class="inline-flex items-center gap-1.5 rounded-full border border-black/5 bg-white px-3 py-1 text-gray-700">
  <i class="fa-solid fa-envelope text-xs <%= DomainTheme.text_class_for(:people, intensity: 600) %>"></i> <!--email_off--><%= mail_to email, email, class: "hover:text-primary" %><!--email_on--><% if email_type.present? %> <span class="text-2xs text-gray-500 uppercase">(<%= email_type %>)</span><% end %><% if person.profile_email_login? && allowed_to?(:manage?, Person) %> <span class="admin-only text-2xs rounded-full bg-blue-100 px-1.5 text-blue-700 uppercase" title="Login email (admin only)">user account</span><% end %>
</span>

<div class="user-only bg-amber-100 border border-amber-200 rounded-lg shadow-sm">
  <div class="section-header flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-6 sm:px-7 py-3 border-b border-amber-200">
    <h2 class="text-xl font-semibold text-gray-800">Annual membership</h2>
    <span class="text-sm text-amber-700 italic">Only visible to you</span>
  </div>

  <div class="section-content px-3 sm:px-4 py-4">
    <% if membership&.good_through %>
      <p class="mb-3 px-3 text-sm text-gray-700">
        Membership good through:
        <span class="font-medium"><%= membership.good_through.strftime("%b %-d, %Y") %></span>
      </p>
    <% end %>

    <% if membership&.current_invoice %>
      <ul class="mb-4">
        <%= render "membership_invoices/invoice_row", invoice: membership.current_invoice %>
      </ul>
    <% end %>

    <div class="px-3">
      <% if membership&.cancelled? %>
        <p class="mb-3 text-sm text-gray-700">
          Your membership is set to expire. Please contact us if this is not correct.
        </p>
      <% elsif autopay_cancelling %>
        <p class="mb-3 text-sm text-gray-700">
          Your automatic payment for membership is set to stop renewing at the end of the current billing cycle.
          You can change this or update your card below.
        </p>
        <%# Turbo can't follow the cross-origin redirect to the Stripe billing portal. %>
        <%= button_to "Manage autopay", membership_billing_portals_path,
                      class: button_classes(:secondary_outline, size: :sm),
                      data: { turbo: false } %>
      <% elsif autopay %>
        <p class="mb-3 text-sm text-gray-700">Your membership renews automatically on the card you have on file.</p>
        <%# Turbo can't follow the cross-origin redirect to the Stripe billing portal. %>
        <%= button_to "Manage autopay", membership_billing_portals_path,
                      class: button_classes(:secondary_outline, size: :sm),
                      data: { turbo: false } %>
      <% else %>
        <p class="mb-3 text-sm text-gray-700">
          Set up your membership to renew automatically each year at
          <%= dollars_from_cents(membership&.cost_cents || Membership::ANNUAL_COST_CENTS) %>.
        </p>
        <%# Turbo can't follow the cross-origin redirect to Stripe Checkout. %>
        <%= button_to "Set up annual membership", membership_checkouts_path,
                      class: button_classes(:primary),
                      data: { turbo: false } %>
      <% end %>
    </div>
  </div>
</div>

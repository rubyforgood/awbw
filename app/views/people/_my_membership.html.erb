<div class="user-only rounded-lg border border-amber-200 bg-amber-100 shadow-sm">
  <div class="section-header flex flex-col justify-between gap-2 border-b border-amber-200 px-6 py-3 sm:flex-row sm:items-center sm:px-7">
    <div class="flex items-center gap-2">
      <h2 class="text-xl font-semibold text-gray-800">Annual membership</h2>
      <%= render "memberships/status_badge", membership: membership %>
    </div>

    <span class="text-sm text-amber-700 italic">Only visible to you</span>
  </div>

  <div class="section-content px-3 py-4 sm:px-4">
    <% if membership&.end_date %>
      <p class="mb-3 px-3 text-sm text-gray-700"><%= membership.coverage_label %> <span class="font-medium"><%= membership.end_date.strftime("%b %-d, %Y") %></span></p>
    <% end %>

    <% if membership&.current_invoice&.outstanding_started? %>
      <ul class="mb-4"><%= render "membership_invoices/invoice_row", invoice: membership.current_invoice %></ul>
    <% end %>

    <div class="px-3">
      <% if membership&.active? && membership&.autorenewal_cancelled? %>
        <p class="mb-3 text-sm text-gray-700">Contact us to renew your membership.</p>
      <% elsif autopay_cancelling %>
        <p class="mb-3 text-sm text-gray-700">
          Your automatic payment for membership is set to stop renewing at the end of the current billing cycle. You can change this or update your card below.
        </p>
        <%= button_to "Manage autopay", membership_billing_portals_path,
                      class: button_classes(:secondary_outline, size: :sm),
                      data: { turbo: false } %>
      <% elsif autopay %>
        <p class="mb-3 text-sm text-gray-700">Your membership renews automatically with the card you have on file.</p>
        <%= button_to "Manage autopay", membership_billing_portals_path,
                      class: button_classes(:secondary_outline, size: :sm),
                      data: { turbo: false } %>
      <% elsif membership&.current_invoice&.outstanding_started? %>
        <p class="mb-3 text-sm text-gray-700">Pay for the current membership year.</p>
        <%= button_to "Pay for current membership fee", membership_checkouts_path,
                      class: button_classes(:primary),
                      data: { turbo: false } %>
      <% elsif membership&.ended? %>
        <p class="mb-3 text-sm text-gray-700">Contact us to rejoin your membership.</p>
      <% else %>
        <p class="mb-3 text-sm text-gray-700">Set up your membership to renew automatically each year at <%= dollars_from_cents(membership&.cost_cents || Membership::ANNUAL_COST_CENTS) %>.</p>
        <%= button_to "Set up automatic renewal", membership_checkouts_path,
                      class: button_classes(:primary),
                      data: { turbo: false } %>
      <% end %>
    </div>
  </div>
</div>

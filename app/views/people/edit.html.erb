<% content_for(:page_bg_class, "admin-or-owner") %>
<div class="<%= DomainTheme.bg_class_for(:people) %> rounded-xl border border-gray-200 p-6 shadow">
        <div class="sticky top-0 z-10 <%= DomainTheme.bg_class_for(:people) %> pb-3">
          <% if params[:return_to] == "onboarding" && params[:event_id].present? %>
            <div class="mb-2">
              <%= link_to onboarding_event_row_path(params[:event_id], params[:highlight]), class: "text-sm #{eyebrow_link_class} px-2 py-1" do %>
                <i class="fa-solid fa-arrow-left text-xs"></i> Onboarding
              <% end %>
            </div>
          <% elsif params[:return_to] == "form_submission" && params[:form_submission_id].present? %>
            <div class="mb-2">
              <%= link_to form_submission_path(params[:form_submission_id]), class: "text-sm #{eyebrow_link_class}" do %>
                <i class="fa-solid fa-arrow-left text-xs"></i> Form submission
              <% end %>
            </div>
          <% elsif params[:return_to] == "registration_link" && params[:event_registration_id].present? %>
            <div class="mb-2">
              <%= link_to link_organization_event_registration_path(params[:event_registration_id], return_to: params[:link_org_return_to].presence), class: "text-sm #{eyebrow_link_class} px-2 py-1" do %>
                <i class="fa-solid fa-arrow-left text-xs"></i> Organization linking
              <% end %>
            </div>
          <% end %>
          <div class="mb-4 flex flex-wrap justify-end gap-2">
            <% unless @person.user %>
              <div class="admin-only bg-blue-100 p-2">
                No user!
                <%= link_to "Create user",
                            new_user_path(person_id: @person.id),
                            class: "btn btn-warning px-2 py-1" %>
              </div>
            <% end %>
            <% if @person.user %>
              <%= link_to "User account", edit_user_path(@person.user), class: "admin-only bg-blue-100 text-sm #{eyebrow_link_class} px-2 py-1" %>
            <% end %>
            <%= link_to "Change password", change_password_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
            <%= link_to "Home", root_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
            <%= link_to "People", people_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
            <%= link_to "Profile", person_path(@person), class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
          </div>
          <h1 class="text-3xl font-semibold tracking-tight text-gray-900">
            Edit Person: <%= truncate(@person.name, length: 30) %>
          </h1>
        </div>
        <div class="space-y-6">
          <div class="mt-4 rounded bg-white p-6">
            <%= render "form" %>
            <%= render "shared/audit_info", resource: @person %>
          </div>
          <div class="rounded bg-white p-6">
            <div class="mb-2 font-semibold text-gray-700">
              Associated records
            </div>
            <div class="rounded-lg border border-gray-200 bg-gray-50 p-4 shadow-sm">
              <%= render "associated_records", person: @person %>
            </div>
          </div>
        </div>
</div>

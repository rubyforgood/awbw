<div class="min-h-screen py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="admin-only bg-blue-100 p-6">
      <div class="<%= DomainTheme.bg_class_for(:people) %>
          border border-gray-200 rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 p-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
          <h1 class="text-3xl font-semibold text-gray-900 tracking-tight">
            Edit <%= @person.class.model_name.human %>
          </h1>
          <div class="flex flex-wrap gap-2">
            <% if allowed_to?(:edit?, @person) %>
              <%= link_to "Change password",
                          change_password_path,
                          class: "btn btn-secondary-outline" %>
            <% end %>
            <% if @person.user %>
              <%= link_to "User account",
                          edit_user_path(@person.user),
                          class: "admin-only bg-blue-100 btn btn-secondary-outline" %>
            <% else %>
              <%= link_to "Create user account",
                          new_user_path(person_id: @person.id),
                          class: "admin-only bg-blue-100 btn btn-secondary-outline" %>
            <% end %>
            <%= link_to "Profile",
                        person_path(@person),
                        class: "btn btn-secondary-outline" %>
          </div>
        </div>
        <div class="space-y-6">
          <div class="bg-white rounded mt-4 p-6">
            <%= render "form" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

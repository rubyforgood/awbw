<% scoped_organization = Organization.find_by(id: params[:organization_id]) if params[:organization_id].present? %>
<%= render "shared/filtered_to", record: scoped_organization,
      clear_path: people_path(request.query_parameters.except("organization_id")) %>
<%= form_tag(people_path, method: :get,
  data: { controller: "collection searchable-checkbox", turbo_frame: "people_results" },
  autocomplete: "off",
  class: "space-y-4") do |f| %>
  <%= hidden_field_tag "organization_id", params[:organization_id] if params[:organization_id].present? %>
  <div class="flex flex-col gap-4 md:flex-row md:flex-wrap md:items-end">
    <!-- Name or email -->
    <%= render "shared/filter_text", param: :name_email, label: "Name or email", submit: true,
          wrapper_class: "w-full md:flex-1" %>

    <!-- Organization name -->
    <%= render "shared/filter_text", param: :organization_name, label: "Organization", submit: true,
          wrapper_class: "w-full md:flex-1" %>

    <!-- Sector -->
    <%= render "shared/filter_multiselect", param: :sector_ids, label: "Sector",
          options: Sector.published.excluding_other.order(:name).map { |s| [ s.name, s.id ] },
          selected: Array(params[:sector_ids]).map(&:to_i), placeholder: "Any sector",
          wrapper_class: "w-full md:flex-1" %>

    <!-- Age range -->
    <%= render "shared/filter_multiselect", param: :age_range_ids, label: "Age range",
          options: Category.age_ranges.published.ordered_by_position_and_name.map { |c| [ c.decorate.age_group_label, c.id ] },
          selected: Array(params[:age_range_ids]).map(&:to_i), placeholder: "Any age range",
          wrapper_class: "w-full md:flex-1" %>

    <!-- Clear filters -->
    <div class="w-full md:ml-auto md:w-auto">
      <%= render "shared/search_clear", url: people_path %>
    </div>
  </div>

  <% if allowed_to?(:manage?, Person) %>
    <div class="mb-6 rounded-xl border border-blue-200 bg-blue-100 p-4">
      <p class="mb-3 text-xs font-semibold tracking-wide text-blue-800 uppercase">Admin-only filters</p>
      <div class="grid grid-cols-1 items-start gap-4 sm:grid-cols-2 lg:grid-cols-6">
        <!-- Role -->
        <%= render "shared/filter_select", param: :role, label: "Role",
              options: Person::ROLE_FILTER_OPTIONS, selected: params[:role],
              blank: "All people", field_class: search_field_class,
              wrapper_class: "w-full" %>

        <!-- Facilitator status -->
        <%= render "shared/filter_select", param: :facilitator_status, label: "Facilitator status",
              options: Person::FACILITATOR_STATUS_FILTER_OPTIONS, selected: params[:facilitator_status],
              blank: "Any status", field_class: search_field_class,
              wrapper_class: "w-full" %>

        <!-- Membership status -->
        <%= render "shared/filter_select", param: :membership_status, label: "Membership status",
              options: Person::MEMBERSHIP_STATUS_FILTER_OPTIONS, selected: params[:membership_status],
              blank: "Any status", field_class: search_field_class,
              wrapper_class: "w-full" %>

        <!-- Staff tag -->
        <% if allowed_to?(:index?, StaffTag) %>
          <%= render "shared/filter_multiselect", param: :staff_tag_ids, label: "Staff tag",
                options: StaffTag.published.ordered.map { |t| [ t.name, t.id ] },
                selected: Array(params[:staff_tag_ids]).map(&:to_i), placeholder: "Any",
                wrapper_class: "w-full",
                hint: link_to("Manage staff tags", staff_tags_path, class: eyebrow_link_class, target: "_blank", rel: "noopener") %>
        <% end %>

        <!-- Topic subscription -->
        <%= render "shared/filter_multiselect", param: :topic_subscription_type_id, label: "Topic subscription",
              options: TopicSubscriptionType.active.ordered.pluck(:name, :id),
              selected: Array(params[:topic_subscription_type_id]).map(&:to_i), placeholder: "Any topic",
              wrapper_class: "w-full",
              hint: link_to("Manage topics", topic_subscription_types_path, class: eyebrow_link_class, target: "_blank", rel: "noopener") %>

        <!-- Contact info (admin only) -->
        <%= render "shared/filter_text", param: :contact_info, label: "Contact info", submit: true,
              wrapper_class: "w-full",
              tooltip: "Searches phone, address, city, state, and ZIP." %>
      </div>
    </div>
  <% end %>
<% end %>

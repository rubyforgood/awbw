<%# Profile pieces the person turned off, shown only to them and admins. %>
<% pieces = person.hidden_profile_pieces %>
<% return if pieces.empty? %>
<% contact_pieces = pieces & %i[profile_show_credentials profile_show_pronouns profile_show_member_since profile_show_email profile_show_phone profile_show_social_media] %>
<% chip_class = "inline-flex items-center gap-1.5 rounded-full border border-black/5 bg-gray-50 px-3 py-1 text-gray-700" %>
<div id="hidden_from_public"
     class="admin-or-owner border-2 bg-white <%= DomainTheme.border_class_for(:user_only) %> overflow-hidden rounded-2xl shadow-sm"
     data-controller="expandable-card"
     data-expandable-card-expanded-value="false">
  <!-- Header -->
  <button type="button" data-action="expandable-card#toggle"
          aria-expanded="false"
          class="section-header flex w-full items-center gap-3 border-b px-5 py-4 text-left sm:px-6 <%= DomainTheme.border_class_for(:user_only, intensity: 200) %>">
    <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full <%= DomainTheme.bg_class_for(:user_only, intensity: 100) %> <%= DomainTheme.text_class_for(:user_only, intensity: 700) %>">
      <i class="fa-solid fa-eye-slash"></i>
    </span>
    <h2 class="font-display text-2xl text-gray-900">Hidden from public</h2>
    <span class="ml-auto flex items-center gap-3">
      <span class="text-sm <%= DomainTheme.text_class_for(:user_only, intensity: 700) %> italic">
        <%= current_user&.person_id == person.id ? "Only visible to you and admins" : "Only visible to this person and admins" %>
      </span>
      <i class="fa-solid fa-chevron-down text-gray-400 transition-transform" data-expandable-card-target="icon"></i>
    </span>
  </button>
  <!-- Hidden content -->
  <div class="section-content hidden space-y-8 px-4 py-5 sm:space-y-10 sm:px-6 sm:py-6"
       data-expandable-card-target="body">
    <% if allowed_to?(:edit?, person) %>
      <p class="text-sm text-gray-600">
        These are turned off in the profile's sharing settings.
        <%= link_to "Change sharing settings", edit_person_path(person), class: "font-medium underline hover:text-primary" %>
      </p>
    <% end %>
    <% if contact_pieces.any? %>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
        <% if contact_pieces.include?(:profile_show_credentials) %>
          <span class="<%= chip_class %>">Credentials: <%= person.license_credentials %></span>
        <% end %>
        <% if contact_pieces.include?(:profile_show_pronouns) %>
          <span class="<%= chip_class %>">Pronouns: <%= person.pronouns %></span>
        <% end %>
        <% if contact_pieces.include?(:profile_show_member_since) %>
          <span class="<%= chip_class %>"><%= render "people/profile_pieces/member_since", person: person %></span>
        <% end %>
        <% if contact_pieces.include?(:profile_show_email) %>
          <%= render "people/profile_pieces/email_chip", person: person %>
        <% end %>
        <% if contact_pieces.include?(:profile_show_phone) %>
          <%= render "people/profile_pieces/phone_chip", person: person %>
        <% end %>
        <% if contact_pieces.include?(:profile_show_social_media) %>
          <%= render "people/social_media_buttons", person: person %>
        <% end %>
      </div>
    <% end %>
    <% if pieces.include?(:profile_show_affiliations) %>
      <%= render "people/profile_pieces/section", person: person, section: :affiliations %>
    <% end %>
    <% if pieces.include?(:profile_show_sectors) %>
      <div>
        <h3 class="mb-3 font-display text-xl text-gray-900">Sectors</h3>
        <%= render "people/profile_pieces/sectors", person: person %>
      </div>
    <% end %>
    <% if pieces.include?(:profile_show_age_ranges) %>
      <div>
        <h3 class="mb-3 font-display text-xl text-gray-900">Age ranges</h3>
        <%= render "shared/age_group_tags", primary: person.primary_age_groups.to_a, additional: person.additional_age_groups.to_a, compact: true %>
      </div>
    <% end %>
    <% if pieces.include?(:profile_show_bio) %>
      <div>
        <h3 class="mb-3 font-display text-xl text-gray-900">Bio</h3>
        <%= render "people/profile_pieces/bio", person: person %>
      </div>
    <% end %>
    <% %i[workshops workshop_variations stories resources].each do |section| %>
      <% if pieces.include?(:"profile_show_#{section}") %>
        <%= render "people/profile_pieces/section", person: person, section: section %>
      <% end %>
    <% end %>
    <% if pieces.include?(:profile_show_events_registered) %>
      <%= render "people/profile_pieces/section", person: person, section: :events %>
    <% end %>
  </div>
</div>

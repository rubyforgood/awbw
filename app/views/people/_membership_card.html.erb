<div class="overflow-hidden rounded-2xl border-2 shadow-sm <%= profile_hidden_wash_class %>"
     data-controller="expandable-card"
     data-expandable-card-expanded-value="true">
  <!-- Header -->
  <button type="button" data-action="expandable-card#toggle"
          aria-expanded="true"
          class="section-header flex w-full items-center gap-3 border-b px-5 py-4 text-left sm:px-6 <%= profile_hidden_border_class %>">
    <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-white <%= profile_hidden_icon_class %>">
      <i class="fa-solid fa-id-card"></i>
    </span>
    <h2 class="font-display text-2xl text-gray-900">Annual membership</h2>
    <span class="ml-auto flex items-center gap-3">
      <%= render "memberships/status_badge", membership: membership %>
      <span class="text-sm italic <%= profile_hidden_text_class %>"><%= owner_and_admins_label(person) %></span>
      <i class="fa-solid fa-chevron-down rotate-180 text-gray-400 transition-transform" data-expandable-card-target="icon"></i>
    </span>
  </button>
  <!-- Membership -->
  <div class="section-content space-y-4 px-4 py-5 sm:px-6 sm:py-6"
       data-expandable-card-target="body">
    <% if membership&.end_date %>
      <p class="text-sm text-gray-700"><%= membership.coverage_label %> <span class="font-medium"><%= membership.end_date.strftime("%b %-d, %Y") %></span></p>
    <% end %>

    <% invoices_due = local_assigns[:invoices_due] %>
    <% if invoices_due&.any? %>
      <div class="space-y-2">
        <% invoices_due.each do |invoice| %>
          <div class="flex flex-wrap items-center gap-2">
            <ul class="flex-1"><%= render "membership_invoices/invoice_row", invoice: invoice %></ul>
            <% if allowed_to?(:pay?, invoice) && !invoice.upcoming? %>
              <%# Turbo can't follow the cross-origin redirect to Stripe Checkout. %>
              <%= button_to "Pay", memberships_invoice_checkouts_path, params: { invoice_id: invoice.id },
                            class: button_classes(:primary, size: :sm),
                            data: { turbo: false } %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if allowed_to?(:manage_subscription?, membership) %>
      <div>
        <% if autopay_cancelling %>
          <p class="mb-3 text-sm text-gray-700">
            Your automatic payment for membership is set to stop renewing at the end of the current billing cycle. You can change this or update your card below.
          </p>
          <%= button_to "Manage autopay", memberships_billing_portals_path,
                        class: button_classes(:secondary_outline, size: :sm),
                        data: { turbo: false } %>
        <% elsif autopay %>
          <p class="mb-3 text-sm text-gray-700">Your membership renews automatically with the card you have on file.</p>
          <%= button_to "Manage autopay", memberships_billing_portals_path,
                        class: button_classes(:secondary_outline, size: :sm),
                        data: { turbo: false } %>
        <% elsif membership&.ended? %>
          <p class="text-sm text-gray-700">Contact us to rejoin your membership.</p>
        <% elsif membership&.autorenewal_cancelled? %>
          <p class="text-sm text-gray-700">Contact us to renew your membership.</p>
        <% else %>
          <p class="mb-3 text-sm text-gray-700">Set up your membership to renew automatically each year at <%= dollars_from_cents(membership&.cost_cents || Membership.annual_cost_cents) %>.</p>
          <%# Turbo can't follow the cross-origin redirect to Stripe Checkout. %>
          <%= button_to "Set up automatic renewal", memberships_subscription_checkouts_path,
                        class: button_classes(:primary),
                        data: { turbo: false } %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="overflow-hidden rounded-2xl border-2 shadow-sm <%= profile_hidden_wash_class %>"
     data-controller="expandable-card"
     data-expandable-card-expanded-value="true">
  <button type="button" data-action="expandable-card#toggle"
          aria-expanded="true"
          class="section-header flex w-full items-center gap-3 border-b px-5 py-4 text-left sm:px-6 <%= profile_hidden_border_class %>">
    <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-white <%= profile_hidden_icon_class %>">
      <i class="fa-solid fa-id-card"></i>
    </span>
    <h2 class="font-display text-2xl text-gray-900">Annual membership</h2>
    <span class="ml-auto flex items-center gap-3">
      <%= render "memberships/status_badge", membership: membership %>
      <span class="text-sm italic <%= profile_hidden_text_class %>"><%= owner_and_admins_label(person) %></span>
      <i class="fa-solid fa-chevron-down rotate-180 text-gray-400 transition-transform" data-expandable-card-target="icon"></i>
    </span>
  </button>

  <div class="section-content space-y-5 px-4 py-5 sm:px-6 sm:py-6"
       data-expandable-card-target="body">
    <% coverage_date = membership.coverage_date %>
    <% if coverage_date %>
      <p class="text-sm text-gray-700"><%= membership.coverage_label %> <span class="font-medium"><%= coverage_date.strftime("%b %-d, %Y") %></span></p>
    <% end %>

    <div class="flex flex-wrap items-center gap-2">
      <%= render "shared/badge", label: membership.payment_label, classes: membership.payment_classes,
            title: membership.payment_tooltip %>
      <%= render "shared/badge", label: "Autopay: #{membership.autopay_label(has_card: has_card)}",
            classes: membership.autopay_classes(has_card: has_card),
            title: membership.autopay_tooltip(has_card: has_card) %>
      <% if membership.autorenewal_cancelled? %>
        <%= render "shared/badge", label: "Renewal off", classes: "bg-amber-50 text-amber-700 border-amber-200",
              title: membership.renewal_tooltip %>
      <% end %>
    </div>

    <% card_label = card&.last4.present? ? "#{card.brand.to_s.titleize.presence || 'Card'} ending #{card.last4}" : nil %>
    <% turn_off_tooltip = "Stops automatic charges. Renewal and already-issued invoices are unchanged." %>
    <% manage_card_tooltip = "Opens Stripe to update the saved card." %>
    <% add_card_tooltip = "Opens Stripe to save a card. Automatic payments stay on." %>
    <% turn_on_tooltip = "Charges future issued invoices automatically. Membership renewal is separate." %>
    <% add_and_turn_on_tooltip = "Saves a card and turns on automatic payments. Membership renewal is unchanged." %>

    <% if invoices&.any? %>
      <div class="space-y-2">
        <% invoices.each do |invoice| %>
          <div class="flex flex-wrap items-center gap-2">
            <ul class="flex-1"><%= render "membership_invoices/invoice_row", invoice: invoice, viewable: true %></ul>
            <% if invoice.upcoming? %>
              <span class="text-xs text-gray-500">Scheduled for <%= invoice.start_date.strftime("%b %-d, %Y") %></span>
            <% elsif allowed_to?(:pay?, invoice) %>
              <%= button_to "Pay now", membership_invoice_checkout_path(invoice),
                    class: button_classes(:primary, size: :sm),
                    title: "Pays this invoice once. The card is not saved for automatic payments.",
                    data: { turbo: false } %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if allowed_to?(:manage_subscription?, membership) %>
      <div class="space-y-3">
        <% if membership.ended? %>
          <p class="text-sm text-gray-700">Your membership has ended. <%= link_to "Contact us", contact_us_path, class: "text-primary underline hover:no-underline" %> to rejoin.</p>
        <% else %>
          <% if membership.autorenewal_cancelled? %>
            <p class="text-sm text-gray-700">
              Renewal is off, so your membership ends <%= membership.end_date ? membership.end_date.strftime("%b %-d, %Y") : "at the end of its term" %>.
              <%= link_to "Contact us", contact_us_path, class: "text-primary underline hover:no-underline" %> to renew.
            </p>
          <% end %>

          <div class="space-y-2">
            <p class="text-xs font-semibold tracking-wide text-gray-600 uppercase">
              Automatic payments
              <i class="fa-solid fa-circle-info ml-0.5 cursor-help text-[0.65rem] text-gray-400"
                 title="Autopay charges issued invoices automatically. It is separate from membership renewal."></i>
            </p>

            <% if card_label.present? %>
              <p class="text-xs text-gray-500" title="The default card used for automatic payments.">Card on file: <%= card_label %></p>
            <% end %>

            <% if membership.autorenewal_cancelled? %>
              <% if autopay && has_card %>
                <p class="text-sm text-gray-700">Automatic payments are on for any invoice already issued.</p>
                <div class="flex flex-wrap items-center gap-2">
                  <%= button_to "Turn off automatic payments", person_autopay_path(person, autopay_on: "0"),
                        method: :patch, class: button_classes(:secondary_outline, size: :sm),
                        title: turn_off_tooltip,
                        data: { turbo_confirm: "Turn off automatic payments for invoices already issued?" } %>
                </div>
              <% elsif autopay %>
                <p class="text-sm text-gray-700">Automatic payments are marked on, but no card is on file. Existing invoices will need to be paid manually.</p>
                <div class="flex flex-wrap items-center gap-2">
                  <%= button_to "Turn off automatic payments", person_autopay_path(person, autopay_on: "0"),
                        method: :patch, class: button_classes(:secondary_outline, size: :sm),
                        title: turn_off_tooltip %>
                </div>
              <% else %>
                <p class="text-sm text-gray-700">Automatic payments are off. Any invoice already issued will need to be paid manually.</p>
              <% end %>
            <% elsif autopay && has_card %>
              <p class="text-sm text-gray-700">Automatic payments are on. We'll charge your saved card when an invoice is due.</p>
              <div class="flex flex-wrap items-center gap-2">
                <%= button_to "Manage card", person_billing_portal_path(person),
                      class: button_classes(:secondary_outline, size: :sm),
                      title: manage_card_tooltip, data: { turbo: false } %>
                <%= button_to "Turn off automatic payments", person_autopay_path(person, autopay_on: "0"),
                      method: :patch, class: button_classes(:secondary_outline, size: :sm),
                      title: turn_off_tooltip,
                      data: { turbo_confirm: "Turn off automatic card payments? Your membership will still renew, and you'll receive invoices to pay manually." } %>
              </div>
            <% elsif autopay %>
              <p class="text-sm text-gray-700">Automatic payments need a card. Add a card to keep them working.</p>
              <div class="flex flex-wrap items-center gap-2">
                <%= button_to "Add a card", person_autopay_setup_path(person),
                      class: button_classes(:primary, size: :sm),
                      title: add_card_tooltip, data: { turbo: false } %>
                <%= button_to "Turn off automatic payments", person_autopay_path(person, autopay_on: "0"),
                      method: :patch, class: button_classes(:secondary_outline, size: :sm),
                      title: turn_off_tooltip %>
              </div>
            <% elsif has_card %>
              <p class="text-sm text-gray-700">Automatic payments are off. You'll pay each invoice manually.</p>
              <div class="flex flex-wrap items-center gap-2">
                <%= button_to "Turn on automatic payments", person_autopay_path(person, autopay_on: "1"),
                      method: :patch, class: button_classes(:primary, size: :sm),
                      title: turn_on_tooltip %>
                <%= button_to "Manage card", person_billing_portal_path(person),
                      class: button_classes(:secondary_outline, size: :sm),
                      title: manage_card_tooltip, data: { turbo: false } %>
              </div>
            <% else %>
              <p class="text-sm text-gray-700">Automatic payments are off. You'll pay each invoice manually.</p>
              <div class="flex flex-wrap items-center gap-2">
                <%= button_to "Add a card & turn on automatic payments", person_autopay_setup_path(person),
                      class: button_classes(:primary, size: :sm),
                      title: add_and_turn_on_tooltip, data: { turbo: false } %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

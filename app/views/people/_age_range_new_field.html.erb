<%# The blank age-range chip the "Add age range" button inserts — mirrors a new
    sector chip (shared/_sectorable_item_fields with no sector_id): a select to
    pick an unused range, a primary star, and a remove ✖. Lives in a <template>;
    the age-range-picker controller clones it on add and keys the star's value to
    the chosen category id on select. %>
<div class="inline-flex items-center gap-2 rounded-md border border-gray-300 bg-white
            text-gray-700 px-3 py-1 text-sm font-medium transition"
     data-age-range-picker-target="chip"
     data-category-id="">
  <%= select_tag "person[category_ids][]",
                 options_for_select([ [ "Select age range…", "" ] ] + @age_ranges_collection.map { |category| [ category.name, category.id ] }),
                 data: { age_range_picker_target: "chipSelect", action: "age-range-picker#choose" },
                 class: "bg-transparent border-none focus:ring-0 text-sm text-gray-500 cursor-pointer py-0" %>
  <label class="cursor-pointer leading-none" title="Mark as a primary age group served">
    <input type="checkbox"
           name="person[primary_age_category_ids][]"
           value=""
           class="peer sr-only"
           data-age-range-picker-target="primaryToggle"
           data-action="age-range-picker#togglePrimary">
    <i class="fa-solid fa-star text-base text-gray-300 peer-checked:text-amber-400 transition-colors" aria-hidden="true"></i>
    <span class="sr-only">Primary</span>
  </label>
  <button type="button"
          data-action="age-range-picker#remove"
          class="ml-0.5 text-gray-400 hover:text-gray-600 font-bold text-xs transition"
          aria-label="Remove age range">✖</button>
</div>

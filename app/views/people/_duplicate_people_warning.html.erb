<%= tag.div id: "duplicate_people_warning" do %>
  <% if @duplicates.present? %>
    <div class="mb-6 rounded-lg border border-yellow-200 bg-yellow-50 p-4"
         data-controller="scroll-to-top">
      <div class="flex items-start gap-3">
        <div class="flex-shrink-0">
          <svg
            class="h-5 w-5 text-yellow-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            />
          </svg>
        </div>

        <div class="flex-1">
          <h3 class="text-sm font-medium text-yellow-800">Possible duplicate person</h3>

          <p class="mt-1 text-sm text-yellow-700">We found existing people with a similar name or email. <%= link_to "View details", check_duplicates_people_path(first_name: @first_name, last_name: @last_name, email: @email, legal_first_name: @legal_first_name, email_2: @email_2), target: "_blank", class: "underline hover:text-yellow-900" %></p>

          <div class="mt-3 bg-white">
            <ul class="divide-y divide-gray-300 overflow-y-auto rounded-md border border-gray-300 text-sm">
              <% @duplicates.each do |dup| %>
                <li class="px-3 py-2">
                  <%= link_to dup[:name], person_path(dup[:id]), target: "_blank", class: "text-blue-600 hover:text-blue-800 underline" %>

                  <% if dup[:blocked] %>
                    <span class="text-2xs rounded bg-red-100 px-1.5 py-0.5 font-medium text-red-700">exact match</span>
                  <% elsif dup[:match_type] == "approximate" %>
                    <span class="text-2xs rounded bg-orange-100 px-1.5 py-0.5 font-medium text-orange-700">approximate match</span>
                  <% else %>
                    <% if dup[:name_match] %>
                      <span class="text-2xs rounded bg-green-100 px-1.5 py-0.5 font-medium text-green-700">name match</span>
                    <% end %>
                    <% if dup[:match_type] == "nickname" %>
                      <span class="text-2xs rounded bg-yellow-100 px-1.5 py-0.5 font-medium text-yellow-700">similar name</span>
                    <% end %>
                    <% if dup[:match_type] == "email" %>
                      <span class="text-2xs rounded bg-blue-100 px-1.5 py-0.5 font-medium text-blue-700">email match</span>
                    <% end %>
                  <% end %>

                  <div class="mt-0.5 text-xs text-gray-500">
                    <% if dup[:labeled_emails].present? %>
                      <% dup[:labeled_emails].each_with_index do |entry, i| %>
                        <span class="text-gray-400"><%= entry[:label] %>:</span>
                        <%= entry[:value] %>
                        <%= ", " unless i == dup[:labeled_emails].size - 1 %>
                      <% end %>
                    <% else %>
                      No email
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>

          <% if @blocked %>
            <p class="m-2 text-sm font-medium text-red-600">An <span class="text-2xs rounded bg-red-100 px-1.5 py-0.5 font-medium text-red-700">existing user</span> with this email already exists.</p>
            <p class="mb-6 text-sm text-gray-500">
              Edit the existing user or change this user's email.
            </p>
          <% elsif @duplicates.any? { |d| d[:match_type] == "approximate" } %>
            <p class="m-2 text-sm font-medium text-orange-600">A person with this name has a matching <span class="text-2xs rounded bg-orange-100 px-1.5 py-0.5 font-medium text-orange-700">secondary or user email</span>. Confirm this is a different person before continuing.</p>
          <% end %>

          <% unless @blocked %>
            <div class="mt-3 flex items-center gap-2">
              <%= check_box_tag :skip_duplicate_check, "1", params[:skip_duplicate_check].present?, id: "skip_duplicate_check", class: "h-4 w-4 text-yellow-600 rounded" %>
              <%= label_tag :skip_duplicate_check, "Create anyway (this is a different person)", for: "skip_duplicate_check", class: "text-sm text-yellow-700" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

<% steps = [ *account.account_milestones, account.account_stop ].compact %>
<ol class="grid <%= steps.size == 5 ? "grid-cols-5" : "grid-cols-4" %> gap-x-1 text-xs">
  <% steps.each_with_index do |step, index| %>
    <li class="relative min-w-0 <%= account.milestone_text_classes(step) %>">
      <% if (following = steps[index + 1]) %>
        <span class="absolute top-2 right-0 left-0 h-0.5 <%= following.state == :reached ? "bg-green-100" : "bg-gray-200" %>"></span>
      <% end %>
      <span class="relative inline-flex size-4 items-center justify-center rounded-full bg-white">
        <% case step.state %>
        <% when :reached %>
          <i class="fa-solid fa-circle-check text-base text-green-300"></i>
        <% when :locked %>
          <i class="fa-solid fa-lock text-sm"></i>
        <% when :inactive %>
          <i class="fa-solid fa-ban text-sm"></i>
        <% else %>
          <span class="size-4 rounded-full border-2 <%= step.state == :next ? "border-amber-500" : "border-gray-300" %>"></span>
        <% end %>
      </span>
      <span class="mt-1 block font-medium"><%= step.label %></span>
      <% if step.date || step.detail.nil? %>
        <span class="block"><%= step.date || "–" %></span>
      <% end %>
      <% if step.detail %>
        <span class="block"><%= step.detail %></span>
      <% end %>
    </li>
  <% end %>
</ol>

<% if account.unconfirmed_email.present? || account.password_reset_pending? %>
  <div class="mt-3 space-y-1 text-xs">
    <% if account.unconfirmed_email.present? %>
      <p class="flex items-center gap-1.5 text-amber-700">
        <i class="fa-solid fa-triangle-exclamation"></i>
        Email change pending: <%= account.unconfirmed_email %>
      </p>
    <% end %>
    <% if account.password_reset_pending? %>
      <p class="flex items-center gap-1.5 text-blue-700">
        <i class="fa-solid fa-key"></i>
        <%= account.password_reset_label %>
      </p>
    <% end %>
  </div>
<% end %>

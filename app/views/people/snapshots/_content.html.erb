<% person = snapshot.person %>
<div class="p-6">
  <p id="person_snapshot_title" class="pr-8 text-sm text-gray-600">
    <span class="font-semibold text-gray-900"><%= person_name(person) %></span>

    <% if person.preferred_email.present? %>
      <span class="text-gray-400">·</span>
      <%= person.preferred_email %>
    <% end %>
  </p>

  <% if snapshot.affiliated_since.present? %>
    <p class="mt-3 text-sm text-gray-500">Affiliated since <%= snapshot.affiliated_since.strftime("%B %Y") %></p>
  <% end %>

  <% if snapshot.empty? %>
    <p class="mt-4 text-sm text-gray-500 italic">No snapshot content yet.</p>
  <% else %>
    <% if snapshot.affiliations.any? %>
      <section class="mt-5">
        <h2 class="mb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">Affiliations</h2>
        <ul class="space-y-3">
          <% snapshot.affiliations.each do |affiliation| %>
            <% affiliation = affiliation.decorate %>
            <li class="flex items-start gap-3">
              <span class="shrink-0"><%= affiliation.status_badge %></span>
              <div class="min-w-0">
                <%= link_to affiliation.organization.name, organization_path(affiliation.organization),
                            class: "block font-medium hover:underline" %>
                <p class="text-xs text-gray-500"><%= affiliation.display_title %> · <%= affiliation.period_label %></p>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if snapshot.trainings.any? %>
      <section class="mt-5">
        <h2 class="mb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">Facilitator trainings</h2>
        <ul class="space-y-3">
          <% snapshot.trainings.each do |registration| %>
            <% registration = registration.decorate %>
            <li class="flex items-start gap-3">
              <span class="inline-flex shrink-0 items-center gap-1 rounded-full border px-2 py-0.5 text-xs font-medium <%= registration.attendance_status_classes %>">
                <%= render "event_registrations/attendance_status_label",
                           icon: registration.attendance_status_icon,
                           label: registration.attendance_status_label,
                           outcome: registration.pre_transfer_outcome %>
              </span>
              <div class="min-w-0">
                <%= link_to truncate(registration.event.title, length: 50), event_path(registration.event),
                            class: "block font-medium hover:underline" %>
                <p class="text-xs text-gray-500"><%= registration.event.decorate.short_date_range %></p>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if (membership = snapshot.membership) %>
      <% membership = membership.decorate %>
      <section class="mt-5">
        <h2 class="mb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">Membership</h2>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <% if membership.payment_badge? %>
              <span class="inline-flex shrink-0 items-center rounded-full border px-2 py-0.5 text-xs font-medium <%= membership.payment_classes %>">
                <%= membership.payment_label %>
              </span>
            <% end %>
            <div class="min-w-0">
              <%= link_to membership.status_label, membership_path(membership),
                          class: "block font-medium hover:underline" %>
              <p class="text-xs text-gray-500"><%= membership.period_label %></p>
            </div>
          </li>
        </ul>
      </section>
    <% end %>
  <% end %>

  <% button_class = admin_button_classes(size: nil, extra: "px-2.5 py-1 text-xs") %>
  <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-gray-100 pt-4">
    <%= link_to "Profile", person_path(person), class: button_class %>
    <%= link_to "Edit", edit_person_path(person), class: button_class %>

    <% if person.user.present? %>
      <%= link_to "User", user_path(person.user), class: button_class %>
    <% end %>

    <%= link_to "Activity", person_activity_path(person), class: button_class %>
    <%= link_to "Comments & communications", comments_and_communications_path(person_id: person.id), class: button_class %>
  </div>
</div>

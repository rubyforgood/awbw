<% content_for(:page_title, "Certificate settings") %>
<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<div class="mx-auto max-w-4xl">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
    <%= link_to "← Admin", admin_path, class: "text-sm #{eyebrow_link_class}" %>
  </div>

  <h1 class="mb-2 text-2xl font-semibold text-gray-900">Certificate of completion settings</h1>
  <p class="mb-6 text-sm text-gray-600">
    Connect a Resource to each slot to control the artwork on registrants' certificates of completion.
    Upload the image as a Resource the usual way, then connect it here. A frame overrides the built-in
    design for that certificate type; a signature fills the signature line. Leave a slot empty to use the
    built-in design.
  </p>

  <div class="space-y-4">
    <% @slots.each do |slot| %>
      <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="flex flex-col gap-4 px-4 py-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="min-w-0 sm:flex-1">
            <h2 class="text-sm font-semibold text-gray-800"><%= slot[:label] %></h2>
            <p class="mt-1 truncate text-xs text-gray-500" title="<%= slot[:description] %>"><%= slot[:description] %></p>

            <%= form_with url: admin_certificate_settings_path, method: :patch, class: "mt-3 flex items-center gap-2" do %>
              <%= hidden_field_tag :slot, slot[:role] %>
              <div class="min-w-0 flex-1">
                <select name="resource_id"
                        data-controller="remote-select"
                        data-remote-select-model-value="resource"
                        class="w-full rounded border-gray-300 bg-white px-2 py-1 text-sm shadow-sm">
                  <option value="">Type to search resources…</option>
                  <% if slot[:resource] %>
                    <option value="<%= slot[:resource].id %>" selected><%= slot[:resource].title %></option>
                  <% end %>
                </select>
              </div>
              <%= submit_tag slot[:resource] ? "Reconnect" : "Connect", class: "shrink-0 #{button_classes(:primary, size: :sm)}" %>
            <% end %>

            <p class="mt-2 text-xs text-gray-400">
              Or title a Resource exactly
              <span class="font-medium text-gray-600">“<%= slot[:title] %>”</span>
              and it's matched automatically.
            </p>
          </div>

          <div class="sm:w-56 sm:shrink-0">
            <% if slot[:resource] %>
              <div class="overflow-hidden rounded-lg border border-gray-200 bg-gray-50 p-2">
                <% if slot[:file]&.variable? %>
                  <%= image_tag slot[:file].variant(:card), alt: "#{slot[:label]} preview",
                        class: "mx-auto max-h-16 w-auto object-contain" %>
                <% else %>
                  <p class="py-6 text-center text-xs text-amber-700">
                    Connected to “<%= slot[:resource].title %>”, but it has no previewable image attached.
                  </p>
                <% end %>
              </div>
              <%= button_to "Disconnect", admin_certificate_settings_path, method: :patch,
                    params: { slot: slot[:role], remove: "1" },
                    class: "mt-2 #{button_classes(:danger_outline, size: :sm)} w-full",
                    form: { data: { turbo_confirm: "Disconnect the #{slot[:label].downcase}? Certificates will use the built-in design until you connect another." } } %>
            <% elsif slot[:builtin] %>
              <div class="overflow-hidden rounded-lg border border-gray-200 bg-gray-50 p-2">
                <%= image_tag slot[:builtin], alt: "#{slot[:label]} built-in design",
                      class: "mx-auto max-h-16 w-auto object-contain" %>
              </div>
              <p class="mt-2 text-center text-xs text-gray-400">Built-in design — none connected</p>
            <% elsif slot[:builtin_css] %>
              <%# Miniature of the CSS-drawn purple/gold certificate frame used in-app
                  when nothing is connected (see _completion_certificate / _ce_confirmation_certificate). %>
              <div class="overflow-hidden rounded-lg border border-gray-200 bg-gray-50 p-2">
                <div class="relative mx-auto aspect-[2200/1556] h-16 overflow-hidden rounded bg-white ring-1 ring-black/5">
                  <span class="pointer-events-none absolute inset-0 rounded border-2 border-purple-950"></span>
                  <span class="pointer-events-none absolute inset-[3px] rounded-sm border border-amber-400"></span>
                  <span class="pointer-events-none absolute -top-3 -left-3 h-8 w-8 rounded-full bg-gradient-to-br from-purple-700 to-purple-950 opacity-10"></span>
                  <span class="pointer-events-none absolute -right-3 -bottom-3 h-8 w-8 rounded-full bg-gradient-to-tr from-amber-400 to-purple-700 opacity-10"></span>
                  <div class="absolute inset-0 flex flex-col items-center justify-center gap-[2px]">
                    <span class="from-accent to-accent h-[3px] w-8 rounded bg-gradient-to-r via-amber-400"></span>
                    <span class="text-[5px] font-semibold tracking-[0.2em] text-purple-800 uppercase">Certificate</span>
                  </div>
                </div>
              </div>
              <p class="mt-2 text-center text-xs text-gray-400">Built-in design — none connected</p>
            <% else %>
              <div class="flex h-24 items-center justify-center rounded-lg border border-dashed border-gray-200 bg-gray-50 text-center text-xs text-gray-400">
                None connected — using built-in design
              </div>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>
  </div>
</div>

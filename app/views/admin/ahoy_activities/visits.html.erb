<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="<%= DomainTheme.bg_class_for(:admin_only) %> border-primary/10 rounded-2xl border p-6 shadow-sm">

      <div class="mb-2 flex flex-wrap items-center gap-y-2">
        <% if allowed_to?(:index?, with: Admin::HomePolicy) %>
          <%= link_to admin_path, class: "inline-flex items-center gap-1 text-sm #{eyebrow_link_class} px-2 py-1" do %>
            <i class="fas fa-arrow-left"></i>
            <span>Admin</span>
          <% end %>
        <% end %>
        <div class="ml-auto">
          <%= render "admin/shared/activities_tabs" %>
        </div>
      </div>

      <div class="mb-6 flex items-baseline gap-3 leading-none">
        <h1 class="text-primary font-display text-2xl leading-none font-semibold">Visits</h1>
        <%= render "visit_count" %>
      </div>

      <div class="mb-6 min-h-10 text-sm">
        <%= render "admin/shared/active_filters_subheader" %>
      </div>

      <div class="border-primary/10 mb-6 rounded-2xl border bg-white p-6 shadow-sm">
        <%# Selects submit on change and the text boxes debounce-submit as you type,
            all into the visit_results frame — the filter form stays put (and
            focused) while just the rows swap. %>
        <%= form_with url: request.path, method: :get,
              data: { controller: "collection", turbo_frame: "visit_results" },
              autocomplete: "off" do %>

          <div class="flex flex-wrap gap-4 lg:flex-nowrap">

            <div class="min-w-0 flex-1">
              <label class="<%= search_label_class %>">
                User
              </label>
              <%= text_field_tag :user_search,
                                 params[:user_search],
                                 placeholder: "Name or email",
                                 class: search_field_class %>
            </div>

            <div class="min-w-0 flex-1">
              <label class="<%= search_label_class %>">
                IP address
              </label>
              <%= text_field_tag :ip,
                                 params[:ip],
                                 placeholder: "e.g. 203.0.113.5",
                                 class: search_field_class %>
            </div>

            <div class="min-w-0 flex-1">
              <label class="<%= search_label_class %>">
                User agent
              </label>
              <%= text_field_tag :user_agent,
                                 params[:user_agent],
                                 placeholder: "e.g. Chrome, iPhone",
                                 class: search_field_class %>
            </div>

            <div class="min-w-0 flex-1">
              <%= render "admin/shared/audience_dropdown", auto_submit: false, stacked: true %>
            </div>

            <div class="min-w-0 flex-1">
              <label class="<%= search_label_class %>">
                Time Period
              </label>
              <%= select_tag :time_period,
                             options_for_select(
                               [["All time", "all_time"], ["Past day", "past_day"], ["Past week", "past_week"], ["Past month", "past_month"], ["Past year", "past_year"]],
                               params[:time_period] || "past_month"
                             ),
                             class: search_field_class %>
            </div>

            <div class="min-w-0 flex-1">
              <label class="<%= search_label_class %>">
                From
              </label>
              <%= date_field_tag :from,
                                 params[:from],
                                 class: date_filter_class(search_field_class, params[:from]) %>
            </div>

            <div class="min-w-0 flex-1">
              <label class="<%= search_label_class %>">
                To
              </label>
              <%= date_field_tag :to,
                                 params[:to],
                                 class: date_filter_class(search_field_class, params[:to]) %>
            </div>

            <div class="w-24 flex-none">
              <label class="<%= search_label_class %>">
                Visit ID
              </label>
              <%= number_field_tag :visit_id,
                                   params[:visit_id],
                                   placeholder: "e.g. 42",
                                   class: search_field_class %>
            </div>

          </div>

          <div class="mt-6 flex items-center gap-3 text-sm">
            <span class="text-gray-500">Quick:</span>
            <% safe_params = params.slice(:user_search, :ip, :user_agent, :visit_id, :from, :to).to_unsafe_h %>
            <%= link_to "24h",
                        url_for(safe_params.merge(from: 1.day.ago.to_date)),
                        class: "text-indigo-600 hover:underline" %>

            <%= link_to "7d",
                        url_for(safe_params.merge(from: 7.days.ago.to_date)),
                        class: "text-indigo-600 hover:underline" %>

            <%= link_to "30d",
                        url_for(safe_params.merge(from: 30.days.ago.to_date)),
                        class: "text-indigo-600 hover:underline" %>

            <%= link_to "Clear filters", request.path,
                        class: "ml-auto #{eyebrow_link_class}",
                        data: { action: "collection#clearAndSubmit" } %>
          </div>

        <% end %>
      </div>

      <%# Results load in a turbo frame so the filter form (outside the frame) can
          swap just the rows — keeping the search inputs focused as you type. %>
      <%= turbo_frame_tag :visit_results, src: admin_activities_visits_path(request.query_parameters), data: { turbo: "temporary" } do %>
        <%= render "results_skeleton" %>
      <% end %>
</div>

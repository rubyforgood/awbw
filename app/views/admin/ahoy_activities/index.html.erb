<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="<%= DomainTheme.bg_class_for(:admin_only) %> border-primary/10 rounded-2xl border p-6 shadow-sm">

      <div class="mb-2 flex flex-wrap items-center gap-y-2">
        <%# Scoped to a person (from their edit page's Activity card, or the filter) —
            return to that person, not the generic Admin default. %>
        <% if @person %>
          <%= link_to edit_person_path(@person), class: "inline-flex items-center gap-1 text-sm #{eyebrow_link_class} px-2 py-1" do %>
            <i class="fas fa-arrow-left"></i>
            <span><%= truncate(@person.name, length: 30) %></span>
          <% end %>
        <% elsif allowed_to?(:index?, with: Admin::HomePolicy) %>
          <%= link_to admin_path, class: "inline-flex items-center gap-1 text-sm #{eyebrow_link_class} px-2 py-1" do %>
            <i class="fas fa-arrow-left"></i>
            <span>Admin</span>
          <% end %>
        <% end %>
        <div class="ml-auto">
          <%= render "admin/shared/activities_tabs" %>
        </div>
      </div>

      <% scoped = Admin::AhoyActivitiesController::SCOPING_PARAMS.any? { |key| params[key].present? } %>
      <div class="mb-6">
        <span class="text-2xs font-semibold tracking-widest uppercase <%= DomainTheme.text_class_for(:people, intensity: 700) %>">Activity</span>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-primary font-display text-3xl">
            <% if @person %>
              <%= link_to @person.full_name, person_path(@person), class: "hover:underline" %>
            <% else %>
              <%= scoped ? "Filtered" : "Everyone" %>
            <% end %>
          </h1>
          <% if @person %>
            <% if allowed_to?(:manage?, Comment) %>
              <%= link_to comments_and_communications_path(person_id: @person.id), class: button_classes(:primary_outline) do %>
                <i class="fa-solid fa-comments"></i>
                <%= @person.first_name %>'s comments &amp; communications
              <% end %>
            <% end %>
            <%= link_to person_path(@person), class: button_classes(:primary_outline) do %>
              <i class="fa-solid fa-user"></i>
              <%= @person.first_name %>'s profile
            <% end %>
          <% end %>
          <% if scoped %>
            <%= link_to "View everyone", admin_activities_events_path, class: "ml-auto text-sm #{eyebrow_link_class} whitespace-nowrap hover:underline" %>
          <% end %>
        </div>
        <div class="mt-2 text-sm text-gray-500"><%= render "count" %></div>
      </div>

      <div class="mb-6 min-h-10 text-sm">
        <%= render "admin/shared/active_filters_subheader",
              default_audiences: Admin::AhoyActivitiesController::EVENTS_DEFAULT_AUDIENCES,
              hide_interactions: hide_interactions? %>
      </div>

      <div class="border-primary/10 mb-6 rounded-2xl border bg-white p-6 shadow-sm">
        <%# Selects submit on change and the text boxes debounce-submit as you type,
            all into the activity_results frame — the filter form stays put (and
            focused) while just the rows swap. turbo_action: "advance" mirrors the
            filter state into the address bar so a hard refresh restores it. %>
        <%= form_with url: request.path, method: :get,
              data: { controller: "collection", turbo_frame: "activity_results", turbo_action: "advance" },
              autocomplete: "off" do %>

          <%# These scope the timeline (person Activity, per-user history, a record's
              audit trail) but have no visible control, so carry them as hidden
              fields — otherwise submitting the form drops them and reverts to the
              global feed. %>
          <% Admin::AhoyActivitiesController::SCOPING_PARAMS.each do |scoping_param| %>
            <% if params[scoping_param].present? %>
              <%= hidden_field_tag scoping_param, params[scoping_param] %>
            <% end %>
          <% end %>

          <div class="flex flex-wrap gap-4 lg:flex-nowrap">

            <%# Picking a person reloads the page scoped to them, since the header names the person. %>
            <div class="min-w-0 flex-[2]">
              <label for="jump_person_id" class="<%= search_label_class %>">
                Person
              </label>
              <%= select_tag :jump_person_id,
                             (@person ? options_for_select([ [ @person.full_name, @person.id ] ], @person.id) : options_for_select([])),
                             include_blank: true, prompt: "e.g. Jane Doe",
                             "aria-label": "Filter to one person's activity",
                             class: search_field_class,
                             data: { controller: "remote-select navigate-select",
                                     remote_select_model_value: "person",
                                     remote_select_search_icon_value: false,
                                     remote_select_exclude_value: @person&.id,
                                     navigate_select_url_template_value: person_activity_path("__ID__"),
                                     action: "change->navigate-select#navigate" } %>
            </div>

            <div class="min-w-0 flex-[1.5]">
              <label class="<%= search_label_class %>">
                Activity title
              </label>
              <%= text_field_tag :event_name,
                                 params[:event_name],
                                 placeholder: "e.g. new workshop",
                                 class: search_field_class %>
            </div>

            <div class="min-w-0 flex-1">
              <label class="<%= search_label_class %>">
                Details
              </label>
              <%= text_field_tag :props,
                                 params[:props],
                                 placeholder: "e.g. an email",
                                 class: search_field_class %>
            </div>

            <div class="min-w-0 flex-1">
              <%= render "admin/shared/audience_dropdown", auto_submit: false, stacked: true,
                    default_audiences: Admin::AhoyActivitiesController::EVENTS_DEFAULT_AUDIENCES %>
            </div>

            <div class="min-w-0 flex-1">
              <label class="<%= search_label_class %>">
                Time Period
              </label>
              <%= select_tag :time_period,
                             options_for_select(
                               [["All time", "all_time"], ["Past day", "past_day"], ["Past week", "past_week"], ["Past month", "past_month"], ["Past year", "past_year"]],
                               params[:time_period] || "past_month"
                             ),
                             class: search_field_class %>
            </div>

            <div class="min-w-0 flex-1">
              <label class="<%= search_label_class %>">
                From
              </label>
              <%= date_field_tag :from,
                                 params[:from],
                                 class: date_filter_class(search_field_class, params[:from]) %>
            </div>

            <div class="min-w-0 flex-1">
              <label class="<%= search_label_class %>">
                To
              </label>
              <%= date_field_tag :to,
                                 params[:to],
                                 class: date_filter_class(search_field_class, params[:to]) %>
            </div>

            <div class="w-24 flex-none">
              <label class="<%= search_label_class %>">
                Visit ID
              </label>
              <%= number_field_tag :visit_id,
                                   params[:visit_id],
                                   placeholder: "e.g. 42",
                                   class: search_field_class %>
            </div>

          </div>

          <div class="mt-6">
            <%= render "filter_toggles" %>
          </div>

          <div class="mt-6 flex items-center gap-3 text-sm">
            <span class="text-gray-500">Quick:</span>
            <% safe_params = params.slice(:event_name, :visit_id, :props, :person_id, :from, :to, :hide_account, :hide_interactions, :hide_communications).to_unsafe_h %>
            <%= link_to "24h",
                        url_for(safe_params.merge(from: 1.day.ago.to_date)),
                        class: "text-indigo-600 hover:underline" %>

            <%= link_to "7d",
                        url_for(safe_params.merge(from: 7.days.ago.to_date)),
                        class: "text-indigo-600 hover:underline" %>

            <%= link_to "30d",
                        url_for(safe_params.merge(from: 30.days.ago.to_date)),
                        class: "text-indigo-600 hover:underline" %>

            <%# Scoping params ride in hidden fields and the header names the scope, so
                clearing a scoped page reloads the whole page unscoped. %>
            <%= link_to "Clear filters", request.path,
                        class: "ml-auto #{eyebrow_link_class}",
                        data: scoped ? { turbo_frame: "_top" } : { action: "collection#clearAndSubmit" } %>
          </div>

        <% end %>
      </div>

      <%# Results load in a turbo frame so the filter form (outside the frame) can
          swap just the rows — keeping the search inputs focused as you type. %>
      <%= turbo_frame_tag :activity_results, src: admin_activities_events_path(request.query_parameters), data: { turbo: "temporary" } do %>
        <%= render "results_skeleton" %>
      <% end %>
</div>

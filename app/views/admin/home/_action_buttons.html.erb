<div class="mt-3 flex flex-wrap gap-2">
  <%= link_to profile_change_requests_path, class: button_classes(:primary_outline) do %>
    <i class="fa-solid fa-user-pen"></i> Changes requested
    <%= render "count_badge", count: local_assigns[:pending_change_requests_count] %>
  <% end %>
  <%= link_to admin_data_health_path, class: button_classes(:primary_outline) do %>
    <i class="fa-solid fa-heart-pulse"></i> Data health
    <%= render "badge", text: (Admin::HomeController::REVIEW_BADGE if local_assigns[:data_health_flagged]), title: Admin::HomeController::DATA_HEALTH_BADGE_TITLE %>
  <% end %>
  <% if allowed_to?(:import?, EventRegistration) %>
    <%= link_to new_event_registration_import_path(return_to: "admin_home"), class: button_classes(:primary_outline) do %>
      <i class="fa-solid fa-upload"></i> Import registrants
    <% end %>
  <% end %>
  <%= link_to author_credit_divergences_path, class: button_classes(:primary_outline) do %>
    <i class="fa-solid fa-pen-nib"></i> Author credit divergences
    <%= render "badge", text: (Admin::HomeController::REVIEW_BADGE if local_assigns[:author_credit_flagged]) %>
  <% end %>
  <% if allowed_to?(:create?, Feature) %>
    <%= button_to import_features_path,
                  class: button_classes(:primary_outline),
                  form: { data: { turbo_confirm: "Add any newly-shipped features and update the ones nobody has edited to match? Your edits are kept." } } do %>
      <i class="fa-solid fa-arrows-rotate"></i> Sync features &amp; tips
      <%= render "badge", text: (Admin::HomeController::REVIEW_BADGE if local_assigns[:features_unsynced]) %>
    <% end %>
  <% end %>
</div>

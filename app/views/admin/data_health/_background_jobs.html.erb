<%# Locals: status (BackgroundJobsStatus, nil where jobs don't run through Solid Queue). %>
<% lights = {
     green: { dot: "bg-green-500", label: "Running", text: "text-green-800" },
     yellow: { dot: "bg-amber-400", label: "Running slowly", text: "text-amber-800" },
     red: { dot: "bg-red-500", label: "Not running", text: "text-red-800" }
   } %>
<section id="background-jobs" class="mb-6 scroll-mt-24 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="flex items-center gap-2 text-base font-semibold text-gray-900">
      Background jobs
      <% if status %>
        <% light = lights.fetch(status.light) %>
        <span class="inline-flex items-center gap-1.5 text-sm font-medium <%= light[:text] %>">
          <span class="inline-block size-2.5 rounded-full <%= light[:dot] %>"></span>
          <%= light[:label] %>
        </span>
      <% end %>
    </h2>
    <% if AppRestart.available? && allowed_to?(:restart_app?, :data_health) %>
      <%= button_to admin_data_health_restart_app_path,
            class: button_classes(:danger_outline, size: :sm),
            form: { data: { turbo_confirm: "Restart the app? The whole site goes down for a minute or two while it comes back." } } do %>
        <i class="fa-solid fa-power-off"></i> Restart app
      <% end %>
    <% end %>
  </div>

  <% if status %>
    <p class="mt-1 text-sm text-gray-600">
      Emails, payment updates, and other work the portal does in the background.
      <% if status.light == :red %>
        Restarting the app usually gets it going again.
      <% end %>
    </p>

    <dl class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-gray-500">Last checked in</dt>
        <dd class="text-gray-900">
          <% if (heartbeat = status.last_worker_heartbeat_at) %>
            <%= time_ago_in_words(heartbeat) %> ago
          <% else %>
            Never on this server
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-gray-500">Waiting to run</dt>
        <dd class="text-gray-900">
          <%= number_with_delimiter(status.waiting_count) %>
          <% if status.oldest_waiting_at %>
            <span class="text-gray-500">(oldest <%= time_ago_in_words(status.oldest_waiting_at) %> ago)</span>
          <% end %>
        </dd>
      </div>
      <% if status.waiting_count.positive? %>
        <div class="sm:col-span-2">
          <dt class="text-gray-500">Waiting by kind</dt>
          <dd class="text-gray-900">
            <%= status.waiting_by_job.first(5).map { |name, count| "#{BackgroundJobsStatus.label_for(name)} (#{number_with_delimiter(count)})" }.join(", ") %>
          </dd>
        </div>
      <% end %>
      <div>
        <dt class="text-gray-500">Failed in the last day</dt>
        <dd class="text-gray-900"><%= number_with_delimiter(status.failed_last_day_count) %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Interrupted when the runner stopped</dt>
        <dd class="flex flex-wrap items-center gap-2 text-gray-900">
          <%= number_with_delimiter(status.interrupted_count) %>
          <% if status.interrupted_count.positive? && allowed_to?(:retry_interrupted_jobs?, :data_health) %>
            <%= button_to "Retry them", admin_data_health_retry_interrupted_jobs_path,
                  class: button_classes(:secondary_outline, size: :sm),
                  form: { data: { turbo_confirm: "Run the #{pluralize(status.interrupted_count, "interrupted job")} again? Emails that already went out won't send twice." } } %>
          <% end %>
        </dd>
      </div>
    </dl>
  <% else %>
    <p class="mt-1 text-sm text-gray-500">Background jobs don't run through the job runner in this environment, so there's nothing to check here.</p>
  <% end %>
</section>

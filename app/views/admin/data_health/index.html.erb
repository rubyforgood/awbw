<% content_for(:page_title, "Data health") %>
<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<% clean = @groups.values.flatten.none?(&:any?) %>

<div class="mx-auto max-w-4xl">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
    <%= link_to "← Admin", admin_path, class: "text-sm #{eyebrow_link_class}" %>
    <%= link_to admin_data_health_filemaker_not_imported_path, class: "text-sm font-medium text-blue-700 hover:underline" do %>
      <i class="fa-solid fa-box-archive mr-1"></i>FileMaker records not imported
    <% end %>
  </div>

  <h1 class="mb-2 text-2xl font-semibold text-gray-900">Data health</h1>
  <p class="mb-6 text-sm text-gray-600">
    Consistency checks that span every record. Repairs are logged in the
    <%= link_to "activity history", admin_activities_events_path, class: "text-indigo-600 hover:underline" %>
    like any other change.
  </p>

  <% if clean %>
    <div class="mb-4 rounded-xl border border-green-200 bg-green-50 p-6 text-center text-sm text-green-800">
      <i class="fa-solid fa-circle-check mr-1"></i>
      Everything checks out — no inconsistencies found.
    </div>
  <% end %>

  <div data-controller="expandable-cards" data-expandable-cards-expanded-value="false">
    <div class="mb-3 flex justify-end">
      <button type="button" data-action="expandable-cards#toggleAll"
              class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 hover:text-gray-800">
        <span data-expandable-cards-target="label">Expand all</span>
        <i class="fa-solid fa-chevron-down text-xs transition-transform" data-expandable-cards-target="icon"></i>
      </button>
    </div>

    <div class="space-y-3">
      <% @groups.each do |group, checks| %>
        <%= render "group_card", title: group, total: checks.sum(&:count), open: checks.any? { |check| check.key == @open_check } do %>
          <% checks.each do |check| %>
            <%= render "check", check: check %>
          <% end %>
        <% end %>
      <% end %>

      <%= turbo_frame_tag :data_health_worklists, src: admin_data_health_worklists_path, loading: :lazy, target: "_top" do %>
        <div class="animate-pulse rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-400 shadow-sm">
          Counting possible duplicates and author credit…
        </div>
      <% end %>
    </div>
  </div>
</div>

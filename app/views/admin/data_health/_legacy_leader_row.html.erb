<%# Locals: record (an Affiliation titled Leader). The person opens their edit page at the
    affiliation; below it, whether they already have a Facilitator row here and which one, if
    any, records the same stretch. %>
<% check = DataHealth::LegacyLeaderAffiliations.new %>
<% facilitators = check.facilitators_for(record) %>
<% twin = check.twin_for(record, facilitators) %>
<% elsewhere = check.facilitator_elsewhere_count(record) %>
<% back = { return_to: "data_health", check: check.key } %>
<div class="flex flex-wrap items-center gap-2">
  <% if record.person %>
    <%= link_to person_name(record.person), edit_person_path(record.person, **back, anchor: dom_id(record)), target: "_blank", rel: "noopener",
          class: "font-medium text-gray-800 hover:text-blue-700 hover:underline" %>
  <% end %>
  <span class="text-gray-500">— <%= record.organization&.name %></span>
  <% if facilitators.any? %>
    <%= render "shared/badge", label: "Has Facilitator row here", classes: "bg-green-50 text-green-800 border-green-300", icon: "fa-solid fa-circle-check" %>
  <% else %>
    <%= render "shared/badge", label: "No Facilitator row here", classes: "bg-amber-50 text-amber-800 border-amber-300", icon: "fa-solid fa-circle-exclamation" %>
  <% end %>
</div>
<div class="text-xs text-gray-500">
  Leader · <%= record.decorate.period_label.presence || "No dates" %><%= " · primary contact" if record.primary_contact? %>
  <% if record.filemaker_code.present? %> · FileMaker <%= record.filemaker_code %><% end %>
</div>
<% facilitators.each do |facilitator| %>
  <% same = check.same_dates?(facilitator, record) %>
  <div class="text-xs <%= facilitator == twin && !same ? "text-amber-700" : "text-gray-500" %>">
    Facilitator #<%= facilitator.id %> · <%= facilitator.decorate.period_label.presence || "No dates" %><%= " · primary contact" if facilitator.primary_contact? %>
    · <%= check.stretch_label(facilitator, record, twin) %>
  </div>
<% end %>
<% if facilitators.any? && twin.nil? %>
  <div class="text-xs text-gray-500">None of these covers this Leader row's stretch.</div>
<% end %>
<% if elsewhere.positive? %>
  <div class="text-xs text-gray-500">Also a Facilitator at <%= pluralize(elsewhere, "other organization") %>.</div>
<% end %>

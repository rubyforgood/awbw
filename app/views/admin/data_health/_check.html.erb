<%# Locals: check (a DataHealth::Check). One check inside its group's card. %>
<div class="px-4 py-4">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="text-sm font-semibold text-gray-800">
        <%= check.title %>
        <span class="ml-1 rounded-full px-2 py-0.5 text-xs font-medium <%= check.any? ? "bg-amber-100 text-amber-800" : "bg-gray-100 text-gray-500" %>">
          <%= check.count %>
        </span>
      </h3>
      <p class="mt-1 text-xs text-gray-500"><%= check.explanation %></p>
    </div>

    <% if check.any? && check.review_path %>
      <%= link_to check.review_label, check.review_path,
            class: button_classes(:secondary_outline, extra: "shrink-0") %>
    <% end %>
    <% if check.any? && check.repairable? %>
      <%= button_to check.repair_label, admin_data_health_repair_path(check: check.key),
            method: :post, class: button_classes(:danger_outline, extra: "shrink-0"),
            form: { data: { turbo_confirm: "#{check.repair_label} for #{check.count} #{'record'.pluralize(check.count)}? This can't be undone." } } %>
    <% elsif check.any? && !check.review_path %>
      <span class="shrink-0 rounded-md border border-gray-200 px-2.5 py-1 text-xs font-medium text-gray-500">
        Review by hand
      </span>
    <% end %>
  </div>

  <% if check.any? %>
    <div class="mt-3 overflow-hidden rounded-lg border border-gray-200">
      <% if check.row_partial %>
        <%# display:contents on each row so its cells land in this grid and the
            columns line up across records. %>
        <ol class="grid grid-cols-[1fr_max-content_max-content] items-center gap-x-4 px-3 pb-2 text-sm">
          <li class="contents text-xs font-medium tracking-wide text-gray-400 uppercase">
            <% check.columns.each do |heading| %><span class="pt-2"><%= heading %></span><% end %>
          </li>
          <% check.preview.each do |record| %>
            <li class="contents">
              <%= render check.row_partial, record: record %>
            </li>
          <% end %>
        </ol>
      <% else %>
        <ul class="divide-y divide-gray-100 text-sm">
          <% check.preview.each do |record| %>
            <li class="px-3 py-2 text-gray-700">
              <% if (path = check.path_for(record)) %>
                <%= link_to check.describe(record), path, target: "_blank", rel: "noopener",
                      class: "hover:text-blue-700 hover:underline" %>
              <% else %>
                <%= check.describe(record) %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <% if check.more_than_preview.positive? %>
        <p class="border-t border-gray-100 px-3 py-2 text-xs text-gray-400">
          …and <%= check.more_than_preview %> more. A repair covers all <%= check.count %>, not just the ones listed.
        </p>
      <% end %>
    </div>
  <% end %>
</div>

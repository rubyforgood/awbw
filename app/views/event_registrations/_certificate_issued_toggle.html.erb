<%# Inline certificate availability cell, targeted by id for turbo replacement.
    Locals: registration, ce (default false) — the CE certificate instead of the event's.
    A certificate unlocks on its own once its requirements are met, so then the cell
    just says so. Otherwise it's a slider that makes it available now (marking it
    issued); once switched on it stays a slider so it can be switched back off.
    The track is a direct sibling of the checkbox so peer-checked applies (it only
    reaches later siblings, not their descendants); the knob is the track's ::after. %>
<% ce = local_assigns.fetch(:ce, false) %>
<% url = ce ? toggle_ce_certificate_issued_event_registration_path(registration) : toggle_certificate_issued_event_registration_path(registration) %>
<% issued = ce ? registration.ce_certificate_issued? : registration.certificate_sent? %>
<% available = !issued && (ce ? registration.ce_certificate_available? : registration.certificate_available?) %>
<span id="<%= dom_id(registration, ce ? :ce_certificate_issued : :certificate_issued) %>" class="inline-block">
  <% if available %>
    <span class="inline-flex items-center gap-1.5 whitespace-nowrap text-green-700" title="Requirements met — the registrant can download it">
      <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
      <span>Available</span>
    </span>
  <% else %>
    <%= form_with url: url, method: :patch, class: "inline" do %>
      <%= hidden_field_tag :value, "0", id: nil %>
      <label class="relative inline-flex cursor-pointer items-center select-none" title="<%= registration.editing_locked? ? "Transferred out — locked" : "Make available now" %>">
        <%= check_box_tag :value, "1", issued,
              id: nil,
              onchange: "this.form.requestSubmit()",
              disabled: registration.editing_locked?,
              "aria-label": ce ? "CE certificate availability" : "Certificate availability",
              class: "peer sr-only" %>
        <span class="relative inline-block h-5 w-9 rounded-full bg-gray-300 transition-colors peer-checked:bg-teal-600 peer-disabled:cursor-not-allowed peer-disabled:opacity-50 after:absolute after:top-0.5 after:left-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:shadow after:transition-transform after:content-[''] peer-checked:after:translate-x-4"></span>
      </label>
    <% end %>
  <% end %>
</span>

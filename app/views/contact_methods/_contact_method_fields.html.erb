<div class="nested-fields mb-3 rounded-lg border border-gray-200 bg-white p-3">
  <%= f.hidden_field :kind, value: :phone %>
  <div class="flex flex-wrap items-end gap-3">
    <!-- Contact Type -->
    <div class="w-full sm:w-36">
      <%= f.input :contact_type,
                  as: :select,
                  required: true,
                  wrapper_html: { class: "mb-0!" },
                  label: "Contact type",
                  collection: ContactMethod::CONTACT_TYPES.compact.map { |t| [t.humanize, t] } %>
    </div>

    <!-- Value -->
    <div class="w-full min-w-32 sm:w-auto sm:flex-1">
      <%= f.input :value,
                  wrapper_html: { class: "mb-0!" },
                  label: "Number" %>
    </div>

    <!-- Primary -->
    <div class="flex h-[42px] items-center">
      <%= f.input :primary,
                  as: :boolean,
                  wrapper: false,
                  label: false,
                  input_html: { checked: f.object.new_record? || f.object.primary?, class: "mr-2 text-blue-600 focus:ring-blue-500" } %>
    </div>

    <!-- Inactive -->
    <div class="flex h-[42px] items-center">
      <%= f.input :inactive,
                  as: :boolean,
                  wrapper: false,
                  label: false,
                  input_html: { class: "mr-2 text-blue-600 focus:ring-blue-500" } %>
    </div>

    <div class="ms-auto text-right">
      <!-- Remove button -->
      <%= link_to_remove_association "Remove",
                                     f,
                                     class: "text-sm text-gray-400 hover:text-red-600 underline whitespace-nowrap" %>
    </div>
  </div>
</div>

<div class="min-h-screen">
  <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="admin-only bg-blue-100 rounded p-6">
      <div class="max-w-7xl mx-auto bg-white border border-gray-200 rounded-xl shadow-lg p-6">
        
        <!-- Header -->
        <div class="mb-6">
          <h1 class="text-3xl font-bold text-gray-900 mb-2">
            Preview Category Deduplication
          </h1>
          <p class="text-gray-600">
            Review the differences before merging. The category on the left will be DELETED and its associations will be moved to the category on the right.
          </p>
          <%= link_to "← Back to Dedupe", dedupe_index_categories_path, class: "inline-block mt-4 text-purple-600 hover:text-purple-800" %>
        </div>

        <!-- Side-by-side Comparison -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
          
          <!-- Category to Delete (Left) -->
          <div class="border-2 border-red-300 rounded-lg p-4 bg-red-50">
            <div class="flex items-center gap-2 mb-4">
              <i class="fa-solid fa-trash-can text-red-600"></i>
              <h2 class="text-xl font-bold text-red-800">
                Category to DELETE
              </h2>
            </div>
            
            <div class="bg-white rounded-lg p-4 space-y-3">
              <div class="border-b pb-2">
                <span class="text-gray-600 text-sm font-semibold">ID:</span>
                <span class="ml-2 text-gray-900"><%= @category_to_delete.id %></span>
              </div>
              
              <div class="border-b pb-2">
                <span class="text-gray-600 text-sm font-semibold">Name:</span>
                <span class="ml-2 text-gray-900 font-bold"><%= @category_to_delete.name %></span>
              </div>
              
              <div class="border-b pb-2">
                <span class="text-gray-600 text-sm font-semibold">Category Type:</span>
                <span class="ml-2 <%= @category_to_delete.category_type_id == @category_to_keep.category_type_id ? 'text-gray-900' : 'text-yellow-600 font-bold bg-yellow-100 px-2 py-1 rounded' %>">
                  <%= @category_to_delete.category_type&.name || '(none)' %>
                  <% if @category_to_delete.category_type_id != @category_to_keep.category_type_id %>
                    <span class="text-xs">DIFFERENT</span>
                  <% end %>
                </span>
              </div>
              
              <div class="border-b pb-2">
                <span class="text-gray-600 text-sm font-semibold">Published:</span>
                <span class="ml-2 <%= @category_to_delete.published == @category_to_keep.published ? 'text-gray-900' : 'text-yellow-600 font-bold bg-yellow-100 px-2 py-1 rounded' %>">
                  <%= @category_to_delete.published? ? 'Yes' : 'No' %>
                  <% if @category_to_delete.published != @category_to_keep.published %>
                    <span class="text-xs">DIFFERENT</span>
                  <% end %>
                </span>
              </div>
              
              <div class="border-b pb-2">
                <span class="text-gray-600 text-sm font-semibold">Position:</span>
                <span class="ml-2 <%= @category_to_delete.position == @category_to_keep.position ? 'text-gray-900' : 'text-yellow-600 font-bold bg-yellow-100 px-2 py-1 rounded' %>">
                  <%= @category_to_delete.position %>
                  <% if @category_to_delete.position != @category_to_keep.position %>
                    <span class="text-xs">DIFFERENT</span>
                  <% end %>
                </span>
              </div>
              
              <div class="border-b pb-2">
                <span class="text-gray-600 text-sm font-semibold">Created:</span>
                <span class="ml-2 text-gray-900"><%= @category_to_delete.created_at&.strftime("%Y-%m-%d %H:%M") || 'N/A' %></span>
              </div>
              
              <div>
                <span class="text-gray-600 text-sm font-semibold">Associated Records:</span>
                <span class="ml-2 text-gray-900 font-bold"><%= @delete_categorizable_items.count %></span>
              </div>
              
              <% if @delete_categorizable_items.any? %>
                <div class="mt-4">
                  <h3 class="text-sm font-semibold text-gray-700 mb-2">Tagged Items:</h3>
                  <ul class="text-sm text-gray-600 space-y-1 max-h-40 overflow-y-auto">
                    <% @delete_categorizable_items.each do |item| %>
                      <li class="pl-2">
                        • <%= item.categorizable_type %>: 
                        <%= item.categorizable.try(:name) || item.categorizable.try(:title) || "ID #{item.categorizable_id}" %>
                      </li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Category to Keep (Right) -->
          <div class="border-2 border-green-300 rounded-lg p-4 bg-green-50">
            <div class="flex items-center gap-2 mb-4">
              <i class="fa-solid fa-check-circle text-green-600"></i>
              <h2 class="text-xl font-bold text-green-800">
                Category to KEEP
              </h2>
            </div>
            
            <div class="bg-white rounded-lg p-4 space-y-3">
              <div class="border-b pb-2">
                <span class="text-gray-600 text-sm font-semibold">ID:</span>
                <span class="ml-2 text-gray-900"><%= @category_to_keep.id %></span>
              </div>
              
              <div class="border-b pb-2">
                <span class="text-gray-600 text-sm font-semibold">Name:</span>
                <span class="ml-2 text-gray-900 font-bold"><%= @category_to_keep.name %></span>
              </div>
              
              <div class="border-b pb-2">
                <span class="text-gray-600 text-sm font-semibold">Category Type:</span>
                <span class="ml-2 text-gray-900">
                  <%= @category_to_keep.category_type&.name || '(none)' %>
                </span>
              </div>
              
              <div class="border-b pb-2">
                <span class="text-gray-600 text-sm font-semibold">Published:</span>
                <span class="ml-2 text-gray-900">
                  <%= @category_to_keep.published? ? 'Yes' : 'No' %>
                </span>
              </div>
              
              <div class="border-b pb-2">
                <span class="text-gray-600 text-sm font-semibold">Position:</span>
                <span class="ml-2 text-gray-900">
                  <%= @category_to_keep.position %>
                </span>
              </div>
              
              <div class="border-b pb-2">
                <span class="text-gray-600 text-sm font-semibold">Created:</span>
                <span class="ml-2 text-gray-900"><%= @category_to_keep.created_at&.strftime("%Y-%m-%d %H:%M") || 'N/A' %></span>
              </div>
              
              <div>
                <span class="text-gray-600 text-sm font-semibold">Associated Records:</span>
                <span class="ml-2 text-gray-900 font-bold"><%= @keep_categorizable_items.count %></span>
              </div>
              
              <% if @keep_categorizable_items.any? %>
                <div class="mt-4">
                  <h3 class="text-sm font-semibold text-gray-700 mb-2">Tagged Items:</h3>
                  <ul class="text-sm text-gray-600 space-y-1 max-h-40 overflow-y-auto">
                    <% @keep_categorizable_items.each do |item| %>
                      <li class="pl-2">
                        • <%= item.categorizable_type %>: 
                        <%= item.categorizable.try(:name) || item.categorizable.try(:title) || "ID #{item.categorizable_id}" %>
                      </li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Warning and Action -->
        <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6">
          <div class="flex">
            <div class="flex-shrink-0">
              <i class="fa-solid fa-exclamation-triangle text-yellow-400"></i>
            </div>
            <div class="ml-3">
              <p class="text-sm text-yellow-700">
                <strong>Warning:</strong> This action cannot be undone. 
                The category "<%= @category_to_delete.name %>" (ID: <%= @category_to_delete.id %>) will be permanently deleted, 
                and all its <%= @delete_categorizable_items.count %> associations will be moved to 
                "<%= @category_to_keep.name %>" (ID: <%= @category_to_keep.id %>).
              </p>
            </div>
          </div>
        </div>

        <!-- Execute Form -->
        <%= form_with url: dedupe_execute_categories_path, method: :post, local: true, 
                      data: { turbo_confirm: "Are you sure you want to merge these categories? This action cannot be undone!" },
                      class: "flex gap-4 justify-center" do |f| %>
          <%= f.hidden_field :category_to_delete_id, value: @category_to_delete.id %>
          <%= f.hidden_field :category_to_keep_id, value: @category_to_keep.id %>
          
          <%= f.submit "Execute Merge", 
                      class: "px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-semibold text-lg" %>
          
          <%= link_to "Cancel", 
                      dedupe_index_categories_path, 
                      class: "px-6 py-3 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors font-semibold text-lg" %>
        <% end %>

      </div>
    </div>
  </div>
</div>

<%= simple_form_for(@category) do |f| %>
  <div class="space-y-6">

    <!-- Errors -->
    <%= f.error_notification %>
    <%= render "shared/errors", resource: @category if @category.errors.any? %>

    <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-4">
      <div class="space-y-6 md:col-span-3">
        <!-- One-line Flex Fields -->
        <div class="flex flex-wrap gap-6">
          <!-- Name -->
          <div class="min-w-[220px] flex-1">
            <%= f.input :name,
                        label: "Name",
                        input_html: { class: "form-control" } %>
          </div>

          <!-- Category Type -->
          <div class="min-w-[220px] flex-1">
            <%= f.input :category_type_id,
                        label: "Category Type",
                        required: true,
                        collection: @category_types,
                        label_method: :name,
                        value_method: :id,
                        include_blank: "Select a Type",
                        input_html: { class: "form-control" } %>
          </div>

          <div class="min-w-[150px] flex-1">
            <label class="mb-3 block text-md font-medium text-gray-700">
              Position
            </label>
            <div class="flex items-center gap-x-2">
              <span class="mb-2 font-medium text-gray-900">
                <%= f.object.position %>
              </span>
            </div>
          </div>
        </div>

        <!-- Description -->
        <div>
          <%= f.input :description,
                      as: :text,
                      label: "Description",
                      hint: "Optional. Shown under this option on the public registration form to clarify its meaning when the name alone isn't enough.",
                      input_html: { class: "form-control", rows: 2 } %>
        </div>

        <!-- Story Share portal placement -->
        <div class="max-w-[220px]">
          <%= f.input :story_share_position,
                      as: :integer,
                      label: "Story share position",
                      hint: "Optional. Shown in the Story Share portal's audience nav at this position. Leave blank to omit.",
                      input_html: { class: "form-control", min: 1 } %>
        </div>
      </div>

      <div class="admin-only mt-6 rounded bg-blue-100 p-3 md:mt-0">
        <%= render "shared/visibility_info", flags: %i[published] %>
        <div class="grid grid-cols-1 items-center">
          <%= visibility_flag_input f, :published %>
        </div>
      </div>
    </div>

    <div class="action-buttons mt-8 flex justify-center gap-3">
      <% if allowed_to?(:destroy?, f.object) %>
        <%= link_to "Delete", @category, class: button_classes(:danger_outline),
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete?" } %>
      <% end %>
      <%= link_to "Cancel", categories_path, class: button_classes(:secondary_outline) %>
      <%= f.button :submit, class: button_classes(:primary) %>
    </div>

  </div>
<% end %>

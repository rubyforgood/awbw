<h1>New contact form submission</h1>

<div style="text-align: left;">
  <p>
    <% if @user.present? %>
      <strong><%= @user.full_name %></strong> has submitted a message through the contact form.
    <% else %>
      <strong><%= "#{@contact_us[:first_name]} #{@contact_us[:last_name]}" %></strong> has submitted a message through the contact form.
    <% end %>
  </p>

  <% if @contact_us[:agency].present? %>
    <p>
      <strong>Organization:</strong> <%= @contact_us[:agency] %>
    </p>
  <% end %>

  <p>
    <strong>Email:</strong> <%= @contact_us[:from] %>
  </p>
</div>

<div style="
  background-color:#f3f4f6;
  border-radius:6px;
  padding:12px;
  margin:16px 0;
  text-align:left;
">
  <p>
    <strong>Subject:</strong> <%= @contact_us[:subject] %>
  </p>

  <p>
    <%= @contact_us[:message] %>
  </p>
</div>

<% if @registration.present? %>
  <div style="text-align: left; margin: 16px 0;">
    <p style="margin: 0 0 6px; font-size: 13px; color: #6b7280;">
      Sent from the scholarship page for
      <strong><%= @registration.event&.title %></strong>
      (<%= @registration.registrant&.full_name %>).
    </p>
    <a href="<%= edit_event_registration_url(@registration) %>"
       style="display:inline-block;background:#e5e7eb;color:#111827;
         text-decoration:none;padding:8px 14px;border-radius:6px;font-weight:bold;">
      View registration
    </a>
  </div>
<% end %>

<div style="text-align: left;">
  <p style="font-size: 13px; color: #6b7280;">
    Submitted on
    <%= Time.current
            .in_time_zone("Pacific Time (US & Canada)")
            .strftime("%B %-d, %Y at %-l:%M %p %Z") %>
  </p>
</div>

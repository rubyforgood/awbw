<p style="margin-bottom: 6px;">
  New contact us page message
</p>

<p style="margin: 0;">
  <% if @user.present? %>
    Name: <strong><%= @user.full_name %><br></strong>
    Organization: <strong><%= @contact_us[:agency] %></strong>
  <% else %>
    <strong>Name:</strong> <%= "#{@contact_us[:first_name]} #{@contact_us[:last_name]}" %><br>
    <strong>Org:</strong> <%= @contact_us[:agency] %>
  <% end %>
</p>

<p style="margin: 4px 0 16px; font-size: 13px; color: #6b7280;">
  Submitted on <%= Time.now.in_time_zone("Pacific Time (US & Canada)")
                           .strftime("%B %-d, %Y at %-l:%M %p %Z") %>
</p>

<hr>

<h2>
  Message
</h2>

<p>
  <span style="font-weight: normal; color:#6b7280;">
    <%= @contact_us[:message] %>
  </span>
</p>

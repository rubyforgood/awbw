<%# One fixed payment-method option, rendered as an on/off checkbox. The label is
    fixed (hidden field), so admins can only turn the method on or off — checking
    keeps/creates the join, unchecking destroys it. The hidden _destroy "1" paired
    with the checkbox "0" inverts the checkbox to mean "included". %>
<label class="flex items-center gap-2 text-sm text-gray-700">
  <%= opt.hidden_field :option_name, value: label %>
  <%= hidden_field_tag "#{opt.object_name}[_destroy]", "1" %>
  <%= check_box_tag "#{opt.object_name}[_destroy]", "0", included,
        class: "rounded border-gray-300 #{DomainTheme.text_class_for(:forms, intensity: 600)}" %>
  <span><%= label %></span>
</label>

<div class="mt-8 rounded-lg border border-gray-200 bg-gray-50 p-4">
  <h2 class="mb-1 text-lg font-semibold text-gray-700">Legacy forms</h2>
  <p class="mb-3 max-w-2xl text-sm text-gray-500">The workshop-log and monthly-report templates. Kept for their existing answers rather than shown in the main list.</p>
  <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
    <% forms.each do |form| %>
      <% form = form.decorate %>
      <li class="flex items-center justify-between gap-4 px-4 py-2.5">
        <div class="min-w-0">
          <p class="truncate text-sm font-medium text-gray-800"><%= form.display_name %></p>
          <p class="truncate text-xs text-gray-500"><%= form.owner_label %></p>
        </div>
        <div class="flex shrink-0 items-center gap-3 text-xs">
          <span class="text-gray-500"><%= pluralize(form.form_fields.size, "field") %></span>
          <%= link_to form.answers_label, form.answers_path,
                      class: "font-medium #{DomainTheme.text_class_for(:forms, intensity: 600)} #{DomainTheme.text_class_for(:forms, intensity: 800, hover: true)} underline" %>
        </div>
      </li>
    <% end %>
  </ul>
</div>

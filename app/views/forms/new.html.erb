<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="<%= DomainTheme.bg_class_for(:forms) %> border border-gray-200 rounded-xl shadow p-6">
  <div class="flex flex-wrap justify-end gap-2 mb-4">
    <%= link_to "Home", root_path, class: "text-sm text-gray-500 hover:text-gray-700 px-2 py-1" %>
    <%= link_to "Forms", forms_path, class: "text-sm text-gray-500 hover:text-gray-700 px-2 py-1" %>
  </div>

  <h1 class="text-2xl font-semibold text-gray-900 mb-2">Create a new form</h1>
  <p class="text-gray-600 mb-8">Choose a template to start with, or create a blank form.</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <% @builders.each do |builder| %>
      <% if builder[:key] == "generic" %>
        <%= form_with url: forms_path, method: :post, class: "block" do %>
          <input type="hidden" name="builder_type" value="<%= builder[:key] %>">
          <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6 hover:shadow-md transition-shadow">
            <h3 class="text-lg font-semibold text-gray-800 mb-2"><%= builder[:name] %></h3>
            <p class="text-sm text-gray-600 mb-4"><%= builder[:description] %></p>
            <div class="flex items-center gap-3">
              <input type="text" name="form_name" placeholder="Form name"
                     class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-800 shadow-sm focus:ring-blue-500 focus:border-blue-500">
              <button type="submit" class="btn btn-primary">Create</button>
            </div>
          </div>
        <% end %>
      <% else %>
        <%= form_with url: forms_path, method: :post, class: "block" do %>
          <input type="hidden" name="builder_type" value="<%= builder[:key] %>">
          <button type="submit"
                  class="w-full text-left bg-white border border-gray-200 rounded-lg shadow-sm p-6 hover:shadow-md hover:border-gray-300 transition-shadow cursor-pointer">
            <h3 class="text-lg font-semibold text-gray-800 mb-2"><%= builder[:name] %></h3>
            <p class="text-sm text-gray-600"><%= builder[:description] %></p>
          </button>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<% content_for(:page_bg_class, "admin-or-public-or-authpublished") %>
<%= render layout: "shared/show_page", locals: { domain: :video_recordings, surface: DomainTheme.bg_class_for(:video_recordings, intensity: @video_recording.is_instructional? ? 100 : 50) } do %>
      <!-- Top Right Utility Links -->
      <div class="mb-4 flex flex-wrap justify-end gap-2">
        <%= link_to "Home", root_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
        <% if @video_recording.is_instructional? %>
          <%= link_to "Instructional videos", video_recordings_path(video_type: "instructional"), class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
        <% else %>
          <%= link_to "Videos", video_recordings_path(video_type: "all"), class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
        <% end %>
        <% if allowed_to?(:edit?, @video_recording) %>
          <%= link_to "Edit", edit_video_recording_path(@video_recording),
                      class: "admin-only bg-blue-100 text-sm #{eyebrow_link_class} px-2 py-1" %>
        <% end %>
        <span class="inline-block text-sm">
          <%= render "bookmarks/editable_bookmark_button", resource: @video_recording.object %>
        </span>
      </div>

      <!-- Resource Card -->
      <div class="space-y-6 rounded-lg bg-white p-6 shadow-md">

        <!-- Title -->
        <div class="my-6 font-semibold text-gray-900">
          <%= title_with_badges(@video_recording, font_size: "text-3xl", display: true) %>
        </div>

        <!-- Embedded Video -->
        <% if @video_recording.youtube_url.present? %>
          <div class="mb-6">
            <div class="relative w-full overflow-hidden rounded-lg shadow-sm" style="padding-top: 56.25%;">
              <iframe
                src="<%= youtube_embed_url(@video_recording.youtube_url) %>"
                title="<%= @video_recording.title %>"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                class="absolute inset-0 h-full w-full border-0">
              </iframe>
            </div>
          </div>
        <% end %>

        <%= render "assets/display_assets", resource: @video_recording, link: true %>


        <!-- Main Text -->
        <%= @video_recording.rhino_body %>

        <!-- Back Button -->
        <div class="mt-8">
          <% if @video_recording.is_instructional? %>
            <%= link_to "← Instructional videos", video_recordings_path(video_type: "instructional"), class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
          <% else %>
            <%= link_to "← Videos", video_recordings_path(video_type: "all"), class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
          <% end %>
        </div>

      </div>
<% end %>

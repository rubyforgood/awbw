<%= turbo_frame_tag "video_library_results" do %>
  <div class="mt-4">
    <div class="overflow-x-auto">
        <% if @video_library.any? %>
          <%= tag.div class: "grid grid-cols-1 lg:grid-cols-2 gap-4" do %>
            <% @video_library.each_with_index do |video_recording, idx| %>
              <%= tag.div class: "bg-white shadow-md rounded-md pt-6 px-2 pb-2" do %>
                <%= render "video_recording", video_recording: video_recording %>
              <% end %>
            <% end %>
          <% end %>

          <!-- Pagination -->
          <div class="pagination flex justify-center mt-12">
            <%= tailwind_paginate @video_library %>
          </div>
        <% else %>
          <div class="text-gray-500 italic">
            No videos found matching your filters.
          </div>
        <% end %>
      </div>
  </div>
<% end %>

<div class="max-w-6xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <% if @allocatable %>
      <h1 class="text-2xl font-bold">
        Allocations
      </h1>
      <h2 class="text-xl font-medium">
        <% if @allocatable.is_a?(EventRegistration) %>
          <%= @allocatable.registrant.full_name %>
          -
          <%= @allocatable.event.title %>
        <% else %>
          <%= @allocatable.model_name.human %>
        <% end %>
      </h2>
      <%= link_to "← Back", allocations_path(allocatable_sgid: params[:allocatable_sgid]), class: "btn btn-secondary" %>
    <% else %>
      <h1 class="text-2xl font-bold">All Allocations</h1>
    <% end %>
  </div>

  <% unless params[:allocatable_sgid].present? %>
    <%= render 'search_boxes' %>
    <% result_src = allocations_path + "?" + request.query_string %>
    <%= turbo_frame_tag :allocation_results, src: result_src, data: { turbo: "temporary" } do %>
      <div class="min-h-screen">
        <div class="animate-pulse">
          <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
            <div class="bg-gray-50 px-6 py-3 flex gap-16">
              <div class="h-4 w-12 bg-gray-200 rounded"></div>
              <div class="h-4 w-20 bg-gray-200 rounded"></div>
              <div class="h-4 w-16 bg-gray-200 rounded"></div>
              <div class="h-4 w-20 bg-gray-200 rounded"></div>
              <div class="h-4 w-24 bg-gray-200 rounded"></div>
              <div class="h-4 w-14 bg-gray-200 rounded ml-auto"></div>
            </div>

            <% 10.times do %>
              <div class="border-t border-gray-200 px-6 py-4 flex gap-16">
                <div class="h-4 w-20 bg-gray-200 rounded"></div>
                <div class="h-4 w-32 bg-gray-200 rounded"></div>
                <div class="h-4 w-16 bg-gray-200 rounded"></div>
                <div class="h-4 w-20 bg-gray-200 rounded"></div>
                <div class="h-4 w-32 bg-gray-200 rounded"></div>
                <div class="h-4 w-10 bg-gray-200 rounded ml-auto"></div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="flex justify-center mt-6 space-x-2 animate-pulse">
          <div class="h-8 w-10 bg-gray-200 rounded"></div>
          <div class="h-8 w-10 bg-gray-200 rounded"></div>
          <div class="h-8 w-10 bg-gray-200 rounded"></div>
        </div>
      </div>
    <% end %>
  <% else %>
    <% if @allocatable.is_a?(EventRegistration) %>
      <div id="payment-form" class="flex gap-2 mb-4">
        <%= button_to "Add Cash Payment", 
            allocation_form_payments_path(type: "CashPayment", allocatable_sgid: params[:allocatable_sgid]),
            class: "btn btn-secondary" %>

        <%= button_to "Add Check Payment", 
            allocation_form_payments_path(type: "CheckPayment", allocatable_sgid: params[:allocatable_sgid]),
            class: "btn btn-secondary" %>

        <%= button_to "Add Discount", 
            allocation_form_discounts_path(allocatable_sgid: params[:allocatable_sgid]),
            class: "btn btn-secondary" %>
      </div>
      <div id="discount-form"></div>
    <% end %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payer</th>

            <% unless @allocatable %>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Allocated To</th>
            <% end %>

            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ref</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>

        <tbody class="bg-white divide-y divide-gray-200">
          <% @allocations.each do |allocation| %>
            <% row_class = if allocation.amount.to_i < 0
                'bg-red-50 hover:bg-red-100'
              elsif allocation.reverted_id.present?
                'bg-gray-100 border border-gray-300 opacity-60 hover:bg-gray-200 hover:opacity-100'
              else
                'hover:bg-gray-50'
              end %>

            <tr class="<%= row_class %>">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= allocation.id %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= allocation.source.class.name.underscore.titleize.gsub(" Payment", "").gsub("External Processor", "Stripe") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= if allocation.source.respond_to?(:payer)
                  allocation.source.payer&.name || "Unknown"
                elsif allocation.source.is_a?(Discount)
                  "Discount"
                else
                  "Scholarship"
                end %></td>

              <% unless @allocatable %>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <% if allocation.allocatable_type == "EventRegistration" && allocation.allocatable.present? %>
                    <%= truncate("#{allocation.allocatable.registrant.full_name} - #{allocation.allocatable.event.title}", length: 40) %>
                  <% else %>
                    <%= allocation.allocatable_type.underscore.titleize %>
                  <% end %>
                </td>
              <% end %>

              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">$<%= "%.2f" % allocation.amount_dollars %></td>

              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <% if allocation.amount.to_i < 0 %>
                  <%= Allocation.find_by(reverted_id: allocation.id)&.id || "-" %>
                <% else %>
                  <%= allocation.reverted_id ? allocation.reverted_id : "-" %>
                <% end %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= allocation.created_at.strftime("%B %d, %Y") %></td>

              <td class="px-6 py-4 whitespace-nowrap text-sm text-left font-medium">
                <% if allocation.source.respond_to?(:payer) %>
                  <%= link_to "View", payment_path(allocation.source), class: "text-blue-600 hover:text-blue-800" %>
                <% elsif allocation.source.is_a?(Discount) %>
                  <%= button_to "Remove", discount_path(allocation.source), method: :delete,
                        class: "cursor-pointer text-danger hover:text-danger-dark",
                        data: { turbo_confirm: "Remove this discount?" } %>
                <% else %>
                  <%= link_to "View", edit_scholarship_path(allocation.source), class: "text-blue-600 hover:text-blue-800" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @allocations.respond_to?(:total_pages) && @allocations.total_pages > 1 %>
      <div class="pagination flex justify-center mt-6"><%= tailwind_paginate @allocations %></div>
    <% end %>
  <% end %>
</div>

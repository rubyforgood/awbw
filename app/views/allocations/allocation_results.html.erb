<%= turbo_frame_tag :allocation_results do %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden blur-on-submit">
    <% if @allocations.any? %>
      <% total = @allocations.respond_to?(:total_entries) ? @allocations.total_entries : @allocations.size %>
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
        <p class="text-sm text-gray-500"><%= total %> allocation<%= "s" if total != 1 %></p>
      </div>

      <div class="overflow-x-auto animate-fade">
        <table class="w-full border-collapse border border-gray-200">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">ID</th>
              <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Type</th>
              <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Source</th>
              <% unless @allocatable %>
                <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Allocated to</th>
              <% end %>
              <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Amount</th>
              <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Ref</th>
              <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Date</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-200">
            <% @allocations.each do |allocation| %>
              <% row_class = if allocation.amount.to_i < 0
                  "bg-red-50 hover:bg-red-100"
                elsif allocation.reverted_id.present?
                  "bg-gray-100 opacity-60 hover:bg-gray-200 hover:opacity-100"
                else
                  "hover:bg-gray-50"
                end %>

              <tr class="<%= row_class %> transition-colors duration-150">
                <td class="px-4 py-2 text-sm text-gray-500"><%= allocation.id %></td>
                <td class="px-4 py-2 text-sm text-gray-800"><%= allocation.source.class.name.underscore.titleize.gsub(" Payment", "").gsub("External Processor", "Stripe") %></td>
                <td class="px-4 py-2 text-sm text-gray-800"><%= if allocation.source.respond_to?(:payer)
                    name = allocation.source.payer&.name || "Unknown"
                    remaining = allocation.source.amount_cents_remaining
                    if remaining.present? && remaining > 0
                      "#{name} ($#{'%.2f' % (remaining / 100.0)} remaining)"
                    else
                      name
                    end
                  elsif allocation.source.is_a?(Discount)
                    "Discount"
                  else
                    "Scholarship"
                  end %></td>

                <% unless @allocatable %>
                  <td class="px-4 py-2 text-sm text-gray-800">
                    <% if allocation.allocatable_type == "EventRegistration" && allocation.allocatable.present? %>
                      <%= truncate("#{allocation.allocatable.registrant.full_name} - #{allocation.allocatable.event.title}", length: 40) %>
                    <% else %>
                      <%= allocation.allocatable_type.underscore.titleize %>
                    <% end %>
                  </td>
                <% end %>

                <td class="px-4 py-2 text-sm font-medium text-gray-900 tabular-nums">$<%= "%.2f" % allocation.amount_dollars %></td>

                <td class="px-4 py-2 text-sm text-gray-500">
                  <% if allocation.amount.to_i < 0 %>
                    <%= Allocation.find_by(reverted_id: allocation.id)&.id || "-" %>
                  <% else %>
                    <%= allocation.reverted_id ? allocation.reverted_id : "-" %>
                  <% end %>
                </td>

                <td class="px-4 py-2 text-sm text-gray-500 text-nowrap"><%= allocation.created_at.strftime("%B %d, %Y") %></td>

                <td class="px-4 py-2 text-right text-sm font-medium">
                  <% if allocation.source.respond_to?(:payer) %>
                    <%= link_to "View", payment_path(allocation.source), data: { turbo_frame: "_top" }, class: "text-blue-600 hover:text-blue-800 underline" %>
                  <% elsif allocation.source.is_a?(Discount) %>
                    <%= button_to "Remove", discount_path(allocation.source), method: :delete,
                          class: "cursor-pointer text-danger hover:text-danger-dark",
                          data: { turbo_confirm: "Remove this discount?", turbo_frame: "_top" } %>
                  <% else %>
                    <%= link_to "View", edit_scholarship_path(allocation.source), data: { turbo_frame: "_top" }, class: "text-blue-600 hover:text-blue-800 underline" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8">
        <%= @allocatable ? "No payments or allocations recorded yet." : "There are no allocations that match your search. Please try again." %>
      </p>
    <% end %>
  </div>

  <% if @allocations.respond_to?(:total_pages) && @allocations.total_pages > 1 %>
    <div class="pagination flex justify-center mt-6"><%= tailwind_paginate @allocations %></div>
  <% end %>
<% end %>

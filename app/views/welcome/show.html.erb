<div class="flex items-center justify-center">
  <div class="w-full max-w-md bg-white rounded-2xl shadow-lg mt-8 p-8">
    <h2 class="text-2xl font-semibold text-center text-gray-800 mb-6">Welcome!</h2>
    
    <div class="mb-6 text-center">
      <p class="text-gray-700">
        Your email has been confirmed. Set a password to complete your account setup.
      </p>
    </div>

    <%= form_with url: user_welcome_update_path(@user.welcome_instructions_token), method: :patch, html: { class: "space-y-4" } do |f| %>

      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <h4><%= pluralize(@user.errors.count, "error") %> prohibited this from being saved:</h4>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- NEW PASSWORD -->
      <div class="form-group password-container" data-controller="password-toggle">
        <%= f.label :password, "New password", class: "form-label" %>
        <%= f.password_field :password,
                            required: true,
                            autofocus: true,
                            autocomplete: "new-password",
                            autocorrect: "off",
                            autocapitalize: "off",
                            spellcheck: "false",
                            class: "form-control form-input password-field",
                            data: { password_toggle_target: "input" } %>
        <button
          type="button"
          class="toggle-password"
          data-action="password-toggle#toggle"
          aria-label="Toggle password visibility">
          <i class="fa-solid fa-eye" data-password-toggle-target="icon"></i>
        </button>
      </div>

      <!-- CONFIRM PASSWORD -->
      <div class="form-group password-container" data-controller="password-toggle">
        <%= f.label :password_confirmation, "Confirm new password", class: "form-label" %>
        <%= f.password_field :password_confirmation,
                            required: true,
                            autocomplete: "new-password",
                            autocorrect: "off",
                            autocapitalize: "off",
                            spellcheck: "false",
                            class: "form-control form-input password-field",
                            data: { password_toggle_target: "input" } %>
        <button
          type="button"
          class="toggle-password"
          data-action="password-toggle#toggle"
          aria-label="Toggle password visibility">
          <i class="fa-solid fa-eye" data-password-toggle-target="icon"></i>
        </button>
      </div>

      <div class="action-buttons mt-8 flex justify-center gap-3">
        <%= f.submit "Set password", class: "btn btn-primary" %>
      </div>

    <% end %>

    <div class="mt-6 text-center text-sm">
      <%= link_to "Skip and log in later", new_user_session_path, class: "text-blue-600 hover:underline" %>
    </div>
  </div>
</div>

<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<% back = capture do %>
  <% if params[:return_to] == "onboarding" && params[:event_id].present? %>
    <div class="mb-2">
      <%= link_to onboarding_event_row_path(params[:event_id], params[:highlight]), class: "text-sm #{eyebrow_link_class} px-2 py-1" do %>
        <i class="fa-solid fa-arrow-left text-xs"></i> Onboarding
      <% end %>
    </div>
  <% elsif params[:return_to] == "person_edit" && params[:person_id].present? %>
    <div class="mb-2">
      <%= link_to edit_person_path(params[:person_id], anchor: "addresses"), class: "text-sm #{eyebrow_link_class} px-2 py-1" do %>
        <i class="fa-solid fa-arrow-left text-xs"></i> Edit person
      <% end %>
    </div>
  <% end %>
<% end %>
<% actions = capture do %>
  <%= filemaker_project_links(@organization, label: "FM project", linked_only: true,
                              link_class: "admin-only bg-blue-100 text-sm #{eyebrow_link_class} px-2 py-1") %>
  <%= filemaker_organization_links(@organization, label: "FM organization", linked_only: true,
                                   link_class: "admin-only bg-blue-100 text-sm #{eyebrow_link_class} px-2 py-1") %>
  <%= link_to "Home", root_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
  <%= link_to "Organizations", organizations_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
  <%= link_to "Profile", organization_path(@organization), class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
<% end %>
<%= render layout: "shared/form_page",
           locals: { domain: :organizations, icon: "fas fa-building", eyebrow: "Edit organization",
                     title: truncate(@organization.name, length: 50),
                     back: back, actions: actions, width: "max-w-7xl",
                     sticky_header: true, card: false } do %>
  <div class="border-primary/10 rounded-2xl border bg-white p-6 shadow-sm">
    <%= render "form" %>
    <%= render "shared/audit_info", resource: @organization %>
    <% if allowed_to?(:index?, with: Admin::AhoyActivityPolicy) %>
      <div class="mt-4 flex justify-end">
        <%= render "application/activity_log", record: @organization,
                   events: Analytics::OrganizationActivityEvents.new(@organization).relation %>
      </div>
    <% end %>
  </div>
  <div class="border-primary/10 rounded-2xl border bg-white p-6 shadow-sm">
    <div class="mb-2 font-semibold text-gray-700">
      Associated records
    </div>
    <div class="border-primary/10 rounded-2xl border bg-gray-50 p-4 shadow-sm">
      <%= render "associated_records", organization: @organization %>
    </div>
  </div>
<% end %>

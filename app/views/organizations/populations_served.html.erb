<% content_for(:page_bg_class, "admin-or-authpublished") %>
<div class="<%= DomainTheme.bg_class_for(:organizations) %> border-primary/10 rounded-2xl border p-6 shadow-sm">
  <h2 class="mb-4 text-lg font-semibold text-gray-800">
     Sector Distribution for <%= @organization.name %>
  </h2>
  <p class="mb-4 text-sm text-gray-500">Primary sectors of the people actively affiliated with this organization.</p>

  <div class="bt-white rounded">
    <% if @sectors_by_people.any? %>
      <ul class="space-y-2">
        <% @sectors_by_people.each do |sector, count| %>
          <li class="flex items-center justify-between rounded border border-gray-100 bg-white p-2 shadow-sm">
            <span><%= sector.name %></span>
           <span class="font-medium text-gray-600">
            <%= count %> <%= count == 1 ? "person" : "people" %>
          </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500 italic">No sectors found for this organization.</p>
    <% end %>
  </div>

  <div class="mt-6">
    <%= link_to "← Back to Organization", organization_path(@organization),
                class: button_classes(:secondary_outline) %>
  </div>
</div>

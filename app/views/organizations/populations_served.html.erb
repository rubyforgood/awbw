<% content_for(:page_bg_class, "admin-or-owner-or-authsearchable") %>
<% facilitator_count = @organization.active_facilitators.size %>
<% show_sectors = @organization.profile_show_sectors? %>
<% show_age_groups = @organization.profile_show_age_ranges? %>
<% back_path, back_label = @organization.decorate.breakdown_return_link(params[:return_to]) %>
<div class="bg-brand-cream border-primary/10 overflow-hidden rounded-2xl border shadow-sm">
  <%= render accent_strip_partial %>
  <div class="<%= DomainTheme.bg_class_for(:organizations, intensity: 100) %> px-4 pt-5 pb-8 sm:px-8">
    <div class="mb-6">
      <%= link_to back_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" do %>
        <i class="fa-solid fa-arrow-left text-xs"></i> <%= back_label %>
      <% end %>
    </div>
    <span class="text-2xs <%= DomainTheme.text_class_for(:organizations, intensity: 700) %> font-semibold tracking-widest uppercase">Populations served</span>
    <h1 class="text-primary font-display text-4xl font-semibold tracking-tight">Sectors and age groups</h1>
    <div class="mt-2 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <p class="max-w-2xl text-gray-700">
        Everything the <%= pluralize(facilitator_count, "active facilitator") %> at <%= @organization.name %>
        list on their profiles.<br>
        The organization's profile and list show only primary tags.
      </p>
      <% if show_sectors || show_age_groups %>
        <div class="flex shrink-0 items-center gap-2 text-sm">
          <span class="text-gray-600">Sort by</span>
          <div class="inline-flex rounded-lg border border-gray-200 bg-white p-0.5 shadow-sm">
            <% Organization::BREAKDOWN_SORT_OPTIONS.each do |label, value| %>
              <% active = value == @sort %>
              <%= link_to label, populations_served_organization_path(@organization, sort: value, return_to: params[:return_to].presence_in(%w[organization_edit])),
                          aria: { current: (active ? "true" : nil) },
                          class: "rounded-md px-3 py-1 font-medium #{active ? "#{DomainTheme.bg_class_for(:organizations, intensity: 700)} text-white" : "text-gray-600 hover:bg-gray-100"}" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Each column follows the organization's own profile display preference, so this
      page never reveals a roll-up the profile hides. %>
  <div class="grid grid-cols-1 gap-6 p-4 sm:p-8 <%= "md:grid-cols-2" if show_sectors && show_age_groups %>">
    <% if show_sectors %>
      <%= render "organizations/tag_breakdown", title: "Sectors", domain: :sectors, facilitator_count: facilitator_count,
                 rows: @organization.active_facilitator_sector_breakdown(sort: @sort), link_param: :sector_names_all %>
    <% end %>
    <% if show_age_groups %>
      <%= render "organizations/tag_breakdown", title: "Age groups served", domain: :categories, facilitator_count: facilitator_count,
                 rows: @organization.active_facilitator_age_group_breakdown(sort: @sort), link_param: :category_names_all %>
    <% end %>
    <% unless show_sectors || show_age_groups %>
      <p class="text-gray-500 italic">This organization doesn't show sectors or age groups on its profile.</p>
    <% end %>
  </div>
</div>

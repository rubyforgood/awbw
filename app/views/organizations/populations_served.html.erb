<% content_for(:page_bg_class, "admin-or-authpublished") %>
<% people_count = @organization.active_people.size %>
<div class="bg-brand-cream border-primary/10 overflow-hidden rounded-2xl border shadow-sm">
  <%= render accent_strip_partial %>
  <div class="<%= DomainTheme.bg_class_for(:organizations, intensity: 100) %> px-4 pt-5 pb-8 sm:px-8">
    <div class="mb-6">
      <%= link_to organization_path(@organization), class: "text-sm #{eyebrow_link_class} px-2 py-1" do %>
        <i class="fa-solid fa-arrow-left text-xs"></i> <%= @organization.name %>
      <% end %>
    </div>
    <span class="text-2xs <%= DomainTheme.text_class_for(:organizations, intensity: 700) %> font-semibold tracking-widest uppercase">Populations served</span>
    <h1 class="text-primary font-display text-4xl font-semibold tracking-tight">Sectors and age groups</h1>
    <p class="mt-2 max-w-2xl text-gray-700">
      Everything the <%= pluralize(people_count, "person") %> actively affiliated with <%= @organization.name %>
      list on their profiles. The organization's profile and list show only primary tags.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6 p-4 sm:p-8 md:grid-cols-2">
    <%= render "organizations/tag_breakdown", title: "Sectors", domain: :sectors, people_count: people_count,
               rows: @organization.active_people_sector_breakdown, link_param: :sector_names_all %>
    <%= render "organizations/tag_breakdown", title: "Age groups served", domain: :categories, people_count: people_count,
               rows: @organization.active_people_age_group_breakdown, link_param: :category_names_all %>
  </div>
</div>

<div class="min-h-screen py-10">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white border border-gray-200 rounded-2xl shadow-lg p-6 sm:p-8">
      <div class="flex items-center mb-6">
        <div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-yellow-100">
          <svg
            class="h-6 w-6 text-yellow-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            />
          </svg>
        </div>

        <h1 class="ml-4 text-xl font-semibold text-gray-900">Possible duplicate organization</h1>
      </div>

      <p class="text-sm text-gray-600 mb-2">Checking: <span class="font-medium text-gray-900"><%= @name %></span></p>

      <p class="text-sm text-gray-500 mb-4">
        We found existing organizations in the system with a similar name.
      </p>

      <p class="text-sm text-gray-500 mt-4 mb-2">
        Please review the list below:
      </p>

      <ul class="divide-y divide-gray-200 border border-gray-200 rounded-lg mb-6">
        <% @duplicates.each do |dup| %>
          <li class="px-4 py-3">
            <div class="flex items-center gap-2 flex-wrap">
              <%= link_to dup[:name],
                          organization_path(dup[:id]),
                          target: "_blank",
                          class: "text-blue-600 hover:text-blue-800 underline font-medium" %>

              <% if dup[:blocked] %>
                <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-red-100 text-red-700">exact match</span>
              <% else %>
                <% if dup[:match_type] == "exact" %>
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-green-100 text-green-700">exact match</span>
                <% else %>
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-yellow-100 text-yellow-700">similar match</span>
                <% end %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>

      <div class="flex flex-col items-center gap-3">
        <% shareable_url = check_duplicates_organizations_url(name: @name) %>

        <%= mail_to "",
              "Ask a colleague",
              subject: "Possible duplicate organization: #{@name}",
              body: "I'm trying to add a new organization and found a possible duplicate. Can you take a look?\n\n#{shareable_url}",
              class: "text-sm text-gray-500 hover:text-blue-600 underline" %>
      </div>
    </div>
  </div>
</div>

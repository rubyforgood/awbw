<div class="mb-4">
  <%= form_with url: organizations_path, method: :get,
    data: { controller: "collection searchable-checkbox", turbo_frame: "organizations_results" },
    autocomplete: "off",
    class: "flex flex-col gap-3 md:flex-row md:items-end" do %>
    <%= render "shared/filter_text", param: :query, label: "Name", wrapper_class: "w-full md:flex-1" %>
    <%= render "shared/filter_multiselect", param: :sector_ids, label: "Sector",
          options: @sector_options || [],
          selected: Array(params[:sector_ids]).map(&:to_i), placeholder: "Any sector",
          wrapper_class: "w-full md:flex-1" %>
    <%= render "shared/filter_multiselect", param: :age_range_ids, label: "Age group",
          options: @age_group_options || [],
          selected: Array(params[:age_range_ids]).map(&:to_i), placeholder: "Any age group",
          wrapper_class: "w-full md:flex-1" %>
    <%= render "shared/filter_multiselect", param: :organization_types, label: "Type",
          options: Organization::ORGANIZATION_TYPE_FILTER_OPTIONS,
          selected: Array(params[:organization_types]), placeholder: "Any type",
          wrapper_class: "w-full md:flex-1" %>
    <%= render "shared/filter_text", param: :address, label: "Address", submit: true,
          tooltip: ContactSearchable::CONTACT_SEARCH_HINT, wrapper_class: "w-full md:flex-1" %>

    <% if allowed_to?(:manage?, Organization) %>
      <%= render "shared/filter_select", param: :program_status, label: "Program status",
            options: Organization::PROGRAM_STATUS_FILTER_OPTIONS, selected: params[:program_status],
            blank: "Any status", field_class: search_field_class,
            wrapper_class: "admin-only w-full bg-blue-100 md:w-40" %>
    <% end %>

    <%= render "shared/search_clear", url: organizations_path, label: "Clear" %>
  <% end %>
</div>

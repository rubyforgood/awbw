<% return unless organization.persisted? %>
<% org_filter = { organization_id: organization.id } %>
<% monthly_reports = MonthlyReport.where(org_filter) %>
<%# Mirrors the person's associated records: administrative system records, then
    content linked to the org or credited to its people. Members see this card too,
    so each button shows only to viewers its index page lets in. %>
<% administrative = [
     organization.event_registrations,
     organization.workshop_logs,
     (monthly_reports if monthly_reports.exists?)
   ].compact %>
<%# Column flow pairs each record type with its related idea: community news /
    resources · stories / story ideas · workshops / workshop ideas · workshop
    variations / workshop variation ideas. Workshop ideas carry no organization,
    so they're credited through the org's active facilitators. %>
<% contributed = [
     CommunityNews.where(org_filter),
     Resource.where(org_filter),
     Story.where(org_filter),
     StoryIdea.where(org_filter),
     organization.credited_workshops,
     organization.credited_to_facilitators(WorkshopIdea),
     WorkshopVariation.where(org_filter),
     WorkshopVariationIdea.where(org_filter)
   ] %>

<div class="mb-5">
  <h3 class="mb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">Administrative</h3>
  <ul class="columns-1 gap-x-6 sm:columns-2 md:columns-3">
    <% administrative.each do |records| %>
      <% next unless allowed_to?(:index?, records.klass) %>
      <li class="mb-2 break-inside-avoid"><%= index_button records, params: org_filter %></li>
    <% end %>
    <% if allowed_to?(:index?, with: Admin::AhoyActivityPolicy) %>
      <li class="mb-2 break-inside-avoid">
        <%= link_to organization_activity_path(organization),
                    data: { turbo_prefetch: false },
                    class: "group flex items-center gap-3 w-full px-3 py-2 rounded-lg admin-only bg-blue-50 hover:bg-blue-100 border border-gray-200 transition-colors duration-200 shadow-sm" do %>
          <span class="w-5 text-center text-gray-500"><i class="fa-solid fa-clock-rotate-left"></i></span>
          <span class="truncate font-medium text-gray-700">Activity</span>
          <span class="ml-auto inline-flex min-w-[2.25rem] items-center justify-center rounded-full border border-gray-200 bg-white px-2 py-0.5 text-sm font-semibold text-gray-700"><i class="fa-solid fa-magnifying-glass text-xs"></i></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>

<div>
  <h3 class="mb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">Contributed content</h3>
  <ul class="columns-1 gap-x-6 sm:columns-2 md:columns-4">
    <% contributed.each do |records| %>
      <% next unless allowed_to?(:index?, records.klass) %>
      <li class="mb-2 break-inside-avoid"><%= index_button records, params: org_filter %></li>
    <% end %>
  </ul>
</div>

<%= tag.div id: "duplicate_organizations_warning" do %>
  <% if @duplicates.present? %>
    <div class="mb-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <div class="flex items-start gap-3">
        <div class="flex-shrink-0">
          <svg
            class="h-5 w-5 text-yellow-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            />
          </svg>
        </div>

        <div class="flex-1">
          <h3 class="text-sm font-medium text-yellow-800">Possible duplicate organization</h3>

          <p class="text-sm text-yellow-700 mt-1">We found existing organizations with a similar name. <%= link_to "View details", check_duplicates_organizations_path(name: @name), target: "_blank", class: "underline hover:text-yellow-900" %></p>

          <div class="mt-3 bg-white">
            <ul class="divide-y divide-gray-300 border border-gray-300 rounded-md text-sm overflow-y-auto">
              <% @duplicates.each do |dup| %>
                <li class="px-3 py-2">
                  <%= link_to dup[:name], organization_path(dup[:id]), target: "_blank", class: "text-blue-600 hover:text-blue-800 underline" %>

                  <% if dup[:blocked] %>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-red-100 text-red-700">exact match</span>
                  <% else %>
                    <% if dup[:match_type] == "exact" %>
                      <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-green-100 text-green-700">exact match</span>
                    <% else %>
                      <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-yellow-100 text-yellow-700">similar match</span>
                    <% end %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>

          <% if @blocked %>
            <p class="text-sm text-red-600 font-medium m-2">An <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-red-100 text-red-700">exact match</span> with this name already exists.</p>
            <p class="text-sm text-gray-500 mb-6">
              Edit the existing organization or change the name.
            </p>
          <% end %>

          <% unless @blocked %>
            <div class="mt-3 flex items-center gap-2">
              <%= check_box_tag :skip_duplicate_check, "1", params[:skip_duplicate_check].present?, id: "skip_duplicate_check", class: "h-4 w-4 text-yellow-600 rounded" %>
              <%= label_tag :skip_duplicate_check, "Create anyway (this is a different organization)", for: "skip_duplicate_check", class: "text-sm text-yellow-700" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

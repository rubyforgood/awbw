<%# One page of the org's monthly reports (OrganizationsController#show ?section=). %>
<%# locals: (organization:, section:, records:) %>
<%= turbo_frame_tag "organization_monthly_reports_section" do %>
  <% if records.any? %>
    <ul class="divide-y divide-gray-200 blur-on-submit">
      <% records.each do |report| %>
        <li class="flex items-center justify-between gap-3 py-2">
          <%= link_to report.name, monthly_report_path(report), class: "#{eyebrow_link_class} hover:underline",
                      data: { turbo_frame: "_top" } %>
          <span class="text-sm text-gray-400"><%= report.display_date %></span>
        </li>
      <% end %>
    </ul>
    <div class="mt-6 flex justify-center">
      <%= tailwind_paginate records, url_for_page: ->(page) { organization_path(organization, section: section, page: page) } %>
    </div>
  <% else %>
    <p class="text-gray-500 italic">Nothing more to show.</p>
  <% end %>
<% end %>

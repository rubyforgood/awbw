<%# Profile pieces the org turned off, shown open (and collapsible) to admins — the
    org twin of people/hidden_from_profile_card. %>
<%# locals: (organization:, hidden_sections:, workshop_log_summary: nil) %>
<% pieces = organization.hidden_profile_pieces %>
<% events_hidden = !organization.profile_show_events_registered? %>
<% return if pieces.empty? && hidden_sections.empty? && workshop_log_summary.nil? && !events_hidden %>
<% contact_pieces = pieces & %i[profile_show_email profile_show_phone profile_show_website] %>
<% section_titles = { "workshops" => "Workshops authored", "stories" => "Stories" } %>
<div id="hidden_from_profile"
     class="scroll-mt-4 overflow-hidden rounded-2xl border-2 shadow-sm <%= org_hidden_wash_class %>"
     data-controller="expandable-card"
     data-expandable-card-expanded-value="true">
  <!-- Header -->
  <button type="button" data-action="expandable-card#toggle"
          aria-expanded="true"
          class="section-header flex w-full items-center gap-3 border-b px-5 py-4 text-left sm:px-6 <%= org_hidden_border_class %>">
    <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-white <%= org_hidden_icon_class %>">
      <i class="fa-solid fa-eye-slash"></i>
    </span>
    <h2 class="font-display text-2xl text-gray-900">Hidden from profile</h2>
    <span class="ml-auto flex items-center gap-3">
      <span class="text-sm italic <%= org_hidden_text_class %>">Only visible to admins</span>
      <i class="fa-solid fa-chevron-down rotate-180 text-gray-400 transition-transform" data-expandable-card-target="icon"></i>
    </span>
  </button>
  <!-- Hidden content -->
  <div class="section-content space-y-8 px-4 py-5 sm:space-y-10 sm:px-6 sm:py-6"
       data-expandable-card-target="body">
    <% if allowed_to?(:edit?, organization) %>
      <p class="text-sm text-gray-600">
        These are turned off in the organization's sharing settings.
        <%= link_to "Change sharing settings", edit_organization_path(organization, anchor: "profile-preferences"), class: "font-medium underline hover:text-primary" %>
      </p>
    <% end %>
    <% if contact_pieces.any? %>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
        <% if contact_pieces.include?(:profile_show_email) %>
          <%= render "organizations/profile_pieces/email_chip", organization: organization %>
        <% end %>
        <% if contact_pieces.include?(:profile_show_phone) %>
          <%= render "organizations/profile_pieces/phone_chip", organization: organization %>
        <% end %>
        <% if contact_pieces.include?(:profile_show_website) %>
          <%= render "organizations/profile_pieces/website_chip", organization: organization %>
        <% end %>
      </div>
    <% end %>
    <% if pieces.include?(:profile_show_description) %>
      <div>
        <h3 class="mb-3 font-display text-xl text-gray-900">Description</h3>
        <%= render "organizations/profile_pieces/description", organization: organization %>
      </div>
    <% end %>
    <% if pieces.include?(:profile_show_sectors) %>
      <div>
        <h3 class="mb-3 font-display text-xl text-gray-900">Sectors</h3>
        <%= render "organizations/profile_pieces/sectors", organization: organization %>
      </div>
    <% end %>
    <% if pieces.include?(:profile_show_age_ranges) %>
      <div>
        <h3 class="mb-3 font-display text-xl text-gray-900">Age groups served</h3>
        <%= render "shared/age_group_tags", primary: organization.active_facilitator_age_groups %>
      </div>
    <% end %>
    <% hidden_sections.each do |section, records| %>
      <div>
        <h3 class="mb-3 font-display text-xl text-gray-900"><%= section_titles.fetch(section) %></h3>
        <%= render "organizations/sections/cards", organization: organization, section: section, records: records %>
      </div>
    <% end %>
    <% if workshop_log_summary %>
      <div id="workshop_logs" class="scroll-mt-4">
        <h3 class="mb-3 font-display text-xl text-gray-900">Workshop logs</h3>
        <%= render "organizations/sections/workshop_logs", organization: organization, summary: workshop_log_summary %>
      </div>
    <% end %>
    <% if events_hidden %>
      <div>
        <h3 class="mb-3 font-display text-xl text-gray-900">Events attended</h3>
        <%= render "organizations/sections/events_frame", organization: organization %>
      </div>
    <% end %>
  </div>
</div>

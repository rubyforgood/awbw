<% content_for(:page_bg_class, "admin-or-owner-or-authsearchable") %>
<%= render "addresses/dedupe_back_link" %>
<div class="bg-brand-cream border-primary/10 overflow-hidden rounded-2xl border shadow-sm">
  <%= render accent_strip_partial %>
  <!-- Organization hero -->
  <div class="<%= DomainTheme.bg_class_for(:organizations, intensity: 100) %> px-4 pt-5 pb-8 sm:px-8">
    <!-- Eyebrow + header actions -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <span class="text-2xs <%= DomainTheme.text_class_for(:organizations, intensity: 700) %> inline-flex items-center gap-2 font-semibold tracking-widest uppercase">
        <i class="fa-solid fa-building"></i> Organization profile
      </span>
      <div class="flex flex-wrap items-center justify-end gap-2">
        <%= link_to "Home", root_path, class: "text-sm text-gray-600 hover:text-primary px-2 py-1" %>
        <%= link_to "Organizations", organizations_path, class: "text-sm text-gray-600 hover:text-primary px-2 py-1" %>
        <% if allowed_to?(:edit?, @organization) %>
          <%= link_to edit_organization_path(@organization),
                        class: "admin-only inline-flex items-center gap-1.5 text-sm font-semibold rounded-full bg-brand-yellow-400 hover:bg-brand-yellow-500 text-primary px-4 py-1.5 shadow-sm transition" do %>
            <i class="fa-solid fa-pen text-xs"></i> Edit
          <% end %>
        <% end %>
        <% if allowed_to?(:index?, with: Admin::AhoyActivityPolicy) %>
          <%= link_to organization_activity_path(@organization), data: { turbo_prefetch: false },
                      class: "admin-only inline-flex items-center gap-1.5 text-sm font-semibold rounded-full border border-blue-200 bg-blue-50 hover:bg-blue-100 text-blue-800 px-4 py-1.5 shadow-sm transition" do %>
            <i class="fa-solid fa-clock-rotate-left text-xs"></i> Activity
          <% end %>
        <% end %>
        <span class="inline-flex rounded-lg bg-white text-sm shadow-sm">
          <%= render "bookmarks/editable_bookmark_button", resource: @organization %>
        </span>
      </div>
    </div>
    <!-- Identity: logo + name + contact + badges -->
    <div class="flex flex-col gap-6 md:flex-row md:items-center">
      <div class="flex flex-shrink-0 justify-center md:justify-start">
        <% if @organization.logo&.attached? %>
          <%= image_tag @organization.logo,
                        class: "w-28 h-28 rounded-full object-cover ring-4 ring-white shadow-md" %>
        <% else %>
          <%= image_tag "missing.png",
                        class: "w-28 h-28 rounded-full object-cover ring-4 ring-white opacity-90" %>
        <% end %>
      </div>
      <div class="flex-1 text-center md:text-left">
        <% org_decorated = @organization.decorate %>
        <div class="flex flex-wrap items-center justify-center gap-3 md:justify-start">
          <h1 class="text-primary font-display text-4xl font-semibold tracking-tight">
            <%= @organization.name %>
          </h1>
          <% if allowed_to?(:manage?, @organization) %>
            <span id="program-status" class="admin-only scroll-mt-20 rounded-full border border-black/5 bg-white px-2 py-1">
              <%= org_decorated.organization_status_chip(admin: allowed_to?(:manage?, Organization)) %>
            </span>
          <% end %>
        </div>
        <% address = if @organization.addresses.loaded?
                       @organization.addresses.find { |a| !a.inactive? }
                     else
                       @organization.addresses.active.first
                     end %>
        <% if address %>
          <div class="mt-1 flex flex-wrap items-center justify-center gap-2 text-sm text-gray-600 md:justify-start">
            <span><%= [address.locality, [address.city, address.state].compact_blank.join(", "), address.district].compact_blank.join(" · ") %></span>
            <% if address.street_address.present? && allowed_to?(:manage?, Organization) %>
              <span class="<%= admin_only_chip_class %>" title="Street address (admin only)">
                <i class="fa-solid fa-lock text-xs text-blue-700"></i> <%= address.street_address %>
              </span>
            <% end %>
          </div>
        <% end %>
        <% affiliated_since = org_decorated.affiliated_since_display %>
        <% if affiliated_since.present? %>
          <p class="mt-1 text-sm text-gray-600">
            Affiliated since
            <span class="text-primary font-semibold"><%= affiliated_since %></span>
          </p>
        <% end %>
        <% program_since = org_decorated.program_since_display %>
        <% if program_since.present? %>
          <p class="mt-1 text-sm text-gray-600">
            Facilitators since
            <span class="text-primary font-semibold"><%= program_since %></span>
          </p>
        <% end %>
        <% if @organization.parent.present? %>
          <p class="mt-1 text-sm text-gray-600">
            <i class="fa-solid fa-sitemap text-xs <%= DomainTheme.text_class_for(:organizations, intensity: 600) %>"></i>
            Part of
            <%= link_to @organization.parent.name, organization_path(@organization.parent),
                        class: "text-primary font-semibold hover:underline" %>
          </p>
        <% end %>
        <!-- Contact info -->
        <div class="mt-3 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm md:justify-start">
          <% if @organization.profile_show_email? && @organization.email.present? %>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-black/5 bg-white px-3 py-1 text-gray-700">
              <i class="fa-solid fa-envelope text-xs <%= DomainTheme.text_class_for(:organizations, intensity: 600) %>"></i> <%= mail_to @organization.email, @organization.email, class: "hover:text-primary" %>
            </span>
          <% elsif @organization.email.present? && allowed_to?(:manage?, Organization) %>
            <span class="<%= admin_only_chip_class %>" title="Email (admin only)">
              <i class="fa-solid fa-lock text-xs text-blue-700"></i> <%= mail_to @organization.email, @organization.email, class: "hover:text-primary" %>
            </span>
          <% end %>
          <% phone = @organization.phone_number %>
          <% if phone.present? %>
            <% if @organization.profile_show_phone? %>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-black/5 bg-white px-3 py-1 text-gray-700">
                <i class="fa-solid fa-phone text-xs <%= DomainTheme.text_class_for(:organizations, intensity: 600) %>"></i> <%= link_to phone, tel_href(phone), class: "hover:text-primary" %>
              </span>
            <% elsif allowed_to?(:manage?, Organization) %>
              <span class="<%= admin_only_chip_class %>" title="Phone (admin only)">
                <i class="fa-solid fa-lock text-xs text-blue-700"></i> <%= link_to phone, tel_href(phone), class: "hover:text-primary" %>
              </span>
            <% end %>
          <% end %>
          <% if @organization.website_url.present? %>
            <% safe_url = @organization.website_link_url %>
            <% if safe_url.present? && @organization.profile_show_website? %>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-black/5 bg-white px-3 py-1 text-gray-700">
                <i class="fa-solid fa-globe text-xs <%= DomainTheme.text_class_for(:organizations, intensity: 600) %>"></i> <%= link_to @organization.website_url, safe_url,
                              target: "_blank", rel: "noopener noreferrer",
                              class: "hover:text-primary" %>
              </span>
            <% elsif safe_url.present? && allowed_to?(:manage?, Organization) %>
              <span class="<%= admin_only_chip_class %>" title="Website (admin only)">
                <i class="fa-solid fa-lock text-xs text-blue-700"></i> <%= link_to @organization.website_url, safe_url,
                              target: "_blank", rel: "noopener noreferrer",
                              class: "hover:text-primary" %>
              </span>
            <% elsif safe_url.blank? && allowed_to?(:edit?, @organization) %>
              <span class="admin-only inline-flex items-center gap-1.5 rounded-full bg-red-100 px-3 py-1 text-xs text-red-700">
                <i class="fa-solid fa-triangle-exclamation"></i>
                Bad URL: "<%= link_to @organization.website_url, edit_organization_path(@organization, anchor: "website-url-field"), class: "underline" %>"
              </span>
            <% end %>
          <% end %>
        </div>
        <!-- Badges -->
        <% badges = org_decorated.badges %>
        <% if badges.any? %>
          <div class="mt-4 flex flex-wrap justify-center gap-1.5 md:justify-start">
            <% badges.each do |badge| %>
              <%= render "shared/badge", label: badge[:label], classes: "#{badge[:bg]} #{badge[:text]} #{badge[:border]}" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <!-- Profile body -->
  <div class="space-y-8 p-4 sm:p-8">
    <!-- Affiliations + sectors/age groups -->
    <div class="grid grid-cols-1 gap-8 md:grid-cols-5">
      <!-- Organization affiliations -->
      <div id="affiliations" class="scroll-mt-4 md:col-span-3" data-controller="paginated-fields" data-paginated-fields-per-page-value="9">
        <h2 class="mb-3 font-display text-2xl text-gray-900">Facilitators</h2>
        <% grouped = org_decorated.active_affiliations_by_facilitator.select { |person, _| allowed_to?(:show?, person) } %>
        <% if grouped.any? %>
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
            <% grouped.each do |person, person_affiliations| %>
              <div class="relative" data-paginated-fields-target="item">
                <% titles = person_affiliations.filter_map { |a| a.title.presence }.uniq %>
                <% titles = titles.sort_by { |t| [t.downcase.include?("facilitator") ? 0 : 1, t.downcase] } %>
                <%= person_profile_button(person, subtitle: titles.any? ? titles.join(", ") : nil) %>
                <% if allowed_to?(:hidden_profile_marker?, person) %>
                  <span class="absolute top-1 right-1 z-10 flex h-5 w-5 items-center justify-center rounded-full border border-blue-200 bg-blue-100 text-blue-700 shadow-sm"
                        title="Hidden from facilitators — only admins see this card" data-testid="profile-hidden-lock">
                    <i class="fa-solid fa-lock text-2xs"></i>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
          <div data-paginated-fields-target="nav" class="mt-3"></div>
        <% else %>
          <p class="text-gray-500 italic">No active facilitators.</p>
        <% end %>
      </div>
      <!-- Sectors + Age groups served (two columns on desktop; stack on narrow viewports) -->
      <% show_sectors = @organization.profile_show_sectors? %>
      <% sectors = show_sectors ? @organization.active_facilitator_sectors : [] %>
      <% age_groups = @organization.profile_show_age_ranges? ? @organization.active_facilitator_age_groups : [] %>
      <% show_age = age_groups.any? %>
      <% if show_sectors || show_age %>
        <div class="md:col-span-2">
          <div class="flex flex-col items-start gap-4 sm:flex-row">
            <% if show_sectors %>
              <div class="min-w-0 flex-1">
                <h2 class="mb-3 font-display text-2xl text-gray-900">Sectors</h2>
                <% if sectors.any? %>
                  <%= render "organizations/sector_preview", sectors: sectors,
                             breakdown_path: populations_served_organization_path(@organization) %>
                <% else %>
                  <p class="text-gray-500 italic">None listed by active facilitators.</p>
                <% end %>
              </div>
            <% end %>
            <% if show_age %>
              <div class="min-w-0 flex-1">
                <h2 class="mb-3 font-display text-2xl text-gray-900">Age groups served</h2>
                <%= render "shared/age_group_tags", primary: age_groups %>
              </div>
            <% end %>
          </div>
          <div class="mt-4">
            <%= link_to populations_served_organization_path(@organization), class: "text-sm #{eyebrow_link_class} px-2 py-1" do %>
              See all sectors and age groups <i class="fa-solid fa-arrow-right text-xs"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <!-- Nested organizations -->
    <% children = @organization.children.order(:name) %>
    <% if children.any? %>
      <div class="<%= DomainTheme.bg_class_for(:organizations, intensity: 50) %>
          border-2 <%= DomainTheme.border_class_for(:organizations) %> rounded-2xl p-5 sm:p-6">
        <h2 class="mb-3 font-display text-2xl text-gray-900">Nested organizations</h2>
        <div class="flex flex-wrap gap-2">
          <% children.each do |child| %>
            <%= link_to child.name, organization_path(child), class: button_classes(:secondary_outline) %>
          <% end %>
        </div>
      </div>
    <% end %>
    <!-- Description -->
    <% if @organization.profile_show_description? && @organization.description.present? %>
      <div class="<%= DomainTheme.bg_class_for(:organizations, intensity: 50) %>
          border-2 <%= DomainTheme.border_class_for(:organizations) %> rounded-2xl p-5 sm:p-6">
        <h2 class="mb-3 font-display text-2xl text-gray-900">Description</h2>
        <div class="leading-relaxed text-gray-700">
          <%= sanitize(@organization.description, tags: %w[p br strong em a ul ol li b i], attributes: %w[href]) %>
        </div>
      </div>
    <% end %>
    <!-- AUTHORED SECTION -->
    <%# A section (and the card) only shows when it's enabled and has something to list. %>
    <% if @published_sections.any? %>
      <% section_titles = {
           "workshops" => "Workshops authored",
           "workshop_variations" => "Workshop variations",
           "resources" => "Resources",
           "stories" => "Stories",
           "community_news" => "Community news"
         } %>
      <div class="organization-only border-2 bg-white <%= DomainTheme.border_class_for(:workshops) %> overflow-hidden rounded-2xl shadow-sm">
        <!-- Header -->
        <div class="section-header flex items-center gap-3 border-b px-5 py-4 sm:px-6 <%= DomainTheme.border_class_for(:workshops, intensity: 200) %>">
          <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full <%= DomainTheme.bg_class_for(:workshops, intensity: 100) %> <%= DomainTheme.text_class_for(:workshops, intensity: 700) %>">
            <i class="fa-solid fa-pen-nib"></i>
          </span>
          <h2 class="font-display text-2xl text-gray-900">Published content</h2>
        </div>
        <!-- Contributed content -->
        <div class="section-content space-y-8 px-4 py-5 sm:space-y-10 sm:px-6 sm:py-6">
          <% @published_sections.each do |section, records| %>
            <div>
              <h3 class="mb-3 font-display text-xl text-gray-900"><%= section_titles.fetch(section) %></h3>
              <%= render "organizations/sections/cards", organization: @organization, section: section, records: records %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    <!-- PARTICIPATION SECTION -->
    <%# Hidden from the profile, admins still see it, marked admin-only. %>
    <% events_hidden = !@organization.profile_show_events_registered? %>
    <% if !events_hidden || allowed_to?(:manage?, Organization) %>
      <% events_theme = events_hidden ? :admin_only : :events %>
      <div class="<%= "admin-only" if events_hidden %> organization-only border-2 bg-white <%= DomainTheme.border_class_for(events_theme) %> overflow-hidden rounded-2xl shadow-sm">
        <!-- Header -->
        <div class="section-header flex items-center gap-3 border-b px-5 py-4 sm:px-6 <%= DomainTheme.border_class_for(events_theme, intensity: 200) %>">
          <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full <%= DomainTheme.bg_class_for(events_theme, intensity: 100) %> <%= DomainTheme.text_class_for(events_theme, intensity: 700) %>">
            <i class="fa-solid fa-calendar-check"></i>
          </span>
          <h2 class="font-display text-2xl text-gray-900">Participation history</h2>
          <% if events_hidden %>
            <span class="ml-auto text-sm <%= DomainTheme.text_class_for(:admin_only, intensity: 700) %> italic">
              <i class="fa-solid fa-eye-slash"></i> Hidden from profile — only admins see this
            </span>
          <% end %>
        </div>
        <!-- Events attended -->
        <div class="section-content space-y-8 px-4 py-5 sm:space-y-10 sm:px-6 sm:py-6">
          <div>
            <h3 class="mb-3 font-display text-xl text-gray-900">Events attended</h3>
            <%= turbo_frame_tag "organization_events_section", src: organization_path(@organization, section: "events"), loading: :lazy do %>
              <p class="text-gray-500 italic">Loading events...</p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
    <!-- SUBMITTED SECTION -->
    <%# Members and admins; each section only shows when it has something to list. %>
    <% if @workshop_log_summary || @submitted_sections.present? %>
      <% submitted_titles = {
           "workshop_ideas" => "Workshop ideas",
           "workshop_variation_ideas" => "Workshop variation ideas",
           "story_ideas" => "Story ideas",
           "monthly_reports" => "Monthly reports"
         } %>
      <div class="organization-only border-2 bg-white <%= DomainTheme.border_class_for(:user_only) %> overflow-hidden rounded-2xl shadow-sm">
        <!-- Header -->
        <div class="section-header flex items-center gap-3 border-b px-5 py-4 sm:px-6 <%= DomainTheme.border_class_for(:user_only, intensity: 200) %>">
          <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full <%= DomainTheme.bg_class_for(:user_only, intensity: 100) %> <%= DomainTheme.text_class_for(:user_only, intensity: 700) %>">
            <i class="fa-solid fa-lock"></i>
          </span>
          <h2 class="font-display text-2xl text-gray-900">Submitted content</h2>
          <span class="ml-auto text-sm <%= DomainTheme.text_class_for(:user_only, intensity: 700) %> italic">Only visible to members and admins</span>
        </div>
        <div class="section-content space-y-8 px-4 py-5 sm:space-y-10 sm:px-6 sm:py-6">
          <% if @workshop_log_summary %>
            <div>
              <h3 class="mb-3 font-display text-xl text-gray-900">Workshop logs</h3>
              <%= render "organizations/sections/workshop_logs", organization: @organization, summary: @workshop_log_summary %>
            </div>
          <% end %>
          <% @submitted_sections.each do |section, records| %>
            <div>
              <h3 class="mb-3 font-display text-xl text-gray-900"><%= submitted_titles.fetch(section) %></h3>
              <% partial = section == "monthly_reports" ? "organizations/sections/monthly_reports" : "organizations/sections/cards" %>
              <%= render partial, organization: @organization, section: section, records: records %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

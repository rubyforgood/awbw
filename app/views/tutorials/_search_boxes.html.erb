<!-- Filters -->
<div class="mb-6 p-4 bg-white border border-gray-200 rounded-lg" data-controller="collection">
  <%= form_with url: tutorials_path,
                method: :get,
                data: { turbo_frame: "tutorials_results", controller: "searchable-checkbox" },
                autocomplete: "off",
                class: "space-y-4" do |f| %>
    <div class="flex flex-wrap gap-4 items-end">
      <div class="flex-1 min-w-[200px]">
        <%= f.label :search, "Title or body contains",
                    class: "text-sm font-medium text-gray-500 mb-1" %>

        <%= f.text_field :search,
                         value: params[:search],
                         placeholder: "e.g. Profile, Workshop search…",
                         class: "w-full bg-white border border-gray-300 rounded-lg px-3 py-2
                                   focus:ring-blue-500 focus:border-blue-500",
                         oninput: "this.form.requestSubmit()" %>
      </div>

      <!-- VISIBILITY -->
      <div class="min-w-[150px]"><%= render "shared/visibility_filter",
                   model_class: Tutorial,
                   admin: allowed_to?(:manage?, Tutorial),
                   authenticated: user_signed_in?,
                   button_text: "All" %></div>
      <div><%= link_to "Clear filters",
                  tutorials_path,
                  class: "btn btn-utility-outline whitespace-nowrap",
                  data: { action: "collection#clearAndSubmit" } %></div>
    </div>

    <div class="flex flex-col sm:flex-row gap-4">
      <%# Categories dropdown %>
      <div class="w-full">
        <label class="text-sm font-medium text-gray-500 mb-1 block" for="categories">Categories</label>

        <%= select_tag "categories",
                       options_for_select(
                         @category_types.flat_map { |ct| ct.categories.ordered_by_position_and_name.map { |c| ["#{ct.title}: #{c.name}", c.id] } },
                         Array(params[:categories]).map(&:to_i)
                       ),
                       multiple: true,
                       include_blank: false,
                       class: "w-full min-w-[200px]",
                       data: { searchable_checkbox_target: "select" } %>
      </div>

      <%# Sectors dropdown %>
      <div class="w-full">
        <label class="text-sm font-medium text-gray-500 mb-1 block" for="sectors">Sectors</label>

        <%= select_tag "sectors",
                       options_from_collection_for_select(@sectors, :id, :name, Array(params[:sectors]).map(&:to_i)),
                       multiple: true,
                       include_blank: false,
                       class: "w-full min-w-[200px]",
                       data: { searchable_checkbox_target: "select" } %>
      </div>
    </div>
  <% end %>
</div>

<% item_class = "block whitespace-nowrap px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
<div data-controller="dropdown" class="relative">
  <button type="button"
          data-action="dropdown#toggle"
          data-dropdown-payload-param='[{"membership-bulk-actions":"hidden"}]'
          class="<%= button_classes(:utility_outline, size: :sm) %>">
    <span>Bulk actions</span>
    <i class="fa-solid fa-chevron-down h-3 w-3 text-gray-400"></i>
  </button>

  <div id="membership-bulk-actions"
       data-dropdown-target="content"
       class="absolute right-0 z-10 mt-1 hidden min-w-[200px] rounded-md border border-gray-200 bg-white py-1 shadow-lg">
    <% @bulk_actions.each do |action| %>
      <%= link_to action.label,
            bulk_action_memberships_path(action.key, @directory.filter_params),
            data: { turbo_frame: "_top" },
            class: item_class %>
    <% end %>
  </div>
</div>

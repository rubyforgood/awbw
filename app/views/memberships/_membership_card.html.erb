<% person = membership.person %>
<% invoice = membership.section_invoice(section_key) %>

<div class="border-primary/10 rounded-xl border bg-gray-50 p-2 sm:p-2">
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-x-6">
<div class="min-w-0">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 min-w-0">
        <%= link_to person_path(person), data: { turbo_frame: "_top" }, class: "min-w-0" do %>
          <span class="block truncate text-sm font-semibold text-gray-800 hover:text-primary"><%= person.full_name %></span>
        <% end %>
        <%= link_to "View membership", person_memberships_path(person), class: "text-sm #{eyebrow_link_class} px-2 py-1", data: { turbo_frame: "_top" } %>
      </div>

      <% if person.preferred_email.present? %>
        <span class="block truncate text-xs text-gray-500"><%= person.preferred_email %></span>
      <% end %>
    </div>

    <div class="min-w-0">
      <ul class="space-y-0.5">
        <% if invoice %>
          <%= render "membership_invoices/invoice_row", invoice: invoice, editable: false, linked: true %>
        <% end %>
      </ul>
    </div>
  </div>
</div>

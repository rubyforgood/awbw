<% person = membership.person %>
<% current_invoice = membership.section_invoice(:current) %>
<% section_invoice = membership.section_invoice(section_key) %>

<div class="border-primary/10 rounded-xl border bg-gray-50 p-3 sm:p-4">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <%= link_to person_path(person), data: { turbo_frame: "_top" }, class: "flex flex-col gap-0.5 min-w-0" do %>
      <span class="truncate text-sm font-semibold text-gray-800 hover:text-primary"><%= person.full_name %></span>

      <% if person.preferred_email.present? %>
        <span class="truncate text-xs text-gray-500"><%= person.preferred_email %></span>
      <% end %>
    <% end %>

    <%= link_to "View membership", person_memberships_path(person), class: "text-sm #{eyebrow_link_class} px-2 py-1", data: { turbo_frame: "_top" } %>
  </div>

  <ul class="space-y-2">
    <% [ current_invoice, section_invoice ].compact.uniq(&:id).each do |invoice| %>
      <%= render "membership_invoices/invoice_row", invoice: invoice, editable: false, linked: true %>
    <% end %>
  </ul>
</div>

<% person = membership.person %>
<% invoice = membership.section_invoice(section_key) %>
<% membership = membership.decorate %>

<div id="membership_card_<%= membership.id %>" class="hover:bg-gray-50 transition-colors">
  <div class="flex flex-wrap items-center gap-3 px-3 py-2 sm:grid sm:grid-cols-[1fr_auto] sm:gap-x-4 sm:flex-row">
    <div class="min-w-0">
      <%= tag.div class: "flex items-center gap-3" do %>
        <% if membership.person.user %>
          <%= render "memberships/membership_lock_toggle", membership: membership, section_key: section_key %>
        <% end %>

        <div>
          <div class="flex items-baseline gap-2 min-w-0">
            <%= link_to person_path(person), data: { turbo_frame: "_top" }, class: "min-w-0" do %>
              <span class="block truncate text-sm font-semibold text-gray-800 hover:text-primary"><%= person.full_name %></span>
            <% end %>

            <%= membership.period_label ? tag.span(membership.period_label, class: "truncate text-xs text-gray-500") : nil %>
          </div>

          <% if membership.stripe_active? %>
            <%= render "shared/badge", label: "Stripe", classes: "bg-green-100 text-green-700 border-green-200" %>
          <% end %>

          <% if person.preferred_email.present? %>
            <span class="block truncate text-xs text-gray-500"><%= person.preferred_email %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if invoice %>
      <div class="min-w-0 flex items-center gap-x-3">
        <%= tag.div id: dom_id(membership, :invoice), class: "flex items-center" do %>
          <%= render "memberships/membership_invoice_row", membership: membership, invoice: invoice, linked: true %>

          <%= link_to membership_path(membership), data: { turbo_method: :get, turbo_stream: true }, class: "text-xs text-gray-400 hover:text-primary transition" do %>
            <span>| View all invoices</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div id="membership_invoices_<%= membership.id %>"></div>
</div>

<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<% current_section = params[:section]&.to_sym
   current_section = :overdue unless Membership::OVERVIEW_SECTIONS.key?(current_section) %>

<div class="mx-auto max-w-6xl">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-primary font-display text-2xl font-bold">Memberships</h1>
    <%= link_to "Membership invoices", membership_invoices_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
  </div>

  <nav class="mb-6 flex flex-wrap items-center gap-1" aria-label="Membership overview">
    <% Membership::OVERVIEW_SECTIONS.each do |key, label| %>
      <% if key == current_section %>
        <span aria-current="page" class="border-b-2 border-primary px-2 py-1 text-sm font-semibold text-primary"><%= label %></span>
      <% else %>
        <%= link_to label, memberships_path(section: key), class: "text-sm #{eyebrow_link_class} border-b-2 border-transparent hover:border-gray-300 px-2 py-1" %>
      <% end %>
    <% end %>
  </nav>

  <%= turbo_frame_tag :memberships_results, src: memberships_path(section: current_section), data: { turbo: "temporary" } do %>
    <%= render "memberships/results_skeleton" %>
  <% end %>
</div>


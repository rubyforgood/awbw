<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<div class="border-primary/10 mx-auto max-w-2xl rounded-2xl border bg-white p-4 shadow-sm sm:p-6">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
    <%= link_to membership_path(@membership), class: "text-sm #{eyebrow_link_class} px-2 py-1" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> Membership
    <% end %>
  </div>

  <h1 class="text-primary mb-1 font-display text-2xl font-bold">Membership term</h1>
  <p class="mb-6 text-sm text-gray-500"><%= @person.full_name %></p>

  <%= simple_form_for @membership do |f| %>
    <%= render "shared/errors", resource: f.object %>

    <div class="grid gap-4 sm:grid-cols-2">
      <%= f.input :start_date,
            as: :date,
            html5: true,
            label: "Starts",
            input_html: { class: "bg-white" } %>
      <%= f.input :end_date,
            as: :date,
            html5: true,
            label: "Ends",
            input_html: { class: "bg-white" } %>
    </div>

    <%= f.input :cost_dollars,
          label: "Locked price ($ per year)",
          required: false,
          hint: "Leave blank for the standard cost (#{dollars_from_cents(Membership.annual_cost_cents)}). Applies to future invoices only — invoices already issued keep the amount they were billed at.",
          input_html: { min: 0, step: 0.01, placeholder: "Standard", class: "bg-white" } %>

    <p class="mt-2 text-xs text-gray-500">
      Changing the term does not change an invoice that has already been issued. Shortening the term stops renewal and removes an unstarted, unpaid next year.
    </p>

    <div class="mt-6 flex items-center gap-3 border-t border-gray-200 pt-6">
      <div class="ml-auto flex items-center gap-3">
        <%= link_to "Cancel", membership_path(@membership), class: button_classes(:secondary_outline) %>
        <%= f.button :submit, "Save term", class: button_classes(:primary) %>
      </div>
    </div>
  <% end %>

  <%= render "shared/audit_info", resource: @membership %>
  <div class="mt-4 flex justify-end">
    <%= render "application/activity_log", record: @membership %>
  </div>
</div>

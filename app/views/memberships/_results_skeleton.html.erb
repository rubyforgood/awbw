<div class="space-y-4">
  <% 3.times do %>
    <div class="border-primary/10 animate-pulse rounded-xl border bg-gray-50 p-3 sm:p-4">
      <div class="mb-3 flex items-center justify-between">
        <div class="space-y-2">
          <div class="h-4 w-40 rounded bg-gray-200"></div>
          <div class="h-3 w-56 rounded bg-gray-100"></div>
        </div>

        <div class="h-6 w-32 rounded bg-gray-200"></div>
      </div>

      <div class="space-y-2">
        <div class="h-4 w-full max-w-md rounded bg-gray-100"></div>
        <div class="h-4 w-full max-w-xs rounded bg-gray-100"></div>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-6 flex animate-pulse justify-center space-x-2">
  <% 3.times do %>
    <div class="h-8 w-10 rounded bg-gray-200"></div>
  <% end %>
</div>


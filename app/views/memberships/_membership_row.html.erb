<% membership = membership.decorate %>

<div id="membership_<%= membership.id %>" class="flex flex-wrap items-center gap-3 px-4 py-3 sm:gap-4">
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <%= link_to person_path(membership.person), data: { turbo_frame: "_top" },
            class: "truncate text-sm font-semibold text-gray-800 hover:text-primary" do %>
        <%= membership.person.full_name %>
      <% end %>
      <%= render "memberships/status_badge", membership: membership %>
      <% if membership.payment_badge? %>
        <%= render "shared/badge", label: membership.payment_label,
              classes: membership.payment_classes, title: membership.payment_tooltip %>
      <% end %>
      <%= render "shared/badge",
            label: membership.autopay_on? ? "Autopay on" : "Autopay off",
            classes: membership.autopay_on? ? "bg-green-50 text-green-700 border-green-200" : "bg-gray-50 text-gray-600 border-gray-200",
            title: membership.autopay_on? ? "Automatic payments are enabled for this membership." : "Automatic payments are disabled for this membership." %>
      <% if membership.locked? %>
        <%= render "shared/badge", label: "Locked", classes: "bg-gray-100 text-gray-600 border-gray-300",
              title: "Historical membership. Unlock it before editing or issuing new invoices." %>
      <% end %>
    </div>

    <div class="mt-0.5 flex flex-wrap gap-x-4 gap-y-0.5 text-xs text-gray-500">
      <span><%= membership.cost_label %></span>
      <% if membership.period_label.present? %>
        <span><%= membership.period_label %></span>
      <% end %>
      <span title="<%= membership.renewal_tooltip %>">Renewal <%= membership.auto_renewal_label %></span>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= link_to "Manage membership", membership_path(membership),
          data: { turbo_frame: "_top" }, class: button_classes(:secondary_outline, size: :sm) %>

    <% if membership.person.user %>
      <%= render "memberships/membership_lock_toggle", membership: membership %>
    <% end %>
  </div>
</div>

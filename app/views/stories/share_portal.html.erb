      <%= link_to "Children", share_portal_stories_path(focus: "children"), class: "whitespace-nowrap text-gray-700 hover:text-purple-700 px-3 py-2 text-sm font-medium" %>
      <%= link_to "Teens", share_portal_stories_path(focus: "teens"), class: "whitespace-nowrap text-gray-700 hover:text-purple-700 px-3 py-2 text-sm font-medium" %>
      <%= link_to "Adults", share_portal_stories_path(focus: "adults"), class: "whitespace-nowrap text-gray-700 hover:text-purple-700 px-3 py-2 text-sm font-medium" %>
      <%= link_to "Families", share_portal_stories_path(focus: "families"), class: "whitespace-nowrap text-gray-700 hover:text-purple-700 px-3 py-2 text-sm font-medium" %>
      <%= link_to "Community", share_portal_stories_path(focus: "community"), class: "whitespace-nowrap text-gray-700 hover:text-purple-700 px-3 py-2 text-sm font-medium" %>
      <%= link_to "Self", share_portal_stories_path(focus: "self"), class: "whitespace-nowrap text-gray-700 hover:text-purple-700 px-3 py-2 text-sm font-medium" %>
      <%= link_to "Colleagues", share_portal_stories_path(focus: "colleagues"), class: "whitespace-nowrap text-gray-700 hover:text-purple-700 px-3 py-2 text-sm font-medium" %>
    </nav>
  </div>
</div>

<!-- Hero Section -->
<section class="bg-white py-12 -mx-2 sm:-mx-6 lg:-mx-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold text-gray-900 text-center mb-4">
      Welcome to our Story Share
    </h1>

    <blockquote class="text-center mb-6">
      <p class="text-lg text-gray-700 italic mb-1">
        "If we can share our story with someone who responds with empathy and understanding, shame can't survive."
      </p>
      <footer class="text-gray-600">~ Brené Brown</footer>
    </blockquote>

    <div class="max-w-4xl mx-auto space-y-4 text-gray-700 leading-relaxed">
      <p>
        At A Window Between Worlds, we aim to uplift the voices and showcase the leadership of our extensive network of art workshop facilitators. We invite you to explore these impactful stories and accompanying participant artwork from trained Windows Facilitators across the country and abroad.
      </p>
      <p>
        This evolving collection illustrates the transformative power of creative expression that is experienced by individuals and communities participating in our art workshops. As we share these powerful stories, we empower others facing their own challenges, helping facilitate their healing journey.
      </p>
    </div>
  </div>
</section>

<!-- Featured Story Carousel -->
<% if @featured_story.present? %>
  <section class="bg-gray-50 py-12 -mx-2 sm:-mx-6 lg:-mx-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-lg overflow-hidden shadow-lg">
        <%= link_to story_path(@featured_story), class: "block relative" do %>
          <div class="aspect-[16/6] bg-gray-200">
            <%= render "assets/display_image",
                       resource: @featured_story,
                       variant: :hero %>
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent flex items-end">
            <div class="p-8 text-white w-full">
              <div class="inline-block bg-purple-600 text-white text-xs font-semibold px-3 py-1 rounded mb-3">
                SCHOOLS & UNIVERSITIES
              </div>
              <h2 class="text-3xl font-bold mb-2">
                <%= @featured_story.title %>
              </h2>
              <p class="text-sm opacity-90">
                <%= @featured_story.organization_name %>
                <% if @featured_story.organization.city_state.present? %>
                  • <%= @featured_story.organization.city_state %>
                <% end %>
              </p>
            </div>
          </div>
        <% end %>

        <!-- Carousel Navigation -->
        <button class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-2 shadow-lg">
          <svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-2 shadow-lg">
          <svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </section>
<% end %>

<!-- Story Sections -->
<section class="bg-white py-12 -mx-2 sm:-mx-6 lg:-mx-8">

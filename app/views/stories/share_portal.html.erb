      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-6"><%= focus %></h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <% @stories_by_focus[focus]&.first(3)&.each do |story| %>
            <article class="bg-white rounded-lg overflow-hidden border border-gray-200 hover:shadow-lg transition-shadow">
              <%= link_to story_path(story), class: "block" do %>
                <div class="aspect-[4/3] bg-gray-200 relative">
                  <%= render "assets/display_image",
                             resource: story,
                             variant: :hero %>
                </div>
              <% end %>

              <div class="p-4">
                <h3 class="font-semibold text-gray-900 mb-2 text-lg hover:text-purple-700">
                  <%= link_to story.title, story_path(story) %>
                </h3>
                <p class="text-sm text-gray-600">
                  <%= story.organization_name %>
                  <% if story.organization.city_state.present? %>
                    • <%= story.organization.city_state %>
                  <% end %>
                </p>
              </div>

                </svg>
                <%= link_to "Permission to Feel Warm and Safe", "#", class: "hover:text-purple-700" %>
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <%= link_to "A Return to Self", "#", class: "hover:text-purple-700" %>
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <%= link_to "More Domestic Violence Stories...", stories_path(focus: "domestic_violence"), class: "hover:text-purple-700 font-medium" %>
              </li>
            <% elsif focus == "Social Justice" %>
              <li class="flex items-center">
                <svg class="w-4 h-4 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <%= link_to "Healing Historical Trauma", "#", class: "hover:text-purple-700" %>
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <%= link_to "Strength & Unity", "#", class: "hover:text-purple-700" %>
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>

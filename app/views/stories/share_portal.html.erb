<!-- What Others Are Reading -->
<section class="bg-white py-12 -mx-2 sm:-mx-6 lg:-mx-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-telefon text-3xl text-black mb-8">What Others Are Reading</h2>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% 
        category_colors = {
          "Self-Care & Personal Growth" => { text: "text-blue-600", bg: "bg-blue-600" },
          "Schools & Universities" => { text: "text-purple-600", bg: "bg-purple-600" },
          "Community Engagement" => { text: "text-teal-600", bg: "bg-teal-600" },
          "Domestic Violence" => { text: "text-pink-600", bg: "bg-pink-600" }
        }
        
        categories = ["Self-Care & Personal Growth", "Schools & Universities", "Community Engagement", "Domestic Violence"]
      %>
      
      <% @popular_stories.first(4).each_with_index do |story, index| %>
        <% category = categories[index % 4] %>
        <% colors = category_colors[category] %>
        
        <%= link_to story_path(story), class: "group block relative aspect-square rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow" do %>
          <div class="absolute inset-0 bg-gray-200">
            <%= render "assets/display_image",
                       resource: story,
                       variant: :hero %>
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex flex-col justify-end">
            <div class="p-4 w-full">
              <div class="inline-block <%= colors[:bg] %> text-white text-xs font-semibold uppercase px-2 py-1 mb-2">
                <%= category %>
              </div>
              <h3 class="font-telefon text-white text-sm leading-tight">
                <%= story.title %>
              </h3>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>


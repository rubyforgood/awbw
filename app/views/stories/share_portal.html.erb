</div><!-- Break out of layout container -->

<!-- Navigation Tabs -->
<div class="bg-white border-b border-gray-200 -mx-2 sm:-mx-6 lg:-mx-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

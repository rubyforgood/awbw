<!-- Featured Story Carousel -->
<% if @featured_story.present? %>
  <section class="bg-gray-50 py-12 -mx-2 sm:-mx-6 lg:-mx-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-lg overflow-hidden shadow-lg" id="hero-carousel">
        <%= link_to story_path(@featured_story), class: "block relative carousel-item active" do %>
          <div class="aspect-[16/6] bg-gray-200">
            <%= render "assets/display_image",
                       resource: @featured_story,
                       variant: :hero %>
          </div>
          <!-- Blue Sector Box on Top Left -->
          <div class="absolute top-6 left-6 bg-blue-600 text-white text-xs font-semibold uppercase px-4 py-2 z-10">
            <%= @featured_story.sectors.first&.name || "SELF-CARE & PERSONAL GROWTH" %>
          </div>
          <!-- Black overlay bar at bottom with title -->
          <div class="absolute bottom-0 left-0 right-0 bg-black/50 p-8 text-white">
            <h2 class="font-telefon text-3xl mb-2">
              <%= @featured_story.title %>
            </h2>
            <p class="text-sm opacity-90">
              <%= @featured_story.organization_name %>
              <% if @featured_story.organization.city_state.present? %>
                - <%= @featured_story.organization.city_state %>
              <% end %>
            </p>
          </div>
        <% end %>

        <!-- Carousel Navigation -->
        <button aria-label="Previous story" class="carousel-prev absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-2 shadow-lg z-10">
          <svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button aria-label="Next story" class="carousel-next absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-2 shadow-lg z-10">
          <svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </section>
  
  <script>
    // Auto-scrolling carousel
    (function() {
      const carousel = document.getElementById('hero-carousel');
      if (!carousel) return;
      
      const items = carousel.querySelectorAll('.carousel-item');
      let currentIndex = 0;
      let autoplayInterval;
      
      function showItem(index) {
        items.forEach((item, i) => {
          if (i === index) {
            item.classList.add('active');
          } else {
            item.classList.remove('active');
          }
        });
      }
      
      function nextItem() {
        currentIndex = (currentIndex + 1) % items.length;
        showItem(currentIndex);
      }
      
      function prevItem() {
        currentIndex = (currentIndex - 1 + items.length) % items.length;
        showItem(currentIndex);
      }
      
      function startAutoplay() {
        autoplayInterval = setInterval(nextItem, 5000); // Auto-scroll every 5 seconds
      }
      
      function stopAutoplay() {
        clearInterval(autoplayInterval);
      }
      
      // Button handlers
      const prevBtn = carousel.querySelector('.carousel-prev');
      const nextBtn = carousel.querySelector('.carousel-next');
      
      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          stopAutoplay();
          prevItem();
          startAutoplay();
        });
      }
      
      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          stopAutoplay();
          nextItem();
          startAutoplay();
        });
      }
      
      // Start autoplay
      if (items.length > 1) {
        startAutoplay();
      }
      
      // Pause on hover
      carousel.addEventListener('mouseenter', stopAutoplay);
      carousel.addEventListener('mouseleave', () => {
        if (items.length > 1) startAutoplay();
      });
    })();
  </script>
<% end %>


<div class="min-h-screen py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="admin-only bg-blue-100 p-6">
      <div class="<%= DomainTheme.bg_class_for(:stories) %>
        border border-gray-200 rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 p-8">
        <div class="flex items-center justify-between mb-3">
          <h1 class="text-3xl font-semibold text-gray-900 tracking-tight">
            Edit <%= @story.class.model_name.human %>
          </h1>
          <div class="text-right text-end space-x-2">
            <%= link_to "External URL", safe_url(@story.external_url), target: "_blank", rel: "noopener noreferrer",
                        class: "btn btn-secondary-outline" if @story.external_url.present? %>
            <%= link_to "View",
                        story_path(@story, no_redirect: true),
                        class: "btn btn-secondary-outline" %>
          </div>
        </div>
        <div class="space-y-6">
          <div class="bg-white rounded mt-4 p-6">
            <%= render "form" %>
          </div>

          <%= turbo_frame_tag "editor_assets_lazy", src: edit_story_path(@story) do %>
            <%= render "shared/loading" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

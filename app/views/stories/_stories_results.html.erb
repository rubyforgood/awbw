<%= turbo_stream.replace("stories_count", partial: "stories_count") %>
<%
  sort_base = params.permit(:title, :query, :author_name, :published, :year, :author_id, :number_of_items_per_page).to_h.symbolize_keys
  sort_link = sort_header_link(frame: "stories_results", path: ->(p) { stories_path(p) }, base: sort_base)
%>
<div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm <%= 'animate-fade blur-on-submit' if @stories.any? %>">
  <table class="w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">
          <%= sort_link.call("title", "Title") %>
          <span class="ml-2 text-xs font-normal"><%= sort_link.call("workshop", "Workshop") %></span>
        </th>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-700"><%= sort_link.call("tags", "Tags") %></th>
        <th class="px-4 py-2 text-left text-sm font-medium whitespace-nowrap text-gray-700">
          <%= sort_link.call("author", "Author") %>
          <span class="ml-2 text-xs font-normal"><%= sort_link.call("organization", "Organization") %></span>
        </th>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-700"><%= sort_link.call("updated_at", "Updated") %></th>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Actions</th>
      </tr>
    </thead>

    <tbody class="divide-y divide-gray-100">
      <% if @stories.any? %>
        <% @stories.each do |story| %>
          <tr class="hover:bg-gray-50">
            <td class="flex items-center gap-2 px-4 py-2 text-sm text-gray-800">
              <!-- BOOKMARK -->
              <span class="pointer-events-auto"><%= render "bookmarks/editable_bookmark_icon", resource: story %></span>

              <%= render "assets/display_image",
                               resource: story,
                               width: 24, height: 14,
                               variant: :index,
                               link_to_object: true,
                               file: story.display_image %>

              <!-- TITLE + BADGES, WORKSHOP BENEATH -->
              <div class="min-w-80">
                <%= link_to title_with_badges(story).html_safe,
                                  story_path(story),
                                  target: story.external_link? ? "_blank" : "", rel: "noopener noreferrer",
                                  data: { turbo_frame: "_top" },
                                  class: "font-bold hover:text-indigo-800 hover:underline" %>
                <% if story.workshop_title %>
                  <div class="line-clamp-1 text-xs text-gray-500" title="<%= story.workshop_title %>"><%= story.workshop_links %></div>
                <% end %>
              </div>
            </td>

            <td class="px-4 py-2 text-sm">
              <% primary_sector = story.primary_sector %>
              <% primary_category = story.primary_category %>
              <div class="flex max-w-sm min-w-52 flex-wrap items-center gap-1">
                <% story.tag_sectors.each do |sector| %>
                  <%= render "sectors/tagging_label", sector: sector, is_primary: sector == primary_sector, compact: true %>
                <% end %>
                <% story.tag_audience_categories.each do |category| %>
                  <%= render "categories/tagging_label", category: category, is_primary: category == primary_category, name_only: true, compact: true %>
                <% end %>
                <%= story.windows_audience_chip %>
              </div>
            </td>

            <td class="min-w-36 px-4 py-2 text-sm text-gray-800">
              <div><%= credited_author_link(story, class: "hover:underline", data: { turbo_frame: "_top" }) %></div>
              <% if story.organization %>
                <div class="line-clamp-1 text-xs text-gray-500" title="<%= story.organization_name %>"><%= story.organization_link %></div>
              <% end %>
            </td>

            <td class="px-4 py-2 text-sm whitespace-nowrap text-gray-500"><%= story.updated_at.strftime("%b %d, %Y") %></td>

            <td class="px-4 py-2 text-sm whitespace-nowrap text-gray-500">
              <% if story.external_link? %>
                <%= link_to "View", story.link_target,
                                  target: "_blank", rel: "noopener noreferrer",
                                  class: button_classes(:secondary_outline) %>
                <% if allowed_to?(:edit?, story) %>
                  <%= link_to "Details", story_path(story, no_redirect: true),
                                    data: { turbo_frame: "_top" },
                                    class: button_classes(:secondary_outline, extra: "admin-only bg-blue-100") %>
                <% end %>
              <% else %>
                <%= link_to "View", story_path(story),
                                  data: { turbo_frame: "_top" },
                                  class: button_classes(:secondary_outline) %>
              <% end %>
              <% if allowed_to?(:edit?, story) %>
                <%= link_to "Edit", edit_story_path(story.id),
                                  data: {turbo_frame: "_top"},
                                  class: button_classes(:secondary_outline, extra: "admin-only bg-blue-100") %>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" class="py-16 text-center">
            <h2 class="mb-2 text-lg text-gray-600">No stories found</h2>
            <% if allowed_to?(:new?, Story) %>
              <div class="admin-only bg-blue-100 p-3">
                <%= link_to "Create a story",
                            new_story_path,
                            data: {turbo_frame: "_top"},
                            class: button_classes(:primary) %>
              </div>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% if @stories.any? %>
  <!-- Pagination -->
  <div class="mt-6 flex justify-center">
    <div class="pagination mt-6"><%= tailwind_paginate @stories %></div>
  </div>
<% end %>

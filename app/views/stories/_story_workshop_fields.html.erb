<div class="nested-fields mb-2 flex flex-wrap items-end gap-3 rounded-lg border border-gray-200 bg-white px-3 py-2">
  <div class="w-full sm:w-72">
    <%= f.input :workshop_id,
                as: :select,
                collection: @workshops,
                label_method: :title,
                value_method: :id,
                include_blank: "— not in the curriculum —",
                label: "Workshop",
                wrapper_html: { class: "mb-0!" },
                input_html: { class: "w-full px-3 py-2 border border-gray-300 rounded-lg" } %>
  </div>
  <div class="w-full min-w-0 sm:flex-1">
    <%= f.input :external_workshop_title,
                as: :string,
                label: "Or a workshop name",
                wrapper_html: { class: "mb-0!" },
                input_html: { maxlength: 255, class: "w-full px-3 py-2 border border-gray-300 rounded-lg" } %>
  </div>
  <%= link_to_remove_association "Remove", f,
        class: "mb-1 rounded px-2 py-1 text-sm text-gray-400 underline whitespace-nowrap hover:text-red-600" %>
</div>

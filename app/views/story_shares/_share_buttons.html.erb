<% share_url = story_share_url(story) %>
<% encoded_url = ERB::Util.url_encode(share_url) %>
<% encoded_title = ERB::Util.url_encode(story.title) %>
<div class="flex items-center gap-4">
  <span class="text-sm font-semibold text-gray-700">Share this story:</span>
  <%= link_to "https://www.facebook.com/sharer/sharer.php?u=#{encoded_url}",
              target: "_blank", rel: "noopener noreferrer",
              class: "text-gray-500 hover:text-blue-600 text-lg", aria: { label: "Share on Facebook" } do %>
    <i class="fa-brands fa-facebook-f"></i>
  <% end %>
  <%= link_to "https://twitter.com/intent/tweet?url=#{encoded_url}&text=#{encoded_title}",
              target: "_blank", rel: "noopener noreferrer",
              class: "text-gray-500 hover:text-black text-lg", aria: { label: "Share on X" } do %>
    <i class="fa-brands fa-x-twitter"></i>
  <% end %>
  <%= link_to "https://www.linkedin.com/sharing/share-offsite/?url=#{encoded_url}",
              target: "_blank", rel: "noopener noreferrer",
              class: "text-gray-500 hover:text-blue-700 text-lg", aria: { label: "Share on LinkedIn" } do %>
    <i class="fa-brands fa-linkedin-in"></i>
  <% end %>
  <%= link_to "https://pinterest.com/pin/create/button/?url=#{encoded_url}&description=#{encoded_title}",
              target: "_blank", rel: "noopener noreferrer",
              class: "text-gray-500 hover:text-red-600 text-lg", aria: { label: "Share on Pinterest" } do %>
    <i class="fa-brands fa-pinterest-p"></i>
  <% end %>
</div>

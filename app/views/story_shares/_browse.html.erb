<div class="bg-gray-100 min-h-screen py-8">
  <div class="max-w-6xl mx-auto px-6">

    <div class="flex items-baseline justify-between mb-6">
      <%# Sector/category names carry intentional casing ("LGBTQIA+",
          "Self-Care/Personal Growth"); render as stored, never .titleize. %>
      <h1 class="text-2xl font-bold text-gray-900"><%= browse_title(params) %></h1>
      <p class="text-sm text-gray-500"><%= pluralize(@count_display, "story") %></p>
    </div>

    <% if @stories.any? %>
      <% lead = @stories.first %>
      <% lead_sector = lead.sectors.first %>

      <!-- Lead story -->
      <div class="rounded shadow-md overflow-hidden mb-10">
        <%= link_to story_share_path(lead), class: "block relative" do %>
          <div class="aspect-[16/7] bg-gray-200">
            <%= image_tag lead.display_image, alt: lead.title, class: "w-full h-full object-cover" %>
          </div>
          <% if lead_sector %>
            <div class="absolute top-4 left-4 <%= story_share_sector_chip_class(lead_sector.name) %> text-white text-xs font-semibold uppercase px-4 py-2">
              <%= lead_sector.name %>
            </div>
          <% end %>
          <div class="bg-gray-700 text-white p-4">
            <h2 class="font-telefon text-lg font-semibold"><%= lead.title %></h2>
            <p class="text-sm opacity-80">
              <%= lead.organization_name %><%= " – #{lead.organization.state}" if lead.organization&.state.present? %>
            </p>
          </div>
        <% end %>
      </div>

      <!-- Remaining stories -->
      <div class="space-y-16">
        <% @stories.drop(1).each do |story| %>
          <%= render "browse_row", story: story %>
        <% end %>
      </div>

      <div class="pagination mt-10"><%= tailwind_paginate @stories %></div>
    <% else %>
      <div class="text-center text-gray-600 py-20">
        No stories found.
      </div>
    <% end %>

  </div>
</div>

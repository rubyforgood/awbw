<%# Hero: full-bleed photo or muted video (from a story outside the carousel) under a navy→purple wash, with the
    marketing site's big serif statement + gold accent + CTAs. %>
<section class="relative overflow-hidden">
  <% if @hero_story %>
    <%= image_tag @hero_story.display_image, alt: "", loading: "eager", class: "absolute inset-0 h-full w-full object-cover" %>
    <%= render "story_shares/banner_video", story: @hero_story %>
    <%= render "story_shares/motion_toggle", position_class: "right-4 bottom-4 motion-reduce:hidden" if youtube_video_id(@hero_story.youtube_url) %>
  <% end %>
  <div class="from-brand-navy-950/95 via-brand-navy-900/85 to-brand-purple-900/75 absolute inset-0 bg-gradient-to-r"></div>
  <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="max-w-2xl text-white">
      <p class="text-brand-yellow-400 mb-4 text-sm font-semibold tracking-widest uppercase">Story share</p>
      <h1 class="font-display text-5xl leading-[1.05] tracking-tight sm:text-6xl">
        Stories of healing <span class="text-brand-yellow-400 italic">in action.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/90">
        Real stories and participant artwork from trained Windows Facilitators across the country
        and abroad — and the people whose lives are changing because of it.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <%= link_to story_shares_path(page: 1),
                    class: "bg-brand-yellow-400 hover:bg-brand-yellow-500 text-brand-navy-900 inline-flex items-center gap-2 rounded-full px-7 py-3 font-semibold shadow-sm transition-colors" do %>
          Browse all stories <i class="fa-solid fa-arrow-right text-sm"></i>
        <% end %>
        <%= link_to "Share your story", new_story_share_path,
                    class: "inline-flex items-center gap-2 rounded-full border-2 border-white/70 px-7 py-3 font-semibold text-white transition-colors hover:bg-white/10" %>
      </div>
    </div>
  </div>
  <% if @hero_story %>
    <%# A video hero has the pause button in the corner, so its credit sits just left of it. %>
    <% hero_video = youtube_video_id(@hero_story.youtube_url).present? %>
    <%= link_to "#{hero_video ? "Video" : "Photo"} from: #{@hero_story.title}", story_share_path(@hero_story),
                class: "absolute #{hero_video ? "right-16 bottom-6" : "right-4 bottom-3"} max-w-[60%] truncate text-xs text-white/70 transition-colors hover:text-white hover:underline" %>
  <% end %>
</section>

<%# Featured stories: marketing-site story row — header with CTA + arrows, then a peeking row of bordered cards. %>
<% if @featured_stories.any? %>
  <section class="bg-brand-cream py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="text-brand-orange-600 mb-2 text-sm font-semibold tracking-widest uppercase">Story share</p>
      <h2 class="font-display text-brand-navy-900 text-4xl tracking-tight sm:text-5xl">Featured stories</h2>
      <div class="mt-4 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <p class="max-w-2xl text-lg leading-relaxed text-gray-600">
          Stories from the shelters, schools, and community organizations putting Windows to work.
        </p>
        <div class="flex shrink-0 flex-wrap items-center gap-3">
          <%= link_to "Browse all stories", story_shares_path(page: 1),
                      class: "bg-brand-magenta-600 hover:bg-brand-magenta-700 border-brand-magenta-800 inline-flex items-center rounded-lg border-b-4 px-6 py-2.5 font-semibold text-white transition-colors" %>
          <div class="flex items-center gap-2 sm:gap-3">
            <%= render "story_shares/motion_toggle", button_class: StorySharesHelper::STORY_ROW_ARROW %>
            <button id="featured-stories-prev" aria-label="Previous story" class="<%= StorySharesHelper::STORY_ROW_ARROW %>">
              <i class="fa-solid fa-chevron-left text-sm"></i>
            </button>
            <button id="featured-stories-next" aria-label="Next story" class="<%= StorySharesHelper::STORY_ROW_ARROW %>">
              <i class="fa-solid fa-chevron-right text-sm"></i>
            </button>
          </div>
        </div>
      </div>

      <div data-controller="carousel"
           class="swiper -mx-1! mt-10 p-1!"
           data-carousel-options-value='<%= { autoplay: { delay: 5000, pauseOnMouseEnter: true }, loop: false, spaceBetween: 32,
                                              navigation: { nextEl: "#featured-stories-next", prevEl: "#featured-stories-prev" },
                                              breakpoints: { 0 => { slidesPerView: 1.15 }, 640 => { slidesPerView: 2.15 }, 1024 => { slidesPerView: 3.15 } } }.to_json %>'>
        <div class="swiper-wrapper">
          <% @featured_stories.each do |story| %>
            <div class="swiper-slide h-auto!">
              <div class="border-brand-navy-600 flex h-full flex-col overflow-hidden rounded-2xl border bg-white/40">
                <%= link_to story_share_path(story), class: "border-brand-navy-600 block border-b" do %>
                  <%= render "story_shares/story_image", story: story, pills: false, video: true %>
                <% end %>
                <div class="flex flex-1 flex-col p-6">
                  <h3 class="text-brand-navy-900 font-display text-2xl leading-snug font-semibold">
                    <%= link_to story.title, story_share_path(story), class: "hover:text-brand-magenta-700" %>
                  </h3>
                  <%= render "story_shares/primary_tag_pills", story: story, pad: "px-3 py-1", wrapper_class: "mt-4" %>
                  <%= link_to story_share_path(story),
                              class: "text-brand-magenta-600 hover:text-brand-magenta-800 mt-auto inline-flex items-center gap-1.5 pt-5 font-semibold" do %>
                    Read the story <i class="fa-solid fa-arrow-right text-xs"></i>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>
<% end %>

<!-- Sector sections -->
<section class="bg-white py-14">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-3">
      <% @stories_by_sector.each_with_index do |(sector, stories), index| %>
        <%= render "sector_section",
                   title: sector.name,
                   stories: stories,
                   theme: story_share_slot_theme(index),
                   more_path: story_shares_path(sector_names_all: sector.name) %>
      <% end %>
      <% @stories_by_audience.each_with_index do |(category, stories), index| %>
        <%= render "sector_section",
                   title: category.name,
                   stories: stories,
                   theme: story_share_slot_theme(@stories_by_sector.size + index),
                   more_path: story_shares_path(category_names_all: category.name) %>
      <% end %>
    </div>
  </div>
</section>

<%# What others are reading: saturated color-wash tiles that lift on hover. %>
<% if @recent_stories.any? %>
  <section class="bg-brand-cream py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="text-brand-orange-600 mb-2 text-sm font-semibold tracking-widest uppercase">Story share</p>
      <h2 class="text-brand-navy-900 mb-8 font-display text-3xl tracking-tight">What others are reading</h2>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <% @recent_stories.each_with_index do |story, index| %>
          <% theme = story_share_slot_theme(index) %>
          <%= link_to story_share_path(story), class: "group relative block aspect-[3/4] overflow-hidden rounded-2xl shadow-sm transition-all duration-200 hover:-translate-y-1.5 hover:shadow-2xl" do %>
            <%= render "assets/fitted_image", file: story.display_image, alt: story.title, loading: "lazy",
                       image_class: "transition-transform duration-700 ease-out group-hover:scale-110" %>
            <div class="absolute inset-0 <%= theme[:overlay] %> mix-blend-multiply"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
            <%= render "story_shares/play_badge", story: story %>
            <div class="absolute inset-x-0 bottom-0 p-5">
              <%= render "story_shares/primary_tag_pills", story: story, glass: true, pad: "px-2.5 py-0.5", wrapper_class: "mb-2" %>
              <h3 class="line-clamp-3 font-display text-xl leading-snug text-white"><%= story.title %></h3>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

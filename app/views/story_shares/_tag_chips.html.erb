<%# Sector + audience chips that link back into the portal's own filters
    (not sectors/_tagging_label, which links to the auth-gated taggings page).
    Pass compact: true for the tighter sidebar variant. %>
<% compact = local_assigns.fetch(:compact, false) %>
<% wrapper_class = compact ? "mb-3 gap-1.5" : "mb-8 gap-2" %>
<% chip_class = compact ? "px-2 py-0.5" : "px-3 py-1" %>
<% sectors = story.sectors.to_a %>
<% audiences = story.audience_categories.to_a %>
<% if sectors.any? || audiences.any? %>
  <div class="flex flex-wrap <%= wrapper_class %>">
    <% sectors.each do |sector| %>
      <%= link_to sector.name, story_shares_path(sector_names_all: sector.name),
                  class: "bg-brand-magenta-50 text-brand-magenta-700 hover:bg-brand-magenta-100 inline-flex items-center rounded-full text-xs font-medium transition-colors #{chip_class}" %>
    <% end %>
    <% audiences.each do |category| %>
      <%= link_to category.decorate.display_name, story_shares_path(category_names_all: category.name),
                  class: "bg-brand-amber-50 text-brand-amber-800 hover:bg-brand-amber-100 inline-flex items-center rounded-full text-xs font-medium transition-colors #{chip_class}" %>
    <% end %>
  </div>
<% end %>

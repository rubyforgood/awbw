<% content_for(:page_bg_class, "admin-or-public-or-authpublished") %>
<% content_for(:title, "#{@story.title} - AWBW Story Share") %>
<% content_for(:head) do %>
  <meta property="og:title" content="<%= @story.title %>">
  <meta property="og:description" content="<%= @story.detail(length: 160) %>">
  <meta property="og:type" content="article">
  <% if @story.primary_asset&.file&.attached? %>
    <meta property="og:image" content="<%= url_for(@story.primary_asset.file) %>">
  <% end %>
<% end %>
</div><!-- Break out of layout container -->

<!-- Hero Section with Story Image -->
<section class="bg-white mt-12 -mx-2 sm:-mx-6 lg:-mx-8">
  <div class="max-w-6xl mx-auto">
    <div class="relative rounded-lg overflow-hidden shadow-lg">
      <div class="aspect-[16/6] bg-gray-200">
        <%= render "assets/display_image", resource: @story, variant: :hero, link: true %>
      </div>

      <% if @story.sectors.first %>
        <div class="absolute top-6 left-6 bg-purple-700 text-white text-xs font-semibold uppercase px-4 py-2 z-10">
          <%= @story.sectors.first.name %>
        </div>
      <% end %>

      <div class="absolute bottom-0 left-0 right-0 bg-black/50 p-6 sm:p-8 text-white">
        <h1 class="font-telefon text-2xl sm:text-3xl mb-2"><%= @story.title %></h1>
        <p class="text-sm opacity-90">
          <%= @story.organization_name %>
          <% if @story.organization&.city_state.present? %>- <%= @story.organization.city_state %><% end %>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Utility Buttons Section -->
<section class="bg-white py-4 -mx-2 sm:-mx-6 lg:-mx-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap justify-end gap-1">
      <%= link_to "All stories", story_shares_path, class: "btn btn-secondary-outline" %>
      <%= link_to "Home", root_path, class: "btn btn-secondary-outline" %>
      <% if current_user&.super_user? %>
        <%= link_to "Edit", edit_story_path(@story.id), class: "btn btn-secondary-outline admin-only bg-blue-100" %>
      <% end %>
      <span class="inline-block text-sm">
        <%= render "bookmarks/editable_bookmark_button", resource: @story %>
      </span>
      <%= print_button(@story, printable_type: "Story", button_text: "Print page") %>
    </div>
  </div>
</section>

<!-- Story Content Section -->
<section class="bg-white py-12 -mx-2 sm:-mx-6 lg:-mx-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Story Metadata -->
    <div class="text-sm text-gray-600 space-y-1 mb-8">
      <p><strong>Story by:</strong> <%= @story.author_credit %></p>
      <% if @story.organization_name.present? %>
        <p><strong>Organization name:</strong> <%= @story.organization_name %></p>
      <% end %>
      <% if @story.workshop_title.present? %>
        <p><strong>Workshop:</strong> <%= @story.workshop_title %></p>
      <% end %>
    </div>

    <%= render "tag_chips", story: @story %>

    <!-- Story Body Text -->
    <div class="prose prose-lg max-w-none text-gray-700 mb-10">
      <%= @story.rhino_body %>
    </div>

    <!-- YouTube embed -->
    <% if (embed_url = youtube_embed_url(@story.youtube_url)) %>
      <div class="aspect-video mb-10">
        <iframe src="<%= embed_url %>" class="w-full h-full rounded-lg"
                title="<%= @story.title %> video" allowfullscreen loading="lazy"></iframe>
      </div>
    <% end %>

    <!-- Additional Story Assets (if any beyond hero) -->
    <% if @story.assets.count > 1 %>
      <div class="mb-10">
        <%= render "assets/display_assets", resource: @story, link: true %>
      </div>
    <% end %>

    <div class="border-t border-gray-200 pt-6">
      <%= render "share_buttons", story: @story %>
    </div>
  </div>
</section>

<!-- Related Stories -->
<% if @related_stories.any? %>
  <section class="bg-gray-50 py-12 -mx-2 sm:-mx-6 lg:-mx-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-telefon text-2xl text-black mb-6">Related stories</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <% @related_stories.each do |story| %>
          <article class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow">
            <%= link_to story_share_path(story), class: "block" do %>
              <div class="aspect-[4/3] bg-gray-200">
                <%= render "assets/display_image", resource: story, variant: :hero %>
              </div>
              <div class="p-4">
                <% if story.sectors.first %>
                  <p class="text-xs font-semibold uppercase text-purple-700 mb-1"><%= story.sectors.first.name %></p>
                <% end %>
                <h3 class="font-telefon text-base text-gray-900 leading-tight"><%= story.title %></h3>
                <p class="text-xs text-gray-500 mt-1"><%= story.organization_name %></p>
              </div>
            <% end %>
          </article>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- What others are reading -->
<% if @popular_stories.any? %>
  <section class="bg-white py-12 -mx-2 sm:-mx-6 lg:-mx-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-telefon text-2xl text-black mb-6">What others are reading</h2>
      <ul class="divide-y divide-gray-200">
        <% @popular_stories.each do |story| %>
          <li class="py-3 flex items-baseline justify-between gap-4">
            <%= link_to story.title, story_share_path(story), class: "text-gray-800 hover:text-purple-700" %>
            <span class="text-xs text-gray-400 whitespace-nowrap"><%= story.created_at.strftime("%B %-d, %Y") %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
<% end %>

<%= render "get_involved" %>

<div><!-- Restore layout container -->

<% content_for(:page_bg_class, "admin-or-public-or-authpublished") %>
</div><!-- Break out of layout container -->

<!-- Hero Section with Story Image -->
<section class="bg-white mt-12 -mx-2 sm:-mx-6 lg:-mx-8">
  <div class="max-w-6xl mx-auto">
    <div class="relative rounded-lg overflow-hidden shadow-lg">
      <div class="aspect-[16/6] bg-gray-200">
        <%= render "assets/display_image",
                   resource: @story,
                   variant: :hero %>
      </div>
      
      <!-- Blue Sector Box on Top Left -->
      <div class="absolute top-6 left-6 bg-blue-600 text-white text-xs font-semibold uppercase px-4 py-2 z-10">
        <%= @story.sectors.first&.name || "Story" %>
      </div>
      
      <!-- Black semi-transparent overlay bar at bottom with title -->
      <div class="absolute bottom-0 left-0 right-0 bg-black/50 p-8 text-white">
        <h1 class="font-telefon text-3xl mb-2">
          <%= @story.title %>
        </h1>
        <p class="text-sm opacity-90">
          <%= @story.organization_name %>
          <% if @story.organization.city_state.present? %>
            - <%= @story.organization.city_state %>
          <% end %>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Utility Buttons Section -->
<section class="bg-white py-4 -mx-2 sm:-mx-6 lg:-mx-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-right space-x-1">
      <%= link_to "All Stories", story_shares_path, class: "btn btn-secondary-outline" %>
      <%= link_to "Stories", stories_path, class: "btn btn-secondary-outline" %>
      <%= link_to "Home", root_path, class: "btn btn-secondary-outline" %>
      <% if current_user&.super_user? %>
        <%= link_to "Edit", edit_story_path(@story),
                    class: "btn btn-secondary-outline admin-only bg-blue-100" %>
      <% end %>
      <span class="inline-block text-sm">
        <%= render "bookmarks/editable_bookmark_button", resource: @story %>
      </span>
      <%= print_button(@story, printable_type: "Story", button_text: "Print page") %>
    </div>
  </div>
</section>

<!-- Story Content Section -->
<section class="bg-white py-12 -mx-2 sm:-mx-6 lg:-mx-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Story Metadata -->
    <div class="text-sm text-gray-600 space-y-1 mb-8">
      <p>
        <strong>Story by:</strong>
        <% author_credit = @story.story_idea&.author_credit || @story.created_by.full_name %>
        <%= author_credit %>
      </p>
      <p>
        <strong>Organization Name:</strong>
        <%= @story.organization_name %>
      </p>
      <% if @story.workshop_title.present? %>
        <p>
          <strong>Workshop:</strong>
          <%= @story.workshop_title %>
        </p>
      <% end %>
    </div>

    <!-- Story Body Text -->
    <div class="prose prose-lg max-w-none text-gray-700 mb-10">
      <%= @story.rhino_body %>
    </div>

    <!-- Additional Story Assets (if any beyond hero) -->
    <% if @story.assets.count > 1 %>
      <div class="mb-10">
        <%= render "assets/display_assets", resource: @story %>
      </div>
    <% end %>
  </div>
</section>

<div><!-- Restore layout container -->

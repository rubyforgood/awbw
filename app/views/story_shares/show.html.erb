<% content_for(:page_bg_class, "admin-or-public-or-authpublished") %>
<% content_for(:title, "#{@story.title} - AWBW Story Share") %>
<% content_for(:head) do %>
  <meta property="og:title" content="<%= @story.title %>">
  <meta property="og:description" content="<%= @story.detail(length: 160) %>">
  <meta property="og:type" content="article">
  <% if @story.primary_asset&.file&.attached? %>
    <meta property="og:image" content="<%= url_for(@story.primary_asset.file) %>">
  <% end %>
<% end %>

<section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
  <% if params[:return_to] == "workshop" && params[:workshop_id].present? %>
    <div class="mb-4">
      <%= link_to workshop_path(params[:workshop_id], anchor: "workshopStories"),
                  class: "text-sm #{eyebrow_link_class}" do %>
        <i class="fa-solid fa-arrow-left text-xs"></i> Workshop
      <% end %>
    </div>
  <% end %>
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
    <!-- MAIN COLUMN -->
    <div class="min-w-0 lg:col-span-2">
      <h1 class="text-brand-navy-900 mb-4 font-display text-3xl leading-tight sm:text-4xl"><%= @story.title %></h1>

      <!-- Metadata + actions share one band so the buttons don't push the page down -->
      <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
        <div class="space-y-1 text-sm text-gray-700">
          <% profile_link = "text-brand-magenta-700 hover:underline" %>
          <p>
            <strong>Story by:</strong>
            <%= credited_author_link(@story, class: profile_link) %>
          </p>
          <% if @story.spotlighted_facilitator %>
            <p><strong>Spotlighted facilitator:</strong> <%= @story.spotlighted_facilitator_link(link_class: profile_link) %></p>
          <% end %>
          <% if @story.organization_name.present? %>
            <p>
              <strong>Organization name:</strong>
              <%= @story.organization_link(link_class: profile_link) %><%= ", #{@story.organization.state}" if @story.organization.state.present? %>
            </p>
          <% end %>
          <% if (workshop_links = @story.workshop_links(link_class: profile_link)).present? %>
            <p><strong><%= @story.workshop_reference_count > 1 ? "Workshops" : "Workshop" %>:</strong> <%= workshop_links %></p>
          <% end %>
        </div>
        <div class="flex shrink-0 flex-wrap items-center justify-end gap-1">
          <% if current_user&.super_user? %>
            <%= link_to "Edit", edit_story_path(@story.id), class: button_classes(:secondary_outline, extra: "admin-only bg-blue-100") %>
          <% end %>
          <span class="inline-block text-sm">
            <%= render "bookmarks/editable_bookmark_button", resource: @story %>
          </span>
          <%= print_button(@story, printable_type: "Story", button_text: "Print page") %>
        </div>
      </div>

      <%= render "tag_chips", story: @story %>

      <!-- Story video + images -->
      <%= render "assets/display_assets_carousel", resource: @story,
                 video_url: youtube_embed_url(@story.youtube_url), video_title: "#{@story.title} video" %>

      <!-- Body -->
      <div class="mb-10 max-w-none prose prose-lg text-gray-700">
        <%= @story.rhino_body %>
      </div>

      <!-- Share -->
      <div class="mb-8 border-t border-gray-200 pt-6">
        <%= render "share_buttons", story: @story %>
      </div>

      <!-- Boilerplate footer -->
      <p class="border-t border-gray-200 pt-6 text-xs leading-relaxed text-gray-400">
        <%= render "shared/organization_footer" %>
      </p>
    </div>

    <!-- RELATED SIDEBAR -->
    <% if @related_stories.any? %>
      <aside class="lg:col-span-1">
        <h2 class="text-brand-magenta-800 border-brand-magenta-700 mb-5 border-b-2 pb-1 font-display text-xl">Related stories</h2>
        <div class="space-y-8">
          <% @related_stories.each do |story| %>
            <article>
              <%= link_to story.title, story_share_path(story), class: "font-display text-lg text-brand-navy-900 hover:text-brand-magenta-700 leading-tight" %>
              <p class="mt-1 mb-2 text-xs text-gray-500">
                <%= story.organization_name %><%= " – #{story.organization.state}" if story.organization&.state.present? %>
              </p>
              <%= render "tag_chips", story: story, compact: true %>
              <%= link_to story_share_path(story), class: "relative block #{StorySharesHelper::STORY_IMAGE_ASPECT} rounded-xl overflow-hidden bg-brand-navy-50" do %>
                <%= render "assets/fitted_image", file: story.display_image, alt: story.title, loading: "lazy" %>
              <% end %>
            </article>
          <% end %>
        </div>
      </aside>
    <% end %>
  </div>
</section>

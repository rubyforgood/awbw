<%# Muted, looping YouTube player covering a banner box, decorative so the slide link and swipe stay live.
    Locals: story. %>
<% if (embed_url = youtube_background_embed_url(story.youtube_url)) %>
  <iframe src="<%= embed_url %>"
          title="<%= story.title %> video"
          class="pointer-events-none absolute inset-0 h-full w-full <%= StorySharesHelper::STORY_BANNER_VIDEO_SCALE %>"
          allow="autoplay; encrypted-media; picture-in-picture"
          tabindex="-1" aria-hidden="true"></iframe>
<% end %>

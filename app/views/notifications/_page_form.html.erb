<%= simple_form_for notification, url: url, data: { turbo: false } do |f| %>
  <%= render "shared/errors", resource: notification if notification.errors.any? %>
  <%= hidden_field_tag :noticeable_sgid, record.to_sgid.to_s if local_assigns[:include_noticeable_sgid] %>

  <div class="space-y-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <%= f.input :channel,
                  collection: Notification::MANUAL_CHANNELS.map { |channel| [ channel.titleize, channel ] },
                  selected: (Notification::MANUAL_CHANNELS.include?(notification.channel) ? notification.channel : "email"),
                  include_blank: false, label: "Channel", input_html: { class: "bg-white" } %>
      <div>
        <span class="mb-1 block text-sm font-medium text-gray-700">Direction</span>
        <%= render "notifications/direction_checkbox", f: f %>
      </div>
    </div>

    <%= f.input :email_subject, as: :text, label: "Subject", required: true,
                input_html: { rows: 1, class: "bg-white" } %>

    <div class="flex items-center gap-2">
      <label class="shrink-0 text-sm font-medium text-gray-700" for="notification_created_at">When</label>
      <%= f.datetime_field :created_at, value: (notification.created_at || Time.current).strftime("%Y-%m-%dT%H:%M"),
                           class: "min-w-0 flex-1 bg-white rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
    </div>

    <%= f.input :email_body_text, as: :text, label: "Body (brief summary)",
                input_html: { rows: 4, class: "bg-white" } %>
  </div>

  <div class="mt-6 flex items-center justify-end gap-3">
    <%= link_to "Cancel", cancel_path, class: button_classes(:secondary_outline) %>
    <%= f.button :submit, "Save", class: button_classes(:primary) %>
  </div>
<% end %>

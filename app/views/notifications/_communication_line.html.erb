<%# One communication row, styled to match a comment card (locals: notification,
    admin:, mark_admin_only:, truncate:, trailing:). The combined section keeps a
    row to one line and links the whole card to the communication; the standalone
    All comments & communications page passes truncate: false, which leaves
    channel/badges/subject on the headline row, drops the full body onto its own
    line underneath, and — since a card-wide link can hold no other links — makes
    the subject the link to the communication so `leading` can be a link too (the
    neutral source chip, pointing at that record's edit page, with the channel icon
    inside it). %>
<% admin = local_assigns.fetch(:admin, true) %>
<% mark_admin_only = local_assigns.fetch(:mark_admin_only, false) %>
<% truncate_body = local_assigns.fetch(:truncate, true) %>
<% leading = local_assigns[:leading] %>
<% trailing = local_assigns[:trailing] %>
<% decorated = notification.decorate %>
<% body_admin_only = notification.channel != "autoemail" %>
<% show_body = admin || !body_admin_only %>
<% subject = notification.email_subject.presence || notification.kind.to_s.humanize %>
<% body = notification.email_body_text.to_s if show_body %>
<% from_name = decorated.from_name %>
<% from_first = from_name.to_s.split.first.presence || from_name %>
<% chip = chip_color(notification.incoming? ? decorated.contact_person&.id : notification.sender_id) %>
<% card = "rounded-md border #{communication_card_class} px-3 py-2" %>
<% body_class = if body_admin_only && mark_admin_only
                  "admin-only rounded bg-blue-100 px-1 text-gray-700"
                elsif body_admin_only
                  "text-gray-900"
                else
                  "text-gray-500"
                end %>
<% row = capture do %>
  <div class="flex flex-wrap items-start gap-x-1 gap-y-1">
    <%# Flag column left empty — communications have no follow-up flag. %>
    <span class="w-4 shrink-0"></span>
    <span class="w-32 shrink-0 text-xs whitespace-nowrap text-gray-400">
      <%= notification.created_at.strftime("%-m/%-d/%Y %-I:%M %p") %>
    </span>
    <span class="inline-flex w-20 shrink-0 items-center">
      <span class="<%= chip[0] %> <%= chip[1] %> max-w-full truncate rounded px-1.5 py-0.5 text-left text-xs" title="<%= decorated.from_title.presence || from_name %>"><%= truncate(from_first.to_s, length: 10, omission: "..") %></span>
    </span>
    <%# Subject and body share one column so the body starts flush with the subject. %>
    <% if truncate_body %>
      <div class="flex min-w-0 flex-1 items-start gap-1 text-sm">
        <%= decorated.channel_chip %>
        <span class="line-clamp-2 min-w-0 flex-1">
          <%= decorated.flag_badges %>
          <span class="font-semibold text-gray-900"><%= subject %></span>
          <% if body.present? %><span class="<%= body_class %>" title="<%= body %>"><%= body %></span><% end %>
        </span>
      </div>
    <% else %>
      <div class="min-w-0 flex-1 text-sm">
        <span>
          <%= leading || decorated.channel_chip %>
          <%= decorated.flag_badges %>
          <% if !admin %>
            <span class="font-semibold text-gray-900"><%= subject %></span>
          <% else %>
            <%= link_to subject, notification_path(notification), target: "_blank", rel: "noopener",
                        class: "font-semibold text-gray-900 hover:underline" %>
          <% end %>
        </span>
        <% if body.present? %>
          <div class="pt-1 whitespace-pre-line <%= body_class %>"><%= body %></div>
        <% end %>
      </div>
    <% end %>
    <%= trailing %>
  </div>
<% end %>
<% if admin && truncate_body %>
  <%= link_to row, notification_path(notification), target: "_blank", rel: "noopener",
              class: "block #{card} transition-colors #{DomainTheme.bg_class_for(:notifications, intensity: 50, hover: true)}" %>
<% else %>
  <div class="<%= card %>"><%= row %></div>
<% end %>

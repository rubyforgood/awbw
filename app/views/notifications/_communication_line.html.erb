<%# ---- One communication rendered to line up column-for-column with a comment
    in the combined section: the channel icon sits in the flag column, then the
    date+time, then a colored person chip, then the subject (aligned with a
    comment's topic) and body. The chip shows who the message is *from* — the
    staff sender for an outgoing message, the person for an incoming one — colored
    by that person's id so it matches their comment chip. The body of a hand-noted
    (non-autoemail) communication is an internal staff note: admin-only, and given
    the blue admin wash on pages non-admins can view. Pass admin: false for a
    non-admin viewer. ---- %>
<% admin = local_assigns.fetch(:admin, true) %>
<% mark_admin_only = local_assigns.fetch(:mark_admin_only, false) %>
<% decorated = notification.decorate %>
<% body_admin_only = notification.channel != "autoemail" %>
<% show_body = admin || !body_admin_only %>
<% subject = notification.email_subject.presence || notification.kind.to_s.humanize %>
<% body = notification.email_body_text.to_s if show_body %>
<% from_name = decorated.from_name %>
<% from_first = from_name.to_s.split.first.presence || from_name %>
<% chip = chip_color(notification.incoming? ? decorated.contact_person&.id : notification.sender_id) %>
<% card = "rounded-md border #{DomainTheme.border_class_for(:notifications, intensity: 200)} #{DomainTheme.bg_class_for(:notifications, intensity: 50)} px-3 py-2" %>
<% row = capture do %>
  <div class="flex items-center gap-x-1">
    <%# Flag column left empty — communications have no follow-up flag. %>
    <span class="w-4 shrink-0"></span>
    <span class="shrink-0 text-xs whitespace-nowrap text-gray-400">
      <%= notification.created_at.strftime("%-m/%-d/%Y %-I:%M %p") %>
    </span>
    <span class="inline-flex w-20 shrink-0 items-center">
      <span class="<%= chip[0] %> <%= chip[1] %> max-w-full truncate rounded px-1.5 py-0.5 text-left text-xs" title="<%= decorated.from_title.presence || from_name %>"><%= truncate(from_first.to_s, length: 10, omission: "..") %></span>
    </span>
    <span class="min-w-0 flex-1 truncate text-sm">
      <%= decorated.flag_badges %>
      <%= decorated.channel_chip %>
      <span class="font-semibold text-gray-900"><%= subject %></span>
      <% if body.present? %>
        <% if body_admin_only && mark_admin_only %>
          <%# Internal staff note on a page non-admins can view — flag it admin-only. %>
          <span class="admin-only rounded bg-blue-100 px-1 text-gray-700" title="<%= body %>"><%= body %></span>
        <% elsif body_admin_only %>
          <%# Internal staff note on an admin-only page — rendered plainly like a comment. %>
          <span class="text-gray-900" title="<%= body %>"><%= body %></span>
        <% else %>
          <span class="text-gray-500" title="<%= body %>"><%= body %></span>
        <% end %>
      <% end %>
    </span>
  </div>
<% end %>
<% if admin %>
  <%= link_to row, notification_path(notification), target: "_blank", rel: "noopener",
              class: "block #{card} transition-colors #{DomainTheme.bg_class_for(:notifications, intensity: 50, hover: true)}" %>
<% else %>
  <div class="<%= card %>"><%= row %></div>
<% end %>

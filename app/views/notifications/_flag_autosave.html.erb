<%# Single-click follow-up flag for a communication, safe inside a parent form —
    it autosaves on its own (PATCHes notification_path independently), unlike the
    button_to notifications/flag_toggle used on the standalone feed where nesting
    a form is fine. The sr-only checkbox drives the flag icon via peer-checked, so
    the toggle shows instantly. Locals: notification. %>
<span data-controller="autosave"
      data-autosave-url-value="<%= notification_path(notification) %>"
      data-autosave-id-value="<%= notification.id %>"
      data-action="change->autosave#save"
      class="leading-none">
  <input type="hidden" name="notification[flagged]" value="0">
  <label class="inline-flex cursor-pointer leading-none" title="<%= notification.flagged? ? "Flagged for follow-up — click to clear" : "Flag for follow-up" %>">
    <input type="checkbox" name="notification[flagged]" value="1" <%= "checked" if notification.flagged? %> class="peer sr-only">
    <i class="fa-regular fa-flag text-gray-500 peer-checked:text-orange-500 peer-checked:[--fa-style:900]! hover:text-orange-400"></i>
  </label>
</span>

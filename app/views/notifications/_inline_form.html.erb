<% record = local_assigns[:record] || notification.noticeable %>
<% persisted = notification.persisted? %>
<% form_url = persisted ? notification_path(notification) : notifications_path %>
<% cancel_path = inline_record_path(record, fallback: notifications_path) %>
<% cancel_slot = local_assigns[:cancel_slot] %>
<% frame_data = turbo_frame_request? ? {} : { turbo_frame: "_top" } %>
<% channel_default = Notification::MANUAL_CHANNELS.include?(notification.channel) ? notification.channel : "email" %>
<% if persisted %>
  <% decorated = notification.decorate %>
  <% from_name = decorated.from_name %>
  <% from_first = from_name.to_s.split.first.presence || from_name %>
  <% from_color = chip_color(notification.incoming? ? decorated.contact_person&.id : notification.sender_id) %>
  <% from_title = decorated.from_title.presence || from_name %>
<% else %>
  <% from_name = current_user&.full_name %>
  <% from_first = current_user&.person&.first_name || current_user&.name.to_s.split.first %>
  <% from_color = chip_color(current_user&.id) %>
  <% from_title = from_name %>
<% end %>
<% logged_at = (notification.created_at || Time.current).strftime("%Y-%m-%dT%H:%M") %>
<% field_class = "w-full bg-white rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
<% select_class = "w-32 bg-white rounded-md border border-gray-300 px-2 py-1 text-xs shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>

<%= turbo_frame_tag frame_id do %>
  <div class="rounded-md border <%= communication_card_class %> px-3 py-2">
    <%= simple_form_for notification, url: form_url, data: frame_data do |f| %>
      <%= render "shared/errors", resource: notification if notification.errors.any? %>

      <%= hidden_field_tag :noticeable_sgid, record.to_sgid.to_s unless persisted %>
      <%= hidden_field_tag :inline, 1 %>

      <div class="flex flex-wrap items-start gap-x-1 gap-y-1">
        <div class="w-40 shrink-0">
          <%= f.datetime_field :created_at, value: logged_at,
                               class: "w-full bg-white rounded-md border border-gray-300 px-2 py-1 text-xs shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none",
                               aria: { label: "When" } %>
        </div>

        <span class="inline-flex w-20 shrink-0 items-center">
          <span class="<%= from_color[0] %> <%= from_color[1] %> max-w-full cursor-default truncate rounded px-1.5 py-0.5 text-left text-xs" title="<%= from_title %>">
            <%= truncate(from_first.presence || "--", length: 10, omission: "..") %>
          </span>
        </span>

        <div class="flex min-w-0 grow flex-col gap-1.5">
          <div class="flex flex-wrap items-center gap-2">
            <%= f.select :channel,
                         options_for_select(Notification::MANUAL_CHANNELS.map { |channel| [ channel.titleize, channel ] }, channel_default),
                         { include_blank: false }, class: select_class, aria: { label: "Channel" } %>
            <%= render "notifications/direction_checkbox", f: f, compact: true %>
          </div>
          <%= f.input_field :email_subject, as: :text, rows: 1, required: true, placeholder: "Topic or subject line",
                            class: field_class, aria: { label: "Subject" } %>
          <%= f.input_field :email_body_text, as: :text, rows: 2, placeholder: "What happened? (e.g. left voicemail, sent reminder)",
                            class: field_class, aria: { label: "Body" } %>
        </div>

        <div class="ml-auto flex shrink-0 items-center gap-x-2">
          <%= f.button :submit, "Save", class: button_classes(:secondary_outline, size: :sm) %>
          <% if cancel_slot.present? %>
            <%= link_to "Cancel", new_notification_path(noticeable_sgid: record.to_sgid.to_s, cancel: 1),
                  class: "text-sm #{eyebrow_link_class}", data: { turbo_frame: cancel_slot } %>
          <% else %>
            <%= link_to "Cancel", cancel_path, class: "text-sm #{eyebrow_link_class}", data: frame_data %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<%= turbo_stream.replace("notifications_count", partial: "notifications_count") %>
<% if @notifications.any? %>
  <div class="overflow-x-auto bg-white border border-gray-200 rounded-xl shadow-sm blur-on-submit">
    <%= render "index" %>
  </div>
  <!-- Pagination -->
  <div class="mt-6 flex justify-center">
    <div class="pagination mt-6"><%= tailwind_paginate @notifications %></div>
  </div>
<% else %>
  <div class="text-center py-16 bg-white rounded-xl border border-gray-200 shadow-sm">
    <h2 class="text-gray-600 text-lg mb-2">No notifications yet</h2>
    <% if current_user_admin? %>
      <div class="admin-only bg-blue-100 p-3">
        <%= link_to "Create a notification",
                    new_notification_path,
                    class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
<% end %>

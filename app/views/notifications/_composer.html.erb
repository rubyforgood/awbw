<%# Log-a-communication composer for a person's combined feed. Mirrors
    comments/_composer: the "Log it against…" picker submits the chosen record's
    signed GlobalID (noticeable_sgid) so the controller can resolve and trust it,
    while `person_id` fixes whose email the communication is addressed to and
    `for_person_id` sends the save back to this feed.
    Locals: person, notification, record_targets. %>
<div class="rounded-lg border <%= DomainTheme.border_class_for(:notifications) %> <%= DomainTheme.bg_class_for(:notifications, intensity: 50) %> p-4 shadow-sm">
  <%= simple_form_for notification, url: notifications_path do |f| %>
    <%= hidden_field_tag :person_id, person.id %>
    <%= hidden_field_tag :for_person_id, person.id %>
    <%= f.hidden_field :sender_id, value: current_user.id %>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-start" data-controller="conditional-fields">
      <div class="shrink-0 space-y-2 sm:w-1/3">
        <label class="mb-1 block text-xs font-semibold text-gray-600" for="noticeable_sgid">Log it against</label>
        <%= select_tag :noticeable_sgid,
                       options_for_select(record_targets.map { |target| [ target[:label], target[:sgid] ] }),
                       class: "w-full bg-white rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
        <%= f.select :channel, options_for_select(Notification::MANUAL_CHANNELS.map { |channel| [ channel.titleize, channel ] }, "email"), { include_blank: false },
                     class: "w-full bg-white rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
        <%= render "notifications/direction_toggle", f: f, compact: true,
                   source_data: { conditional_fields_target: "source", action: "change->conditional-fields#toggle" } %>
        <label class="flex items-center gap-2" data-conditional-fields-target="field" data-show-when="incoming" hidden>
          <%= f.check_box :responded, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
          <span class="text-sm text-gray-700">Already responded</span>
        </label>
      </div>
      <div class="grow space-y-2">
        <label class="mb-1 block text-xs font-semibold text-gray-600" for="notification_email_subject">Subject (visible to user)</label>
        <%= f.input_field :email_subject,
                          required: true,
                          placeholder: "Topic or subject line",
                          class: "w-full bg-white rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
        <%= f.input_field :email_body_text,
                          as: :text,
                          rows: 3,
                          placeholder: "What happened? (e.g. left voicemail, sent reminder)",
                          class: "w-full bg-white rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
      </div>
    </div>

    <div class="mt-3">
      <%= f.submit t("communications.add"), class: "btn btn-secondary-outline" %>
    </div>
  <% end %>
</div>

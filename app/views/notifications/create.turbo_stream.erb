<% record = @notification.noticeable %>
<% if @notification.errors.any? %>
  <%= turbo_stream.update "activity-new-form-slot" do %>
    <%= render "notifications/inline_new_form", notification: @notification, record: record,
               url: notifications_path,
               cancel_path: new_notification_path(noticeable_sgid: record.to_sgid.to_s, cancel: 1) %>
  <% end %>
<% else %>
  <%= turbo_stream.update "activity-new-form-slot", "" %>
  <%= turbo_stream.prepend "activity-list" do %>
    <%= render "notifications/inline_row", notification: @notification %>
  <% end %>
  <%= turbo_stream.remove "activity-list-empty" %>
<% end %>

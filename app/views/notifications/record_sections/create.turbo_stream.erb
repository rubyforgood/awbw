<% record = @notification.noticeable %>
<% if @notification.errors.any? %>
  <%= turbo_stream.update "comments-and-communications-new-form-slot" do %>
    <%= render "notifications/record_section_new_form", notification: @notification, record: record,
               url: notifications_record_sections_path,
               cancel_path: new_notifications_record_section_path(noticeable_sgid: record.to_sgid.to_s, cancel: 1) %>
  <% end %>
<% else %>
  <%= turbo_stream.update "comments-and-communications-new-form-slot", "" %>
  <%= turbo_stream.prepend "comments-and-communications-list" do %>
    <%= render "notifications/record_section_row", notification: @notification %>
  <% end %>
  <%= turbo_stream.remove "comments-and-communications-list-empty" %>
<% end %>

<% if params[:cancel].present? %>
  <%= turbo_stream.update "comments-and-communications-new-form-slot", "" %>
<% else %>
  <%= turbo_stream.update "comments-and-communications-new-form-slot" do %>
    <%= render "notifications/record_section_new_form", notification: @notification, record: @noticeable,
               url: notifications_record_sections_path,
               cancel_path: new_notifications_record_section_path(noticeable_sgid: @noticeable.to_sgid.to_s, cancel: 1) %>
  <% end %>
<% end %>

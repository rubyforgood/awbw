<%= simple_form_for(@banner) do |f| %>
  <div class="space-y-6">
    <!-- Validation Errors -->
    <%= render 'shared/errors', resource: @banner if @banner.errors.any? %>

    <!-- Hidden Tracking Fields -->
    <%= f.hidden_field :created_by_id, value: f.object.created_by_id || current_user&.id %>
    <%= f.hidden_field :updated_by_id, value: current_user&.id %>

    <!-- Content + Visibility -->
    <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-4">
      <div class="md:col-span-3">
        <%= f.input :content,
                    as: :text,
                    label: "Banner Content",
                    input_html: {
                      rows: 2,
                      class: "w-full rounded-md border border-gray-300 px-3 py-2 text-gray-800 shadow-sm
                             focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none"
                    },
                    hint: "You can include limited HTML (e.g. <b>, <i>, <a>)." %>
      </div>

      <div class="admin-only mt-6 rounded bg-blue-100 p-3 md:mt-0">
        <%= render "shared/visibility_info", flags: %i[published] %>
        <div class="grid grid-cols-1 items-center">
          <%= visibility_flag_input f, :published %>
        </div>
      </div>
    </div>

    <div class="action-buttons mt-8 flex justify-center gap-3">
      <% if allowed_to?(:destroy?, f.object) %>
        <%= link_to "Delete", @banner, class: button_classes(:danger_outline),
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete?" } %>
      <% end %>
      <%= link_to "Cancel", banners_path, class: button_classes(:secondary_outline) %>
      <%= f.button :submit, class: button_classes(:primary) %>
    </div>
  </div>
<% end %>

<% content_for(:page_bg_class, "admin-or-owner") %>
<div class="border border-gray-200 rounded-xl shadow overflow-hidden">
  <!-- Workshop idea header banner -->
  <div class="<%= DomainTheme.bg_class_for(:workshop_ideas, intensity: 100) %> border-b <%= DomainTheme.border_class_for(:workshop_ideas, intensity: 300) %> px-8 py-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 <%= DomainTheme.text_class_for(:workshop_ideas, intensity: 700) %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
        </svg>
        <span class="text-sm font-semibold <%= DomainTheme.text_class_for(:workshop_ideas, intensity: 900) %> uppercase tracking-wide">Workshop Idea</span>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Home", root_path, class: "text-sm text-gray-500 hover:text-gray-700 px-2 py-1" %>
        <% if allowed_to?(:index?, WorkshopIdea) %>
          <%= link_to "Workshop Ideas", workshop_ideas_path, class: "text-sm text-gray-500 hover:text-gray-700 px-2 py-1" %>
        <% end %>
        <% if allowed_to?(:edit?, @workshop_idea) %>
          <%= link_to "Edit", edit_workshop_idea_path(@workshop_idea), class: "text-sm text-gray-500 hover:text-gray-700 px-2 py-1" %>
        <% end %>
      </div>
    </div>
  </div>
  <div class="<%= DomainTheme.bg_class_for(:workshop_ideas) %> p-4 sm:p-8 space-y-6">

  <div class="bg-white rounded-lg shadow-md p-6 space-y-6">
    <div class="font-semibold text-gray-900 mb-2">
      <h1 class="text-3xl tracking-tight"><%= @workshop_idea.title %></h1>
    </div>

    <% if @workshop_idea.workshops.any? %>
      <div class="flex items-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3">
        <i class="fas fa-arrow-up-from-bracket text-blue-600"></i>
        <span class="text-sm font-medium text-blue-800">
          Promoted to:
          <% @workshop_idea.workshops.each do |workshop| %>
            <%= link_to workshop.title, workshop_path(workshop), class: "underline hover:text-blue-600" %>
          <% end %>
        </span>
      </div>
    <% end %>

    <div class="bg-gray-50 rounded-lg border border-gray-200 p-4 text-sm text-gray-600">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        <div>
          <span class="font-semibold text-gray-700">Author credit:</span>
          <%= @workshop_idea.author_credit_preference&.humanize || "—" %>
        </div>
        <div>
          <span class="font-semibold text-gray-700">Windows audience:</span>
          <%= @workshop_idea.windows_type&.short_name || "—" %>
        </div>
        <div>
          <span class="font-semibold text-gray-700">Timeframe:</span>
          <%= @workshop_idea.timeframe.presence || "—" %>
        </div>
        <div>
          <span class="font-semibold text-gray-700">Created by:</span>
          <%= @workshop_idea.created_by&.full_name %>
          <br><span class="text-gray-400"><%= @workshop_idea.created_at.in_time_zone.strftime("%Y-%m-%d %I:%M %P") %></span>
        </div>
        <div>
          <span class="font-semibold text-gray-700">Updated by:</span>
          <%= @workshop_idea.updated_by&.full_name %>
          <br><span class="text-gray-400"><%= @workshop_idea.updated_at.in_time_zone.strftime("%Y-%m-%d %I:%M %P") %></span>
        </div>
      </div>

      <% if @workshop_idea.staff_notes.present? %>
        <div class="mt-3 pt-3 border-t border-gray-200">
          <span class="font-semibold text-gray-700">Staff notes:</span>
          <%= @workshop_idea.staff_notes %>
        </div>
      <% end %>
    </div>

    <% if @workshop_idea.description.present? %>
      <div class="text-sm text-gray-600">
        <p><strong>Description:</strong> <%= @workshop_idea.description %></p>
      </div>
    <% end %>

    <%= render "assets/display_assets", resource: @workshop_idea, link: true %>

    <%
      sections = [
        ["Objective",          @workshop_idea.rhino_objective],
        ["Materials",          @workshop_idea.rhino_materials],
        ["Optional materials", @workshop_idea.rhino_optional_materials],
        ["Setup",              @workshop_idea.rhino_setup],
        ["Introduction",       @workshop_idea.rhino_introduction],
        ["Opening circle",     @workshop_idea.rhino_opening_circle],
        ["Warm up",            @workshop_idea.rhino_warm_up],
        ["Visualization",      @workshop_idea.rhino_visualization],
        ["Demonstration",      @workshop_idea.rhino_demonstration],
        ["Creation",           @workshop_idea.rhino_creation],
        ["Closing",            @workshop_idea.rhino_closing],
        ["Tips",               @workshop_idea.rhino_tips],
        ["Notes",              @workshop_idea.rhino_notes],
      ]
    %>
    <% sections.each do |label, content| %>
      <% if content.present? %>
        <div class="mb-4">
          <h3 class="text-sm font-semibold text-gray-700 mb-1"><%= label %></h3>
          <div class="text-gray-900"><%= content %></div>
        </div>
      <% end %>
    <% end %>
  </div>

  </div>
</div>

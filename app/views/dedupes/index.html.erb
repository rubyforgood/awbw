<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="<%= DomainTheme.bg_class_for(@dedupe[:domain]) %> border-primary/10 rounded-2xl border p-6 shadow-sm">
  <div class="space-y-6">

    <!-- Eyebrow + header -->
    <div>
      <%= link_to "← #{@dedupe[:back_label] || @dedupe[:model_label_plural]}",
                  @dedupe[:back_path] || url_for(action: :index),
                  class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
      <h1 class="text-primary mt-2 font-display text-2xl font-semibold">
        Dedupe <%= @dedupe[:model_label_plural].downcase %>
      </h1>
      <p class="mt-1 text-gray-500">
        Pick which <%= @dedupe[:model_label].downcase %> to delete and which to keep — its
        records move to the one you keep before it's removed.
      </p>
      <% if @dedupe[:subtitle].present? %>
        <p class="mt-1 text-sm text-gray-500"><%= @dedupe[:subtitle] %></p>
      <% end %>
    </div>

    <% if @just_merged %>
      <div class="flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-emerald-900" role="status">
        <i class="fa-solid fa-circle-check mt-0.5 text-emerald-600" aria-hidden="true"></i>
        <p>
          <span class="font-semibold"><%= @just_merged[:deleted_label] %></span> was successfully merged into
          <% if @just_merged[:kept_path] %>
            <%= link_to @just_merged[:kept_label], @just_merged[:kept_path], class: "font-semibold underline hover:text-emerald-700" %>
            and deleted.
          <% elsif @just_merged[:kept_label] %>
            <span class="font-semibold"><%= @just_merged[:kept_label] %></span> and deleted.
          <% else %>
            the kept <%= @dedupe[:model_label].downcase %> and deleted.
          <% end %>
        </p>
      </div>
    <% end %>

    <!-- Selection form -->
    <%= form_with url: url_for(action: :dedupe_preview), method: :get, data: { turbo: false },
                  class: "rounded-xl bg-white border border-gray-200 p-6 space-y-4" do |f| %>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <label class="mb-2 block font-medium text-gray-700">
            <%= @dedupe[:model_label] %> to delete
          </label>
          <%= f.select @dedupe[:delete_id_param].to_sym,
                      options_for_select([]),
                      { include_blank: true, prompt: @dedupe[:search_hint] },
                      class: "w-full px-4 py-2 rounded border border-gray-300 focus:border-blue-500 focus:ring-blue-200 text-gray-900",
                      required: true,
                      data: { controller: "remote-select", remote_select_model_value: @dedupe[:search_model] } %>
        </div>
        <div>
          <label class="mb-2 block font-medium text-gray-700">
            <%= @dedupe[:model_label] %> to keep
          </label>
          <%= f.select @dedupe[:keep_id_param].to_sym,
                      options_for_select([]),
                      { include_blank: true, prompt: @dedupe[:search_hint] },
                      class: "w-full px-4 py-2 rounded border border-gray-300 focus:border-blue-500 focus:ring-blue-200 text-gray-900",
                      required: true,
                      data: { controller: "remote-select", remote_select_model_value: @dedupe[:search_model] } %>
        </div>
      </div>
      <div class="flex justify-end gap-3 pt-2">
        <%= link_to "Clear", url_for(action: :dedupe_index),
                    class: button_classes(:secondary_outline) %>
        <%= f.submit "Preview merge", class: button_classes(:primary) %>
      </div>
    <% end %>

    <!-- Possible duplicates -->
    <% if @possible_duplicate_groups.any? %>
      <div>
        <h2 class="mb-3 text-lg font-semibold text-gray-900">
          Possible duplicate groups (<%= number_with_delimiter(@possible_duplicate_groups.count) %>)
        </h2>
        <% if @possible_duplicate_groups.any?(&:tier) %>
          <div class="space-y-3">
            <% @possible_duplicate_groups.chunk_while { |group, following| group.tier == following.tier }.each_with_index do |chunk, index| %>
              <details class="border-primary/10 rounded-2xl border bg-white" <%= "open" if index.zero? %>>
                <summary class="cursor-pointer select-none px-4 py-3 font-semibold text-gray-900">
                  <%= chunk.first.tier %>
                  <span class="font-normal text-gray-400">(<%= chunk.count %>)</span>
                </summary>
                <div class="space-y-4 px-4 pb-4">
                  <%= render partial: "dedupes/group", collection: chunk, as: :group %>
                </div>
              </details>
            <% end %>
          </div>
        <% else %>
          <div class="space-y-4">
            <%= render partial: "dedupes/group", collection: @possible_duplicate_groups, as: :group %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="border-primary/10 rounded-2xl border bg-white py-10 text-center">
        <i class="fa-solid fa-circle-check mb-2 text-3xl text-emerald-500"></i>
        <p class="text-gray-600">No likely duplicate <%= @dedupe[:model_label_plural].downcase %> detected.</p>
      </div>
    <% end %>

  </div>
</div>

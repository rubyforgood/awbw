<%# One aligned cell of the reassignment summary. Locals: entry ({ label:, count:,
  names: [..] } or nil for a side that has none of this association), border, round.
  A single record shows inline; several expand to a bulleted list of every loaded name. %>
<div class="border-x border-b <%= border %> <%= round %> bg-white px-5 py-3 text-sm">
  <% if entry.nil? %>
    <span class="text-gray-300">—</span>
  <% elsif entry[:count] <= 1 %>
    <span class="font-medium text-gray-800"><%= entry[:label] %></span>
    <span class="text-gray-400">(<%= entry[:count] %>)</span>
    <% if entry[:names].any? %>
      <span class="text-gray-500">· <%= entry[:names].first %></span>
    <% end %>
  <% else %>
    <% extra = entry[:count] - entry[:names].size %>
    <details class="group">
      <summary class="flex cursor-pointer list-none items-center gap-1 text-gray-600 [&::-webkit-details-marker]:hidden">
        <span class="font-medium text-gray-800"><%= entry[:label] %></span>
        <span class="text-gray-400">(<%= entry[:count] %>)</span>
        <i class="fa-solid fa-chevron-right ml-auto text-xs text-gray-400 transition-transform group-open:rotate-90"></i>
      </summary>
      <ul class="mt-1 ml-5 list-disc space-y-0.5 text-gray-500">
        <% entry[:names].each do |name| %>
          <li><%= name %></li>
        <% end %>
        <% if extra > 0 %>
          <li class="list-none text-gray-400">+<%= extra %> more</li>
        <% end %>
      </ul>
    </details>
  <% end %>
</div>

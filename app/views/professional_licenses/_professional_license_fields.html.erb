<%# A license is editable by an admin, or by its holder while it has no CE
    registrations. Once CE registrations exist it locks to admins — shown read-only,
    with a change request for the owner. simple_fields_for still emits the hidden
    id in the locked branch, so the record submits unchanged. %>
<% editable = f.object.new_record? || allowed_to?(:edit?, f.object) %>
<% if editable %>
  <div class="nested-fields mb-3 rounded-lg border border-gray-200 bg-white p-3">
    <div class="grid grid-cols-1 items-start gap-4 md:grid-cols-5">
      <div>
        <%= f.input :number,
                    wrapper: false,
                    label: "License number",
                    input_html: { placeholder: "e.g. 90210", class: "rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" } %>
      </div>

      <div>
        <%= f.input :kind,
                    wrapper: false,
                    label: "Type",
                    input_html: { placeholder: "e.g. LMFT", class: "rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" } %>
      </div>

      <div>
        <% license = f.object.decorate %>
        <%= f.input :issuing_state,
                    as: :select,
                    collection: us_states,
                    include_blank: true,
                    selected: (license.issuing_state unless outside_usa_state?(license.issuing_state)),
                    wrapper: false,
                    label: "Issuing state",
                    input_html: { class: "w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" } %>
        <%= render layout: "shared/outside_usa", locals: { open: license.outside_usa? } do %>
          <%= f.input :issuing_state_outside_usa,
                      wrapper: false,
                      label: "State / province",
                      input_html: { value: (license.issuing_state if outside_usa_state?(license.issuing_state)),
                                    class: "w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" } %>
          <%= f.input :issuing_country,
                      as: :select,
                      collection: GeographyHelper::COUNTRIES,
                      include_blank: true,
                      wrapper: false,
                      label: "Country",
                      input_html: { class: "w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" } %>
        <% end %>
      </div>

      <div>
        <%= f.input :expires_on,
                    as: :date,
                    html5: true,
                    wrapper: false,
                    label: "Expires",
                    input_html: { class: "rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" } %>
      </div>

      <div class="flex items-center justify-end gap-3 text-right md:pt-8">
        <% if f.object.persisted? %>
          <%= link_to "Edit", edit_professional_license_path(f.object, return_to: "person"),
                      class: "text-sm text-gray-400 hover:text-blue-600 underline whitespace-nowrap",
                      data: { turbo_frame: "_top" } %>
        <% end %>
        <% if f.object.new_record? || f.object.removable? %>
          <%= link_to_remove_association "Remove",
                                         f,
                                         class: "text-sm text-gray-400 hover:text-red-600 underline whitespace-nowrap" %>
        <% else %>
          <%= link_to edit_professional_license_path(f.object, return_to: "person"),
                      class: "text-sm text-amber-600 hover:text-amber-800 hover:underline whitespace-nowrap",
                      title: f.object.decorate.ce_events_summary,
                      data: { turbo_frame: "_top" } do %>
            Can't<br>remove
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <div class="nested-fields mb-3 rounded-lg border border-blue-200 bg-blue-50 p-3">
    <div class="flex items-start justify-between gap-4">
      <dl class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm sm:grid-cols-4">
        <div>
          <dt class="text-xs tracking-wide text-gray-400 uppercase">License number</dt>
          <dd class="font-medium text-gray-900"><%= f.object.number.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs tracking-wide text-gray-400 uppercase">Type</dt>
          <dd class="font-medium text-gray-900"><%= f.object.kind.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs tracking-wide text-gray-400 uppercase">Issuing state</dt>
          <dd class="font-medium text-gray-900"><%= f.object.decorate.issuing_place.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs tracking-wide text-gray-400 uppercase">Expires</dt>
          <dd class="font-medium text-gray-900"><%= f.object.expires_on&.to_fs(:long) || "—" %></dd>
        </div>
      </dl>
      <%= render "shared/badge", label: "Locked", classes: "bg-blue-100 text-blue-700 border-blue-200", icon: "fa-solid fa-lock text-2xs", extra: "shrink-0" %>
    </div>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
      <p class="text-xs text-gray-500">Locked because this license has CE registrations — only an admin can edit it.</p>
      <% pending = f.object.profile_change_requests.pending.first %>
      <div class="flex items-center gap-2">
        <%= render "people/pending_request_icon", request: pending if pending %>
        <%= link_to new_profile_change_request_path(person_id: f.object.person_id, field: ProfileChangeRequest::LICENSE_FIELD, professional_license_id: f.object.id),
                    target: "_blank", rel: "noopener", class: button_classes(:secondary_outline, size: :sm) do %>
          <%= pending ? "See your request" : "Request a change" %> <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

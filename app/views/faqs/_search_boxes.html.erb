<%= form_tag(faqs_path, method: :get, class: "space-y-4", data: { controller: "collection" }) do |f| %>
  <div class="mb-6 flex flex-col md:flex-row md:items-end md:gap-4">
    <!-- Search -->
    <%= render "shared/filter_text", param: :query, label: "Search", submit: true,
          wrapper_class: "mb-3 w-full md:mb-0 md:flex-1" %>

    <!-- Visibility -->
    <div class="mb-3 w-full md:mb-0 md:w-48">
      <%= render "shared/visibility_filter",
                 model_class: Faq,
                 admin: allowed_to?(:manage?, Faq),
                 authenticated: user_signed_in?,
                 button_text: "All" %>
    </div>

    <!-- Clear filters -->
    <div class="w-full md:w-auto">
      <%= render "shared/search_clear", url: faqs_path %>
    </div>
  </div>
<% end %>



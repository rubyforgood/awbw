<div class="flex items-center gap-1">
  <label class="flex items-center gap-1 cursor-pointer">
    <%= radio_button_tag :sort, "created",
                         @sort == "created",
                         onclick: "submitSort(this);" %>
    <span class="text-sm">Newest</span>
  </label>
</div>

<div class="flex items-center gap-1">
  <label class="flex items-center gap-1 cursor-pointer">
    <%= radio_button_tag :sort, "title",
                         @sort == "title",
                         onclick: "submitSort(this);" %>
    <span class="text-sm">Title</span>
  </label>
</div>

<div class="flex items-center gap-1">
  <label class="flex items-center gap-1 cursor-pointer">
    <%= radio_button_tag :sort, "led",
                         @sort == "led",
                         onclick: "submitSort(this);" %>
    <span class="text-sm">Most bookmarked</span>
  </label>
</div>

<% if params[:query].present? %>
  <div class="flex items-center gap-1">
    <label class="flex items-center gap-1 cursor-pointer">
      <%= radio_button_tag :sort, "keywords",
                           @sort == "keywords",
                           onclick: "submitSort(this);" %>
      <span class="text-sm">Keyword match</span>
    </label>
  </div>
<% end %>

<script>
    function submitSort(radio) {
        const form = radio.form
        const defaultSort = "<%= @default_sort %>"

        // Only include sort param if different from default
        if (radio.value === defaultSort) {
            const input = form.querySelector('input[name="sort"]')
            if (input) input.disabled = true
        }

        form.submit()
    }
</script>

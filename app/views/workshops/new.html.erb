<div class="min-h-screen py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="admin-only bg-blue-100 p-6">
      <div class="<%= DomainTheme.bg_class_for(:workshops) %>
          border border-gray-200 rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 p-8">
        <div class="flex items-center justify-between mb-3">
          <h1 class="text-3xl font-semibold text-gray-900 tracking-tight">
            New <%= @workshop.class.model_name.human %>
          </h1>
        </div>
        <div class="space-y-6">

      <%= tag.div data: {controller: "asset-upload", action:"turbo:before-stream-render@document->asset-upload#handleStream 
                                                               turbo:frame-load->asset-upload#handleFrameLoad"} do %>
        <div class="mt-4 bg-white rounded p-3"><%= render "form", workshop: @workshop, url: '/workshops', inline_uploads: true %></div>

        <div class="my-4"><%= render "assets/form", owner: @workshop %></div>
      <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

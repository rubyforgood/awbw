<div class="show-associations-section mt-6 print:hidden">
  <%= render "shared/show_mentions_list", mentions: @mentioners, heading: "Mentioned by" %>
  <%= render "shared/show_mentions_list", mentions: @mentionees, heading: "Mentions in this Workshop" %>
  <%# if @workshop_variations.any? %>
  <div id="workshop-variations" class="mb-3 flex-1 space-y-8 rounded-lg bg-white p-6 shadow-md">
    <section id="workshopVariations">
      <div class="variations-header mb-1 flex items-start justify-between">
        <div class="pr-6">
          <h2 class="mb-2 text-lg font-semibold">Variations of this Workshop</h2>
        </div>
        <div class="flex justify-end gap-2">
          <% if allowed_to?(:new?, WorkshopVariation) && @workshop.persisted? %>
            <%= link_to "New variation",
                        new_workshop_variation_path(from: "workshop_show", workshop_id: workshop.id),
                        class: "admin-only bg-blue-100 btn btn-secondary-outline" %>
          <% end %>
          <% if allowed_to?(:new?, WorkshopVariationIdea) %>
            <%= link_to "New variation idea",
                        new_workshop_variation_idea_path(from: "workshop_show", workshop_id: workshop.id),
                        class: "btn btn-secondary-outline" %>
          <% end %>
        </div>
      </div>
      <hr class="mb-4 border-gray-300">
      <div class="variations-list flex flex-wrap gap-2">
        <% @workshop_variations.each do |variation| %>
          <%= link_to variation.name,
                      workshop_variation_path(variation),
                      id: "variation-#{variation.id}",
                      class: "btn btn-secondary-outline" %>
        <% end %>
      </div>
    </section>
  </div>
  <%# end %>
  <% if @quotes.any? %>
    <div id="workshop-quotes" class="mb-3 flex-1 space-y-8 rounded-lg bg-white p-6 shadow-md">
      <section id="workshopQuotes">
        <div class="quotes-header mb-1 flex items-start justify-between">
          <div class="pr-6">
            <h2 class="mb-2 text-lg font-semibold">Quotes</h2>
          </div>
          <% if allowed_to?(:new?, Quote) && @workshop.persisted? %>
            <%= link_to "New quote",
                        new_quote_path(workshop_id: @workshop.id),
                        class: "admin-only bg-blue-100 btn btn-secondary-outline" %>
          <% end %>
        </div>
        <hr class="mb-4 border-gray-300">
        <div class="quotes-list grid grid-cols-1 gap-6 md:grid-cols-2">
          <% @quotes.decorate.each do |quote| %>
            <div class="space-y-1">
              <p class="text-sm text-gray-700 italic"><%= quote.body %></p>
              <p class="text-sm font-bold text-gray-800">- <%= quote.speaker %></p>
            </div>
          <% end %>
        </div>
      </section>
    </div>
  <% end %>
  <% if @leader_spotlights.any? %>
    <div id="workshop-spotlights" class="mb-3 flex-1 rounded-lg bg-white p-6 shadow-md">
      <section id="workshopLeaderSpotlights">
        <div class="spotlights-header mb-1 flex items-start justify-between">
          <div class="pr-6">
            <h2 class="mb-2 text-lg font-semibold">Related facilitator spotlights</h2>
          </div>
          <% if allowed_to?(:new?, Story) && @workshop.persisted? %>
            <%= link_to "New story",
                        new_story_path(workshop_id: @workshop.id,
                                       windows_type_id: @workshop.windows_type_id,
                                       owner_id: @workshop_id,
                                       owner_type: "Workshop"),
                        class: "admin-only bg-blue-100 btn btn-secondary-outline" %>
          <% end %>
        </div>
        <hr class="mb-4 border-gray-300">
        <div class="spotlights-list flex flex-wrap gap-4">
          <% @leader_spotlights.each do |spotlight| %>
            <div class="mb-3 flex max-w-[120px] flex-col items-center space-y-2">
              <%= link_to resource_path(spotlight), class: "flex flex-col items-center text-center" do %>
                <%= render "assets/display_image",
                           resource: spotlight,
                           width: 10, height: 10,
                           variant: :index,
                           link_to_object: true,
                           file: spotlight.decorate.display_image %>
                <p class="mt-1 text-sm leading-tight text-gray-700">
                  <span class="block"><%= spotlight.author_credit %></span>
                  <span class="block text-xs text-gray-500"><%= spotlight.title %></span>
                </p>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>
    </div>
  <% end %>
</div>

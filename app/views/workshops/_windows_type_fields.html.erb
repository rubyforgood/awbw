<div class="relative">
  <div
    data-controller="dropdown"
    class="inline-block w-full"
    data-dropdown-target="content"
  >
    <!-- Trigger button -->
    <button
      id="windows-types-button"
      type="button"
      data-action="dropdown#toggle"
      data-dropdown-payload-param='[{"windows-types-dropdown":"hidden"},{"windows-types-arrow":"rotate-180"},{"windows-types-button":"rounded-md rounded-t-md"}]'
      class="
        relative z-10 w-full bg-white text-gray-800 py-2 px-4 shadow-sm rounded-md
        border border-gray-300 cursor-pointer flex justify-between items-center
      "
    >

      <label class="mb-0 font-medium text-gray-700">
        Windows Type</label>
      <i
        id="windows-types-arrow"
        class="
          fa-solid fa-chevron-down w-4 h-4 transition-transform duration-300
        "
      ></i>
    </button>
    <div
      id="windows-types-dropdown"
      class="
        absolute left-0 top-full w-full shadow-sm bg-white border border-t-0
        border-gray-300 rounded-b-md hidden z-40
      "
    >
      <% windows_types.each do |windows_type| %>
        <div class="form-check flex items-center gap-2 mb-1 px-4">
          <%= check_box_tag "windows_types[#{windows_type.id}]",
          windows_type.id,
          params.dig(:windows_types, windows_type.id.to_s).to_s == windows_type.id.to_s,
          id: "windows_types_#{windows_type.id}",
          class: "form-check-input category-checkbox" %>
          <%= label_tag "windows_type_#{windows_type.id}",
          windows_type.name.titleize,
          class: "form-check-label text-sm text-gray-700" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

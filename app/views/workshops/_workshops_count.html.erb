<div id="workshops_count">
  <hr class="my-6 border-gray-300">
  <div class="filters-applied flex w-full flex-wrap items-center gap-3">
    <h3 class="text-sm font-semibold tracking-wide text-gray-500 uppercase">
      Workshops (<%= number_with_delimiter(@workshops&.total_entries) %>)
    </h3>
    <%= render "shared/copy_url" %>

    <%# Radios inside the search form, so a change auto-submits via the collection controller %>
    <div class="ml-auto">
      <%= render "shared/sort_strip", options: WorkshopSearchService::SORT_OPTIONS, selected: @sort, domain: :workshops %>
    </div>
  </div>
</div>

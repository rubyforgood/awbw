<%# A nav-menu card: a title over one sortable menu list. Locals: title, plus every
    local _menu_list takes. %>
<section class="mb-8 rounded-lg bg-white p-6 shadow">
  <h2 class="mb-4 text-lg font-semibold text-gray-900"><%= title %></h2>
  <%= render "menu_list", **local_assigns.except(:title) %>
</section>

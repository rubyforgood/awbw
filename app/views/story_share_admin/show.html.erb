<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to "← Story Share portal", story_shares_path, class: "text-sm text-purple-700 hover:underline" %>
  </div>

  <h1 class="text-primary mb-2 font-display text-2xl font-bold">Story Share admin</h1>
  <p class="mb-8 text-gray-600">
    Choose which sectors, age ranges, and story populations appear in the Story Share portal's nav
    menus, and drag to reorder them. The top nav shows the first six sectors; the second nav shows the
    age ranges, then the story populations, in this order. Use <span class="font-medium">Add to Story Share home</span>
    to give one its own box of stories on the Story Share home — the boxes appear in this same order.
  </p>

  <section class="mb-8 rounded-lg bg-white p-6 shadow">
    <h2 class="mb-1 text-lg font-semibold text-gray-900">Home background photo</h2>
    <p class="mb-4 text-sm text-gray-600">
      Choose a published, public story with a main image. It leaves the carousel and gets a small credit link on
      the background. With no choice here, the home picks a story outside the carousel.
    </p>
    <% if @hero_story %>
      <div class="mb-4 flex flex-wrap items-center gap-3 text-sm">
        <span>Current: <%= link_to @hero_story.title, story_share_path(@hero_story), class: "font-medium text-purple-700 hover:underline" %></span>
        <%= button_to "Use automatic pick", story_share_admin_hero_story_path, method: :patch,
                      class: "text-gray-600 underline hover:text-gray-900" %>
      </div>
      <% unless @hero_story_showing %>
        <p class="mb-4 text-sm text-amber-700">This story can't be shown right now, so the home is using the automatic pick.</p>
      <% end %>
    <% end %>
    <%= form_with url: story_share_admin_hero_story_path, method: :patch, class: "flex items-center gap-3" do %>
      <div class="min-w-0 flex-1">
        <%= select_tag :story_id, nil, prompt: "Search stories", "aria-label": "Search stories",
                       data: { controller: "remote-select", remote_select_model_value: "story" } %>
      </div>
      <%= submit_tag "Save", class: "rounded bg-purple-700 px-4 py-2 text-sm font-semibold text-white hover:bg-purple-800" %>
    <% end %>
  </section>

  <%= render "menu_section",
             title: "Top nav — sectors",
             type: "sector",
             records: @sectors,
             fixed_leading: [ { label: "Home", dot: "bg-brand-navy-900" } ],
             fixed_trailing: [ { label: "Additional Focus Areas", dot: "bg-brand-orange-600" } ],
             empty: "No sectors are featured yet. Add one below." %>

  <section class="mb-8 rounded-lg bg-white p-6 shadow">
    <h2 class="mb-1 text-lg font-semibold text-gray-900">Second nav — who stories are about</h2>
    <p class="mb-4 text-sm text-gray-600">One nav row: age ranges first, then story populations. Drag to reorder within each group.</p>
    <div class="space-y-6">
      <% @audience_groups.each do |group| %>
        <div>
          <h3 class="mb-2 text-sm font-semibold tracking-wide text-gray-700 uppercase"><%= group[:label] %></h3>
          <%= render "menu_list",
                     type: "category",
                     records: group[:featured],
                     addable: group[:addable],
                     label: group[:label].singularize,
                     empty: "No #{group[:label].downcase} are featured yet. Add one below." %>
        </div>
      <% end %>
    </div>
  </section>
</div>

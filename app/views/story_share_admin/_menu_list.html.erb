<%# Sortable list of featured sectors/categories + an "Add" picker. Fixed nav items
    (Home, Facilitator Spotlights, …) render as non-interactive rows around the list.
    Locals: type ("sector"/"category"), records, empty; optional fixed_leading,
    fixed_trailing (lists of { label, dot }); optional addable (records offered in a
    plain picker, labeled by label) instead of the remote search picker. %>
<% fixed_leading = local_assigns.fetch(:fixed_leading, []) %>
<% fixed_trailing = local_assigns.fetch(:fixed_trailing, []) %>
<% addable = local_assigns[:addable] %>
<% if records.any? || fixed_leading.any? || fixed_trailing.any? %>
  <%# Leading color swatch (a ::before dot) marks each menu slot's color. Sectors are
      colored by position via nth-child so the color stays fixed to the slot as rows are
      dragged (mirrors StorySharesHelper::SLOT_THEMES chips); categories are all grey. %>
  <% swatch_base = "before:content-[''] before:size-4 before:rounded-full before:shrink-0" %>
  <% swatch_classes = if type == "sector"
       "#{swatch_base} nth-[6n+1]:before:bg-red-700 nth-[6n+2]:before:bg-sky-700 nth-[6n+3]:before:bg-green-700 nth-[6n+4]:before:bg-purple-700 nth-[6n+5]:before:bg-indigo-700 nth-[6n]:before:bg-fuchsia-700"
     else
       "#{swatch_base} before:bg-gray-400"
     end %>
  <div class="divide-y divide-gray-200 border border-gray-200 rounded">
    <% fixed_leading.each do |item| %>
      <%= render "fixed_row", item: item %>
    <% end %>
    <% if records.any? %>
      <ul class="divide-y divide-gray-200"
          data-controller="sortable"
          data-sortable-url-value="<%= story_share_admin_reorder_path(type: type, id: ":id") %>">
        <% records.each do |record| %>
          <li class="flex items-center gap-3 px-4 py-3 <%= swatch_classes %>" data-sortable-id="<%= record.id %>">
            <i class="fa-solid fa-grip-vertical cursor-move text-gray-400 hover:text-gray-600" data-sortable-handle=""></i>
            <span class="flex-1 text-gray-800">
              <%= record.name %>
              <% unless record.published? %>
                <span class="ml-2 rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-500">Unpublished — hidden from the nav</span>
              <% end %>
            </span>
            <% on_home = record.story_share_home_section %>
            <details class="relative">
              <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-1 text-sm font-medium [&::-webkit-details-marker]:hidden <%= on_home ? "bg-green-100 text-green-800 hover:bg-green-200" : "bg-gray-100 text-gray-600 hover:bg-gray-200" %>">
                <i class="fa-solid <%= on_home ? "fa-check" : "fa-plus" %>"></i>
                <%= on_home ? "On home" : "Add to home" %>
                <i class="fa-solid fa-chevron-down text-xs"></i>
              </summary>
              <div class="absolute right-0 z-10 mt-1 w-44 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-lg">
                <%= button_to story_share_admin_toggle_home_section_path(type: type, id: record.id),
                              method: :put, params: { on_home: true },
                              class: "flex w-full items-center gap-2 px-3 py-2 text-left text-sm hover:bg-gray-50 #{on_home ? "font-semibold text-green-800" : "text-gray-700"}" do %>
                  <i class="fa-solid fa-check w-4 <%= on_home ? "" : "invisible" %>"></i> On home
                <% end %>
                <%= button_to story_share_admin_toggle_home_section_path(type: type, id: record.id),
                              method: :put, params: { on_home: false },
                              class: "flex w-full items-center gap-2 px-3 py-2 text-left text-sm hover:bg-gray-50 #{on_home ? "text-gray-700" : "font-semibold text-gray-900"}" do %>
                  <i class="fa-solid fa-check w-4 <%= on_home ? "invisible" : "" %>"></i> Not on home
                <% end %>
              </div>
            </details>
            <%= button_to "Remove", story_share_admin_remove_path(type: type, id: record.id),
                          method: :delete,
                          form: { data: { turbo_confirm: "Remove “#{record.name}” from the menu?" } },
                          class: "text-sm text-red-700 hover:underline" %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% fixed_trailing.each do |item| %>
      <%= render "fixed_row", item: item %>
    <% end %>
  </div>
<% end %>
<% if records.empty? %>
  <p class="text-sm text-gray-500 mt-4"><%= empty %></p>
<% end %>

<%= form_with url: story_share_admin_add_path(type: type), method: :post, class: "flex items-center gap-2 mt-4" do %>
  <% if addable %>
    <%= select_tag "id", options_from_collection_for_select(addable, :id, :name),
                   include_blank: "Choose #{label.downcase}…",
                   required: true,
                   class: "w-72 rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
  <% else %>
    <%= select_tag "id", options_for_select([]),
                   include_blank: "Search #{type.pluralize}…",
                   required: true,
                   data: { controller: "remote-select",
                           remote_select_model_value: type,
                           remote_select_exclude_value: records.map(&:id).join(",") },
                   class: "w-72 rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
  <% end %>
  <%= submit_tag "Add", class: button_classes(:primary) %>
<% end %>

<%= simple_form_for(@organization_status) do |f| %>
  <div class="form-body space-y-6">
    <%= f.error_notification %>
    <%= render "shared/errors", resource: @organization_status if @organization_status.errors.any? %>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <%= f.input :name,
                  label: "Status Name",
                  input_html: { class: "form-control" },
                  required: true %>
      <div class="flex items-center pt-6">
        <%= f.input :published,
                    as: :boolean,
                    label: "Published?",
                    input_html: { class: "h-4 w-4" },
                    wrapper_html: { class: "mb-0" } %>
      </div>
    </div>

    <div class="action-buttons mt-8 flex justify-center gap-3">
      <% if allowed_to?(:destroy?, f.object) %>
        <%= link_to "Delete", @organization_status, class: button_classes(:danger_outline),
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete?" } %>
      <% end %>
      <%= link_to "Cancel", organization_statuses_path, class: button_classes(:secondary_outline) %>
      <%= f.button :submit, class: button_classes(:primary) %>
    </div>
  </div>
<% end %>

<div class="rounded-xl bg-white p-6">
  <%= simple_form_for(@quote) do |f| %>
  <div class="space-y-6">
    <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-4">
      <div class="space-y-6 md:col-span-3">
        <!-- Workshop -->
        <div>
          <%= f.input :workshop_id,
                      as: :select,
                      collection: @workshops,
                      label_method: :title,
                      value_method: :id,
                      include_blank: "Select workshop",
                      label: "Workshop",
                      input_html: { class: "w-full" },
                      wrapper_html: { class: "w-full" }
          %>
        </div>

        <!-- Published quote (shown in the quotes index and to users) -->
        <div>
          <%= f.input :body,
                      as: :text,
                      label: "Published quote",
                      hint: "The wording shown in the quotes index and to users.",
                      input_html: { rows: 5, class: "w-full" },
                      wrapper_html: { class: "w-full" }
          %>
        </div>

        <!-- Original submission (as received; preserved automatically) -->
        <div>
          <%= f.input :original_body,
                      as: :text,
                      label: "Original submission",
                      hint: "What we received. Captured automatically the first time; edit the published quote above to change what's shown.",
                      input_html: { rows: 5, class: "w-full" },
                      wrapper_html: { class: "w-full" }
          %>
        </div>

        <!-- Author -->
        <div>
          <%= f.input :author_id,
                      as: :select,
                      collection: author_picker_person(f.object).present? ? [[ author_picker_person(f.object).remote_search_label[:label], author_picker_person(f.object).id ]] : [],
                      selected: author_picker_person(f.object)&.id,
                      include_blank: "Select an author",
                      label: (f.object.author ? (
                        link_to "Author", person_path(f.object.author),
                                class: "hover:underline") : "Author").html_safe,
                      hint: "Link the person who said this, if they're on file. Otherwise use the speaker name below.",
                      input_html: { class: "w-full rounded border-gray-300",
                                    data: { controller: "remote-select",
                                            remote_select_model_value: "person" } }
          %>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <div>
            <%= f.input :speaker_name,
                        label: "Speaker name",
                        hint: "Free-text fallback when the speaker isn't a person on file.",
                        input_html: { value: f.object.speaker_name, class: "w-full" },
                        wrapper_html: { class: "w-full" }
            %>
          </div>

          <div>
            <!-- Check if quote was created with a string for an age-->
            <% if f.object.age.present? && f.object.age.to_s.match?(/\D/) %>
              <%= f.input :age,
                          as: :string,
                          label: "Age",
                          input_html: { class: "w-full" } %>
            <% else %>
              <%= f.input :age,
                          as: :integer,
                          label: "Age",
                          input_html: { min: 0, class: "w-full" } %>
            <% end %>
          </div>

          <div>
            <%= f.input :gender,
                        as: :string,
                        input_html: { class: "w-full" }
            %>
          </div>
        </div>
      </div>

      <div class="mt-6 space-y-4 md:mt-0">
        <div class="admin-only rounded bg-blue-100 p-3">
          <%= render "shared/visibility_info", flags: %i[published] %>
          <div class="grid grid-cols-1 items-center">
            <%= visibility_flag_input f, :published %>
          </div>
        </div>

        <div class="admin-only rounded bg-blue-100 p-3">
          <%= render "shared/visibility_info", flags: %i[standout], heading: "Quality" %>
          <div class="grid grid-cols-1 items-center">
            <%= visibility_flag_input f, :standout %>
          </div>
        </div>
      </div>
    </div>

    <div class="action-buttons mt-8 flex justify-center gap-3">
      <% if allowed_to?(:destroy?, f.object) %>
        <%= link_to "Delete", @quote, class: "btn btn-danger-outline",
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete?" } %>
      <% end %>
      <%= link_to "Cancel",
                  (allowed_to?(:index?, Quote) ? quotes_path : root_path),
                  class: "btn btn-secondary-outline ms-2" %>
      <%= f.button :submit, class: "btn btn-primary" %>
    </div>
  </div>

<% end %>
</div>

<!-- Filters -->
<div class="mb-6 rounded-lg border border-gray-200 bg-white p-4">
  <%= form_with url: quotes_path,
                method: :get,
                data: {controller: "collection"},
                      autocomplete: "off",
                class: "flex flex-wrap gap-4" do |f| %>
    <div class="min-w-[200px] flex-grow">
      <%= f.label :query, "Keywords",
                  class: search_label_class %>

      <%= f.text_field :query,
                       value: params[:query],
                       placeholder: "Search quotes…",
                       class: search_field_class(extra: "bg-white"),
                       oninput: "this.form.requestSubmit()" %>
    </div>

    <% if allowed_to?(:manage?, Quote) %>
      <!-- PUBLISHED -->
      <div class="admin-only min-w-[150px] rounded-md bg-blue-100 p-2">
        <label for="published" class="<%= search_label_class %>">
          Published
        </label>

        <%= select_tag :published,
                       options_for_select(
                         [["All", ""], ["Published", "true"], ["Unpublished", "false"]],
                         params[:published]
                       ),
                       class: search_field_class(extra: "search-select-placeholder"),
                       onchange: "this.form.requestSubmit()" %>
      </div>

      <!-- STANDOUT -->
      <div class="admin-only min-w-[150px] rounded-md bg-blue-100 p-2">
        <label for="standout" class="<%= search_label_class %>">
          Standout
        </label>

        <%= select_tag :standout,
                       options_for_select(
                         [["All", ""], ["Standout", "true"], ["Not standout", "false"]],
                         params[:standout]
                       ),
                       class: search_field_class(extra: "search-select-placeholder"),
                       onchange: "this.form.requestSubmit()" %>
      </div>
    <% end %>

    <!-- Clear -->
    <div><%= render "shared/search_clear", url: quotes_path %></div>
  <% end %>
</div>

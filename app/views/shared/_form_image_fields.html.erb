<% section_title ||= "Upload Images / Media Releases" %>

<div class="image-fields">
  <hr class="my-6 border-gray-200">
  <h2 class="text-lg font-semibold text-gray-800 mb-2"><%= section_title %></h2>

  <p class="text-sm text-gray-600 mb-3">
    ***If any image includes the client or client artwork, download
    the <a href="https://bit.ly/AWBWartmedia" target="_blank" class="text-blue-600 hover:underline">
    Art/Media Release</a> form.***
  </p>

  <div class="images bg-gray-50 border border-gray-200 rounded-md p-4 pb-0">
    <% if section_subtitle %>
    <div class="mb-6">
      Attach photos, PDFs, or signed media release forms
    </div>
    <% end %>
    <!-- Image fields -->
    <div class="flex flex-wrap justify-start gap-6">
      <% counter = 1 %>
      <%= f.fields_for :gallery_images do |img| %>
        <div class="flex flex-col text-left items-left gap-1 w-full md:w-1/3 lg:w-1/4 mb-6">
          <%= render "shared/form_image_field",
                     f: img,
                     resource: img.object,
                     label: "Image #{counter}" %>
        </div>
        <% counter += 1 %>
      <% end %>
    </div>

    <!-- Add file button aligned bottom right -->
    <div class="mt-4 flex text-right text-end justify-end justify-right">
      <%= link_to_add_association "Add another file",
                                  f,
                                  :gallery_images,
                                  partial: "shared/form_image_field",
                                  render_options: {
                                    locals: {
                                      field_name: :file,
                                      resource: f.object.gallery_images.build,
                                      label: "Upload file",
                                      hint: "Attach photos, PDFs, or signed media release forms"
                                    }
                                  },
                                  class: "text-blue-600 hover:text-blue-800 font-medium text-sm
flex flex-col gap-1 w-full md:w-1/2 lg:w-1/3 mb-6" %>
    </div>
  </div>
</div>
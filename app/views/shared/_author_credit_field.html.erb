<%# Admin-facing credit preference. Interim, like the submitter forms: the value is
    recorded but the credited person's profile decides what renders — so this sits
    alongside the note and divergence warning, which link out to resolve it.
    Locals: f. Optional: attribute (default :author_credit_preference), label, hint. %>
<% attribute = local_assigns.fetch(:attribute, :author_credit_preference) %>
<% label = local_assigns.fetch(:label, "Credit preference") %>
<% hint = local_assigns.fetch(:hint, "The primary author's profile decides what renders (adjust it on the divergences page).") %>
<%= f.input attribute,
            as: :select,
            collection: AuthorCreditable::ADMIN_FORM_OPTIONS.to_a,
            include_blank: "None (follow profile)",
            label: label,
            hint: hint %>

<%# Closes a comment or communication row, marking it as one the person never
    sees. Comments are internal by definition; a communication is internal unless
    the portal sent it (Notification#portal_sent?). %>
<span class="mt-0.5 shrink-0 leading-none" title="Admin-facing only — not shown to the person">
  <i class="fa-solid fa-lock text-xs text-gray-400"></i>
</span>

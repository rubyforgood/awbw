<div id="copy_url" class="flex flex-1 gap-2">
  <button type="button" data-action="share-url#copy" class="<%= button_classes(:secondary_outline) %>">
    Share this search
  </button>

  <input
    data-share-url-target="output"
    readonly
    class="hidden w-full max-w-md cursor-text overflow-x-auto rounded border border-gray-300 bg-gray-100 px-3 font-mono text-sm whitespace-nowrap"
  >
</div>

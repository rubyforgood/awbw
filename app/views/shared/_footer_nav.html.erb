<!-- Floating Help Button -->
<div id="fab-container"
     class="fixed right-6 bottom-6 z-50 flex flex-col items-end print:hidden">

  <!-- Hidden menu items -->
  <div id="fab-menu"
     class="mb-2 flex hidden flex-col items-start space-y-2 rounded-lg border border-gray-300 bg-white p-4 shadow-md transition-all duration-300">
 
  <%= link_to faqs_path, class: "flex items-center space-x-2 text-gray-800 px-3 py-2 rounded hover:bg-gray-100 w-max" do %>
    <i class="fas fa-question-circle"></i> 
    <span>FAQs</span>
  <% end %>


  <%= link_to contact_us_path, class: "flex items-center space-x-2 text-gray-800 px-3 py-2 rounded hover:bg-gray-100 w-max" do %>
    <i class="fas fa-envelope"></i>
    <span>Contact us</span>
  <% end %>

  <%= link_to video_recordings_path(video_type: "instructional"), class: "flex items-center space-x-2 text-gray-800 px-3 py-2 rounded hover:bg-gray-100 w-max" do %>
    <i class="fas fa-circle-play"></i>
    <span>Instructional videos</span>
  <% end %>

  <%= link_to "https://www.awbw.org", target: "_blank", class: "flex items-center space-x-2 text-gray-800 px-3 py-2 rounded hover:bg-gray-100 w-max" do %>
    <i class="fas fa-globe"></i>
    <span>Public website</span>
  <% end %>
</div>



  <!-- Main round button -->
  <button id="fab-button"
          type="button"
          class="bg-primary hover:bg-primary/90 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold text-white shadow-lg transition">
    ?
  </button>
</div>

<script>
    document.addEventListener("turbo:load", () => {
        const fabButton = document.getElementById("fab-button");
        const fabMenu = document.getElementById("fab-menu");

        if (!fabButton || !fabMenu) return;

        // Remove any previous event listener to prevent duplicates
        fabButton.onclick = () => {
            fabMenu.classList.toggle("hidden");
            fabButton.classList.toggle("rotate-45");
        };
    });
</script>

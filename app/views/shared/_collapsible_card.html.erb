<%# A collapsible card with a tinted title bar — icon, title, and optional chips on
    the left, chevron on the right. Rendered with `render layout:`; the block is
    the body, shown when expanded. Shared by the callout form cards and the
    agreement history so they read as one kind of card.
    locals: title; bar_class (the bar's tint — bg + text); icon (optional);
            border_class (frame + divider colour, default gray); badges (optional
            HTML after the title); open (default false); id (optional).
    A named group so `group` styles inside the body stay independent. %>
<% border_class = local_assigns.fetch(:border_class, "border-gray-200") %>
<details <%= tag.attributes(id: local_assigns[:id]) %> class="group/collapsible-card scroll-mt-24 overflow-hidden rounded-xl border <%= border_class %> bg-white shadow-sm" <%= "open" if local_assigns.fetch(:open, false) %>>
  <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-2.5 select-none <%= bar_class %> <%= border_class %> group-open/collapsible-card:border-b [&::-webkit-details-marker]:hidden">
    <% if local_assigns[:icon] %>
      <i class="<%= icon %> text-sm" aria-hidden="true"></i>
    <% end %>
    <h2 class="text-sm font-semibold"><%= title %></h2>
    <%= local_assigns[:badges] %>
    <i class="fa-solid fa-chevron-down ml-auto text-xs transition-transform group-open/collapsible-card:rotate-180" aria-hidden="true"></i>
  </summary>
  <%= yield %>
</details>

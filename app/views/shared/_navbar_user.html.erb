<div class="navbar-user-button relative" id="avatar" data-controller="dropdown">
  <% user = current_user %>
  <% person = user&.person %>
  <% avatar_image = person&.avatar&.attached? ? url_for(person.avatar) : "missing.png" %>

  <button
    type="button"
    class="relative flex rounded-full focus-visible:outline-2
           focus-visible:outline-offset-2 focus-visible:outline-indigo-500 cursor-pointer"
    data-action="dropdown#toggle"
    data-dropdown-payload-param='[{"avatar-dropdown":"hidden"}]'>
    <span class="sr-only">Open user menu</span>
    <span class="absolute -inset-1.5"></span>

    <%= image_tag avatar_image,
                  id: "avatar-image",
                  class: "size-10 rounded-full bg-gray-800 outline -outline-offset-1 outline-white/10" %>
  </button>

  <!-- Dropdown menu -->
  <div
    class="absolute right-0 mt-2 w-56 rounded-md bg-white py-1 shadow-lg outline outline-black/5 hidden"
    id="avatar-dropdown"
    data-dropdown-target="content">

    <% if allowed_to?(:index?, with: Admin::HomePolicy) %>
      <%= link_to admin_path,
                  class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 space-x-2" do %>
        <i class="fas fa-cog"></i>
        <span>Admin</span>
      <% end %>
    <% end %>

    <% if person && allowed_to?(:show?, person) %>
      <%= link_to person_path(person),
                  class: "admin-only bg-blue-100 flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 space-x-2" do %>
        <i class="fas fa-user"></i>
        <span>My profile</span>
      <% end %>
    <% end %>

    <% active_affiliations = @current_user_active_affiliations || [] %>
    <% if active_affiliations.any? %>
      <% active_affiliations.each do |affiliation| %>
        <% if allowed_to?(:show?, affiliation.organization) %>
          <%= link_to organization_path(affiliation.organization),
                      class: "admin-only bg-blue-100 flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 space-x-2" do %>
            <i class="fas fa-users"></i>
            <span>
              My team
              <% if active_affiliations.many? %>
                (<%= affiliation.organization.name.truncate(12) %>)
              <% end %>
            </span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if allowed_to?(:personal?, Bookmark) %>
      <%= link_to personal_bookmarks_path,
                  class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 space-x-2" do %>
        <i class="fas fa-bookmark"></i>
        <span>My bookmarks</span>
      <% end %>
    <% end %>

    <% if allowed_to?(:index?, WorkshopLog) %>
      <%= link_to workshop_logs_path(user_id: user.id),
                  class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 space-x-2" do %>
        <i class="fas fa-clipboard-list"></i>
        <span>My workshop logs</span>
      <% end %>
    <% end %>

    <%= link_to change_password_path,
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 space-x-2" do %>
      <i class="fas fa-key"></i>
      <span>Change password</span>
    <% end %>

    <%= link_to destroy_user_session_path,
                data: { turbo_method: :delete },
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 space-x-2" do %>
      <i class="fas fa-sign-out-alt"></i>
      <span>Logout</span>
    <% end %>

  </div>
</div>

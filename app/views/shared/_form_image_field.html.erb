<%# ------------------------------------------
    Shared image field partial
    Supports:
    - Pattern B wrapper model (Media + file)
    - Parent has_one_attached
    - Parent has_many_attached
    - Media gallery display
    ------------------------------------------ %>

<% f ||= nil %>
<% raise "form_image_field requires f:" if f.nil? %>

<% asset ||= f.object %>
<% field_name ||= :file %>
<% label ||= field_name.to_s.titleize %>
<% hint ||= nil %>
<% rounded ||= false %>
<% multiple ||= false %>
<% file ||= nil %>
<% use_profile_placeholder ||= false %>
<% compact ||= false %>
<% preview_size = compact ? "h-16 w-16" : "h-32 w-32" %>
<% preview_span = compact ? "row-span-2" : nil %>
<% show_file_field = show_file_field.to_s.present? ? show_file_field : true %>
<% show_existing   = show_existing.to_s.present? ? show_existing : true %>
<% accept_attr = asset.class.respond_to?(:accept_attribute) ? asset.class.accept_attribute : nil %>
<% accepted_label = asset.class.respond_to?(:accepted_types_label) ? asset.class.accepted_types_label : nil %>
<% file =
    if file.present?
      file
    elsif asset.respond_to?(field_name)
      asset.public_send(field_name)
    end
%>
<% blob        = file&.attached? ? file.blob : nil %>
<% is_image    = blob&.image? %>
<% is_pdf      = blob&.content_type == "application/pdf" %>
<% image_dom_id = "#{dom_id(asset)}_#{field_name}_image" %>

<div data-controller="file-preview" class="<%= compact ? "text-left" : "text-center" %>">

  <%= f.label label, class: "block font-medium gap-1 text-gray-700 string required" %>

  <% if hint %>
    <p class="text-sm text-gray-500"><%= hint.html_safe %></p>
  <% end %>

  <div class="<%= compact ? "grid grid-cols-[auto_auto] items-center justify-start gap-x-3 gap-y-1" : "flex flex-col items-center gap-2" %>">

    <% if show_existing %>

      <%# ---------- IMAGE ---------- %>
      <% if is_image && file.present? && file.try(:persisted?) %>
        <%= link_to url_for(file), target: "_blank", rel: "noopener noreferrer",
                    title: "Open image in a new tab", class: class_names("block cursor-zoom-in", preview_span) do %>
          <%= image_tag file,
                        id: image_dom_id,
                        alt: "#{label}",
                        data: { file_preview_target: "preview" },
                        class: class_names(preview_size, "object-cover border border-gray-300 shadow-sm hover:opacity-90 transition-opacity", "rounded-full": rounded) %>
        <% end %>

        <%# ---------- PDF PREVIEW ---------- %>
      <% elsif is_pdf && file.previewable? %>
        <%= link_to url_for(file), target: "_blank", rel: "noopener noreferrer",
                    title: "Open PDF in a new tab", class: class_names("block cursor-zoom-in", preview_span) do %>
          <%= image_tag file.preview(resize_to_limit: [300, 300]),
                        id: image_dom_id,
                        alt: "#{label} PDF preview",
                        data: { file_preview_target: "preview" },
                        class: class_names(preview_size, "object-contain border border-gray-300 shadow-sm hover:opacity-90 transition-opacity") %>
        <% end %>

        <%# ---------- PLACEHOLDER ---------- %>
      <% else %>
        <div class="<%= class_names("relative", preview_size, preview_span) %>">
          <img id="<%= image_dom_id %>"
               data-file-preview-target="preview"
               class="<%= class_names("hidden border border-gray-300 object-cover shadow-sm", preview_size) %>">

          <div data-file-preview-target="placeholder"
               class="<%= class_names("absolute inset-0 flex items-center justify-center border border-gray-300 bg-gray-50 text-gray-400 shadow-sm", compact ? "text-2xl" : "text-6xl") %>">
            <i class="fa-regular fa-image"></i>
          </div>
        </div>
      <% end %>

      <div data-file-preview-target="filename"
           class="<%= class_names("text-sm break-all text-gray-500", compact ? "w-0 min-w-full text-left" : "max-w-[8rem] text-center") %>">
        <%= if blob.present? && blob.respond_to?(:persisted?) && blob.persisted?
              link_to(blob.filename.to_s, url_for(file), class: "underline cursor-zoom-in", target: "_blank", rel: "noopener noreferrer", title: "Open image in a new tab")
            else
              "No file selected"
            end
        %>
      </div>

    <% end %>

    <% if show_file_field %>
      <div class="flex items-center gap-3">

        <div class="relative w-28">
          <%= f.file_field field_name,
                           accept: accept_attr,
                           data: {
                             file_preview_target: "input",
                             action: "change->file-preview#update"
                           },
                           multiple: multiple,
                           direct_upload: true,
                           class: "absolute inset-0 w-full h-full opacity-0 cursor-pointer" %>

          <button type="button"
                  class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700 hover:bg-gray-50">
            Choose file
          </button>
        </div>

        <% if asset.persisted? && file&.attached? %>
          <div class="flex items-center gap-1">
            <%= f.check_box :_destroy,
                            class: "h-4 w-4 appearance-none checked:bg-red-600
                                    bg-gray-100 text-white border border-gray-300 rounded cursor-pointer
                                    checked:border-red-600 checked:text-white" %>

            <%= f.label :_destroy, "Remove", class: "text-sm cursor-pointer" %>
          </div>
        <% end %>

      </div>

      <% if accepted_label.present? %>
        <p class="<%= class_names("mt-1 text-xs text-gray-400", "col-start-2": compact) %>">Accepts: <%= accepted_label %></p>
      <% end %>
    <% end %>

  </div>
</div>

<% if asset.errors[:file].any? %>
  <div class="mx-auto mt-2 w-fit rounded-md border border-red-200 bg-red-50 px-3 py-2 text-center">
    <p class="text-sm text-red-600">
      <i class="fa-solid fa-circle-exclamation mr-1"></i>
      File type not accepted
    </p>
  </div>
<% end %>

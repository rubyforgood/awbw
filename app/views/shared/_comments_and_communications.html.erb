<%# Combined comments + communications section (locals: f:, and optional
    mark_admin_only:, comments_all_path:, communications_all_email:). %>
<% record = f.object %>
<% can_manage_comments = allowed_to?(:manage?, Comment) %>
<% admin = allowed_to?(:index?, with: NotificationPolicy) %>
<% mark_admin_only = local_assigns.fetch(:mark_admin_only, false) %>
<% comments_all_path = local_assigns[:comments_all_path] %>
<% communications_all_email = local_assigns[:communications_all_email] %>
<%# `record` may be a Draper decorator — read the type via model_name, not class.name. %>
<% record_type = record.model_name.name %>
<% list_id = "#{record.model_name.param_key}-activity-list" %>

<% notifications = record.communications_scope.order(created_at: :desc).to_a %>
<% new_notifications = admin ? record.notifications.select(&:new_record?) : [] %>
<% editable_notifications = admin ? notifications.select { |n| n.channel != "autoemail" && n.noticeable_type == record_type && n.noticeable_id == record.id } : [] %>
<%# Render the in-memory notification (by id) so an admin's unsaved edits survive a re-render. %>
<% own_notifications_by_id = admin ? record.notifications.index_by(&:id) : {} %>

<% comments = can_manage_comments ? record.comments.reject(&:new_record?) : [] %>
<% new_comments = can_manage_comments ? record.comments.select(&:new_record?) : [] %>

<% entries = (comments + notifications).sort_by { |r| r.created_at || Time.current }.reverse %>

<section class="scroll-mt-24 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm"
         id="comments-section"
         data-controller="paginated-fields edit-toggle"
         data-paginated-fields-per-page-value="10">
  <div class="flex items-center gap-3 border-b border-gray-100 px-4 py-3">
    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg <%= DomainTheme.bg_class_for(:notifications, intensity: 100) %> <%= DomainTheme.text_class_for(:notifications, intensity: 600) %>">
      <i class="fa-solid fa-comments"></i>
    </span>
    <h2 class="text-sm font-semibold text-gray-700"><%= can_manage_comments ? t("communications.section_title") : t("communications.title") %></h2>
    <div class="ml-auto flex items-center gap-3">
      <% if comments_all_path.present? && can_manage_comments %>
        <%= link_to comments_all_path, target: "_blank", rel: "noopener",
                    class: "inline-flex items-center gap-1.5 text-xs font-medium #{eyebrow_link_class} hover:underline" do %>
          All comments
          <i class="fa-solid fa-arrow-up-right-from-square text-2xs"></i>
        <% end %>
      <% end %>
      <% if communications_all_email.present? && admin %>
        <% view_all_marker = mark_admin_only ? "admin-only bg-blue-100 rounded px-1.5 py-0.5" : "" %>
        <%= link_to notifications_path(email: communications_all_email, return_to_type: record_type, return_to_id: record.id),
                    class: "inline-flex items-center gap-1.5 text-xs font-medium #{eyebrow_link_class} hover:underline #{view_all_marker}",
                    target: "_blank", rel: "noopener" do %>
          All communications
          <i class="fa-solid fa-arrow-up-right-from-square text-2xs"></i>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="space-y-3 p-4">
    <div id="<%= list_id %>" class="space-y-2">
      <% entries.each do |entry| %>
        <% if entry.is_a?(Comment) %>
          <%= f.simple_fields_for :comments, entry do |cf| %>
            <%= render "comments/comment_fields", f: cf %>
          <% end %>
        <% elsif editable_notifications.include?(entry) %>
          <%= f.simple_fields_for :notifications, own_notifications_by_id.fetch(entry.id, entry) do |nf| %>
            <%= render "notifications/notification_fields", f: nf, record: record, mark_admin_only: mark_admin_only %>
          <% end %>
        <% else %>
          <div data-paginated-fields-target="item">
            <%= render "notifications/communication_line", notification: entry, admin: admin, mark_admin_only: mark_admin_only %>
          </div>
        <% end %>
      <% end %>

      <% if can_manage_comments %>
        <%= f.simple_fields_for :comments, new_comments do |cf| %>
          <%= render "comments/comment_fields", f: cf %>
        <% end %>
      <% end %>
      <% if admin %>
        <%= f.simple_fields_for :notifications, new_notifications do |nf| %>
          <%= render "notifications/notification_fields", f: nf, record: record, mark_admin_only: mark_admin_only %>
        <% end %>
      <% end %>
    </div>

    <div data-paginated-fields-target="nav"></div>

    <% if entries.empty? && new_comments.empty? && new_notifications.empty? %>
      <p class="text-sm text-gray-400"><%= can_manage_comments ? t("communications.section_none") : t("communications.section_none_comms_only") %></p>
    <% end %>

    <% if can_manage_comments || admin %>
      <% button_base = "inline-flex items-center gap-1.5 rounded-md border border-gray-300 px-2.5 py-1 text-xs font-medium text-gray-600 transition-colors hover:bg-gray-50 cursor-pointer" %>
      <div class="mt-3 flex items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <% if can_manage_comments %>
            <%= link_to_add_association f, :comments,
                  partial: "comments/comment_fields",
                  data: { association_insertion_node: "##{list_id}", association_insertion_method: "append" },
                  class: button_base do %>
              <i class="fa-solid fa-plus text-2xs"></i>
              <%= t("communications.add_comment") %>
            <% end %>
          <% end %>
          <% if admin %>
            <% comm_button_class = mark_admin_only ? "#{button_base} admin-only bg-blue-100" : button_base %>
            <%= link_to_add_association f, :notifications,
                  partial: "notifications/notification_fields",
                  render_options: { locals: { record: record, mark_admin_only: mark_admin_only } },
                  data: { association_insertion_node: "##{list_id}", association_insertion_method: "append" },
                  class: comm_button_class do %>
              <i class="fa-solid fa-plus text-2xs"></i>
              <%= t("communications.add") %>
            <% end %>
          <% end %>
        </div>

        <% if (can_manage_comments && comments.any?) || editable_notifications.any? %>
          <button type="button"
                  class="cursor-pointer text-sm whitespace-nowrap text-gray-400 underline hover:text-gray-600"
                  data-action="edit-toggle#toggle">
            <span data-edit-toggle-target="editLabel"><%= t("communications.section_edit") %></span>
            <span data-edit-toggle-target="viewLabel" class="hidden"><%= t("communications.done_editing") %></span>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

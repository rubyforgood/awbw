<% if mentions.any? %>
  <div class="mb-3 flex-1 rounded-lg bg-white p-4 shadow-md">
    <section>
      <div class="mb-1 flex items-start justify-between">
        <div class="pr-6">
          <h2 class="mb-2 text-lg font-semibold"><%= heading %></h2>
        </div>
      </div>
      <hr class="mb-4 border-gray-300">
      <div class="space-y-4">
        <% mentions.each do |mentionable_type, mentionable_records| %>
          <div>
            <h3 class="mb-2 text-sm font-medium text-gray-600">
              <%= mentionable_type.pluralize %>
            </h3>
            <div class="flex flex-wrap gap-2">
              <% mentionable_records.each do |record| %>
                <%= link_to polymorphic_path(record),
                            class: button_classes(:secondary_outline) do %>
                  <%= record.title&.to_s %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  </div>
<% end %>

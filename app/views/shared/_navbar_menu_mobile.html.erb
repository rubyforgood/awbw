<div id="mobile-menu" class="hidden md:hidden">

  <div class="space-y-1 px-2 pt-2 pb-3">
    <!-- CURRICULUM -->
    <div data-controller="dropdown">
      <button
        class="mobile-section flex justify-between w-full"
        data-action="dropdown#toggle"
        data-dropdown-payload-param='[{"mobile-curriculum":"hidden"}]'>
        Curriculum
        <i class="fas fa-chevron-down" data-dropdown-target="arrow"></i>
      </button>

      <div id="mobile-curriculum"
           class="hidden flex flex-col pl-4 mt-1 mb-3 space-y-2"
           data-dropdown-target="content">
        <%= link_to workshops_path, class: "flex items-center px-4 py-2 text-sm text-white
                    hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
          <i class="fas fa-palette"></i>
          <span>Workshops</span>
        <% end %>
        <%= link_to resources_path, class: "flex items-center px-4 py-2 text-sm text-white
                    hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
          <i class="fas fa-file"></i>
          <span>Resources</span>
        <% end %>
        <%= link_to tags_path, class: "flex items-center px-4 py-2 text-sm text-white
                    hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
          <i class="fas fa-tag"></i>
          <span>Tags</span>
        <% end %>
      </div>
    </div>

    <!-- Community -->
    <div data-controller="dropdown">
      <button
        class="mobile-section flex justify-between w-full"
        data-action="dropdown#toggle"
        data-dropdown-payload-param='[{"mobile-community":"hidden"}]'
      >
        Community
        <i class="fas fa-chevron-down" data-dropdown-target="arrow"></i>
      </button>

      <div id="mobile-community"
           class="hidden flex flex-col pl-4 mt-1 mb-3 space-y-2"
           data-dropdown-target="content">
        <%= link_to community_news_index_path, class: "flex items-center px-4 py-2 text-sm text-white
                    hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
          <i class="fas fa-newspaper"></i>
          <span>News</span>
        <% end %>
        <%= link_to stories_path, class: "flex items-center px-4 py-2 text-sm text-white
                    hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
          <i class="fas fa-file-alt"></i>
          <span>Stories</span>
        <% end %>
        <%= link_to events_path, class: "flex items-center px-4 py-2 text-sm text-white
                    hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
          <i class="fas fa-calendar"></i>
          <span>Events</span>
        <% end %>

        <% if allowed_to?(:index?, Person) %>
          <%= link_to people_path, class: "admin-only bg-blue-100 flex items-center px-4 py-2 text-sm text-white
                      hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
            <i class="fas fa-user-friends"></i>
            <span>People</span>
          <% end %>
        <% end %>
        <% if allowed_to?(:index?, Organization) %>
          <%= link_to organizations_path, class: "admin-only bg-blue-100 flex items-center px-4 py-2 text-sm text-white
                      hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
            <i class="fas fa-building"></i>
            <span>Organizations</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Help -->
    <div data-controller="dropdown">
      <button
        class="mobile-section flex justify-between w-full"
        data-action="dropdown#toggle"
        data-dropdown-payload-param='[{"mobile-help":"hidden"}]'>
        Help
        <i class="fas fa-chevron-down" data-dropdown-target="arrow"></i>
      </button>

      <div id="mobile-help"
           class="hidden flex flex-col pl-4 mt-1 mb-3 space-y-2"
           data-dropdown-target="content">
        <%= link_to faqs_path, class: "flex items-center px-4 py-2 text-sm text-white
                    hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
          <i class="fas fa-question-circle"></i>
          <span>FAQs</span>
        <% end %>


        <%= link_to contact_us_path, class: "flex items-center px-4 py-2 text-sm text-white
                    hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
          <i class="fas fa-envelope"></i>
          <span>Contact us</span>
        <% end %>

        <%= link_to tutorials_path, class: "flex items-center px-4 py-2 text-sm text-white
                    hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
          <i class="fas fa-circle-play"></i>
          <span><%= Tutorial.model_name.human(count: 2) %></span>
        <% end %>

        <%= link_to "https://www.awbw.org", target: "_blank", class: "flex items-center px-4 py-2 text-sm text-white
                    hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
          <i class="fas fa-globe"></i>
          <span>Public website</span>
        <% end %>
      </div>
    </div>

    <!-- New -->
    <% if user_signed_in? %>
    <div data-controller="dropdown">
      <button
        class="mobile-section flex justify-between w-full"
        data-action="dropdown#toggle"
        data-dropdown-payload-param='[{"mobile-new":"hidden"}]'>
        New
        <i class="fas fa-chevron-down" data-dropdown-target="arrow"></i>
      </button>

      <div id="mobile-new"
           class="hidden flex flex-col pl-4 mt-1 mb-3 space-y-2"
           data-dropdown-target="content">
        <%= link_to new_workshop_variation_idea_path,
                    class: "flex items-center px-4 py-2 text-sm text-white
                    hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3"></path></svg>
          <span class="whitespace-nowrap">New workshop variation idea</span>
        <% end %>

        <% if allowed_to?(:new?, WorkshopIdea) %>
          <div class="admin-only bg-blue-100">
            <%= link_to new_workshop_idea_path,
                        class: "flex items-center px-4 py-2 text-sm text-white
                      hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
              <i class="fas fa-lightbulb"></i>
              <span>New workshop idea</span>
            <% end %>
          </div>
        <% end %>

        <%= link_to new_workshop_log_path,
                    class: "flex items-center px-4 py-2 text-sm text-white
                    hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
          <span>New workshop log</span>
        <% end %>

        <%= link_to new_story_idea_path,
                    class: "flex items-center px-4 py-2 text-sm text-white
                    hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
          <span>New story idea</span>
        <% end %>

        <% if allowed_to?(:new?, Story) %>
          <div class="admin-only bg-blue-100">
            <%= link_to new_story_path,
                        class: "flex items-center px-4 py-2 text-sm text-white
                      hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
              <i class="fas fa-book"></i>
              <span>New story</span>
            <% end %>
          </div>
        <% end %>

        <% if allowed_to?(:new?, WorkshopVariation) %>
          <div class="admin-only bg-blue-100">
            <%= link_to new_workshop_variation_path,
                        class: "flex items-center px-4 py-2 text-sm text-white
                      hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
              <i class="fas fa-swatchbook"></i>
              <span>New workshop variation</span>
            <% end %>
          </div>
        <% end %>

        <% if allowed_to?(:new?, Workshop) %>
          <div class="admin-only bg-blue-100">
            <%= link_to new_workshop_path,
                        class: "flex items-center px-4 py-2 text-sm text-white
                      hover:text-gray-700 hover:bg-gray-100 w-full space-x-2" do %>
              <i class="fas fa-chalkboard-teacher"></i>
              <span>New workshop</span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <% end %>

  </div>
</div>

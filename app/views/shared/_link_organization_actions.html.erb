<%# Shared "Add an organization" block for the org-linking editors (event
    registration and form submission): a create-and-link row per submitted name
    not in the database, suggested matches for the submitted name, and a
    remote-search select for linking any existing org. Locals:
      select_url         – POST target linking an existing org (organization_id param)
      create_url         – POST target creating from a submitted name (organization_name param)
      creatable_org_names – submitted names not in the database yet
      potential_matches  – orgs suggested for the submitted name
      submitter_noun     – how to refer to the form-filler ("registrant"/"person")
      return_to          – carried through both actions %>
<% submitter_noun = local_assigns.fetch(:submitter_noun, "registrant") %>
<%# Each org the submitter typed that we don't have gets the solid (primary)
    create+link style; "Link organization" is then demoted to the outline style. %>
<% create_is_primary = creatable_org_names.any? %>
<div class="border-t border-gray-200 pt-4">
  <h3 class="text-sm font-semibold text-gray-700 mb-3">Add an organization</h3>

  <% if creatable_org_names.any? %>
    <p class="text-sm text-gray-600 mb-2">
      <%= creatable_org_names.size > 1 ? "These organizations the #{submitter_noun} entered aren't in the database yet. Create each in the database and link it in one step:" : "The #{submitter_noun} entered this organization on their form, but it's not in the database yet. Create the organization in the database and link it in one step:" %>
    </p>
    <% creatable_org_names.each do |creatable_name| %>
      <div class="flex items-stretch gap-2 mb-2">
        <div class="flex-1 min-w-0 flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800">
          <span class="truncate"><%= creatable_name %></span>
        </div>
        <%= button_to create_url,
                      method: :post,
                      params: { organization_name: creatable_name, return_to: return_to },
                      form: { class: "shrink-0", data: { turbo_frame: "_top" } },
                      class: button_classes(:primary, extra: "shrink-0 w-48 justify-center focus:ring-primary cursor-pointer") do %>
          Create and link
        <% end %>
      </div>
    <% end %>
    <p class="text-sm text-gray-600 mb-2 mt-4">Or, add an existing organization instead:</p>
  <% end %>

  <% if potential_matches.any? %>
    <p class="text-xs text-gray-500 mb-2">Suggested matches for the submitted name:</p>
    <div class="space-y-2 mb-4">
      <% potential_matches.each do |org| %>
        <%= form_with url: select_url,
                      method: :post,
                      data: { turbo_frame: "_top" },
                      class: "flex items-center justify-between bg-blue-50 border border-blue-200 rounded-lg p-3" do %>
          <%= hidden_field_tag :organization_id, org.id %>
          <%= hidden_field_tag :return_to, return_to %>
          <div class="min-w-0">
            <p class="font-medium text-gray-800"><%= org.name %><% if org.city_state.present? %> <span class="text-xs text-gray-500">· <%= org.city_state %></span><% end %></p>
          </div>
          <%= submit_tag "Link organization", class: button_classes(:primary, extra: "cursor-pointer") %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= form_with url: select_url,
                method: :post,
                data: { turbo_frame: "_top" },
                class: "flex items-stretch gap-2" do %>
    <%= hidden_field_tag :return_to, return_to %>
    <div class="flex-1 min-w-0">
      <%= select_tag :organization_id,
                     options_from_collection_for_select([], :id, :name),
                     include_blank: true,
                     class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-800 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none",
                     data: { controller: "remote-select", remote_select_model_value: "organization" },
                     prompt: "Type to search organizations…" %>
    </div>
    <%= submit_tag "Link organization",
                   class: button_classes(create_is_primary ? :primary_outline : :primary, extra: "shrink-0 w-48 justify-center focus:ring-primary cursor-pointer") %>
  <% end %>
</div>

<%
  # Partial for displaying created_at and updated_at information on edit pages
  # Usage: render "shared/audit_info", resource: @resource
  return unless resource&.persisted?

  model = resource.respond_to?(:object) ? resource.object : resource
  created_by_user = resource.try(:created_by)
  updated_by_user = resource.try(:updated_by)
%>

<div class="mt-6 flex justify-end border-t border-gray-200 pt-4">
  <div class="space-y-1 text-right text-xs text-gray-500">
    <% if resource.created_at.present? %>
      <div>
        <span class="font-medium">Created:</span>
        <%= resource.created_at.strftime("%b %d, %Y at %-l:%M %p") %>
        <% if created_by_user %>
          by <%= user_button(created_by_user) %>
        <% end %>
        <% if allowed_to?(:index?, with: Admin::AhoyActivityPolicy) %>
          <%= link_to admin_activities_events_path(resource_type: model.class.name, resource_id: resource.id),
                      class: "ml-1 text-indigo-600 hover:underline",
                      title: "View creation event in Ahoy" do %>
            <i class="fas fa-chart-line"></i>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if resource.updated_at.present? && resource.updated_at != resource.created_at %>
      <div>
        <span class="font-medium">Last updated:</span>
        <%= resource.updated_at.strftime("%b %d, %Y at %-l:%M %p") %>
        <% if updated_by_user %>
          by <%= user_button(updated_by_user) %>
        <% end %>
        <% if allowed_to?(:index?, with: Admin::AhoyActivityPolicy) %>
          <%= link_to admin_activities_events_path(resource_type: model.class.name, resource_id: resource.id),
                      class: "ml-1 text-indigo-600 hover:underline",
                      title: "View update events in Ahoy" do %>
            <i class="fas fa-chart-line"></i>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

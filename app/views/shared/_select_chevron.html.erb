<%# Custom chevron for an appearance-none filter <select>, inset from the right
    border (the browser's native arrow is pinned to the edge). Wrap the select in
    a `relative` container and give it `appearance-none pr-10`. %>
<span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-gray-400">
  <i class="fa-solid fa-chevron-down text-xs"></i>
</span>

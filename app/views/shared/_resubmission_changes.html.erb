<% if notes.any? %>
  <div style="background-color: #fef3c7; border-radius: 6px; padding: 12px 16px; margin: 0 0 16px; color: #92400e; text-align: left;">
    <p style="margin: 0 0 4px; font-weight: bold;">This submission changed the registration:</p>
    <ul style="margin: 0; padding-left: 20px;">
      <% notes.each do |note| %>
        <li><%= note %></li>
      <% end %>
    </ul>
  </div>
<% end %>

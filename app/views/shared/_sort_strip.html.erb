<%# The one "Sort by" control for card/list indexes (tables sort by column header instead).
    Segments fill with the domain's 700 color when active.

    Two modes:
      - Radios (no `href`): put it inside the search form so the collection controller
        auto-submits; the checked segment is styled with `has-checked` (no JS).
        `default` names the value that submits blank, so the server re-derives it.
      - Links (`href` given): the server marks the active segment.

    locals:
      options   - { label => value }
      selected  - the active value
      domain    - DomainTheme key for the active fill
      href      - optional ->(value) { path } (link mode)
      link_data - optional data attributes for each link (e.g. turbo_frame)
      active_icon - optional Font Awesome class shown after the active link (e.g. a direction arrow)
      default   - optional radio value that submits blank %>
<%
  href = local_assigns[:href]
  active_icon = local_assigns[:active_icon]
  active_bg = DomainTheme.bg_class_for(domain, intensity: 700)
  segment = "inline-flex items-center gap-1 rounded-md px-3 py-1 font-medium"
%>
<div class="flex items-center gap-2 text-sm">
  <span class="text-gray-600">Sort by</span>
  <div class="inline-flex flex-wrap rounded-lg border border-gray-200 bg-white p-0.5 shadow-sm">
    <% options.each do |label, value| %>
      <% if href %>
        <% active = value == selected %>
        <%= link_to href.call(value), data: local_assigns[:link_data], aria: { current: (active ? "true" : nil) },
                    class: "#{segment} #{active ? "#{active_bg} text-white" : "text-gray-600 hover:bg-gray-100"}" do %>
          <%= label %>
          <% if active && active_icon %><i class="fa-solid <%= active_icon %> text-xs"></i><% end %>
        <% end %>
      <% else %>
        <label class="<%= segment %> has-checked:<%= active_bg %> cursor-pointer text-gray-600 hover:bg-gray-100 has-checked:text-white has-focus-visible:ring-2 has-focus-visible:ring-indigo-300">
          <%= radio_button_tag :sort, (value == local_assigns[:default] ? "" : value), value == selected,
                               id: "sort_#{value}", class: "sr-only" %>
          <%= label %>
        </label>
      <% end %>
    <% end %>
  </div>
</div>

<%# Info "i" popover listing what each visibility checkbox means. %>
<%# Pass flags: an array of flag symbols present in this section, in display order. %>
<% flags = local_assigns.fetch(:flags) %>
<% definitions = flags.filter_map { |flag| VisibilityFlagsHelper::FLAG_DEFINITIONS[flag] } %>
<% if definitions.any? %>
  <div class="relative inline-flex" data-controller="info-popover">
    <button type="button"
            data-action="info-popover#toggle"
            aria-label="What do these checkboxes mean?"
            class="text-gray-400 hover:text-blue-600 focus:text-blue-600 focus:outline-none cursor-pointer">
      <i class="fa-solid fa-circle-info"></i>
    </button>

    <div data-info-popover-target="panel"
         class="hidden absolute right-0 top-full mt-2 z-40 w-72 rounded-lg border border-gray-200 bg-white p-3 text-left shadow-lg">
      <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-500">What these mean</p>
      <dl class="space-y-2">
        <% definitions.each do |definition| %>
          <div>
            <dt class="text-sm font-semibold text-gray-800"><%= definition[:label] %></dt>
            <dd class="text-xs text-gray-600"><%= definition[:description] %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
<% end %>

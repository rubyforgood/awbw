<%# Hover/focus reveal listing what each visibility checkbox means. Pure CSS — %>
<%# no JS. Pass flags: an array of flag symbols present in this section. %>
<% flags = local_assigns.fetch(:flags) %>
<% definitions = flags.filter_map { |flag| VisibilityFlagsHelper::FLAG_DEFINITIONS[flag] } %>
<% if definitions.any? %>
  <div class="group relative inline-flex">
    <button type="button"
            aria-label="What these checkboxes mean"
            class="inline-flex items-center gap-1 text-gray-400 group-hover:text-blue-600 focus:text-blue-600 focus:outline-none cursor-help">
      <span class="text-xs font-semibold uppercase tracking-wide">Definitions</span>
      <i class="fa-solid fa-circle-info"></i>
    </button>

    <%# pt-2 (not margin) keeps the hover area continuous across the visual gap %>
    <div class="hidden group-hover:block group-focus-within:block absolute right-0 top-full z-40 pt-2">
      <div class="w-72 rounded-lg border border-gray-200 bg-white p-3 text-left shadow-lg">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-500">What these mean</p>
        <dl class="space-y-2">
          <% definitions.each do |definition| %>
            <div>
              <dt class="text-sm font-semibold text-gray-800"><%= definition[:label] %></dt>
              <dd class="text-xs text-gray-600"><%= definition[:description] %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </div>
  </div>
<% end %>

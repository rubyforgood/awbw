<%= simple_form_for @resource do |f| %>
  <%= render 'shared/errors', resource: @resource if @resource.errors.any? %>

  <div class="row mb-3">
    <div class="col-md-4">
      <%= f.input :title,
                  as: :text,
                  input_html: { rows: 1 },
                  wrapper: false,
                  label_html: { class: 'form-label' } %>
    </div>
    <div class="col-md-4">
      <%= f.input :kind, as: :select,
                  collection: Resource::KINDS %>
    </div>

    <% if request.path == workshops_share_idea_path %>
      <%= f.hidden_field :inactive, value: true %>
    <% else %>
      <!-- Flags -->
      <div class="col-md-4">
        <label>Flags</label>
        <div style="display: flex;" class="d-flex gap-3 align-items-center">
          <div style="margin-right: 3em;">
            <%= f.input :featured, as: :boolean, wrapper: false %>
          </div>
          <%= f.input :inactive, as: :boolean, wrapper: false %>
        </div>
      </div>
    <% end %>
  </div>


  <div class="row mb-3">

    <div class="col-md-4">
      <%= f.input :sectors, as: :select, collection: @sectors %>
    </div>
    <div class="col-md-4">
      <%= f.input :url, as: :text, input_html: { rows: 1, class: "form-control w-100" } %>
    </div>
    <div class="col-md-3">
      <%= f.input :ordering,
                  as: :integer,
                  label: "Dashboard display order",
                  input_html: { class: "form-control form-control-sm", min: 1, step: 1 },
                  wrapper_html: { class: "form-group-sm" } %>
    </div>
  </div>
  <div class="row mb-3">
    <div class="col-md-4">
      <%= f.input :text, as: :text, input_html: { rows: 5 } %>
    </div>
    <!-- Nested Images -->
    <div class="col-md-4">
      <!-- Main Image -->
      <div class="flex-1 flex flex-col">
        <%= f.simple_fields_for :images, f.object.images.first || f.object.images.build do |mi| %>
          <div class="nested-fields flex flex-col">
            <%= mi.input :file, as: :file, label: "Main Image", wrapper_html: { class: "mb-2" } %>

            <% if mi.object.persisted? && mi.object.file.present? %>
              <%= image_tag mi.object.file.url(:thumb),
                            alt: "Main Image",
                            class: "rounded-md border max-h-[150px] w-auto mb-2" %>
              <%= mi.input :_destroy, as: :boolean, label: "Remove", wrapper_html: { class: "mb-0" } %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="col-md-4">
      <!-- Attachment -->
      <div class="flex-1 flex flex-col">
        <%= f.simple_fields_for :attachments, f.object.attachments.first || f.object.attachments.build do |att| %>
          <div class="nested-fields flex flex-col">
            <%= att.input :file, as: :file, label: "Attachment", wrapper_html: { class: "mb-2" } %>

            <% if att.object.persisted? && att.object.file.present? %>
              <% if att.object.file_content_type.start_with?('image/') %>
                <%= image_tag att.object.file.url(:thumb),
                              alt: "Attachment",
                              class: "rounded-md border max-h-[150px] w-auto mb-2" %>
              <% else %>
                <span class="block text-sm text-gray-700 mb-2"><%= att.object.file_file_name %></span>
              <% end %>
              <%= att.input :_destroy, as: :boolean, label: "Remove", wrapper_html: { class: "mb-0" } %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>



  </div>




  <div class="form-group">
    <br>
    <%= link_to 'Cancel', resources_path, class: 'btn btn-secondary btn-outline-secondary' %>
    <%= f.submit 'Submit', class: "btn btn-primary btn-outline-primary" %>
  </div>

<% end %>
<section>
  <div class="flex flex-col items-start">
    <div class="inline-block">
      <h2 class="text-2xl text-gray-700 font-medium m-2"><%= title %></h2>
      <hr class="h-1 bg-[#063b8d] border-0 rounded-sm my-2 mx-4">
    </div>
  </div>
  <% unless resources.any? %>
    <div class="flex flex-wrap">
      <% resources.each do |resource| %>
        <div class="col-xs-6 col-xs-6-custom">
          <div class="workshop-box">
            <%= link_to resource.featured_url, target: :blank do %>
              <%# Do we need to check for 'Theme'? Not in query %>
              <% unless resource.kind == 'Theme' %>
                <%# <figure %>
                <%#   class="portrait-img" %>
                <%#   style="background-image: url(<%= resource.main_image %>
                <%# ></figure> %>
              <% end %>
              <div class="">
                <h3><%= resource.title %></h3>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= "There are no resources at this time." %>
  <% end %>
</section>

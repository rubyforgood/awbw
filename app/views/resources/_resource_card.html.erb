<div class="relative">
  <!-- BOOKMARK ICON -->
  <div class="absolute top-3 right-3 z-30">
    <%= render "bookmarks/editable_bookmark_icon", resource: resource.object %>
  </div>
  <!-- CARD -->
  <div
    class="flex flex-row flex-wrap overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-all hover:shadow-md"
  >
    <!-- LEFT SIDE -->
    <div
      class="flex w-40 flex-shrink-0 flex-col items-center justify-center border-b border-gray-200 px-3 py-4 pb-3 text-center md:w-40 md:border-r md:border-b-0"
    >
      <!-- IMAGE -->
      <div class="relative h-32 w-32">
        <%= link_to resource_path(resource),
                    data: { turbo_frame: "_top", turbo_prefetch: false },
                    class: "block w-full h-full" do %>
          <!-- fallback icon -->
          <div class="resource-icon absolute inset-0 flex items-center justify-center text-gray-700">
            <%= render "resources/resource_icon", kind: resource.kind %>
          </div>
          <%= render "assets/display_image",
                     resource: resource.object,
                     width: "32", height: "32",
                     link: false,
                     link_to_object: false,
                     file: resource.display_image,
                     variant: :gallery %>
        <% end %>
      </div>
      <!-- TYPE -->
      <span class="mt-2 text-xs font-medium tracking-wide text-gray-500 uppercase"><%= resource.kind_display %></span>
    </div>
    <!-- RIGHT SIDE -->
    <div class="relative mt-2 min-w-0 flex-1 pr-10 pb-12 pl-4">
      <div class="mt-3 mb-2">
        <%= link_to resource_path(resource),
                    data: { turbo_frame: "_top", turbo_prefetch: false },
                    class: "inline-flex min-w-0 max-w-full text-lg font-semibold
                            text-gray-900 leading-tight hover:underline" do %>
          <%= title_with_badges(resource).html_safe %>
        <% end %>
      </div>
      <!-- ACTION BUTTONS -->
      <div class="absolute right-3 bottom-3 left-4 z-30 flex items-center">
        <% if allowed_to?(:edit?, resource) %>
          <p class="admin-only text-2xs rounded bg-blue-50 px-1.5 py-0.5 whitespace-nowrap text-blue-600"><%= resource.created_at.strftime("%b %-d, %Y") %></p>
        <% end %>
        <div class="ml-auto flex items-center space-x-2">
        <% if resource.downloadable_asset&.file&.attached? %>
          <%= link_to(
                content_tag(:span, "", class: "fa fa-download"),
                resource_download_path(resource.object),
                download: true,
                class: "btn btn-utility"
              ) %>
        <% end %>
        <% if controller_name == "resources" &&  allowed_to?(:edit?, resource) %>
          <%= link_to(
                content_tag(:span, "", class: "far fa-edit"),
                edit_resource_path(resource.object),
                class: "admin-only bg-blue-100 btn btn-secondary-outline",
                data: {turbo_frame: "_top", turbo_prefetch: false }
              ) %>
        <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="mb-3">
  <h3 class="mb-1 text-xs font-semibold tracking-wide text-gray-500 uppercase">
    Kinds (click to filter)
  </h3>

  <div class="flex flex-wrap gap-2">
    <% Resource::PUBLISHED_KINDS.each do |sortable_field| %>
      <% name = sortable_field.is_a?(String) ? sortable_field : sortable_field.name %>

      <label
        for="kind_<%= name %>"
        class="
          inline-flex cursor-pointer items-center rounded-lg px-4 py-2 text-sm font-medium transition-all duration-150
          <%= default_btn %>
        "
      >
        <%= check_box_tag("kinds[]", name, Array(params[:kinds]).include?(name),
                        id: "kind_#{name}",
                        class: "hidden") %>
        <%= name.titleize.pluralize %>
      </label>
    <% end %>

    <% if allowed_to?(:manage?, Resource) %>
      <%# Outside a <label> wrapper on purpose: the collection controller's class
          toggle skips it, so peer-checked drives the admin-blue selected state. %>
      <span class="admin-only">
        <%= check_box_tag "legacy", "1", params[:legacy] == "1", id: "legacy", class: "peer sr-only" %>
        <label for="legacy"
               title="<%= Resource::LEGACY_KINDS.join(", ") %>"
               class="inline-flex cursor-pointer items-center rounded-lg border border-blue-300 bg-blue-100 px-4 py-2 text-sm font-medium text-blue-800 shadow-sm transition-all duration-150 peer-checked:border-blue-600 peer-checked:bg-blue-600 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-blue-300 hover:bg-blue-200 peer-checked:hover:bg-blue-700">
          Legacy
        </label>
      </span>
    <% end %>
  </div>
</div>

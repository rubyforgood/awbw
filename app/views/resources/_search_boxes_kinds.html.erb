<div class="mb-3">
  <h3 class="mb-1 text-xs font-semibold tracking-wide text-gray-500 uppercase">
    Kinds (click to filter)
  </h3>

  <div class="flex flex-wrap gap-2">
    <% Resource::PUBLISHED_KINDS.each do |sortable_field| %>
      <% name = sortable_field.is_a?(String) ? sortable_field : sortable_field.name %>

      <label
        for="kind_<%= name %>"
        class="
          inline-flex cursor-pointer items-center rounded-lg px-4 py-2 text-sm font-medium transition-all duration-150
          <%= default_btn %>
        "
      >
        <%= check_box_tag("kinds[]", name, Array(params[:kinds]).include?(name),
                        id: "kind_#{name}",
                        class: "hidden") %>
        <%= name.titleize.pluralize %>
      </label>
    <% end %>
  </div>
</div>

<article id="tutorial-<%= tutorial.id %>"
         class="tutorial-block scroll-mt-24">

  <header class="mb-4 flex w-full items-center gap-4">
    <h2 class="text-2xl">
      <%= link_to title_with_badges(tutorial, font_size: "text-2xl"),
                  tutorial_path(tutorial),
                  data: {turbo_frame: "_top"},
                  class: "hover:underline" %>
    </h2>
    <% if allowed_to?(:edit?, tutorial) %>
      <%= link_to "Edit",
                  edit_video_recording_path(tutorial),
                  data: {turbo_frame: "_top"},
                  class: "admin-only bg-blue-100 btn btn-secondary-outline" %>
    <% end %>
    <div class="ml-auto flex items-center gap-2">
      <%= render "bookmarks/editable_bookmark_icon", resource: tutorial %>
      <%= link_to "View", tutorial_path(tutorial),
                    data: { turbo_frame: "_top"},
                    class: "btn btn-secondary-outline" %>
    </div>
  </header>

  <!-- Embedded Video -->
  <% if tutorial.youtube_url.present? %>
    <div class="mb-2">
      <div class="relative w-full overflow-hidden rounded-lg shadow-sm" style="padding-top: 56.25%;">
        <iframe
          src="<%= youtube_embed_url(tutorial.youtube_url) %>"
          title="<%= tutorial.title %>"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="absolute inset-0 h-full w-full border-0">
        </iframe>
      </div>
    </div>
  <% end %>

  <!-- Body -->
  <%= tutorial.rhino_body %>

</article>

<%= simple_form_for(@sector) do |f| %>
  <div class="space-y-6">

    <!-- Errors -->
    <%= render "shared/errors", resource: @sector if @sector.errors.any? %>

    <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-4">
      <div class="space-y-6 md:col-span-3">
        <!-- Name -->
        <div>
          <%= f.input :name,
                      label: "Name",
                      input_html: { class: "form-control" } %>
        </div>

        <!-- Description -->
        <div>
          <%= f.input :description,
                      as: :text,
                      label: "Description",
                      hint: "Optional. Shown under this sector on the public registration form to clarify its meaning when the name alone isn't enough.",
                      input_html: { class: "form-control", rows: 2 } %>
        </div>

        <!-- Story Share portal placement -->
        <div class="max-w-[220px]">
          <%= f.input :story_share_position,
                      as: :integer,
                      label: "Story share position",
                      hint: "Optional. Featured in the Story Share portal at this position (top nav and its own landing-page row; first 6 shown). Leave blank to list it only under Additional focus areas.",
                      input_html: { class: "form-control", min: 1 } %>
        </div>
      </div>

      <div class="admin-only mt-6 rounded bg-blue-100 p-3 md:mt-0">
        <%= render "shared/visibility_info", flags: %i[published] %>
        <div class="grid grid-cols-1 items-center">
          <%= visibility_flag_input f, :published %>
        </div>
      </div>
    </div>

    <div class="action-buttons mt-8 flex justify-center gap-3">
      <% if allowed_to?(:destroy?, f.object) %>
        <%= link_to "Delete", @sector, class: button_classes(:danger_outline),
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete?" } %>
      <% end %>
      <%= link_to "Cancel", sectors_path, class: button_classes(:secondary_outline) %>
      <%= f.button :submit, class: button_classes(:primary) %>
    </div>

  </div>
<% end %>

<%= turbo_frame_tag :assets_results do %>
  <p class="text-sm text-gray-500 mb-4"><%= @count_display %> <%= "asset".pluralize(@assets.total_entries) %></p>

  <% if @assets.any? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 animate-fade">
      <% AssetDecorator.decorate_collection(@assets).each do |asset| %>
        <%= render "asset_card", asset: asset %>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-center py-6">No assets match your search. Try clearing the filters.</p>
  <% end %>

  <div class="pagination flex justify-center mt-6 w-full"><%= tailwind_paginate @assets %></div>
<% end %>

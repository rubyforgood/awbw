<div class="flex flex-wrap gap-2 p-3 m-2 bg-white my-5 rounded-md">
  <% owner.assets.each do |asset| %>
    <% next if asset.type == "RichTextAsset" %>

    <div class="flex flex-col items-center border border-gray-300 rounded-md shadow-sm p-2">
      <%= render "assets/type_selector", asset: asset, owner: owner %>

      <%= render "active_storage/blobs/blob_thumbnail", asset: asset %>

      <%= render "assets/title", asset: asset %>
    </div>
  <% end %>
</div>

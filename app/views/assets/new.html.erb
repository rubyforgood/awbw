<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="max-w-2xl mx-auto <%= DomainTheme.bg_class_for(:admin_only) %> border border-gray-200 rounded-xl shadow p-6">
  <div class="flex flex-wrap justify-end gap-2 mb-4">
    <%= link_to "← Asset library", asset_library_path, class: "text-sm text-gray-500 hover:text-gray-700 px-2 py-1" %>
  </div>

  <h1 class="text-2xl font-semibold text-gray-900 mb-2">New asset</h1>
  <p class="text-gray-600 mb-6">Upload a file to the library. New assets are hidden from search by default.</p>

  <%= simple_form_for @asset, url: asset_library_path, method: :post,
        as: :asset, html: { multipart: true } do |f| %>
    <%= render "shared/errors", resource: @asset if @asset.errors.any? %>

    <div class="space-y-6">
      <%= f.input :file, as: :file, label: "File",
            hint: "Accepted: #{Asset.accepted_types_label}" %>

      <%= f.input :type, collection: Asset::TYPES.map { |t| [ t.underscore.humanize, t ] },
            include_blank: false, label: "Type" %>

      <%= f.input :title, label: "Caption", input_html: { value: @asset.title } %>

      <%= f.input :hidden_from_search, as: :boolean, label: "Hidden from search" %>

      <div class="flex items-center gap-3">
        <%= f.button :submit, "Add to library", class: "btn btn-primary" %>
        <%= link_to "Cancel", asset_library_path, class: "btn btn-utility" %>
      </div>
    </div>
  <% end %>
</div>

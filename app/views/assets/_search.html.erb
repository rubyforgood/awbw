<%= form_tag asset_library_path, method: :get,
      data: { controller: "collection", turbo_frame: "assets_results" },
      autocomplete: "off",
      class: "space-y-2" do %>
  <div class="flex flex-wrap md:flex-nowrap items-end gap-6">
    <!-- KEYWORDS -->
    <div class="flex-1 min-w-[200px] pb-2">
      <label for="query" class="block text-xs font-semibold uppercase text-gray-500 tracking-wide mb-1">
        Keywords
      </label>
      <div class="relative">
        <%= text_field_tag :query, params[:query],
              placeholder: "Caption, filename, or attached record",
              class: "w-full bg-white border border-gray-300 rounded-lg px-3 py-2 pr-10
                      focus:ring-blue-500 focus:border-blue-500" %>
        <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700">
          <i class="fa fa-search"></i>
        </button>
      </div>
    </div>

    <!-- TYPE -->
    <div class="min-w-[160px] pb-2">
      <label for="type" class="block text-xs font-semibold uppercase text-gray-500 tracking-wide mb-1">
        Type
      </label>
      <%= select_tag :type,
            options_for_select(types.map { |t| [ t.underscore.humanize, t ] }, params[:type]),
            include_blank: "All types",
            class: "w-full bg-white border border-gray-300 rounded-lg px-3 py-2" %>
    </div>

    <!-- FILE TYPE -->
    <div class="min-w-[160px] pb-2">
      <label for="content_type" class="block text-xs font-semibold uppercase text-gray-500 tracking-wide mb-1">
        File type
      </label>
      <%= select_tag :content_type,
            options_for_select(content_types.map { |ct| [ Asset::CONTENT_TYPE_LABELS[ct] || ct, ct ] }, params[:content_type]),
            include_blank: "All files",
            class: "w-full bg-white border border-gray-300 rounded-lg px-3 py-2" %>
    </div>

    <!-- ATTACHED TO -->
    <div class="min-w-[160px] pb-2">
      <label for="owner_type" class="block text-xs font-semibold uppercase text-gray-500 tracking-wide mb-1">
        Attached to
      </label>
      <%= select_tag :owner_type,
            options_for_select(owner_types.map { |t| [ t.underscore.humanize, t ] }, params[:owner_type]),
            include_blank: "Anything",
            class: "w-full bg-white border border-gray-300 rounded-lg px-3 py-2" %>
    </div>

    <!-- CLEAR FILTERS -->
    <div class="min-w-[120px] pb-3">
      <label class="block text-xs font-semibold uppercase text-gray-500 tracking-wide mb-1">&nbsp;</label>
      <%= link_to "Clear filters", asset_library_path, class: "btn btn-utility", data: { action: "collection#clearAndSubmit" } %>
    </div>
  </div>
<% end %>

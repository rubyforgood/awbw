<% upload_target = "uploadLabel#{type.capitalize}" %>
<% button_target = "uploadButton#{type.capitalize}" %>
<% delete_target = "#{type}DeleteButton" %>
<% type_param = "#{type.capitalize}Asset" %>
<% button_text =
  case type
  when "primary"
    "Add Primary Image"
  when "downloadable"
    "Add Downloadable File"
  when "gallery"
    "Add Gallery Attachment"
  end %>

<div class="relative w-fit">
  <!-- Fake X button to remove asset -->
  <button
    type="button"
    data-action="
      click->asset-upload#removeFake<%= type.capitalize %>
    "
    data-asset-upload-target="<%= delete_target %>"
    class="
      absolute top-1 right-1 flex items-center justify-center w-7 h-7 rounded-full
      bg-black/60 text-white hover:bg-red-600 z-10 hidden
    "
  >
    ✕
  </button>
  <!-- Preview area -->
  <div data-asset-upload-target="<%= upload_target %>">
    <!-- initial upload icon -->
    <svg class="w-16 h-16 cursor-pointer">
      <!-- default upload icon SVG -->
    </svg>
  </div>
  <!-- Fake Add button -->
  <button
    type="button"
    data-action="asset-upload#triggerFileInput"
    data-asset-upload-type-param="<%= type_param %>"
    data-asset-upload-target="<%= button_target %>"
    class="mt-2 btn btn-secondary-outline"
  >
    <%= button_text %>
  </button>
</div>

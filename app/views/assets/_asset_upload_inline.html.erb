<% upload_target = "uploadLabel#{type.capitalize}" %>
<% button_target = "uploadButton#{type.capitalize}" %>
<% delete_target = "#{type}DeleteButton" %>
<% type_param = "#{type.capitalize}Asset" %>

<% button_text =
  case type
  when "primary"
    "Primary Image"
  when "downloadable"
    "Downloadable File"
  when "gallery"
    "Gallery Attachment"
  end %>

<div class="relative w-fit">
  <!-- Fake X button to remove asset -->
  <button
    type="button"
    data-action="
      click->asset-upload#removeFake<%= type.capitalize %>
    "
    data-asset-upload-target="<%= delete_target %>"
    class="
      absolute top-1 right-1 flex items-center justify-center w-7 h-7 rounded-full
      bg-black/60 text-white hover:bg-red-600 z-10 hidden
    "
  >
    ✕
  </button>

  <!-- Preview area -->
  <div data-asset-upload-target="<%= upload_target %>"></div>

  <div>
    <button
      type="button"
      data-action="asset-upload#triggerFileInput"
      data-asset-upload-type-param="<%= type_param %>"
      data-asset-upload-target="<%= button_target %>"
    >
      <div class="bg-gray-50 w-48 h-48 mb-6 rounded-md shadow-md grid place-content-center">
        <div class="w-32 h-32 p-2 border rounded-md flex flex-col justify-end items-center gap-2 bg-white">
          <%= icon( "upload-cloud",
                    class: "w-16 h-16 hover:w-20 hover:h-20 cursor-pointer",
                    title: "Add File") %>

          <p class="text-sx">Add File</p>
        </div>
      </div>
    </button>

    <p class="text-sm font-semibold text-center"><%= button_text %></p>
  </div>
</div>

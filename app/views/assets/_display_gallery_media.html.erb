<!-- Gallery Media -->
<% secondary_assets = resource.secondary_assets.select { |img| img.file.attached? } %>
<% if secondary_assets.any? %>
  <div class="<%= resource.class.table_name %>-gallery text-center mb-4">
    <div class="flex flex-wrap justify-center gap-4 mx-auto max-w-4xl">
      <% secondary_assets.each_with_index do |secondary_assets, idx| %>
        <%= render "assets/display_image", item: secondary_assets, idx: idx %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="flex flex-col bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
  <!-- Thumbnail -->
  <div class="aspect-square w-full bg-gray-100 flex items-center justify-center overflow-hidden">
    <% if asset.pdf? %>
      <iframe src="<%= asset.inline_url %>" loading="lazy" title="<%= asset.filename %>"
              class="w-full h-full border-0"></iframe>
    <% elsif asset.thumbnail %>
      <%= image_tag asset.thumbnail, loading: "lazy", alt: asset.filename,
            class: "object-cover w-full h-full" %>
    <% elsif asset.file.attached? %>
      <div class="flex flex-col items-center text-gray-400">
        <i class="fa-solid fa-file text-4xl"></i>
        <span class="mt-2 text-xs font-semibold"><%= asset.content_type_label %></span>
      </div>
    <% else %>
      <div class="flex flex-col items-center text-gray-300">
        <i class="fa-regular fa-image text-4xl"></i>
        <span class="mt-2 text-xs">No file</span>
      </div>
    <% end %>
  </div>

  <!-- Meta -->
  <div class="flex flex-col gap-2 p-3 text-sm">
    <div class="flex items-center justify-between gap-2">
      <span class="inline-flex items-center rounded-full bg-gray-100 text-gray-700 text-xs px-2 py-0.5">
        <%= asset.type_label %>
      </span>
      <% if asset.content_type_label && !asset.image? %>
        <span class="text-xs text-gray-400"><%= asset.content_type_label %></span>
      <% end %>
    </div>

    <!-- Attached-to record -->
    <div class="text-xs text-gray-500 line-clamp-2">
      Attached to:
      <% if asset.owner_path %>
        <%= link_to asset.owner_type_label, asset.owner_path, class: "text-blue-600 hover:underline" %>
      <% else %>
        <span><%= asset.owner_type_label %></span>
      <% end %>
      <% if asset.owner_name %>
        <span class="text-gray-400">&mdash; <%= asset.owner_name %></span>
      <% end %>
    </div>

    <!-- Filename (editable) -->
    <%= render "filename_field", asset: asset %>

    <!-- Caption (editable) -->
    <%= render "caption_field", asset: asset %>
  </div>
</div>

<%= turbo_frame_tag :attendees_results do %>
  <%= turbo_stream.replace("attendees_count", partial: "attendees_count") %>

  <% if @people.any? %>
    <% charts_src = attendees_events_path(request.query_parameters) %>
    <div data-controller="panel-toggle">
      <%# Toggle bar: hide/show the attendees table and the stats charts. Charts
          start hidden; revealing the panel loads its lazy Turbo frame on first show. %>
      <%= render "events/charts_toggle_bar", buttons: [
            { name: "attendees", icon: "fa-table-list", shown_label: "Hide attendees", hidden_label: "Show attendees", expanded: true },
            { name: "charts", icon: "fa-chart-column", shown_label: "Hide charts", hidden_label: "Show charts", expanded: false }
          ] %>

      <%# Attendees panel — shown by default. %>
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2 <%= DomainTheme.text_class_for(:event_registrations, intensity: 700) %>">
        <i class="fa-solid fa-user-pen"></i>
        Attendees
      </h2>
      <div data-panel-toggle-target="panel" data-panel-toggle-name="attendees">
        <div class="rounded-xl bg-white overflow-hidden animate-fade blur-on-submit">
          <%# Page-level toggle: expand every row's Training cell to all events, or
              collapse back to the most recent one. Broadcasts to each row's
              expandable-card via @window (see _registrant_roster). %>
          <div class="flex items-center justify-end px-4 py-3 border-b border-gray-100">
            <button type="button"
                    data-controller="expandable-cards"
                    data-expandable-cards-expanded-value="false"
                    data-expandable-cards-collapsed-label-value="Show all events attended"
                    data-expandable-cards-expanded-label-value="Show last event attended"
                    data-action="expandable-cards#toggleAll"
                    class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-600 hover:text-gray-800">
              <span data-expandable-cards-target="label">Show all events attended</span>
              <i class="fa-solid fa-chevron-down text-xs transition-transform" data-expandable-cards-target="icon"></i>
            </button>
          </div>
          <%= render "events/registrant_roster", roster: @roster, show_event_column: true, show_affiliation_status: true, clickable_rows: false %>
        </div>

        <div class="mt-6 flex justify-center">
          <div class="pagination"><%= tailwind_paginate @people %></div>
        </div>
      </div>

      <%# Charts panel — hidden by default; the lazy frame loads on first reveal. %>
      <h2 class="text-xl font-bold mt-10 mb-4 flex items-center gap-2 <%= DomainTheme.text_class_for(:event_registrations, intensity: 700) %>">
        <i class="fa-solid fa-chart-pie"></i>
        Charts
      </h2>
      <%= render "events/charts_cta" %>
      <div data-panel-toggle-target="panel" data-panel-toggle-name="charts" class="hidden">
        <%= turbo_frame_tag :attendees_charts, src: charts_src, loading: :lazy do %>
          <%= render "events/charts_loading" %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="rounded-xl bg-white overflow-hidden animate-fade blur-on-submit">
      <p class="text-gray-500 text-center px-6 py-8">No training attendees found.</p>
    </div>
  <% end %>
<% end %>

<% submission = submission.decorate %>
<% payment = submission.payments.first %>
<% attendee_matches = submission.matched_attendees(event_registrations) %>
<div id="<%= dom_id(submission, :card) %>" data-controller="dropdown" class="bg-white border border-gray-200 rounded-xl shadow-sm px-4 py-3 hover:shadow-md transition-shadow">
  <div class="flex items-center justify-between gap-2">
    <span class="text-sm font-medium text-gray-900 truncate"><%= submission.person.name %></span>
    <span class="text-sm text-gray-500 truncate"><%= submission.person.email %></span>
    <span class="text-sm text-gray-500 shrink-0 text-center"><%= submission.answers_by_identifier["payment_method"].presence || "—" %></span>
    <span id="<%= dom_id(payment, :remaining) if payment %>">
      <%= render "payment_badge", payment: payment %>
    </span>
    <span class="text-sm text-gray-500 whitespace-nowrap shrink-0"><%= submission.created_at.strftime("%b %-d, %Y") %></span>
    <button type="button"
            data-action="dropdown#toggle"
            data-dropdown-payload-param='[{"payment-details-<%= submission.id %>":"hidden"}, {"payment-arrow-<%= submission.id %>":"rotate-180"}]'
            class="text-gray-400 hover:text-gray-600 p-1 shrink-0"
            title="More info">
      <i id="payment-arrow-<%= submission.id %>" class="fa-solid fa-chevron-down transition-transform duration-200"></i>
    </button>
  </div>
  <div id="payment-details-<%= submission.id %>"
       class="hidden mt-3 pt-3 border-t border-gray-100 space-y-3"
       data-dropdown-target="content">
    <div>
      <%= link_to form_submission_path(submission),
                  class: "text-sm text-blue-600 hover:text-blue-800 font-medium inline-flex items-center gap-1",
                  target: "_blank", rel: "noopener noreferrer" do %>
        <i class="fa-solid fa-file-lines text-xs"></i> View submission
      <% end %>
    </div>
    <% if attendee_matches.present? %>
      <div class="border-t border-gray-100 pt-2 space-y-1.5">
        <h4 class="text-xs font-medium text-gray-500 uppercase tracking-wide">Submitted Info</h4>
        <table class="min-w-full">
          <thead>
            <tr class="text-xs font-medium text-gray-500 uppercase tracking-wide border-b border-gray-200">
              <th class="text-left pb-1 pr-2 font-medium">First Name</th>
              <th class="text-left pb-1 pr-2 font-medium">Last Name</th>
              <th class="text-left pb-1 pr-2 font-medium">Email</th>
              <th class="pb-1"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% attendee_matches.each do |am| %>
              <tr class="align-top text-sm">
                <td class="py-2 pr-2 text-gray-900 font-medium whitespace-nowrap"><%= am[:first_name] %></td>
                <td class="py-2 pr-2 text-gray-900 whitespace-nowrap"><%= am[:last_name] %></td>
                <td class="py-2 pr-2 text-gray-500"><%= am[:email] %></td>
                <td class="py-2 whitespace-nowrap text-right">
                  <% if am[:matches].any? %>
                    <div class="flex flex-col gap-1 items-end">
                      <% am[:matches].each do |reg| %>
                        <div class="flex items-center gap-2">
                          <% if payment && payment.amount_cents_remaining > 0 && !reg.paid_in_full? %>
                            <%= form_tag allocate_bulk_payment_event_path(@event), class: "flex items-center gap-1 shrink-0" do %>
                              <%= hidden_field_tag :payment_id, payment.id %>
                              <%= hidden_field_tag :event_registration_id, reg.id %>
                              <span class="text-sm text-gray-500">$</span>
                              <%= number_field_tag :amount_dollars, nil, step: "0.01", min: "0.01", class: "w-16 rounded border border-gray-300 px-1 py-1 text-xs", placeholder: "0.00" %>
                              <%= button_tag "Allocate", class: "rounded bg-blue-600 px-1.5 py-1 text-xs font-medium text-white hover:bg-blue-700 transition-colors" %>
                            <% end %>
                          <% end %>
                          <%= render "matched_person_card", person: reg.registrant %>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-gray-400 text-sm">No match</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    <% if payment %>
      <div class="border-t border-gray-100 pt-2 space-y-2">
        <h4 class="text-xs font-medium text-gray-500 uppercase tracking-wide">Payment Allocations</h4>
        <div id="<%= dom_id(payment, :allocations) %>">
          <%= render "payment_allocations", payment: payment %>
        </div>
        <% if payment.amount_cents_remaining > 0 %>
          <div class="pt-2 border-t border-gray-100">
            <h5 class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">New Allocation</h5>
            <%= form_tag allocate_bulk_payment_event_path(@event),
                         class: "flex items-center gap-2" do %>
              <%= hidden_field_tag :payment_id, payment.id %>
              <%= select_tag :event_registration_id,
                   options_from_collection_for_select(event_registrations, :id, ->(er) { "#{er.registrant.name} — #{er.registrant.preferred_email}" }),
                   prompt: "Select registrant...",
                   class: "w-64 rounded-lg border border-gray-300 bg-white px-2 py-1.5 text-sm shadow-sm" %>
              <span class="text-sm text-gray-500">$</span>
              <%= number_field_tag :amount_dollars, nil,
                                   step: "0.01", min: "0.01",
                                   class: "w-20 rounded border border-gray-300 px-1.5 py-1.5 text-sm",
                                   placeholder: "0.00" %>
              <%= button_tag "Allocate",
                  class: "rounded bg-blue-600 px-2.5 py-1.5 text-xs font-medium text-white hover:bg-blue-700 transition-colors" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render "bulk_payment_form", submission: submission %>
    <% end %>
  </div>
</div>

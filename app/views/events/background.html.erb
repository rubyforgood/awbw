<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<% primary_sector_data = @dashboard.primary_sectors.map { |s| [ s.name, @dashboard.primary_sector_counts.fetch(s.id, 0) ] }.sort_by { |_, count| -count } %>
<% sector_data = @dashboard.sectors.map { |s| [ s.name, @dashboard.sector_counts.fetch(s.id, 0) ] }.sort_by { |_, count| -count } %>
<%# Free-text "Other" sectors ride along as one aggregate slice, pinned last (the
    actual typed values get their own detail card below). The primary chart has no
    such slice — "Other" is an additional-sector answer only. %>
<% sector_data += [ [ "Other", @dashboard.other_sector_response_count ] ] if @dashboard.other_sector_response_count.positive? %>
<%# Detail list of the actual typed values, each drilling into the registrants who typed it. %>
<% other_response_data = @dashboard.other_sector_response_rows.map { |text, count, _ids| [ text, count ] } %>
<% other_response_paths = @dashboard.other_sector_response_rows.to_h { |text, _count, ids| [ text, registrants_event_path(@event, registrant_ids: ids.join("-")) ] } %>
<% age_group_data = @dashboard.age_groups.map { |c| [ c.name, @dashboard.age_group_counts.fetch(c.id, 0) ] }.sort_by { |_, count| -count } %>
<% all_age_group_data = @dashboard.all_age_groups.map { |c| [ c.name, @dashboard.all_age_group_counts.fetch(c.id, 0) ] }.sort_by { |_, count| -count } %>
<% state_data = @dashboard.state_counts.sort_by { |_, count| -count } %>
<% country_data = @dashboard.country_counts.sort_by { |_, count| -count } %>
<% school_district_data = @dashboard.school_district_counts.sort_by { |_, count| -count } %>
<%# Program-status breakdown of the represented orgs. Each status carries its own
    swatch (green/blue/purple) matching the OrganizationDecorator badge colors, and
    zero-count statuses drop out so data and palette stay aligned. %>
<% program_status_rows = [ [ "New", @dashboard.program_status_counts[:new], "#22c55e" ],
                           [ "Ongoing", @dashboard.program_status_counts[:ongoing], "#3b82f6" ],
                           [ "Reinstated", @dashboard.program_status_counts[:reinstated], "#a855f7" ] ].select { |_, count, _| count.positive? } %>
<% program_status_data = program_status_rows.map { |label, count, _| [ label, count ] } %>
<% program_status_palette = program_status_rows.map { |_, _, color| color } %>
<% life_experience_data = @dashboard.life_experiences.map { |c| [ c.name, @dashboard.life_experience_counts.fetch(c.id, 0) ] }.sort_by { |_, count| -count } %>
<% settings_data = @dashboard.settings.map { |c| [ c.name, @dashboard.settings_counts.fetch(c.id, 0) ] }.sort_by { |_, count| -count } %>

<%# Shared palette: pie slice i and its legend swatch i both use palette[i]. %>
<% palette = %w[#3b82f6 #ef4444 #f59e0b #10b981 #6366f1 #ec4899 #14b8a6 #f97316 #8b5cf6 #84cc16 #06b6d4 #eab308 #a855f7 #22c55e #fb7185] %>

<%# Opt out of the layout's max-w-7xl cap to match the wider registrants page;
    the wrapper restores the layout's gutters at a wider bound. %>
<% content_for(:full_width, true) %>
<div class="mx-auto max-w-[96rem] px-2 sm:px-6 lg:px-8">
<div class="<%= DomainTheme.bg_class_for(:events) %> border border-gray-200 rounded-xl shadow p-4 sm:p-6">
  <%# Top bar: back link + sub-nav, matching the other event pages %>
  <div class="flex flex-wrap items-center justify-between gap-2 sm:gap-4 mb-6 print:hidden">
    <%= link_to "← Events", events_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    <%= render "events/subnav", event: @event, current: :background %>
  </div>
  <%# Title block with the Print button pinned top-right so it shares the title's
      vertical band instead of stacking above it. On mobile it sits in its own
      right-aligned row above the centered title to avoid overlapping it. %>
  <div class="relative mb-8">
    <div class="flex justify-end gap-3 mb-4 sm:mb-0 sm:absolute sm:right-0 sm:top-0 print:hidden">
      <button onclick="window.print();" class="btn btn-utility-outline">
        <i class="fa-solid fa-print"></i> Print
      </button>
    </div>

    <div class="text-center">
      <%= link_to @event.decorate.compact_label, edit_event_path(@event), title: @event.title, class: "text-sm font-semibold text-gray-500 uppercase tracking-wide hover:text-gray-700" %>
      <% if @event.start_date.present? %>
        <p class="text-sm text-gray-500 mt-1"><%= @event.date_range %></p>
      <% end %>
      <h1 class="text-3xl font-bold text-gray-900 mt-2 flex items-center justify-center gap-2">
        <i class="fa-solid fa-users-viewfinder <%= DomainTheme.text_class_for(:people, intensity: 500) %>"></i>
        Get to know the registrants
      </h1>
    </div>
  </div>

  <%# ---- At-a-glance counts — one compact "stat bar" of metrics; each segment
      drills into the matching filtered registrant list. Scholarships and CE ride
      along as subtotals of registrants, and states + countries combine into a
      single "Locations" total with per-type subtotals. ---- %>
  <% ps = @dashboard.program_status_counts %>
  <% program_breakdown = @dashboard.organization_count.positive? ? "#{ps[:new]} new · #{ps[:ongoing]} ongoing · #{ps[:reinstated]} reinstated" : nil %>
  <% ce_registrant_ids = @dashboard.ce_registrant_ids %>
  <%# Every stat-bar link returns to the stat bar itself (anchor "overview"). %>
  <% leading_metrics = [
       { label: "Organizations", value: @dashboard.organization_count, icon: "fa-building", theme: :organizations,
         path: background_return_path(registrants_event_path(@event, registrant_ids: @dashboard.organization_registrant_ids.join("-")), "overview"), sub: program_breakdown },
       { label: "Sectors", value: @dashboard.sectors.size, icon: "fa-hand-holding-heart", theme: :sectors,
         path: background_return_path(registrants_event_path(@event, registrant_ids: @dashboard.sector_registrant_ids.join("-")), "overview"),
         sub: @dashboard.sectors.any? ? "#{@dashboard.primary_sector_count} primary · #{@dashboard.additional_sector_count} additional" : nil }
     ] %>
  <div id="overview" class="scroll-mt-24 flex flex-wrap items-stretch divide-y sm:divide-y-0 sm:divide-x divide-gray-100 rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
    <%# Registrants, with scholarship recipients and CE as subtotals drilling into their lists. %>
    <div class="flex items-center gap-3 px-4 py-3 grow basis-44">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg <%= DomainTheme.bg_class_for(:people, intensity: 100) %> <%= DomainTheme.text_class_for(:people, intensity: 600) %>">
        <i class="fa-solid fa-users"></i>
      </span>
      <span class="min-w-0">
        <%= link_to background_return_path(registrants_event_path(@event), "overview"), class: "group/reg block hover:underline leading-tight" do %>
          <span class="text-xl font-bold text-gray-900 tabular-nums"><%= @dashboard.registrant_count %></span>
          <span class="text-xs text-gray-500">Registrants</span>
          <i class="fa-solid fa-arrow-up-right-from-square text-[10px] text-gray-400 opacity-0 group-hover/reg:opacity-100 transition-opacity"></i>
        <% end %>
        <span class="block text-xs text-gray-400 mt-0.5">
          <%= link_to recipients_event_path(@event), class: "hover:underline whitespace-nowrap" do %><%= pluralize(@dashboard.scholarship_recipient_count, "scholarship") %><% end %>
          <span class="text-gray-300" aria-hidden="true">·</span>
          <%= link_to background_return_path(registrants_event_path(@event, registrant_ids: ce_registrant_ids.join("-")), "overview"), class: "hover:underline whitespace-nowrap" do %><%= ce_registrant_ids.size %> CE<% end %>
        </span>
      </span>
    </div>

    <% leading_metrics.each do |metric| %>
      <%= render "stat_segment", metric: metric %>
    <% end %>

    <%# States + countries combined: a unique-locations total with per-type subtotals. %>
    <div class="flex items-center gap-3 px-4 py-3 grow basis-56">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg <%= DomainTheme.bg_class_for(:addresses, intensity: 100) %> <%= DomainTheme.text_class_for(:addresses, intensity: 600) %>">
        <i class="fa-solid fa-earth-americas"></i>
      </span>
      <span class="min-w-0">
        <span class="block leading-tight">
          <span class="text-xl font-bold <%= DomainTheme.text_class_for(:addresses, intensity: 700) %> tabular-nums"><%= @dashboard.states.size + @dashboard.countries.size %></span>
          <span class="text-xs <%= DomainTheme.text_class_for(:addresses, intensity: 600) %>">Locations</span>
        </span>
        <span class="block text-xs text-gray-400 mt-0.5">
          <%= link_to background_return_path(registrants_event_path(@event, registrant_ids: @dashboard.state_registrant_ids.join("-")), "overview"), class: "hover:underline whitespace-nowrap" do %><%= pluralize(@dashboard.states.size, "state") %><% end %>
          <span class="text-gray-300" aria-hidden="true">·</span>
          <%= link_to background_return_path(registrants_event_path(@event, registrant_ids: @dashboard.country_registrant_ids.join("-")), "overview"), class: "hover:underline whitespace-nowrap" do %><%= pluralize(@dashboard.countries.size, "country") %><% end %>
        </span>
      </span>
    </div>
  </div>

  <%# ---- Registrant roster (full width) ---- %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden mt-6">
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-700">Registrants</h2>
      <span class="text-xs text-gray-500"><%= pluralize(@dashboard.registrant_count, "person") %></span>
    </div>
    <% if @dashboard.registrants.any? %>
      <div class="overflow-x-auto">
        <%# Below sm the whole table chain reflows to block so each row stacks into
            a labeled card (header hidden; per-cell mobile_label supplies the name).
            At sm+ it returns to a normal sortable table. %>
        <table class="block sm:table w-full border-collapse" data-controller="table-sort">
          <thead class="hidden sm:table-header-group bg-gray-100">
            <tr>
              <% columns = [
                   { index: 0, align: "text-left", parts: [ { label: "First", key: "first" }, { label: "Last", key: "last" } ] },
                   { index: 1, align: "text-left", parts: [ { label: "Primary sector", key: "sector" }, { label: "Primary age group", key: "age" } ] },
                   { label: "Organization", index: 2, align: "text-left" },
                   { label: "Status", index: 3, align: "text-left" },
                   { label: "Location", index: 4, align: "text-left" },
                   { label: "Scholarship", index: 5, align: "text-center" },
                   { label: "CE", index: 6, align: "text-center" }
                 ] %>
              <% columns.each do |col| %>
                <th class="px-4 py-2 <%= col[:align] %> text-xs font-semibold text-gray-700" aria-sort="none">
                  <span class="inline-flex items-center gap-1.5">
                    <% (col[:parts] || [ { label: col[:label] } ]).each_with_index do |part, i| %>
                      <% if i.positive? %><span class="text-gray-300" aria-hidden="true">/</span><% end %>
                      <%= render "shared/sortable_header", label: part[:label], index: col[:index], key: part[:key] %>
                    <% end %>
                  </span>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody class="block sm:table-row-group divide-y divide-gray-100" data-table-sort-target="body">
            <% orgs_by_id = @dashboard.organizations.index_by(&:id) %>
            <% lime_chip_class = "inline-flex items-center whitespace-nowrap rounded-md border border-lime-300 bg-lime-200 px-2 py-0.5 text-xs font-medium text-lime-800" %>
            <%# Per-cell label shown only in the stacked mobile card; the column
                header supplies it at sm+, so it's hidden there. %>
            <% mobile_label = ->(text) { tag.span(text, class: "sm:hidden shrink-0 w-24 pt-0.5 text-xs font-semibold uppercase tracking-wide text-gray-400") } %>
            <% @dashboard.registrants.each do |person| %>
              <% person_orgs = (@dashboard.organization_ids_by_registrant[person.id] || []).filter_map { |org_id| orgs_by_id[org_id] } %>
              <% location = @dashboard.location_label_by_registrant[person.id] %>
              <% person_sectors = @dashboard.primary_sector_names_by_registrant[person.id] || [] %>
              <% person_age_groups = @dashboard.primary_age_group_names_by_registrant[person.id] || [] %>
              <% scholarship = @dashboard.scholarship_by_recipient[person.id] %>
              <% ce_registration = @dashboard.ce_registration_by_registrant[person.id] %>
              <tr class="block sm:table-row hover:bg-blue-50 transition-colors cursor-pointer"
                  onclick="window.location='<%= person_path(person) %>'">
                <%# Card title on mobile (larger, allowed to wrap); plain name cell at sm+. %>
                <td class="block sm:table-cell px-4 pt-3 pb-1 sm:py-1.5 text-sm sm:whitespace-nowrap"
                    data-sort-first="<%= person.first_name.to_s.downcase %>"
                    data-sort-last="<%= person.last_name.to_s.downcase %>">
                  <%= link_to person.name, person_path(person), class: "font-bold text-gray-900 hover:underline text-base sm:text-sm" %>
                </td>
                <%# Primary sector + age group — one column, each independently
                    sortable (data-sort-sector / data-sort-age), mirroring the
                    First/Last name cell. Sector and age-group chips share a single
                    wrapping row. %>
                <td class="flex sm:table-cell gap-3 px-4 py-1 sm:py-1.5 text-sm"
                    data-sort-sector="<%= person_sectors.join(", ").downcase %>"
                    data-sort-age="<%= person_age_groups.join(", ").downcase %>">
                  <%= mobile_label.("Sector / age") %>
                  <div class="min-w-0 flex-1">
                    <% if person_sectors.any? || person_age_groups.any? %>
                      <div class="flex flex-wrap items-center gap-1">
                        <% (person_sectors + person_age_groups).each do |name| %>
                          <span class="<%= lime_chip_class %>"><%= name %></span>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="text-gray-300">—</span>
                    <% end %>
                  </div>
                </td>
                <td class="flex sm:table-cell gap-3 px-4 py-1 sm:py-1.5 text-sm text-gray-600" data-sort-value="<%= person_orgs.map(&:name).join(", ").downcase %>">
                  <%= mobile_label.("Organization") %>
                  <div class="min-w-0 flex-1 break-words">
                    <% if person_orgs.any? %>
                      <% person_orgs.each_with_index do |org, i| %><%= ", " if i.positive? %><%= org.decorate.high_profile_icon %><%= link_to org.name, organization_path(org), class: "hover:underline", onclick: "event.stopPropagation()" %><% end %>
                    <% else %>
                      <span class="text-gray-300">—</span>
                    <% end %>
                  </div>
                </td>
                <% statuses = @dashboard.program_statuses_by_registrant[person.id] || [] %>
                <td class="flex sm:table-cell gap-3 px-4 py-1 sm:py-1.5 text-sm" data-sort-value="<%= statuses.join(", ") %>">
                  <%= mobile_label.("Status") %>
                  <div class="min-w-0 flex-1">
                    <% if statuses.any? %>
                      <span class="flex flex-wrap gap-1">
                        <% statuses.each do |status| %>
                          <%= render "shared/badge",
                                label: status.to_s.titleize,
                                classes: OrganizationDecorator.program_status_classes(status) %>
                        <% end %>
                      </span>
                    <% else %>
                      <span class="text-gray-300">—</span>
                    <% end %>
                  </div>
                </td>
                <td class="flex sm:table-cell gap-3 px-4 py-1 sm:py-1.5 text-sm" data-sort-value="<%= location.to_s.downcase %>">
                  <%= mobile_label.("Location") %>
                  <div class="min-w-0 flex-1">
                    <% if location.present? %>
                      <%= render "shared/badge",
                            label: location,
                            classes: "bg-slate-100 text-slate-700 border-slate-200" %>
                    <% else %>
                      <span class="text-gray-300">—</span>
                    <% end %>
                  </div>
                </td>
                <% participant_slug = @dashboard.registration_slug_by_registrant[person.id] %>
                <td class="flex sm:table-cell items-center gap-3 px-4 py-1 sm:py-1.5 text-sm sm:text-center" data-sort-value="<%= scholarship ? 1 : 0 %>">
                  <%= mobile_label.("Scholarship") %>
                  <% if scholarship %>
                    <%= link_to recipients_event_path(@event, anchor: ("participant-#{participant_slug}" if participant_slug)),
                                class: "#{DomainTheme.text_class_for(:scholarships, intensity: 600)} hover:#{DomainTheme.text_class_for(:scholarships)}",
                                title: "Scholarship recipient — view application",
                                onclick: "event.stopPropagation()" do %>
                      <i class="fa-solid fa-graduation-cap"></i>
                    <% end %>
                  <% else %>
                    <span class="sm:hidden text-gray-300">—</span>
                  <% end %>
                </td>
                <%# CE: the icon shows for registrants with a CE registration and
                    links to that record's edit page. %>
                <td class="flex sm:table-cell items-center gap-3 px-4 pt-1 pb-3 sm:py-1.5 text-sm sm:text-center" data-sort-value="<%= ce_registration ? 1 : 0 %>">
                  <%= mobile_label.("CE") %>
                  <% if ce_registration %>
                    <%= link_to edit_continuing_education_registration_path(ce_registration),
                                class: "#{DomainTheme.text_class_for(:continuing_education, intensity: 600)} hover:#{DomainTheme.text_class_for(:continuing_education)}",
                                title: "Edit continuing education",
                                onclick: "event.stopPropagation()" do %>
                      <i class="fa-solid fa-certificate"></i>
                    <% end %>
                  <% else %>
                    <span class="sm:hidden text-gray-300">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8 text-sm">No registrants yet.</p>
    <% end %>
  </div>

  <%# ---- Charts & breakdowns (below the list) ---- %>
  <%# Per-row drill-ins: each breakdown row links to the registrant list filtered
      to the people behind it (sectors/states use their named filters, the rest use
      the matching registrant_ids set). %>
  <% primary_sector_paths = @dashboard.primary_sectors.to_h { |s| [ s.name, registrants_event_path(@event, registrant_ids: @dashboard.primary_sector_registrant_ids_by_sector.fetch(s.id, []).join("-")) ] } %>
  <% sector_paths = @dashboard.sectors.to_h { |s| [ s.name, registrants_event_path(@event, sector: s.id) ] } %>
  <% sector_paths["Other"] = registrants_event_path(@event, registrant_ids: @dashboard.other_sector_response_registrant_ids.join("-")) if @dashboard.other_sector_response_count.positive? %>
  <% age_group_paths = @dashboard.age_groups.to_h { |c| [ c.name, registrants_event_path(@event, registrant_ids: @dashboard.age_group_registrant_ids_by_category.fetch(c.id, []).join("-")) ] } %>
  <% all_age_group_paths = @dashboard.all_age_groups.to_h { |c| [ c.name, registrants_event_path(@event, registrant_ids: @dashboard.all_age_group_registrant_ids_by_category.fetch(c.id, []).join("-")) ] } %>
  <% state_paths = @dashboard.states.index_with { |state| registrants_event_path(@event, state: state) } %>
  <% country_paths = @dashboard.country_registrant_ids_by_country.transform_values { |ids| registrants_event_path(@event, registrant_ids: ids.join("-")) } %>
  <% school_district_paths = @dashboard.school_district_registrant_ids_by_district.transform_values { |ids| registrants_event_path(@event, registrant_ids: ids.join("-")) } %>
  <% life_experience_paths = @dashboard.life_experiences.to_h { |c| [ c.name, registrants_event_path(@event, registrant_ids: @dashboard.life_experience_registrant_ids_by_category.fetch(c.id, []).join("-")) ] } %>
  <% settings_paths = @dashboard.settings.to_h { |c| [ c.name, registrants_event_path(@event, registrant_ids: @dashboard.settings_registrant_ids_by_category.fetch(c.id, []).join("-")) ] } %>
  <% program_status_paths = @dashboard.program_status_registrant_ids.to_h { |status, ids| [ status.to_s.titleize, registrants_event_path(@event, registrant_ids: ids.join("-")) ] } %>
  <%# States and countries use the addresses theme color (slate) for their map ramps. %>
  <% addresses_color = "#475569" %>
  <%# Organizations breakdown rows: distinct-registrant count + scholarship-
      recipient count per org, sorted by registrants desc, each linking to its
      filtered registrant list. %>
  <% org_rows = @dashboard.organizations.map { |o|
       { name: o.name,
         high_profile: o.high_profile?,
         count: @dashboard.organization_counts.fetch(o.id, 0),
         scholarship_count: @dashboard.scholarship_recipient_count_by_org.fetch(o.id, 0),
         path: background_return_path(registrants_event_path(@event, registrant_ids: @dashboard.organization_registrant_ids_by_org.fetch(o.id, []).to_a.join("-")), "all-organizations") }
     }.sort_by { |row| -row[:count] } %>
  <%# Two-slice % pies for row 1: scholarship recipients and CE as a share of all
      registrants. Each slice links into its filtered registrant list. %>
  <%# Complement id lists so the "No …" slices link to everyone outside the slice. %>
  <% all_registrant_ids = @dashboard.registrants.map(&:id) %>
  <% non_scholarship_ids = all_registrant_ids - @dashboard.scholarship_registrants.map(&:id) %>
  <% non_ce_ids = all_registrant_ids - ce_registrant_ids %>
  <% scholarship_pie_data = [ [ "Scholarship", @dashboard.scholarship_recipient_count ], [ "No scholarship", @dashboard.registrant_count - @dashboard.scholarship_recipient_count ] ] %>
  <% scholarship_pie_paths = {
       "Scholarship" => recipients_event_path(@event),
       "No scholarship" => registrants_event_path(@event, registrant_ids: non_scholarship_ids.join("-")) } %>
  <% ce_pie_data = [ [ "CE", ce_registrant_ids.size ], [ "No CE", @dashboard.registrant_count - ce_registrant_ids.size ] ] %>
  <% ce_pie_paths = {
       "CE" => registrants_event_path(@event, registrant_ids: ce_registrant_ids.join("-")),
       "No CE" => registrants_event_path(@event, registrant_ids: non_ce_ids.join("-")) } %>
  <%# Scholarship (fuchsia) and CE (teal) fill their first slice; the remainder is neutral gray. %>
  <% scholarship_pie_palette = %w[#c026d3 #e5e7eb] %>
  <% ce_pie_palette = %w[#14b8a6 #e5e7eb] %>
  <%# Three columns share four subgrid row tracks so cards line up in height across
      columns: % pies (row 1), primary breakdowns (row 2), the "all" lists (row 3),
      and locations (row 4). "All organizations" spans rows 2–3 (2× tall) to fill
      the primary+all stack beside it. Secondary breakdowns flow below. %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
    <%# Col 1: scholarships % → primary sector → all sectors → countries %>
    <div class="flex flex-col gap-6 lg:grid lg:grid-rows-subgrid lg:row-span-4">
      <% if @dashboard.registrant_count.positive? %>
        <%= render "breakdown_card", title: "Scholarships", data: scholarship_pie_data, chart: :pie, palette: scholarship_pie_palette, row_paths: scholarship_pie_paths %>
      <% end %>
      <%= render "breakdown_card", title: "Primary sector", data: primary_sector_data, chart: :pie, palette: palette,
                                   empty_message: "No sector responses from registration answers yet.", row_paths: primary_sector_paths %>
      <% if sector_data.any? %>
        <%= render "breakdown_card", title: "All sectors", data: sector_data, chart: :pie, palette: palette, row_paths: sector_paths %>
      <% end %>
      <% if country_data.any? %>
        <%= render "breakdown_card", title: "Countries", data: country_data, chart: :world_map, palette: palette, map_color: addresses_color, row_paths: country_paths %>
      <% end %>
    </div>
    <%# Col 2: CE % → primary age group → all age groups → states %>
    <div class="flex flex-col gap-6 lg:grid lg:grid-rows-subgrid lg:row-span-4">
      <% if @dashboard.registrant_count.positive? %>
        <%= render "breakdown_card", title: "Continuing education", data: ce_pie_data, chart: :pie, palette: ce_pie_palette, row_paths: ce_pie_paths %>
      <% end %>
      <%= render "breakdown_card", title: "Primary age group", data: age_group_data, chart: :pie, palette: palette,
                                   empty_message: "No age group responses from registration answers yet.", row_paths: age_group_paths %>
      <%# Row 3 splits into two stacked cards so School districts fills the space the
          short "All age groups" pie leaves beside the tall "All sectors" list. %>
      <% if all_age_group_data.any? || school_district_data.any? %>
        <div class="flex flex-col gap-6">
          <% if all_age_group_data.any? %>
            <%= render "breakdown_card", title: "All age groups", data: all_age_group_data, chart: :pie, palette: palette, row_paths: all_age_group_paths %>
          <% end %>
          <% if school_district_data.any? %>
            <%= render "breakdown_card", title: "School districts (via Address data)", data: school_district_data, chart: :bar, palette: palette, row_paths: school_district_paths %>
          <% end %>
        </div>
      <% end %>
      <% if state_data.any? %>
        <%= render "breakdown_card", title: "States", data: state_data, chart: :map, palette: palette, map_color: addresses_color, row_paths: state_paths %>
      <% end %>
    </div>
    <%# Col 3: org/program status → all organizations (2× tall) → all cities %>
    <div class="flex flex-col gap-6 lg:grid lg:grid-rows-subgrid lg:row-span-4">
      <% if program_status_data.any? %>
        <%= render "breakdown_card", title: "Organization/program status", data: program_status_data, chart: :pie, palette: program_status_palette, row_paths: program_status_paths %>
      <% end %>
      <% if org_rows.any? %>
        <%= render "events/organizations_breakdown", org_rows: org_rows, extra_class: "lg:row-span-2" %>
      <% end %>
      <% if @dashboard.registrant_city_breakdown.any? %>
        <%= render "events/registrant_city_breakdown", breakdown: @dashboard.registrant_city_breakdown, metrics: :both, title: "All cities", return_anchor: "all-cities" %>
      <% end %>
    </div>
    <%# --- Secondary breakdowns flow below the three aligned columns --- %>
    <%# The free-text values behind the "Other" sector slice — a list, since these
        are un-curated answers a curator later promotes into real sectors. %>
    <% if other_response_data.any? %>
      <%= render "breakdown_card", title: "Other sector responses", data: other_response_data, chart: nil, palette: palette, row_paths: other_response_paths %>
    <% end %>
    <%# Life experiences and settings come from registration answers; hide each
        card entirely when no one has answered those questions. %>
    <% if life_experience_data.any? %>
      <%= render "breakdown_card", title: "Life experiences", data: life_experience_data, chart: :bar, palette: palette, row_paths: life_experience_paths %>
    <% end %>
    <% if settings_data.any? %>
      <%= render "breakdown_card", title: "Settings", data: settings_data, chart: :bar, palette: palette, row_paths: settings_paths %>
    <% end %>
  </div>
</div>
</div>

<%#
  Event checklist panel — the admin's auto-detected to-do list for the whole event
  lifecycle, shown under the headcount cards on the dashboard. Outstanding work sits
  at the top grouped by phase; satisfied / not-applicable items collapse below.
  Locals: checklist (EventChecklist).
%>
<%
  done = checklist.done_count
  relevant = checklist.relevant_count
  progress = relevant.positive? ? (done * 100 / relevant) : 0
  resolved_done = checklist.resolved_items.count(&:done?)
  resolved_na = checklist.resolved_items.size - resolved_done
%>
<div class="mt-3 sm:mt-4 rounded-xl border <%= DomainTheme.border_class_for(:event_dashboard, intensity: 200) %> <%= DomainTheme.bg_class_for(:event_dashboard, intensity: 50) %> p-4 sm:p-5 shadow-sm">
  <div class="flex items-center justify-between gap-2 flex-wrap">
    <div class="flex items-center gap-2 <%= DomainTheme.text_class_for(:event_dashboard, intensity: 600) %> text-sm font-semibold uppercase tracking-wide">
      <i class="fa-solid fa-list-check"></i><span>Event checklist</span>
    </div>
    <div class="flex items-center gap-3">
      <div class="hidden sm:flex items-center gap-2">
        <div class="h-2 w-40 rounded-full bg-gray-200 overflow-hidden">
          <div class="h-full bg-emerald-500" style="width: <%= progress %>%"></div>
        </div>
        <span class="text-xs text-gray-500 tabular-nums"><%= done %> of <%= relevant %> done</span>
      </div>
      <% if checklist.all_clear? %>
        <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-700"><i class="fa-solid fa-circle-check"></i> All caught up</span>
      <% else %>
        <span class="inline-flex items-center gap-1 rounded-full bg-orange-100 px-2.5 py-1 text-xs font-semibold text-orange-700"><i class="fa-solid fa-circle-exclamation"></i> <%= pluralize(checklist.todo_count, "to do") %></span>
      <% end %>
    </div>
  </div>

  <% unless checklist.all_clear? %>
    <div class="mt-4 space-y-4">
      <% EventChecklist::PHASES.each do |phase| %>
        <% phase_items = checklist.todo_items_by_phase[phase] %>
        <% next unless phase_items.present? %>
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mb-1"><%= EventChecklist::PHASE_LABELS[phase] %> · <%= pluralize(phase_items.size, "to do") %></p>
          <div class="rounded-lg border border-gray-100 bg-white divide-y divide-gray-100">
            <% phase_items.each do |item| %>
              <%= render "events/checklist_item", item: item %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if checklist.resolved_items.any? %>
    <details class="group mt-4">
      <summary class="flex items-center gap-2 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden text-xs font-semibold text-gray-500 hover:text-gray-700">
        <i class="fa-solid fa-chevron-right text-[10px] transition-transform group-open:rotate-90"></i>
        Done &amp; not applicable · <%= resolved_done %> done · <%= resolved_na %> n/a
      </summary>
      <div class="mt-2 rounded-lg border border-gray-100 bg-white divide-y divide-gray-100">
        <% checklist.resolved_items.each do |item| %>
          <%= render "events/checklist_resolved_item", item: item %>
        <% end %>
      </div>
    </details>
  <% end %>
</div>

<%= turbo_frame_tag :onboarding_results do %>
  <% day_count = @event.day_count %>
  <% columns = onboarding_columns(@event) %>
  <% align_class = { "left" => "text-left", "center" => "text-center", "right" => "text-right" } %>
  <% current_filter = params[:status_filter].presence || "active" %>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden blur-on-submit" data-controller="column-visibility">
    <div class="flex items-center justify-between gap-4 px-6 py-4 border-b border-gray-100">
      <nav class="inline-flex rounded-lg bg-gray-100 p-0.5 text-sm font-medium" aria-label="Attendance filter">
        <%= link_to onboarding_event_path(@event, status_filter: "active", keyword: params[:keyword].presence, step: params[:step].presence, step_state: params[:step_state].presence),
              data: { turbo_frame: "_top" },
              class: "px-3 py-1 rounded-md transition-colors #{current_filter == "active" ? "bg-white text-gray-800 shadow-sm" : "text-gray-500 hover:text-gray-700"}" do %>
          Active <span class="text-gray-400">(<%= @active_count %>)</span>
        <% end %>
        <%= link_to onboarding_event_path(@event, status_filter: "inactive", keyword: params[:keyword].presence, step: params[:step].presence, step_state: params[:step_state].presence),
              data: { turbo_frame: "_top" },
              class: "px-3 py-1 rounded-md transition-colors #{current_filter == "inactive" ? "bg-white text-gray-800 shadow-sm" : "text-gray-500 hover:text-gray-700"}" do %>
          Inactive <span class="text-gray-400">(<%= @inactive_count %>)</span>
        <% end %>
      </nav>

      <details class="relative">
        <summary class="list-none cursor-pointer select-none inline-flex items-center gap-1.5 rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50">
          <i class="fa-solid fa-table-columns"></i> Columns
        </summary>
        <div class="absolute right-0 z-20 mt-2 w-56 rounded-lg border border-gray-200 bg-white p-3 shadow-lg">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Show columns</p>
          <% onboarding_toggle_entries(@event).each do |key, label| %>
            <label class="flex items-center gap-2 py-1 text-sm text-gray-700 cursor-pointer">
              <input type="checkbox" checked
                     data-action="column-visibility#toggle"
                     data-column-visibility-key-param="<%= key %>"
                     class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-200">
              <%= label %>
            </label>
          <% end %>
        </div>
      </details>
    </div>

    <% if @event_registrations.any? %>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse" data-controller="table-sort">
          <thead class="bg-gray-100">
            <tr>
              <% columns.each_with_index do |column, index| %>
                <% th_classes = [ "px-4 py-2 text-xs font-semibold text-gray-700", align_class[column[:align]] ]
                   th_classes << "sticky left-0 bg-gray-100" if column[:sticky] %>
                <th class="<%= th_classes.join(" ") %>"
                    <%= "data-onboarding-col=#{column[:toggle]}".html_safe if column[:toggle] %>
                    <%= 'aria-sort="none"'.html_safe if column[:sortable] %>>
                  <% if column[:sortable] %>
                    <%= render "shared/sortable_header", label: column[:label], index: index %>
                  <% else %>
                    <%= column[:label] %>
                  <% end %>
                </th>
              <% end %>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-200" data-table-sort-target="body">
            <% @event_registrations.each do |registration| %>
              <%= render "events/onboarding_row",
                    registration: registration,
                    event: @event,
                    columns: columns,
                    day_count: day_count,
                    program_statuses: @program_statuses_by_registrant[registration.registrant_id] %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8">No registrants found.</p>
    <% end %>
  </div>
<% end %>

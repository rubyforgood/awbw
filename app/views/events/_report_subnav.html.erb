<%# Sub-navigation across the participation report and the pages that read the same
    population from a different angle: the year-by-year Details, the people behind
    them (Attendees), those people charted (Breakdowns), and their logged time
    (Sign-ins). Sits on the eyebrow's row, so the tabs read as siblings of the back
    link rather than of the page title.

    Every tab carries the report's own filters forward — the event, the event type,
    and (translated to the index's `event_year`) the time period — so switching angle
    keeps the same events in scope. The current page renders as a non-link underlined
    tab, matching events/_subnav.
    Locals: current (one of :details, :attendees, :breakdowns, :signins). %>
<% report_filters = { event_id: params[:event_id].presence, event_type: params[:event_type].presence }.compact %>
<%# The attendees index has no time_period vocabulary — it narrows by the event's
    calendar year — so the period is translated rather than passed through. %>
<% attendee_filters = report_filters.merge(
     event_year: time_period_to_event_year(params[:time_period].presence || "all_time"),
     attendance_status: EventRegistration::FILTER_ALL,
     event_type: params[:event_type].presence || EventRegistration::FILTER_ALL,
     return_to: "participation"
   ).compact %>
<nav class="flex flex-wrap items-center gap-1" aria-label="Report views">
  <% tabs = [
       { key: :details, label: "Details", path: participation_events_path(report_filters.merge(time_period: params[:time_period].presence).compact) },
       { key: :attendees, label: "Attendees", path: attendees_events_path(attendee_filters) },
       { key: :breakdowns, label: "Breakdowns", path: attendees_events_path(attendee_filters.merge(charts: "open", anchor: "breakdowns")) },
       { key: :signins, label: "Sign-ins", path: signins_events_path(report_filters) }
     ] %>
  <% tabs.each do |tab| %>
    <% if tab[:key] == current %>
      <span aria-current="page" class="text-sm font-semibold text-gray-900 border-b-2 border-indigo-600 px-2 py-1"><%= tab[:label] %></span>
    <% else %>
      <%= link_to tab[:label], tab[:path], class: "text-sm text-gray-500 hover:text-gray-700 border-b-2 border-transparent hover:border-gray-300 px-2 py-1" %>
    <% end %>
  <% end %>
</nav>

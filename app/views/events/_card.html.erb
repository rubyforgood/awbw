<% event = event.decorate %>

<%= tag.div id: dom_id(event, :card),
            class: "relative bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-md
  transition p-4 flex flex-col gap-4" do %>
  <!-- Bookmark -->
  <div class="absolute top-3 right-3 z-20">
    <%= render "bookmarks/editable_bookmark_icon", resource: event.object %>
  </div>

  <!-- 1️⃣ Thumbnail + Title Row -->
  <div class="flex flex-col md:flex-row gap-2">
    <!-- Thumbnail -->
    <%= render "assets/display_image",
               resource: event,
               width: 32, height: 24,
               variant: :index,
               link_to_object: true,
               file: event.display_image %>

    <!-- Title + badges -->
    <div class="flex flex-col gap-2 flex-1 min-w-0 pr-1 mr-4 mt-1">
      <%= link_to event_path(event),
                  class: "hover:underline block leading-tight",
                  data: { turbo_prefetch: false, turbo: false } do %>
        <%= title_with_badges(event).html_safe %>
      <% end %>
    </div>
  </div>

<div class="flex flex-col gap-2 flex-1 min-w-0 pr-1 mr-4 mt-1">
  <div class="text-sm font-medium overflow-hidden text-ellipsis whitespace-nowrap">
    <%= event.rhino_description.to_plain_text %>
  </div>
</div>

  <!-- Location + Virtual event label -->
  <div class="flex flex-wrap items-center gap-x-3 text-sm text-gray-500">
    <% if event.location.present? %>
      <span><%= event.location.name %></span>
    <% end %>
    <% if event.autoshow_videoconference_label && event.videoconference_label.present? %>
      <span><%= event.videoconference_label %></span>
    <% end %>
  </div>

  <!-- END title row -->
  <!-- 2️⃣ TIMES + BUTTONS IN ONE ROW -->
  <div class="times-and-buttons flex flex-wrap items-center justify-between w-full gap-4">
    <!-- LEFT: Times -->
    <div class="text-sm text-gray-700 leading-tight whitespace-pre-line">
      <%= event.times(display_day: true, display_date: true).html_safe %>
    </div>

    <!-- RIGHT: Buttons + Registered -->
    <div class="flex items-center gap-3">
      <% if current_user %>
        <% registered = event.actively_registered?(current_user.person) %>
        <% if allowed_to?(:edit?, event) %>
          <%= link_to "Edit",
                    edit_event_path(event),
                    data: { turbo_frame: "_top"},
                    class: "admin-only bg-blue-100 btn btn-secondary-outline" %>
        <% end %>

        <% if registered %>
          <% registration = event.active_registration_for(current_user.person) %>
          <%= link_to "View your registration", registration_ticket_path(registration.slug),
                      class: "text-sm text-green-700 hover:text-green-900 underline" %>
        <% elsif event.ended? %>
          <span class="text-sm text-gray-500 italic">Event ended</span>
          <% if allowed_to?(:manage?, event) %>
            <%= button_to "Register",
                        event_registrant_registration_path(event_id: event),
                        class: "admin-only bg-blue-100 btn btn-primary-outline" %>
          <% end %>
        <% elsif !event.published? %>
          <span class="admin-only bg-blue-100 p-1 text-sm text-gray-500 italic">Not published</span>
        <% elsif event.registerable? %>
          <%= button_to "Register",
                      event_registrant_registration_path(event_id: event),
                      class: "btn btn-primary-outline" %>
        <% else %>
          <span class="text-sm text-gray-500 italic">Registration closed</span>
        <% end %>

      <% elsif event.registerable? && event.object.forms.exists?(name: "Public Registration") %>
        <%= link_to "Register",
                    new_event_public_registration_path(event),
                    data: { turbo_frame: "_top" },
                    class: "btn btn-primary-outline" %>
      <% end %>
    </div>
  </div>
  <% if current_user %>
    <% registered ||= event.actively_registered?(current_user.person) %>
    <!-- 4️⃣ FULL-WIDTH CALENDAR LINKS ROW -->
    <% if registered %>
      <div class="flex flex-col items-center mt-4 pt-3 border-t border-gray-100">
        <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-2">
          Add to Your Calendar
        </p>

        <div class="social-links flex flex-wrap gap-1 items-center justify-center w-full text-sm text-blue-600 font-medium">
          <%= event.calendar_links %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

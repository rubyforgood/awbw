<% event = event.decorate %>
<% ended = event.ended? %>

<%= tag.div id: dom_id(event, :card),
            class: class_names(
              "relative rounded-2xl shadow-sm transition p-4 flex flex-col gap-4 h-full",
              "bg-gray-100 border border-gray-300 opacity-60": ended,
              "bg-white border border-gray-200 hover:shadow-md": !ended
            ) do %>
  <!-- Bookmark -->
  <div class="absolute top-3 right-3 z-20">
    <%= render "bookmarks/editable_bookmark_icon", resource: event.object %>
  </div>

  <!-- 1️⃣ Thumbnail + Title Row -->
  <div class="flex flex-col md:flex-row gap-2 flex-1">
    <!-- Thumbnail -->
    <%= render "assets/display_image",
               resource: event,
               width: 32, height: 24,
               variant: :index,
               link_to_object: true,
               file: event.display_image %>

    <!-- Title + badges -->
    <div class="flex flex-col gap-2 flex-1 min-w-0 pr-1 mr-4 mt-1">
      <%= link_to event_path(event),
                  class: "hover:underline block leading-tight",
                  data: { turbo_prefetch: false, turbo: false } do %>
        <%= title_with_badges(event).html_safe %>
      <% end %>
    </div>
  </div>

  <!-- Location + Times + Buttons (bottom-aligned group) -->
  <% registered = current_user && event.actively_registered?(current_user.person) %>
  <div class="mt-auto flex flex-col gap-4">
    <div class="text-sm text-gray-700 leading-none">
      <% if event.location.present? %>
        <span><%= event.location.name %></span>
      <% end %>
      <% if event.autoshow_videoconference_label && event.videoconference_label.present? %>
        <span><%= event.videoconference_label %></span>
      <% end %>
      <div class="mt-1"><%= event.times(display_day: true, display_date: true).html_safe %></div>
    </div>

    <div class="flex items-center gap-3">
    <% if allowed_to?(:edit?, event) %>
      <%= link_to "Edit",
                edit_event_path(event),
                data: { turbo_frame: "_top" },
                class: "admin-only bg-blue-100 text-sm text-gray-500 hover:text-gray-700 px-2 py-1" %>
    <% end %>

    <% if registered %>
      <% registration = event.active_registration_for(current_user.person) %>
      <% if registration&.slug.present? %>
      <%= link_to "View registration", registration_ticket_path(registration.slug),
                  data: { turbo_frame: "_top" },
                  class: "btn px-3 py-2 text-xs uppercase leading-tight text-white hover:bg-white event-view-registration-btn",
                  style: "font-family: 'Telefon Bold', sans-serif; background-color: rgb(22, 101, 52); border: 2px solid rgb(22, 101, 52);" %>
      <% end %>
    <% elsif event.ended? %>
      <span class="text-sm text-gray-500 italic">Event ended</span>
      <% if allowed_to?(:manage?, event) %>
        <%= button_to "Register",
                    event_registrant_registration_path(event_id: event),
                    class: "admin-only bg-blue-100 btn btn-primary-outline" %>
      <% end %>
    <% elsif !event.published? %>
      <span class="admin-only bg-blue-100 p-1 text-sm text-gray-500 italic">Not published</span>
    <% elsif event.registerable? %>
      <% if user_signed_in? %>
        <%= button_to "Register",
                    event_registrant_registration_path(event_id: event),
                    class: "btn px-3 py-2 text-xs uppercase leading-tight font-telefon text-accent border-2 border-accent hover:text-white hover:bg-orange-700" %>
      <% elsif event.object.public_registration_enabled? && event.object.event_forms.registration.exists? %>
        <%= link_to "Register",
                    new_event_public_registration_path(event),
                    data: { turbo_frame: "_top" },
                    class: "btn px-3 py-2 text-xs uppercase leading-tight font-telefon text-accent border-2 border-accent hover:text-white hover:bg-orange-700" %>
      <% end %>
    <% else %>
      <span class="text-sm text-gray-500 italic">Registration closed</span>
    <% end %>
    </div>
  </div>
<% end %>

<% event = event.decorate %>
<% ended = event.ended? %>
<% registered = current_user && event.actively_registered?(current_user.person) %>
<% location_text = [ event.location&.name, (event.videoconference_label if event.autoshow_videoconference_label) ].compact_blank.join(" · ") %>
<% datetime = event.card_datetime %>
<% register_class = button_classes(:accent_outline, size: nil, extra: "px-4 py-2 text-sm uppercase leading-tight font-telefon") %>

<%= tag.div id: dom_id(event, :card),
            class: class_names(
              "group relative flex flex-col overflow-hidden rounded-2xl shadow-sm transition duration-200 h-full",
              "bg-gray-100 border border-gray-300 opacity-60": ended,
              "bg-white border #{DomainTheme.border_class_for(:events, intensity: 200)} hover:-translate-y-1 hover:shadow-lg": !ended
            ) do %>
  <!-- Image banner -->
  <div class="relative aspect-video w-full overflow-hidden <%= DomainTheme.bg_class_for(:events, intensity: 50) %>">
    <%= link_to event_path(event),
                class: "block h-full w-full",
                data: { turbo_frame: "_top", turbo_prefetch: false, turbo: false } do %>
      <%= render "assets/display_image",
                 resource: event,
                 variant: :banner,
                 width: "full", height: "full",
                 link_to_object: false,
                 extra_image_classes: "transition duration-500 group-hover:scale-105",
                 file: event.display_image %>
    <% end %>

    <!-- Bookmark -->
    <div class="absolute top-3 right-3 z-10">
      <div class="rounded-full bg-white/85 p-1 shadow-sm backdrop-blur">
        <%= render "bookmarks/editable_bookmark_icon", resource: event.object %>
      </div>
    </div>
  </div>

  <!-- Content -->
  <div class="flex flex-1 flex-col gap-3 p-4">
    <%= link_to event_path(event),
                class: "block hover:underline leading-tight",
                data: { turbo_prefetch: false, turbo: false } do %>
      <%= title_with_badges(event).html_safe %>
    <% end %>

    <div class="mt-auto flex items-end justify-between gap-3">
      <!-- When + where -->
      <div class="min-w-0 text-sm leading-snug">
        <div class="flex flex-wrap items-baseline gap-x-2">
          <span class="font-medium whitespace-nowrap text-gray-900"><%= datetime[:date] %></span>
          <span class="whitespace-nowrap text-gray-500"><%= datetime[:time] %></span>
        </div>
        <% if location_text.present? %>
          <div class="mt-1 font-medium <%= DomainTheme.text_class_for(:events, intensity: 700) %>"><%= location_text %></div>
        <% end %>
      </div>

      <!-- Actions -->
      <div class="flex shrink-0 flex-col items-end gap-2">
        <% if allowed_to?(:dashboard?, event) %>
          <%= link_to "Dashboard",
                    dashboard_event_path(event),
                    data: { turbo_frame: "_top" },
                    class: "admin-only bg-blue-100 text-sm #{eyebrow_link_class} px-2 py-1" %>
        <% end %>

        <div class="flex items-center gap-3">
          <% if registered %>
            <% if ended %>
              <span class="text-sm text-gray-500 italic">Event ended</span>
            <% end %>
            <% registration = event.active_registration_for(current_user.person) %>
            <% if registration&.slug.present? %>
              <%= link_to "View ticket", registration_ticket_path(registration.slug),
                          data: { turbo_frame: "_top" },
                          class: button_classes(:success, size: nil, extra: "px-4 py-2 text-sm uppercase leading-tight font-telefon") %>
            <% end %>
          <% elsif event.ended? %>
            <span class="text-sm text-gray-500 italic">Event ended</span>
          <% elsif !event.published? %>
            <span class="admin-only bg-blue-100 p-1 text-sm text-gray-500 italic">Not published</span>
          <% elsif event.registerable? %>
            <% if user_signed_in? %>
              <% if event.object.one_click_for_signed_in? %>
                <%= button_to "Register",
                            event_registrant_registration_path(event_id: event),
                            data: { turbo: !event.object.cost_cents.to_i.positive? },
                            class: register_class %>
              <% else %>
                <%= link_to "Register",
                            new_event_public_registration_path(event),
                            data: { turbo_frame: "_top" },
                            class: register_class %>
              <% end %>
            <% elsif event.object.public_registration_enabled? && event.object.event_forms.registration.exists? %>
              <%= link_to "Register",
                          new_event_public_registration_path(event),
                          data: { turbo_frame: "_top" },
                          class: register_class %>
            <% end %>
          <% else %>
            <span class="text-sm text-gray-500 italic">Registration closed</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

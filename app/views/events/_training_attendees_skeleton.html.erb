<div class="rounded-xl bg-white p-6">
  <div class="overflow-x-auto">
    <table class="w-full border-collapse animate-pulse">
      <thead class="bg-gray-100">
        <tr>
          <% %w[Name Sector\ /\ age Organization Status Location Scholarship CE Training].each do |heading| %>
            <th class="px-4 py-2 text-left text-xs font-semibold text-gray-700"><%= heading %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% 8.times do %>
          <tr>
            <% 8.times do %>
              <td class="px-4 py-3"><div class="h-4 w-20 bg-gray-200 rounded"></div></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-6 flex justify-center space-x-2 animate-pulse">
  <div class="h-8 w-10 bg-gray-200 rounded"></div>
  <div class="h-8 w-10 bg-gray-200 rounded"></div>
  <div class="h-8 w-10 bg-gray-200 rounded"></div>
</div>

<% content_for(:page_title, "Bulk Payments — #{@event.title}") %>

<%= render "subnav", event: @event, current: :bulk_payments %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="sm:flex sm:items-center sm:justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Bulk Payments</h1>
    <p class="text-sm text-gray-500 mt-1 sm:mt-0"><%= @submissions.size %> submission<%= "s" unless @submissions.size == 1 %></p>
  </div>

  <% if @submissions.any? %>
    <div class="grid grid-cols-1 gap-3">
      <% @submissions.each do |submission| %>
        <%
          answers_by_identifier = submission.form_answers.select { |a| a.form_field&.field_identifier.present? }
                                                  .index_by { |a| a.form_field.field_identifier }
          payment_method = answers_by_identifier["payment_method"]&.submitted_answer
        %>
        <%
          content_id = "payment-details-#{submission.id}"
          arrow_id = "payment-arrow-#{submission.id}"
        %>
        <div data-controller="dropdown" class="bg-white border border-gray-200 rounded-xl shadow-sm px-4 py-3 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between gap-2">
            <span class="text-sm font-medium text-gray-900 truncate"><%= submission.person.name %></span>
            <span class="text-sm text-gray-500 truncate"><%= submission.person.email %></span>
            <span class="text-sm text-gray-500 shrink-0 text-center"><%= payment_method.presence || "—" %></span>
            <% if submission.payments.any? %>
              <%= link_to payment_path(submission.payments.first),
                          class: "inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800 hover:bg-green-200 shrink-0" do %>
                <i class="fa-solid fa-circle-check text-green-500"></i> Paid
              <% end %>
            <% else %>
              <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800 shrink-0">
                <i class="fa-solid fa-clock text-amber-500"></i> Pending
              </span>
            <% end %>
            <span class="text-sm text-gray-500 whitespace-nowrap shrink-0"><%= submission.created_at.strftime("%b %-d, %Y") %></span>
            <button type="button"
                    data-action="dropdown#toggle"
                    data-dropdown-payload-param='[{"<%= content_id %>":"hidden"}, {"<%= arrow_id %>":"rotate-180"}]'
                    class="text-gray-400 hover:text-gray-600 p-1 shrink-0"
                    title="More info">
              <i id="<%= arrow_id %>" class="fa-solid fa-chevron-down transition-transform duration-200"></i>
            </button>
          </div>
          <div id="<%= content_id %>"
               class="hidden mt-3 pt-3 border-t border-gray-100 space-y-2"
               data-dropdown-target="content">
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-white border border-gray-200 rounded-lg">
      <i class="fa-regular fa-receipt text-4xl text-gray-300 mb-3"></i>
      <p class="text-gray-500">No bulk payment submissions yet.</p>
    </div>
  <% end %>
</div>
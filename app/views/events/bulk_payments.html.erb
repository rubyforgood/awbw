<% content_for(:page_title, "Bulk Payments — #{@event.title}") %>

<%= render "subnav", event: @event, current: :bulk_payments %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="sm:flex sm:items-center sm:justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Bulk Payments</h1>
    <p class="text-sm text-gray-500 mt-1 sm:mt-0"><%= @submissions.size %> submission<%= "s" unless @submissions.size == 1 %></p>
  </div>

  <% if @submissions.any? %>
    <div class="grid grid-cols-1 gap-3">
      <% @submissions.each do |submission| %>
        <%
          answers_by_identifier = submission.form_answers.select { |a| a.form_field&.field_identifier.present? }
                                                  .index_by { |a| a.form_field.field_identifier }
          payment_method = answers_by_identifier["payment_method"]&.submitted_answer
        %>
        <%
          content_id = "payment-details-#{submission.id}"
          arrow_id = "payment-arrow-#{submission.id}"
        %>
        <div data-controller="dropdown" class="bg-white border border-gray-200 rounded-xl shadow-sm px-4 py-3 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between gap-2">
            <span class="text-sm font-medium text-gray-900 truncate"><%= submission.person.name %></span>
            <span class="text-sm text-gray-500 truncate"><%= submission.person.email %></span>
            <span class="text-sm text-gray-500 shrink-0 text-center"><%= payment_method.presence || "—" %></span>
            <% if submission.payments.any? %>
              <%= link_to payment_path(submission.payments.first),
                          class: "inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800 hover:bg-green-200 shrink-0" do %>
                <i class="fa-solid fa-circle-check text-green-500"></i> Paid
              <% end %>
            <% else %>
              <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800 shrink-0">
                <i class="fa-solid fa-clock text-amber-500"></i> Pending
              </span>
            <% end %>
            <span class="text-sm text-gray-500 whitespace-nowrap shrink-0"><%= submission.created_at.strftime("%b %-d, %Y") %></span>
            <button type="button"
                    data-action="dropdown#toggle"
                    data-dropdown-payload-param='[{"<%= content_id %>":"hidden"}, {"<%= arrow_id %>":"rotate-180"}]'
                    class="text-gray-400 hover:text-gray-600 p-1 shrink-0"
                    title="More info">
              <i id="<%= arrow_id %>" class="fa-solid fa-chevron-down transition-transform duration-200"></i>
            </button>
          </div>
          <div id="<%= content_id %>"
               class="hidden mt-3 pt-3 border-t border-gray-100 space-y-3"
               data-dropdown-target="content">
            <div>
              <%= link_to form_submission_path(submission),
                          class: "text-sm text-blue-600 hover:text-blue-800 font-medium inline-flex items-center gap-1",
                          target: "_blank", rel: "noopener noreferrer" do %>
                <i class="fa-solid fa-file-lines text-xs"></i> View submission
              <% end %>
            </div>
            <% if (attendee_matches = @attendee_matches[submission.id]).present? %>
              <div class="border-t border-gray-100 pt-2 space-y-1.5">
                <h4 class="text-xs font-medium text-gray-500 uppercase tracking-wide">Attendee matches</h4>
                <% attendee_matches.each do |am| %>
                  <div class="flex items-start justify-between border-b border-gray-100 last:border-b-0 pb-2 last:pb-0 gap-4">
                    <div class="min-w-0 shrink-0">
                      <span class="text-gray-900 font-medium"><%= am[:first_name] %> <%= am[:last_name] %></span>
                      <div class="text-sm text-gray-500"><%= am[:email] %></div>
                    </div>
                    <div>
                      <% if am[:matches].any? %>
                        <div class="flex flex-col gap-1">
                          <% am[:matches].each do |reg| %>
                            <% matched_person = reg.registrant.decorate %>
                            <%= link_to person_path(reg.registrant),
                                        target: "_blank", rel: "noopener noreferrer",
                                        title: matched_person.name,
                                        class: "group relative flex items-center gap-2 w-64 shrink-0 px-4 py-2 border border-sky-300 bg-sky-100 hover:bg-sky-200 rounded-lg transition-colors duration-200 font-medium shadow-sm leading-none overflow-hidden" do %>
                              <% if matched_person.avatar.present? %>
                                <%= image_tag matched_person.avatar.variant(:thumbnail),
                                              class: "w-10 h-10 rounded-full object-cover border border-gray-300 shadow-sm flex-shrink-0" %>
                              <% else %>
                                <span class="w-10 h-10 rounded-full flex items-center justify-center bg-sky-200 text-sky-700 font-bold text-lg border border-sky-300 shadow-sm flex-shrink-0">
                                  <%= matched_person.name.first.upcase %>
                                </span>
                              <% end %>
                              <div class="flex flex-col leading-tight text-left min-w-0">
                                <span class="font-semibold text-sky-800 truncate"><%= matched_person.name %></span>
                                <% if matched_person.preferred_email.present? %>
                                  <span class="text-xs text-gray-500 font-normal truncate"><%= matched_person.preferred_email %></span>
                                <% end %>
                              </div>
                            <% end %>
                          <% end %>
                        </div>
                      <% else %>
                        <span class="text-gray-400 text-sm">No match</span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-white border border-gray-200 rounded-lg">
      <i class="fa-regular fa-receipt text-4xl text-gray-300 mb-3"></i>
      <p class="text-gray-500">No bulk payment submissions yet.</p>
    </div>
  <% end %>
</div>
<%= form_with url: onboarding_event_path(@event), method: :get,
  data: { controller: "collection", turbo_frame: "onboarding_results" },
  autocomplete: "off",
  class: "flex flex-col md:flex-row md:flex-wrap md:items-end gap-4 mb-6" do %>

  <%= hidden_field_tag :status_filter, params[:status_filter].presence || "active" %>
  <%= hidden_field_tag :hide, params[:hide] if params[:hide].present? %>

  <%= render "shared/filter_text", param: :keyword, label: "Keyword",
        placeholder: "Name, email, phone, city, or organization", submit: true, wrapper_class: "w-full md:w-1/3" %>

  <div class="flex w-full justify-end md:w-auto">
    <%= link_to "Clear", onboarding_event_path(@event, hide: params[:hide].presence),
                class: button_classes(:utility_outline),
                data: { action: "collection#clearAndSubmit" } %>
  </div>
<% end %>

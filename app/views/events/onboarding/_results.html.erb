<%= turbo_frame_tag :onboarding_results do %>
  <% day_count = @event.day_count %>
  <% columns = visible_onboarding_columns(@event, @hidden_columns) %>
  <% align_class = { "left" => "text-left", "center" => "text-center", "right" => "text-right" } %>
  <% current_filter = params[:status_filter].presence || "active" %>
  <% filter_params = { keyword: params[:keyword].presence, hide: params[:hide].presence } %>

  <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm blur-on-submit">
    <div class="flex items-center justify-between gap-4 border-b border-gray-100 px-6 py-4">
      <nav class="inline-flex rounded-lg bg-gray-100 p-0.5 text-sm font-medium" aria-label="Attendance filter">
        <%= link_to onboarding_event_path(@event, status_filter: "active", **filter_params),
              data: { turbo_frame: "_top" },
              class: "px-3 py-1 rounded-md transition-colors #{current_filter == "active" ? "bg-white text-gray-800 shadow-sm" : "text-gray-500 hover:text-gray-700"}" do %>
          Active <span class="text-gray-400">(<%= @active_count %>)</span>
        <% end %>
        <%= link_to onboarding_event_path(@event, status_filter: "inactive", **filter_params),
              data: { turbo_frame: "_top" },
              class: "px-3 py-1 rounded-md transition-colors #{current_filter == "inactive" ? "bg-white text-gray-800 shadow-sm" : "text-gray-500 hover:text-gray-700"}" do %>
          Inactive <span class="text-gray-400">(<%= @inactive_count %>)</span>
        <% end %>
      </nav>

      <%# Server-side column show/hide: each entry links to a reload with the column
          added to / removed from the `hide` param. No client-side toggling. %>
      <details class="relative">
        <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 select-none hover:bg-gray-50">
          <i class="fa-solid fa-table-columns"></i> Columns
        </summary>
        <div class="absolute right-0 z-20 mt-2 w-56 rounded-lg border border-gray-200 bg-white p-3 shadow-lg">
          <p class="mb-2 text-xs font-semibold tracking-wide text-gray-400 uppercase">Show columns</p>
          <% onboarding_toggle_entries(@event).each do |key, label| %>
            <% is_hidden = @hidden_columns.include?(key) %>
            <% new_hide = (is_hidden ? @hidden_columns - [ key ] : @hidden_columns + [ key ]).uniq.join(",") %>
            <%= link_to onboarding_event_path(@event, status_filter: params[:status_filter].presence, keyword: params[:keyword].presence, hide: new_hide.presence),
                  class: "flex items-center gap-2 py-1 text-sm text-gray-700 hover:bg-gray-50 rounded" do %>
              <span class="flex h-4 w-4 items-center justify-center rounded border <%= is_hidden ? "border-gray-300 bg-white" : "border-blue-600 bg-blue-600 text-white" %>">
                <% unless is_hidden %><i class="fa-solid fa-check text-2xs"></i><% end %>
              </span>
              <%= label %>
            <% end %>
          <% end %>
        </div>
      </details>
    </div>

    <% if @event_registrations.any? %>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse" data-controller="table-sort">
          <thead class="bg-gray-100">
            <tr>
              <% columns.each_with_index do |column, index| %>
                <% th_classes = [ "px-4 py-2 text-xs font-semibold text-gray-700", align_class[column[:align]] ]
                   th_classes << "sticky left-0 bg-gray-100" if column[:sticky] %>
                <th class="<%= th_classes.join(" ") %>" <%= 'aria-sort="none"'.html_safe if column[:sortable] %>>
                  <% if column[:sortable] %>
                    <%= render "shared/sortable_header", label: column[:label], index: index %>
                  <% else %>
                    <%= column[:label] %>
                  <% end %>
                  <%# Says which date the column's verdicts were judged on. %>
                  <% if column[:note] %>
                    <i class="fa-solid fa-circle-info text-gray-400 text-[0.65rem] ml-0.5" title="<%= column[:note] %>"></i>
                  <% end %>
                </th>
              <% end %>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-200" data-table-sort-target="body">
            <% @event_registrations.each do |registration| %>
              <%= render "events/onboarding/row",
                    registration: registration,
                    event: @event,
                    columns: columns,
                    day_count: day_count %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="py-8 text-center text-gray-500">No registrants found.</p>
    <% end %>
  </div>
<% end %>

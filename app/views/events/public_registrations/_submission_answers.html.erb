<%# locals: submission, form_fields, responses (defaults to the submission's own), skip_name (a field echoing the form's title) %>
<% responses = local_assigns[:responses] || submission.form_answers.index_by(&:form_field_id) %>
<div class="grid grid-cols-1 md:grid-cols-12 gap-x-4">
  <% form_fields.each do |field| %>
    <% next if field.field_identifier == "confirm_email" %>
    <% next if local_assigns[:skip_name] && field.name.to_s.strip.casecmp?(skip_name.to_s.strip) %>

    <% if field.group_header? %>
      <div class="md:col-span-12 pt-6 pb-2 border-b border-gray-200 mb-4">
        <h3 class="rich-label flex items-center gap-2.5 text-lg font-semibold text-gray-800">
          <span class="<%= form_section_bar_class %>"></span><%= form_label_inline_html(field.name) %>
        </h3>
      </div>
    <% else %>
      <% display_answer_rows(submission, field, responses[field.id]).each do |label, response| %>
        <div class="<%= field.grid_span_class %> pb-8">
          <dt class="rich-label text-xs font-medium text-gray-500 uppercase tracking-wide"><%= form_label_html(label) %></dt>
          <dd class="mt-0.5 text-base font-semibold text-gray-900 whitespace-pre-line"><%= render "shared/form_answer_value", field: field, response: response %></dd>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>

<%#
  One event's attendance totals — a line per reported registrant (per CE licence on
  the CE report) with a "Day N logged" column per event day, and an All row beneath.
  The headline figures a CE board certifies, so it leads the per-event report and is
  the whole of each event's section on the cross-event sign-ins page.
  locals: report (EventAttendanceReport); return_to (origin the row links carry back).
%>
<%# One column template, so the header, the rows and the All row stay aligned. %>
<% day_col = "minmax(5rem,auto) " %>
<% cols = report.ce_only? ?
     "2fr minmax(6rem,1fr) minmax(6rem,auto) #{day_col * report.dates.size}minmax(6rem,auto)" :
     "2fr #{day_col * report.dates.size}minmax(6rem,auto)" %>
<div class="overflow-x-auto rounded-xl border border-teal-200 bg-white shadow-sm">
  <div class="min-w-[40rem]">
    <%# Two-line headers: the caps eyebrow on top, a smaller lowercase qualifier
        below, so the "… logged" columns stay readable when narrow. %>
    <% qualifier = "block normal-case font-normal tracking-normal text-[0.625rem] text-teal-600" %>
    <div class="grid items-end gap-x-3 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-teal-700 bg-teal-50 border-b border-teal-100"
         style="grid-template-columns: <%= cols %>">
      <div>Name</div>
      <% if report.ce_only? %>
        <div>License #</div>
        <div class="text-right leading-tight">Hours<span class="<%= qualifier %>">awarded</span></div>
      <% end %>
      <% report.dates.each_with_index do |_date, index| %>
        <div class="text-right leading-tight">Day <%= index + 1 %><span class="<%= qualifier %>">logged</span></div>
      <% end %>
      <div class="text-right leading-tight">Total<span class="<%= qualifier %>">logged</span></div>
    </div>
    <div class="divide-y divide-teal-50">
      <% report.rows.each do |row| %>
        <% ce_reg = row.ce_registration %>
        <div class="relative grid items-center gap-x-3 px-4 py-2.5 text-sm <%= "hover:bg-teal-50" if ce_reg %>"
             style="grid-template-columns: <%= cols %>">
          <%# Whole row → CE edit page; the name link (z-10, above) → the registrant's
              CE callout page instead. %>
          <% if ce_reg %>
            <%= link_to "", edit_continuing_education_registration_path(ce_reg, return_to: return_to),
                  class: "absolute inset-0", "aria-label": "Edit CE registration for #{row.name}" %>
          <% end %>
          <div class="relative z-10 min-w-0 justify-self-start">
            <% if ce_reg %>
              <%= link_to row.name, registration_ce_path(row.registration.slug, return_to: return_to),
                    class: "font-medium text-gray-900 hover:text-teal-700 hover:underline" %>
            <% else %>
              <%= link_to row.name, edit_event_registration_path(row.registration, return_to: return_to),
                    class: "font-medium text-gray-900 hover:text-teal-700 hover:underline" %>
            <% end %>
          </div>
          <% if report.ce_only? %>
            <div class="text-gray-600 tabular-nums truncate"><%= row.license_number.presence || "—" %></div>
            <div class="text-right text-gray-600 tabular-nums"><%= plain_number(row.hours_awarded) %></div>
          <% end %>
          <% report.dates.each do |date| %>
            <div class="text-right text-gray-700 tabular-nums"><%= attendance_duration_label(report.day_minutes(row, date)) %></div>
          <% end %>
          <div class="text-right font-semibold text-gray-900 tabular-nums"><%= attendance_duration_label(report.total_minutes(row)) %></div>
        </div>
      <% end %>
    </div>
    <div class="grid items-center gap-x-3 px-4 py-3 bg-teal-100 text-sm font-bold text-teal-900"
         style="grid-template-columns: <%= cols %>">
      <div class="uppercase tracking-wide text-xs text-teal-700">All registrants</div>
      <% if report.ce_only? %>
        <div></div>
        <div class="text-right tabular-nums"><%= plain_number(report.total_hours_awarded) %></div>
      <% end %>
      <% report.dates.each do |date| %>
        <div class="text-right tabular-nums"><%= attendance_duration_label(report.day_grand_minutes(date)) %></div>
      <% end %>
      <div class="text-right tabular-nums"><%= attendance_duration_label(report.grand_total_minutes) %></div>
    </div>
  </div>
</div>

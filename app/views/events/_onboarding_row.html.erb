<%# One registrant row on the Onboarding matrix. Iterates the shared column list
    so cell positions line up with the sortable header.
    Locals: registration, event, columns, day_count, program_statuses (array of symbols). %>
<% person = registration.registrant %>
<% align_class = { "left" => "text-left", "center" => "text-center", "right" => "text-right" } %>
<tr id="<%= dom_id(registration, :onboarding_row) %>" class="hover:bg-gray-50 transition-colors duration-150">
  <% columns.each do |column| %>
    <% td_classes = [ "px-4 py-2 text-sm", align_class[column[:align]] ]
       td_classes << "sticky left-0 bg-white" if column[:sticky] %>
    <% case column[:kind]
       when :first_name %>
      <td class="<%= td_classes.join(" ") %> text-gray-800" data-sort-value="<%= person.first_name.to_s.downcase %>">
        <%= link_to person.first_name.presence || "—", person_path(person), class: "font-medium text-gray-800 hover:underline", data: { turbo_prefetch: false, turbo_frame: "_top" } %>
      </td>

    <% when :last_name %>
      <td class="<%= td_classes.join(" ") %> text-gray-800" data-sort-value="<%= person.last_name.to_s.downcase %>">
        <%= person.last_name.presence || content_tag(:span, "—", class: "text-gray-400") %>
      </td>

    <% when :email %>
      <% email = person.preferred_email %>
      <td class="<%= td_classes.join(" ") %> text-gray-600" data-sort-value="<%= email.to_s.downcase %>">
        <% if email.present? %>
          <!--email_off--><span class="text-gray-600"><%= email %></span><!--email_on-->
        <% else %>
          <span class="text-gray-400">—</span>
        <% end %>
      </td>

    <% when :progress %>
      <td class="<%= td_classes.join(" ") %>" data-sort-value="<%= registration.onboarding_completed_count(day_count) %>">
        <%= render "events/onboarding_progress", registration: registration, day_count: day_count %>
      </td>

    <% when :program %>
      <% org_names = registration.organizations.map(&:name) %>
      <td class="<%= td_classes.join(" ") %> text-gray-700" data-sort-value="<%= org_names.join(", ").downcase %>">
        <%= org_names.any? ? truncate(org_names.join(", "), length: 40) : content_tag(:span, "—", class: "text-gray-400") %>
      </td>

    <% when :program_type %>
      <% statuses = Array(program_statuses) %>
      <td class="<%= td_classes.join(" ") %>" data-sort-value="<%= statuses.map(&:to_s).sort.join %>">
        <% if statuses.any? %>
          <div class="flex flex-col items-center gap-1">
            <% statuses.each do |status| %>
              <span class="inline-flex items-center rounded-full text-xs font-medium border px-2.5 py-0.5 <%= OrganizationDecorator.program_status_classes(status) %>"><%= status.to_s.titleize %></span>
            <% end %>
          </div>
        <% else %>
          <span class="text-gray-400">—</span>
        <% end %>
      </td>

    <% when :payment %>
      <% paid_cents = registration.allocations_sum %>
      <% due_cents = event.cost_cents.to_i - paid_cents %>
      <td class="<%= td_classes.join(" ") %>" data-sort-value="<%= due_cents %>">
        <% if registration.paid_in_full? %>
          <span class="inline-flex items-center gap-1 rounded-full text-xs font-medium border px-2.5 py-0.5 bg-green-50 text-green-700 border-green-200"><i class="fas fa-circle-check"></i> Paid</span>
        <% elsif registration.discounted? %>
          <span class="inline-flex items-center gap-1 rounded-full text-xs font-medium border px-2.5 py-0.5 bg-purple-50 text-purple-700 border-purple-200"><i class="fas fa-tag"></i> Discounted</span>
        <% elsif registration.partially_paid? %>
          <span class="inline-flex items-center gap-1 rounded-full text-xs font-medium border px-2.5 py-0.5 bg-blue-50 text-blue-700 border-blue-200">Partial · <%= dollars_from_cents(due_cents) %> due</span>
        <% else %>
          <span class="inline-flex items-center gap-1 rounded-full text-xs font-medium border px-2.5 py-0.5 bg-amber-50 text-amber-700 border-amber-200"><%= dollars_from_cents(due_cents) %> due</span>
        <% end %>
        <% if !registration.paid_in_full? && registration.intends_to_pay? %>
          <div class="mt-1 text-[0.65rem] font-medium text-blue-600"><i class="fa-solid fa-hand-holding-dollar"></i> Intends to pay</div>
        <% end %>
      </td>

    <% when :scholarship %>
      <% scholarship = registration.scholarships.first %>
      <td class="<%= td_classes.join(" ") %>" data-sort-value="<%= scholarship&.amount_cents.to_i %>">
        <% if scholarship %>
          <div class="flex flex-col items-center gap-0.5">
            <span class="font-medium text-gray-800"><%= dollars_from_cents(scholarship.amount_cents) %></span>
            <span class="text-xs text-gray-500"><%= scholarship.grant&.name.presence || "Unfunded" %></span>
          </div>
        <% elsif registration.scholarship_requested? %>
          <span class="inline-flex items-center rounded-full text-xs font-medium border px-2.5 py-0.5 bg-amber-50 text-amber-700 border-amber-200">Requested</span>
        <% else %>
          <span class="text-gray-400">—</span>
        <% end %>
      </td>

    <% when :scholarship_tasks %>
      <% scholarships = registration.scholarships %>
      <% sort_value = scholarships.any? ? (scholarships.all?(&:tasks_completed?) ? 1 : 0) : -1 %>
      <td class="<%= td_classes.join(" ") %>" data-sort-value="<%= sort_value %>">
        <%= render "events/onboarding_cell", registration: registration, field: "scholarship_tasks_completed" %>
      </td>

    <% when :fees_due %>
      <% due_cents = [ event.cost_cents.to_i - registration.allocations_sum, 0 ].max %>
      <td class="<%= td_classes.join(" ") %> font-medium <%= due_cents.zero? ? "text-gray-400" : "text-gray-800" %>" data-sort-value="<%= due_cents %>">
        <%= dollars_from_cents(due_cents) %>
      </td>

    <% when :fee_note %>
      <td class="<%= td_classes.join(" ") %>">
        <%= render "events/onboarding_cell", registration: registration, field: "fee_note" %>
      </td>

    <% when :portal_invite %>
      <td class="<%= td_classes.join(" ") %> align-top" data-sort-value="<%= registration.account_status %>">
        <% if person.user.present? %>
          <%= render "users/confirmed_status", user: person.user, invite_params: {} %>
        <% else %>
          <%= link_to "Create user", new_user_path(person_id: person.id), class: "btn btn-secondary-outline", data: { turbo_frame: "_top" } %>
        <% end %>
      </td>

    <% when :checkbox %>
      <% done = EventRegistration::CHECKLIST_STEPS.key?(column[:field]) ? registration.checklist_step_completed?(column[:field]) : registration.public_send(column[:field]) %>
      <td class="<%= td_classes.join(" ") %>" data-sort-value="<%= done ? 1 : 0 %>">
        <%= render "events/onboarding_cell", registration: registration, field: column[:field] %>
      </td>

    <% when :attendance %>
      <td class="<%= td_classes.join(" ") %>" data-sort-value="<%= registration.status %>">
        <%= render "event_registrations/attendance_status_badge", registration: registration %>
      </td>

    <% when :comments %>
      <% comments = registration.comments %>
      <td class="<%= td_classes.join(" ") %>" data-sort-value="<%= comments.size %>">
        <% if comments.any? %>
          <% latest = comments.first %>
          <%= link_to edit_event_registration_path(registration, return_to: "onboarding"),
                class: "inline-flex items-center gap-1 text-purple-500 hover:text-purple-700",
                title: "#{comments.size} comment#{'s' if comments.size != 1} — Latest (#{latest.created_at.strftime('%Y-%m-%d')}): #{latest.body.truncate(100)}",
                data: { turbo_frame: "_top" } do %>
            <i class="fa-solid fa-message"></i><span class="text-xs"><%= comments.size %></span>
          <% end %>
        <% else %>
          <%= link_to edit_event_registration_path(registration, return_to: "onboarding"),
                class: "text-gray-300 hover:text-gray-500",
                title: "Add a comment",
                data: { turbo_frame: "_top" } do %>
            <i class="fa-regular fa-message"></i>
          <% end %>
        <% end %>
      </td>

    <% when :edit %>
      <td class="<%= td_classes.join(" ") %>">
        <%= link_to edit_event_registration_path(registration, return_to: "onboarding"),
              title: "View #{person.full_name}'s registration for #{event.title}",
              class: "inline-flex items-center shrink-0 rounded-lg border border-gray-300 bg-white px-3 py-2 text-gray-600 shadow-sm hover:bg-gray-50 hover:text-gray-800 transition-colors",
              data: { turbo_frame: "_top" } do %>
          <i class="fa-solid fa-clipboard-list text-gray-400"></i>
        <% end %>
      </td>
    <% end %>
  <% end %>
</tr>

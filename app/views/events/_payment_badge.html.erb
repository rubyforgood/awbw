<% if payment %>
  <% if payment.amount_cents_remaining > 0 %>
    <%= render "shared/badge",
          href: payment_path(payment),
          label: "Paid — #{dollars_from_cents(payment.amount_cents_remaining)} unallocated",
          classes: "bg-orange-100 text-orange-800 border-orange-200",
          icon: "fa-solid fa-circle-exclamation text-orange-500",
          extra: "shrink-0" %>
  <% else %>
    <%= render "shared/badge",
          label: "Fully allocated",
          classes: "bg-green-100 text-green-800 border-green-300",
          icon: "fa-solid fa-circle-check text-green-500",
          extra: "shrink-0" %>
  <% end %>
<% else %>
  <%= render "shared/badge",
        label: "Pending",
        classes: "bg-amber-100 text-amber-800 border-amber-200",
        icon: "fa-solid fa-clock text-amber-500",
        extra: "shrink-0" %>
<% end %>

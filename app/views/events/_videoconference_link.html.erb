<%= tag.div id: dom_id(event.object, :videoconference_link), class: "text-base text-gray-700" do %>
  <% if event.autoshow_videoconference_link && event.videoconference_url.present? %>
    <% if local_assigns.key?(:joinable) %>
      <% show_link = joinable %>
    <% else %>
      <% registration = event.active_registration_for(current_user&.person) %>
      <% show_link = registration&.joinable? %>
    <% end %>
    <% if show_link %>
      <%= link_to "Join on #{event.videoconference_domain}", safe_url(event.videoconference_url), target: "_blank", rel: "noopener noreferrer", class: "underline" %>
      <%= render "events/videoconference_connection", event: event %>
    <% end %>
  <% end %>
<% end %>

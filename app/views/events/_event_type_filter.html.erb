<%# Event-type filter (all events / trainings / other) shared by the
    revenue/participation/reports report forms. `all_label` overrides the
    blank option (revenue lists paid events only). %>
<div class="w-full sm:w-40">
  <label class="block text-xs font-semibold uppercase text-gray-500 tracking-wide mb-1" for="event_type">Event type</label>
  <%= select_tag :event_type,
        options_for_select([ [ "Trainings", "trainings" ], [ "Other", "other" ] ], @event_type),
        include_blank: local_assigns.fetch(:all_label, "All events"),
        class: "w-full bg-white border border-gray-300 rounded-lg px-3 py-2 focus:ring-blue-500 focus:border-blue-500",
        onchange: "this.form.submit()" %>
</div>

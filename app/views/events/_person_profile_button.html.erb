<%# Compact person profile button — an avatar circle inside a button box styled
    like the profile cards used elsewhere (sky border/fill), linking to the
    person's profile page and sized to a single button row (as tall as the action
    buttons beside it). Pass show_name: true to also render the name next to the
    circle; it defaults to false (circle only).
    Locals: person:, show_name: (optional, default false). %>
<% profile_person = person.decorate %>
<% show_name = local_assigns.fetch(:show_name, false) %>
<%# When opened from a bulk payment tray, carry the origin so the person page's
    back link returns to that tray expanded (see EventHelper#bulk_payments_return_path). %>
<% person_link_params = local_assigns[:return_to] == "bulk_payments" ?
     { return_to: "bulk_payments", event_id: local_assigns[:event]&.id, expand: local_assigns[:expand] } : {} %>
<%= link_to person_path(person, person_link_params),
            title: "#{profile_person.name} — #{person.preferred_email}",
            class: "inline-flex items-center gap-2 shrink-0 rounded-lg border border-sky-300 bg-sky-100 hover:bg-sky-200 px-3 py-2 shadow-sm transition-colors" do %>
  <% if profile_person.avatar.present? %>
    <%= image_tag profile_person.avatar.variant(:thumbnail),
                  class: "h-5 w-5 rounded-full object-cover border border-sky-300" %>
  <% else %>
    <span class="h-5 w-5 rounded-full flex items-center justify-center bg-sky-200 text-sky-700 font-bold text-xs border border-sky-300">
      <%= profile_person.name.first.upcase %>
    </span>
  <% end %>
  <% if show_name %>
    <span class="font-semibold text-sky-800 truncate"><%= profile_person.name %></span>
  <% end %>
<% end %>

<%= turbo_stream.replace "flash_now", partial: "shared/flash_messages" %>

<%= turbo_stream.replace dom_id(@payment, :remaining) do %>
  <%= render "payment_badge", payment: @payment %>
<% end %>

<% unless flash[:alert] %>
  <% target_id = @from_no_match ? "no-match-#{@submission_id}-#{@attendee_index}" : dom_id(@event_registration, :allocation_form) %>
  <%= turbo_stream.replace target_id do %>
    <%= render "attendee_allocation_result",
               person: @event_registration.registrant,
               amount_dollars: @allocated_amount_dollars %>
  <% end %>
<% end %>

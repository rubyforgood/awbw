<%= turbo_stream.replace "flash_now", partial: "shared/flash_messages" %>

<%# Re-render the whole card so the per-registration due/allocated totals, the
    payment badge and allocations table, and the inline allocate boxes (hidden
    once a registration is paid in full) all reflect the new allocation. Kept
    expanded so the admin stays on the row they were working in. %>
<% if @submission %>
  <%= turbo_stream.replace dom_id(@submission, :card) do %>
    <%= render "events/bulk_payment_card", submission: @submission,
          event_registrations: @event_registrations,
          allocated_by_registration: @allocated_by_registration,
          expanded: true %>
  <% end %>
<% end %>

<%# Broadcast the affected registration's refreshed totals to every other card
    that lists the same registrant (a payer can appear in multiple submissions),
    targeting the per-registration amount spans by class so each card keeps its
    own expand state and back-link params. %>
<% if @allocated_registration %>
  <% reg_id = @allocated_registration.id %>
  <% allocated_cents = @allocated_by_registration.fetch(reg_id, 0) %>
  <% remaining_cents = [ @event.cost_cents.to_i - allocated_cents, 0 ].max %>
  <%= turbo_stream.update_all ".js-reg-due-#{reg_id}" do %><%= dollars_from_cents(remaining_cents) %><% end %>
  <%= turbo_stream.update_all ".js-reg-allocated-#{reg_id}" do %><%= dollars_from_cents(allocated_cents) %><% end %>
  <%# Once the registration is fully paid, no card should still offer to allocate to it. %>
  <% if allocated_cents >= @event.cost_cents.to_i %>
    <%= turbo_stream.update_all ".js-reg-allocate-#{reg_id}" do %><% end %>
  <% end %>
<% end %>

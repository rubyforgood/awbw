<%# Paid / All CE segmented toggle on the timesheet pages. Paid is the default (no
    param); All carries ce_payment=all.
    locals: paid_count, all_count (reported lines under each choice). %>
<nav class="inline-flex rounded-lg bg-teal-100 p-0.5 text-xs font-medium" aria-label="CE payment filter">
  <%= link_to ce_payment_toggle_path(all: false),
        class: "px-2.5 py-1 rounded-md transition-colors #{ce_paid_only? ? "bg-white text-gray-800 shadow-sm" : "text-teal-700 hover:text-teal-900"}" do %>
    Paid <span class="text-gray-400">(<%= paid_count %>)</span>
  <% end %>
  <%= link_to ce_payment_toggle_path(all: true),
        class: "px-2.5 py-1 rounded-md transition-colors #{ce_paid_only? ? "text-teal-700 hover:text-teal-900" : "bg-white text-gray-800 shadow-sm"}" do %>
    All CE <span class="text-gray-400">(<%= all_count %>)</span>
  <% end %>
</nav>

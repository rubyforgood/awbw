<% content_for(:page_bg_class, "public") %>
<% content_for(:page_title, "Invoice — #{@event.title}") %>
<%# Eyebrow returns to the payment callout when the registrant came from there,
    falling back to the ticket when reached directly. %>
<% back_path, back_label = case params[:return_to]
   when "payment"
     [registration_payment_path(@event_registration.slug), "Back to payment"]
   else
     [registration_ticket_path(@event_registration.slug), "Back to ticket"]
   end %>
<%= render "events/invoices/actions", back_path: back_path, back_label: back_label %>
<div class="px-4 sm:px-8 py-6 print:p-0">
  <%= render "events/invoices/invoice", invoice: @invoice %>
</div>

<% content_for(:page_bg_class, "public") %>
<% content_for(:page_title, "#{@event.ce_hours_details_label} — #{@event.title}") %>
<%= render layout: "events/registrations/callout_page", locals: { title: @event.ce_hours_details_label } do %>
  <% if @event_registration.ce_credit_requested? %>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-gray-400">Hours requested</dt>
        <dd class="mt-1 text-lg font-semibold text-gray-900 tabular-nums"><%= @event_registration.ce_hours_requested || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-gray-400">Amount due</dt>
        <dd class="mt-1 text-lg font-semibold text-gray-900 tabular-nums"><%= dollars_from_cents(@event_registration.ce_amount_owed_cents) %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-gray-400">License number</dt>
        <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @event_registration.ce_license_number.presence || "—" %></dd>
      </div>
    </dl>
  <% else %>
    <p class="text-sm text-gray-600">You haven't requested continuing education credit for this training. CE hours are available for an additional fee — reach out to request credit.</p>
  <% end %>

  <% if @event.ce_hours_details.present? %>
    <div class="mt-6 border-t border-gray-100 pt-5 rich-label prose max-w-none text-gray-700 leading-relaxed prose-headings:text-gray-800 prose-a:text-blue-700">
      <%= form_label_html(@event.ce_hours_details) %>
    </div>
  <% end %>
<% end %>

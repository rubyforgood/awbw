<% content_for(:page_bg_class, "public") %>
<% content_for(:page_title, "Handouts — #{@event.title}") %>
<%= render layout: "events/registrations/callout_page", locals: { title: "Handouts" } do %>
  <% if @handout_cards.any? %>
    <div class="space-y-3">
      <% @handout_cards.each do |card| %>
        <%= render "event_registrations/callout_card", callout: card %>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-gray-500">Training handouts will be available here soon.</p>
  <% end %>
<% end %>

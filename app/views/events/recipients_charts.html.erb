<%# Lazily-loaded charts frame for the scholarship-recipients page — the
    breakdown queries run only when the admin reveals the charts panel. The data
    is this event's scholarship recipients (a subset of registrants); each row
    drills in by filtering the recipient cards on the page below. %>
<%= turbo_frame_tag :recipients_charts do %>
  <%= render "events/registrant_breakdowns", data: @breakdowns, context: :recipients, event: @event %>
<% end %>

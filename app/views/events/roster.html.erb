<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<%# Opt out of the layout's max-w-7xl cap to match the wider Manage page;
    the wrapper restores the layout's gutters at a wider bound. %>
<% content_for(:full_width, true) %>
<div class="mx-auto max-w-[96rem] px-2 sm:px-6 lg:px-8">
<div class="<%= DomainTheme.bg_class_for(:events) %> border border-gray-200 rounded-xl shadow p-4 sm:p-6">
  <%# Top bar: back link + sub-nav, matching the other event pages %>
  <div class="flex flex-wrap items-center justify-between gap-2 sm:gap-4 mb-6 print:hidden">
    <%= link_to "← Dashboard", dashboard_event_path(@event), class: "text-sm text-gray-500 hover:text-gray-700" %>
    <%= render "events/subnav", event: @event, current: :roster %>
  </div>
  <% print_button = capture do %>
    <button onclick="window.print();" class="btn btn-utility-outline">
      <i class="fa-solid fa-print"></i> Print
    </button>
  <% end %>
  <%= render "events/report_header",
        title: "Registrant roster",
        icon: "fa-solid fa-users-viewfinder",
        theme: :people,
        event: @event,
        subtitle: pluralize(@dashboard.registrant_count, "active registrant"),
        actions: print_button %>

  <%# ---- At-a-glance counts — one compact "stat bar" of metrics; each segment
      drills into the matching filtered registrant list. Scholarships and CE ride
      along as subtotals of registrants, and states + countries combine into a
      single "Locations" total with per-type subtotals. ---- %>
  <% ps = @dashboard.program_status_counts %>
  <% program_breakdown = @dashboard.organization_count.positive? ? "#{ps[:new]} new · #{ps[:ongoing]} ongoing · #{ps[:reinstated]} reinstated" : nil %>
  <% ce_registrant_ids = @dashboard.ce_registrant_ids %>
  <%# Every stat-bar link returns to the stat bar itself (anchor "overview"). %>
  <% leading_metrics = [
       { label: "Organizations", value: @dashboard.organization_count, icon: "fa-building", theme: :organizations,
         path: roster_return_path(registrants_event_path(@event, registrant_ids: @dashboard.organization_registrant_ids.join("-")), "overview"), sub: program_breakdown },
       { label: "Sectors", value: @dashboard.sectors.size, icon: "fa-hand-holding-heart", theme: :sectors,
         path: roster_return_path(registrants_event_path(@event, registrant_ids: @dashboard.sector_registrant_ids.join("-")), "overview"),
         sub: @dashboard.sectors.any? ? "#{@dashboard.primary_sector_count} primary · #{@dashboard.additional_sector_count} additional" : nil }
     ] %>
  <div id="overview" class="scroll-mt-24 flex flex-wrap items-stretch divide-y sm:divide-y-0 sm:divide-x divide-gray-100 rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
    <%# Registrants, with scholarship recipients and CE as subtotals drilling into their lists. %>
    <div class="flex items-center gap-3 px-4 py-3 grow basis-44">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg <%= DomainTheme.bg_class_for(:people, intensity: 100) %> <%= DomainTheme.text_class_for(:people, intensity: 600) %>">
        <i class="fa-solid fa-users"></i>
      </span>
      <span class="min-w-0">
        <%= link_to roster_return_path(registrants_event_path(@event), "overview"), class: "group/reg block hover:underline leading-tight" do %>
          <span class="text-xl font-bold text-gray-900 tabular-nums"><%= @dashboard.registrant_count %></span>
          <span class="text-xs text-gray-500">Registrants</span>
          <i class="fa-solid fa-arrow-up-right-from-square text-[10px] text-gray-400 opacity-0 group-hover/reg:opacity-100 transition-opacity"></i>
        <% end %>
        <span class="block text-xs text-gray-400 mt-0.5">
          <%= link_to recipients_event_path(@event), class: "hover:underline whitespace-nowrap" do %><%= pluralize(@dashboard.scholarship_recipient_count, "scholarship") %><% end %>
          <span class="text-gray-300" aria-hidden="true">·</span>
          <%= link_to roster_return_path(registrants_event_path(@event, registrant_ids: ce_registrant_ids.join("-")), "overview"), class: "hover:underline whitespace-nowrap" do %><%= ce_registrant_ids.size %> CE<% end %>
        </span>
      </span>
    </div>

    <% leading_metrics.each do |metric| %>
      <%= render "stat_segment", metric: metric %>
    <% end %>

    <%# States + countries + cities combined: a unique-locations total with per-type subtotals. %>
    <% city_rows = @dashboard.registrant_city_breakdown.rows.reject { |row| row.city == RegistrantCityBreakdown::UNKNOWN_LABEL } %>
    <% city_registrant_ids = city_rows.flat_map(&:registrant_ids).uniq %>
    <div class="flex items-center gap-3 px-4 py-3 grow basis-64">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg <%= DomainTheme.bg_class_for(:addresses, intensity: 100) %> <%= DomainTheme.text_class_for(:addresses, intensity: 600) %>">
        <i class="fa-solid fa-earth-americas"></i>
      </span>
      <span class="min-w-0">
        <span class="block leading-tight">
          <span class="text-xl font-bold <%= DomainTheme.text_class_for(:addresses, intensity: 700) %> tabular-nums"><%= @dashboard.states.size + @dashboard.countries.size + city_rows.size %></span>
          <span class="text-xs <%= DomainTheme.text_class_for(:addresses, intensity: 600) %>">Locations</span>
        </span>
        <span class="block text-xs text-gray-400 mt-0.5">
          <%= link_to roster_return_path(registrants_event_path(@event, registrant_ids: city_registrant_ids.join("-").presence || "0"), "overview"), class: "hover:underline whitespace-nowrap" do %><%= pluralize(city_rows.size, "city") %><% end %>
          <span class="text-gray-300" aria-hidden="true">·</span>
          <%= link_to roster_return_path(registrants_event_path(@event, registrant_ids: @dashboard.state_registrant_ids.join("-")), "overview"), class: "hover:underline whitespace-nowrap" do %><%= pluralize(@dashboard.states.size, "state") %><% end %>
          <span class="text-gray-300" aria-hidden="true">·</span>
          <%= link_to roster_return_path(registrants_event_path(@event, registrant_ids: @dashboard.country_registrant_ids.join("-")), "overview"), class: "hover:underline whitespace-nowrap" do %><%= pluralize(@dashboard.countries.size, "country") %><% end %>
        </span>
      </span>
    </div>
  </div>

  <div data-controller="panel-toggle" class="mt-6">
    <%# Toggle bar: hide/show the registrants table and the demographic charts.
        Charts start hidden; revealing the panel loads its lazy Turbo frame on
        first show, so the breakdown queries only run on demand. %>
    <%= render "events/charts_toggle_bar", buttons: [
          { name: "registrants", icon: "fa-table-list", shown_label: "Hide registrants", hidden_label: "Show registrants", expanded: true },
          { name: "charts", icon: "fa-chart-column", shown_label: "Hide charts", hidden_label: "Show charts", expanded: false }
        ] %>

    <%# Registrants panel — shown by default. %>
    <h2 class="text-xl font-bold mb-4 flex items-center gap-2 <%= DomainTheme.text_class_for(:people, intensity: 700) %>">
      <i class="fa-solid fa-users"></i>
      Registrants
    </h2>
    <div data-panel-toggle-target="panel" data-panel-toggle-name="registrants">
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <%= render "events/registrant_roster", roster: @dashboard, row_return_to: "roster" %>
      </div>
    </div>

    <%# Charts panel — hidden by default; the lazy frame loads on first reveal. %>
    <h2 class="text-xl font-bold mt-10 mb-4 flex items-center gap-2 <%= DomainTheme.text_class_for(:people, intensity: 700) %>">
      <i class="fa-solid fa-chart-pie"></i>
      Charts
    </h2>
    <%= render "events/charts_cta" %>
    <div data-panel-toggle-target="panel" data-panel-toggle-name="charts" class="hidden">
      <%= turbo_frame_tag :event_roster_charts, src: roster_event_path(@event), loading: :lazy do %>
        <%= render "events/charts_loading" %>
      <% end %>
    </div>
  </div>
</div>
</div>

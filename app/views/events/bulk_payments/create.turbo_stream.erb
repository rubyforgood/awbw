<%= turbo_stream.replace "flash_now", partial: "shared/flash_messages" %>

<% unless flash[:alert] %>
  <%= turbo_stream.replace "payment-card-#{@submission.id}" do %>
    <%= render "events/bulk_payment_card", submission: @submission,
          event_registrations: @event_registrations,
          linked_registrations_by_id: @linked_registrations_by_id,
          allocated_by_registration: @allocated_by_registration,
          expanded: true %>
  <% end %>
<% end %>

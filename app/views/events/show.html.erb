<% content_for(:page_bg_class, "admin-or-public-or-authpublished") %>

<!-- Top Right Actions -->
<div class="flex flex-wrap justify-end gap-2">
  <%= link_to "Home", root_path, class: "text-sm text-gray-500 hover:text-gray-700 px-2 py-1" %>
  <%= link_to "Events", events_path, class: "text-sm text-gray-500 hover:text-gray-700 px-2 py-1" %>
  <% if allowed_to?(:edit?, @event) %>
    <%= link_to "Edit", edit_event_path(@event), class: "text-sm text-gray-500 hover:text-gray-700 px-2 py-1 admin-only bg-blue-100" %>
  <% end %>
  <span class="inline-block text-sm"><%= render "bookmarks/editable_bookmark_button", resource: @event.object %></span>
</div>

<%# ---- HEADER CONTENT ---- %>
<% if @event.rhino_header.present? %>
  <div class="rhino-centered prose max-w-none prose-img:max-w-full prose-img:w-full prose-strong:text-inherit prose-em:text-inherit mb-4">
    <%= @event.rhino_header %>
  </div>
<% end %>

<%# ---- TITLE ---- %>
<% if @event.autoshow_title %>
  <div class="text-center mb-4 max-w-2xl mx-auto">
    <% if @event.pre_title.present? %>
      <p class="text-3xl text-base font-semibold font-telefon text-gray-700 mb-2" style="font-family: 'Telefon Bold', sans-serif"><%= @event.pre_title %></p>
    <% end %>
    <h1 class="text-4xl font-bold text-green-800" style="font-family: Lato, sans-serif"><%= @event.title %></h1>
  </div>
<% end %>

<%# ---- EVENT DETAILS (conditional on autoshow) ---- %>
<div class="text-center space-y-2 mb-4">
  <% if @event.autoshow_date || @event.autoshow_time %>
    <div class="text-3xl font-bold text-blue-900 uppercase" style="font-family: Lato, sans-serif">
      <%= @event.times(display_day: @event.autoshow_date, display_date: @event.autoshow_date, styled: true) %>
    </div>
  <% end %>

  <% if @event.autoshow_cost && @event.labelled_cost %>
    <div class="text-xl font-bold text-blue-900 uppercase" style="font-family: Lato, sans-serif"><%= @event.labelled_cost %></div>
  <% end %>

  <% if @event.autoshow_location && @event.location.present? %>
    <div class="text-base text-gray-700"><%= @event.location.name %></div>
  <% end %>

  <%= render "events/videoconference_link", event: @event %>

  <% if @event.registration_close_date %>
    <div class="text-base text-gray-700">
      Registration closes <%= @event.registration_close_date.in_time_zone(Time.zone).strftime("%B %-d, %Y %l:%M %P %Z") %>
    </div>
  <% end %>

  <% if @event.autoshow_registration %>
    <div class="mt-4">
      <%= render "events/registration_section", event: @event, instance: 1, button_text: "Register Now" %>
    </div>
  <% end %>
</div>

<%# ---- DESCRIPTION ---- %>
<% if @event.rhino_description.present? %>
  <div class="prose max-w-none prose-img:max-w-full prose-img:w-full prose-strong:text-inherit prose-em:text-inherit mb-12">
    <%= @event.rhino_description %>
  </div>
<% end %>

<%# ---- GALLERY IMAGES ---- %>
<div class="mb-12">
  <%= render "assets/display_gallery_media", resource: @event, link: true %>
</div>

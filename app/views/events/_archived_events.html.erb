<%# Compact linked list of admin-only events kept off the cards grid: unpublished
    drafts and events that ended more than a month ago. %>
<div class="admin-only mt-10 rounded-lg bg-blue-100 p-4">
  <h2 class="mb-3 text-lg font-semibold text-gray-700">Drafts and past events</h2>
  <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
    <% events.each do |event| %>
      <% event = event.decorate %>
      <% unreconciled_count = local_assigns.fetch(:unreconciled_counts, {})[event.id].to_i %>
      <%# The title link stretches over the whole row (after:inset-0) so the row
          stays clickable; the chip sits above it (relative z-10) because links
          can't nest. %>
      <li class="relative flex items-center justify-between gap-4 px-4 py-2.5 hover:bg-gray-50">
        <%= link_to event.title, event_path(event),
                    class: "min-w-0 truncate text-sm font-medium text-gray-800 hover:underline after:absolute after:inset-0",
                    data: { turbo_prefetch: false, turbo: false } %>
        <span class="flex shrink-0 items-center gap-3 text-xs text-gray-500">
          <% if unreconciled_count.positive? && allowed_to?(:dashboard?, event) %>
            <span class="relative z-10"><%= render "events/unreconciled_chip", event: event, count: unreconciled_count %></span>
          <% end %>
          <span><%= event.short_date_range %></span>
          <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-600">
            <%= event.archive_status_label %>
          </span>
        </span>
      </li>
    <% end %>
  </ul>
</div>

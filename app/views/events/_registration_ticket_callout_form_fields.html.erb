<%# One linked-form row: the form to deliver plus its optional display date,
    added another at a time (cocoon), mirroring the linked-resources rows. A blank
    date shows the form right away; a future date drips it open on that date. %>
<div class="nested-fields flex items-start gap-2">
  <div class="grid min-w-0 flex-1 grid-cols-1 gap-2 sm:grid-cols-2">
    <%= f.select :form_id,
          options_from_collection_for_select(@callout_forms, :id, :name, f.object.form_id),
          { include_blank: "Select a form…" },
          class: "rounded border-gray-300 bg-white shadow-sm px-2 py-1 text-sm" %>
    <%= f.date_field :display_from,
          class: "rounded border-gray-300 bg-white shadow-sm px-2 py-1 text-sm" %>
  </div>
  <%= link_to_remove_association "✖", f,
        class: "shrink-0 text-gray-400 hover:text-red-600 font-bold text-xs pt-1.5" %>
</div>

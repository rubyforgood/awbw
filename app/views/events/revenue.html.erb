<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<% content_for(:full_width, true) %>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
  <div class="<%= DomainTheme.bg_class_for(:events) %> border border-gray-200 rounded-xl shadow p-6">
    <div class="mb-6">
      <%= link_to "← Events", events_path,
            class: "text-sm font-medium #{DomainTheme.text_class_for(:events, intensity: 700)} hover:underline" %>
    </div>

    <div class="mb-6">
      <h1 class="text-2xl font-semibold text-gray-900">Event revenue</h1>
      <p class="text-gray-600 mt-1">
        Money behind each facilitator training: registration payments, CE fees, scholarships, and what's still outstanding.
      </p>
      <p class="text-xs text-gray-500 mt-2">
        CE fees are shown as the amount owed ($<%= EventRegistration::CE_HOURLY_RATE_DOLLARS %> per requested hour); none are collected yet, so the full CE fee counts as outstanding.
      </p>
    </div>

    <% if @report.rows.any? %>
      <div class="overflow-x-auto rounded-lg border border-gray-200">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
            <tr>
              <th scope="col" class="px-4 py-3 text-left font-semibold">Event</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Registration payments</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">CE fees</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Scholarships (funded)</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Scholarships (unfunded)</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Outstanding</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Total monies (excl. unfunded)</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Total monies</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <% @report.rows.each do |row| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <%= link_to dashboard_event_path(row.event), class: "font-medium #{DomainTheme.text_class_for(:events, intensity: 700)} hover:underline" do %>
                    <%= row.event.title %>
                  <% end %>
                  <div class="text-xs text-gray-500"><%= row.event.date_range %></div>
                </td>
                <td class="px-4 py-3 text-right tabular-nums"><%= dollars_from_cents(row.registration_payments_cents) %></td>
                <td class="px-4 py-3 text-right tabular-nums"><%= dollars_from_cents(row.ce_fees_cents) %></td>
                <td class="px-4 py-3 text-right tabular-nums"><%= dollars_from_cents(row.funded_scholarship_cents) %></td>
                <td class="px-4 py-3 text-right tabular-nums"><%= dollars_from_cents(row.unfunded_scholarship_cents) %></td>
                <td class="px-4 py-3 text-right tabular-nums text-amber-700"><%= dollars_from_cents(row.outstanding_cents) %></td>
                <td class="px-4 py-3 text-right tabular-nums"><%= dollars_from_cents(row.total_monies_excluding_unfunded_cents) %></td>
                <td class="px-4 py-3 text-right tabular-nums font-semibold"><%= dollars_from_cents(row.total_monies_cents) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-gray-50 font-semibold text-gray-900">
            <tr>
              <td class="px-4 py-3 text-left">Total</td>
              <td class="px-4 py-3 text-right tabular-nums"><%= dollars_from_cents(@report.registration_payments_cents) %></td>
              <td class="px-4 py-3 text-right tabular-nums"><%= dollars_from_cents(@report.ce_fees_cents) %></td>
              <td class="px-4 py-3 text-right tabular-nums"><%= dollars_from_cents(@report.funded_scholarship_cents) %></td>
              <td class="px-4 py-3 text-right tabular-nums"><%= dollars_from_cents(@report.unfunded_scholarship_cents) %></td>
              <td class="px-4 py-3 text-right tabular-nums text-amber-700"><%= dollars_from_cents(@report.outstanding_cents) %></td>
              <td class="px-4 py-3 text-right tabular-nums"><%= dollars_from_cents(@report.total_monies_excluding_unfunded_cents) %></td>
              <td class="px-4 py-3 text-right tabular-nums"><%= dollars_from_cents(@report.total_monies_cents) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12 text-gray-500">
        No facilitator trainings to report on yet.
      </div>
    <% end %>
  </div>
</div>

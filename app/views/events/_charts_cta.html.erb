<%# In-section prompt to reveal the charts panel, sitting under the "Charts"
    header. It's a second control for the same panel as the top toggle bar and
    hides itself once the charts show (see panel-toggle's CTA behaviour). %>
<button type="button"
        data-panel-toggle-target="button"
        data-panel-toggle-name="charts"
        data-panel-toggle-cta="true"
        data-action="panel-toggle#toggle"
        aria-expanded="false"
        class="mb-6 inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-800 print:hidden">
  <i class="fa-solid fa-chart-column"></i>
  Show charts
</button>

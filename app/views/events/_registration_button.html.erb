<%
  # ActionText passes the record using model_name.element as the variable via :as option
  event = event.decorate if event&.respond_to?(:decorate)
%>

<span class="inline-event-registration">
  <% if event.nil? %>
    <span class="text-xs text-red-500">No event</span>
  <% elsif Current.user.nil? %>
    <span class="text-xs text-gray-500">Login to register</span>
  <% elsif event.event_registrations.exists?(registrant_id: Current.user.person_id) %>
    <%= button_to "De-register",
                event_registrant_registration_path(event_id: event),
                method: :delete,
                data: { turbo_confirm: "Are you sure?", turbo: false},
                class: "btn btn-secondary-outline text-sm" %>
    <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full">Registered</span>
  <% elsif event.ended? %>
    <span class="text-sm text-gray-500 italic">Event ended</span>
    <% if allowed_to?(:manage?, event) %>
      <%= button_to "Register",
                  event_registrant_registration_path(event_id: event),
                  data: {turbo: false},
                  class: "admin-only bg-blue-100 btn btn-primary-outline text-sm" %>
    <% end %>
  <% elsif !event.published? %>
    <span class="admin-only bg-blue-100 p-1 text-sm text-gray-500 italic">Not published</span>
  <% elsif event.registerable? %>
    <%= button_to "Register",
                event_registrant_registration_path(event_id: event),
                class: "btn btn-primary-outline text-sm" %>
  <% else %>
    <span class="text-sm text-gray-500 italic">Registration closed</span>
  <% end %>
</span>

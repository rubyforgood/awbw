<%# Approved / All CE toggle on the timesheet pages. The first is the
    default (no param); All carries ce_approval=all.
    locals: approved_count, all_count (reported lines under each choice). %>
<nav class="inline-flex rounded-lg bg-teal-100 p-0.5 text-xs font-medium" aria-label="CE approval filter">
  <%= link_to ce_approval_toggle_path(all: false),
        class: "px-2.5 py-1 rounded-md transition-colors #{ce_approved_only? ? "bg-white text-gray-800 shadow-sm" : "text-teal-700 hover:text-teal-900"}" do %>
    Approved <span class="text-gray-400">(<%= approved_count %>)</span>
  <% end %>
  <%= link_to ce_approval_toggle_path(all: true),
        class: "px-2.5 py-1 rounded-md transition-colors #{ce_approved_only? ? "text-teal-700 hover:text-teal-900" : "bg-white text-gray-800 shadow-sm"}" do %>
    All CE <span class="text-gray-400">(<%= all_count %>)</span>
  <% end %>
</nav>

<%# Per-person onboarding completion bar. Locals: registration, day_count. %>
<% done = registration.onboarding_completed_count(day_count) %>
<% total = registration.onboarding_total_count(day_count) %>
<% pct = total.zero? ? 0 : (done * 100.0 / total).round %>
<span id="<%= dom_id(registration, :onboarding_progress) %>" class="inline-flex flex-col items-center gap-1 w-20">
  <span class="text-xs font-medium <%= pct == 100 ? "text-green-700" : "text-gray-700" %>"><%= done %>/<%= total %></span>
  <span class="block w-full h-1.5 rounded-full bg-gray-200 overflow-hidden">
    <span class="block h-full rounded-full <%= pct == 100 ? "bg-green-500" : "bg-blue-500" %>" style="width: <%= pct %>%"></span>
  </span>
</span>

<div class="overflow-hidden rounded-lg border <%= DomainTheme.border_class_for(:payments) %> <%= DomainTheme.bg_class_for(:payments) %>" data-controller="conditional-fields">
  <div class="px-3 py-2 text-xs font-medium tracking-wide uppercase <%= DomainTheme.bg_class_for(:payments, intensity: 100) %> <%= DomainTheme.text_class_for(:payments, intensity: 700) %>">Add payment</div>

  <%= form_tag bulk_payments_event_path(@event), class: "p-3" do %>
    <%= hidden_field_tag :submission_id, submission.id %>
    <%= hidden_field_tag :currency, "usd" %>

    <div class="grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2">
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">Payment Type</label>
        <%= select_tag :payment_type,
             options_for_select([["Cash", "CashPayment"], ["Check", "CheckPayment"]]),
             prompt: "Select type...",
             data: { conditional_fields_target: "source", action: "change->conditional-fields#toggle" },
             class: "bg-white w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>

      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">Amount ($)</label>
        <%= number_field_tag :amount_dollars, nil,
             step: "0.01", min: "0.01", placeholder: "0.00",
             class: "bg-white w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500",
             data: { controller: "currency-input", action: "currency-input#format" } %>
      </div>

      <div data-conditional-fields-target="field" data-show-when="CheckPayment">
        <label class="mb-1 block text-sm font-medium text-gray-700">Check Number</label>
        <%= text_field_tag :check_number, nil,
             class: "bg-white w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500",
             placeholder: "Check #" %>
      </div>

      <div data-conditional-fields-target="field" data-show-when="CheckPayment">
        <label class="mb-1 block text-sm font-medium text-gray-700">Memo</label>
        <%= text_field_tag :memo, nil,
             class: "bg-white w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500",
             placeholder: "Optional" %>
      </div>
    </div>

    <div class="mt-4 grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2">
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">Payer</label>
        <%= select_tag :payer_sgid, nil,
             prompt: "Search people and organizations",
             required: true,
             data: { controller: "remote-select", remote_select_model_value: "person_or_organization" },
             class: "bg-white w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
        <p class="mt-1 text-xs text-gray-500">Whose account is the money coming from?</p>
      </div>

      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">Additional designation</label>
        <%= select_tag :additional_designation_sgid, nil,
             prompt: "Search people and organizations",
             include_blank: true,
             data: { controller: "remote-select", remote_select_model_value: "person_or_organization" },
             class: "bg-white w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="mt-4 flex gap-2">
      <%= button_tag class: button_classes(:success, extra: "inline-flex items-center gap-1.5") do %>
        <i class="fa-solid fa-plus text-xs"></i>
        Create payment
      <% end %>
    </div>
  <% end %>
</div>

<div class="bg-green-200 border-2 border-green-400 rounded-lg p-4">
  <h3 class="text-lg font-medium mb-4">Record Payment</h3>
  <%= form_tag create_bulk_payment_event_path(@event) do %>
    <%= hidden_field_tag :submission_id, submission.id %>

    <div class="grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Payment Type</label>
        <%= select_tag :payment_type,
             options_for_select([["Cash", "CashPayment"], ["Check", "CheckPayment"]]),
             prompt: "Select type...",
             class: "bg-white w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Amount ($)</label>
        <%= number_field_tag :amount_dollars, nil,
             step: "0.01", min: "0.01", placeholder: "0.00",
             class: "bg-white w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500",
             data: { controller: "currency-input", action: "currency-input#format" } %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Check Number</label>
        <%= text_field_tag :check_number, nil,
             class: "bg-white w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500",
             placeholder: "Optional" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Memo</label>
        <%= text_field_tag :memo, nil,
             class: "bg-white w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500",
             placeholder: "Optional" %>
      </div>
    </div>

    <div class="flex gap-2 mt-4">
      <%= button_tag class: "btn btn-primary inline-flex items-center gap-1.5" do %>
        <i class="fa-solid fa-plus text-xs"></i>
        Create payment
      <% end %>
    </div>
  <% end %>
</div>

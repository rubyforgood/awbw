<% day_count = @event.day_count %>
<%= form_with url: onboarding_event_path(@event), method: :get,
  data: { controller: "collection", turbo_frame: "onboarding_results" },
  autocomplete: "off",
  class: "flex flex-col md:flex-row md:flex-wrap md:items-end gap-4 mb-6" do %>

  <%= hidden_field_tag :status_filter, params[:status_filter].presence || "active" %>

  <div class="w-full md:flex-1">
    <%= label_tag :keyword, "Keyword", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="relative">
      <%= text_field_tag :keyword, params[:keyword],
                         class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-800 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none",
                         placeholder: "Name, email, phone, city, or organization" %>
      <button type="submit" class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-blue-600">
        <i class="fa fa-search"></i>
      </button>
    </div>
  </div>

  <div class="w-full md:w-56">
    <%= label_tag :step, "Step", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <% step_groups = [
         [ "Checklist", EventRegistration::CHECKLIST_STEPS.map { |key, label| [ label, key ] } ],
         [ "Attendance", (1..day_count).map { |day| [ "Day #{day} attended", "completed_day_#{day}" ] } ]
       ] %>
    <%= select_tag :step,
                   grouped_options_for_select(step_groups, params[:step]),
                   include_blank: "Any step",
                   class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-800 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
  </div>

  <div class="w-full md:w-40">
    <%= label_tag :step_state, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= select_tag :step_state,
                   options_for_select([ [ "Missing", "missing" ], [ "Done", "has" ] ], params[:step_state].presence || "missing"),
                   class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-800 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
  </div>

  <div class="w-full md:w-auto flex justify-end">
    <%= link_to "Clear filters", onboarding_event_path(@event),
                class: "btn btn-utility-outline",
                data: { action: "collection#clearAndSubmit" } %>
  </div>
<% end %>

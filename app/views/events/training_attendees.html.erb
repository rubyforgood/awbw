<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<% content_for(:full_width, true) %>
<div class="mx-auto max-w-[96rem] px-2 sm:px-6 lg:px-8 py-6">
  <div class="<%= DomainTheme.bg_class_for(:events) %> border border-gray-200 rounded-xl shadow p-4 sm:p-6">
    <div class="mb-6">
      <% if params[:return_to] == "participation" %>
        <%= link_to "← Participation", participation_events_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <% else %>
        <%= link_to "← Events statistics", statistics_events_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <% end %>
    </div>

    <%= render "training_attendees_count" %>

    <%= render "training_attendees_search" %>

    <% result_src = training_attendees_events_path + "?" + request.query_string %>
    <%= turbo_frame_tag :training_attendees_results, src: result_src, data: { turbo: "temporary" } do %>
      <%= render "training_attendees_skeleton" %>
    <% end %>
  </div>
</div>

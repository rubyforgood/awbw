<% content_for(:page_bg_class, "public") %>
<%# When the event grants CE and this registrant has a CE registration, the tab is
    a chooser of certificate documents (the completion/training certificate plus a
    CE Confirmation of Attendance per license), styled like the payment documents
    list. Otherwise it opens the completion certificate straight away. The completion
    card re-enters this action with ?document=completion to render the document. %>
<%# Only paid CE registrations earn a certificate (an unpaid licence can't), so the
    chooser — and whether we show one at all — keys off those. %>
<% ce_certificate_regs = @event_registration.continuing_education_registrations.select { |ce| ce.paid_in_full? || sample_preview? } %>
<% ce_applies = ce_certificate_regs.any? && (sample_preview? || @event.ce_eligible?) %>
<% from_chooser = params[:document] == "completion" %>
<% show_chooser = ce_applies && !from_chooser %>
<% content_for(:page_title, "#{show_chooser ? "Certificates" : "Certificate of completion"} — #{@event.title}") %>
<% if show_chooser %>
  <% training = @event.facilitator_training? %>
  <% completion_href = sample_preview? ? sample_certificate_event_path(@event, document: "completion") : registration_certificate_path(@event_registration.slug, document: "completion") %>
  <% cards = [ BuiltinCalloutCards::Card.new(
        icon_class: "fa-solid fa-certificate", color: "gray",
        title: training ? "Certificate of training" : "Certificate of completion",
        subtitle: "Your certificate for completing this training",
        href: completion_href, target: nil, trailing_icon: "fa-solid fa-arrow-right") ] %>
  <% ce_certificate_regs.each do |ce_reg| %>
    <% ce_href = sample_preview? ? sample_ce_certificate_event_path(@event, return_to: "certificate") : registration_ce_certificate_path(@event_registration.slug, ce_reg, return_to: "certificate") %>
    <% ce_subtitle = ce_reg.professional_license&.number_known? ? "Continuing education confirmation · #{ce_reg.professional_license.name}" : "Continuing education confirmation of attendance" %>
    <% cards << BuiltinCalloutCards::Card.new(
          icon_class: "fa-solid fa-award", color: "gray",
          title: "CE confirmation of attendance", subtitle: ce_subtitle,
          href: ce_href, target: nil, trailing_icon: "fa-solid fa-arrow-right") %>
  <% end %>
  <%= render layout: "events/callouts/callout_page", locals: { title: "Certificates" } do %>
    <div class="space-y-3">
      <% cards.each do |card| %>
        <%= render "event_registrations/callout_card", callout: card %>
      <% end %>
    </div>
  <% end %>
<% elsif sample_preview? || @event_registration.certificate_available? %>
  <%
    event = @event.decorate
    if from_chooser
      back_path = sample_preview? ? sample_certificate_event_path(@event) : registration_certificate_path(@event_registration.slug)
      back_label = "Back to certificates"
    else
      back_path = sample_preview? ? sample_ticket_event_path(@event) : registration_ticket_path(@event_registration.slug)
      back_label = "Back to ticket"
    end
  %>

  <% content_for :head do %>
    <%# Slug-gated public page carrying a signature image — keep it out of search
        indexes in case a certificate link is ever shared publicly. %>
    <meta name="robots" content="noindex, noimageindex">
    <style>
      @media print {
        /* Landscape, and zero page margin so the browser has no room to print
           its own header/footer (date, title, URL, page number). Each
           certificate supplies its own inset via print padding on its wrapper. */
        @page { size: landscape; margin: 0; }
        /* The layout's global print logo would duplicate the certificate's own. */
        .printed-logo { display: none !important; }
        /* Color is the point here — force it (and the painted border image) to
           survive the print pipeline. */
        .certificate, .certificate img { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      }
    </style>
  <% end %>

  <%# Screen-only controls: return link + print. Hidden from the printed page. %>
  <div class="mx-auto flex max-w-4xl flex-wrap items-center gap-2 px-4 pt-4 sm:px-8 print:hidden">
    <%= link_to back_path, class: "inline-flex items-center gap-1.5 text-sm #{eyebrow_link_class} px-2 py-1" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> <%= back_label %>
    <% end %>
    <button onclick="window.print();"
            class="ml-auto inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm transition-colors hover:bg-gray-50">
      <i class="fa-solid fa-file-arrow-down"></i> Download PDF
    </button>
  </div>

  <%# Facilitator trainings get the branded painted-border certificate (full-bleed
      in print so the painted border reaches the paper edge); every other event
      keeps the default CSS-drawn completion certificate, inset from the edge. %>
  <% training = @event.facilitator_training? %>
  <% certificate_partial = training ? "training_certificate" : "completion_certificate" %>
  <div class="px-4 py-6 sm:px-8 <%= training ? "print:p-0" : "print:p-[0.4in]" %>">
    <%= render certificate_partial,
          event: event,
          recipient: @event_registration.registrant.full_name,
          signature_file: @signature_file %>
  </div>
<% else %>
  <% if from_chooser %>
    <% pending_back_path = sample_preview? ? sample_certificate_event_path(@event) : registration_certificate_path(@event_registration.slug) %>
    <% pending_back_label = "Back to certificates" %>
  <% else %>
    <% pending_back_path = sample_preview? ? sample_ticket_event_path(@event) : registration_ticket_path(@event_registration.slug) %>
    <% pending_back_label = "Back to ticket" %>
  <% end %>
  <%= render layout: "events/callouts/callout_page", locals: { title: "Certificate of completion", back_path: pending_back_path, back_label: pending_back_label } do %>
    <%# Not yet unlocked: show each condition and which are met, like the videoconference page. %>
    <% ended = @event.end_date&.past? %>
    <% attended = @event_registration.attended? %>
    <div class="space-y-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
      <p class="font-medium text-gray-700">Your certificate of completion unlocks once these are met:</p>
      <ul class="space-y-1">
        <li class="flex items-center gap-2">
          <i class="fa-solid <%= ended ? "fa-circle-check text-green-600" : "fa-circle-xmark text-gray-300" %>"></i>
          The training has ended<%= " (#{@event.end_date.to_date.strftime("%B %-d, %Y")})" if @event.end_date %>
        </li>
        <li class="flex items-center gap-2">
          <i class="fa-solid <%= attended ? "fa-circle-check text-green-600" : "fa-circle-xmark text-gray-300" %>"></i>
          Your attendance is confirmed
        </li>
        <% if @event_registration.scholarships.any? %>
          <li class="flex items-center gap-2">
            <i class="fa-solid <%= @event_registration.scholarship_tasks_met? ? "fa-circle-check text-green-600" : "fa-circle-xmark text-gray-300" %>"></i>
            Your scholarship tasks are complete
          </li>
        <% end %>
      </ul>
      <%# An obligation on the registrant rather than an unlock condition, so it
          sits below the checklist — a tick beside it would read as "already done". %>
      <% if @event.completion_deadline %>
        <p class="border-t border-gray-200 pt-2 text-gray-700">
          <i class="fa-solid fa-hourglass-half text-gray-400"></i>
          Complete this training by <strong><%= @event.decorate.completion_deadline_display %></strong>.
        </p>
      <% end %>
    </div>
  <% end %>
<% end %>

<%# A per-resource "clarity" question fans out to one input per linked resource,
    the resource title appended to the prompt. Answers submit under
    callout_form[clarity][field_id][resource_id] and store with a nil form_field. %>
<%# Sector/category-backed fields store no options of their own, so resolve them
    the same way the public form field does. %>
<% options = dynamic_form_field_options(field)&.map(&:first) ||
     field.form_field_answer_options.includes(:answer_option).map { |ffo| ffo.answer_option.name } %>
<% field.form_field_resources.ordered.includes(:resource).each do |link| %>
  <% resource = link.resource %>
  <% next unless resource %>
  <% prefill = submission&.form_answers&.find_by(form_field: nil, question_name_when_answered: field.per_resource_question(resource))&.submitted_answer %>
  <fieldset class="mb-7">
    <legend class="rich-label mb-1.5 text-sm font-semibold text-gray-700"><%= form_label_html(field.name) %> <strong><%= resource.title %></strong></legend>
    <%# Two fan-out questions can share a prompt and differ only by subtitle (the
        clarity pair's "Part One" / "Part Two"), so the subtitle has to show. %>
    <% if field.subtitle.present? %>
      <p class="rich-label mb-1.5 text-xs text-gray-500"><%= form_label_html(field.subtitle) %></p>
    <% end %>
    <%# Card-style radios, matching the shared form-field partial so every question
        reads the same. %>
    <div class="mt-1 flex flex-wrap gap-2.5">
      <% options.each do |option| %>
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-gray-300 bg-white px-3.5 py-2 text-sm text-gray-700 transition hover:border-blue-400 hover:bg-blue-50 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 has-[:checked]:text-blue-900">
          <%= radio_button_tag "callout_form[clarity][#{field.id}][#{resource.id}]", option, prefill == option, class: "text-blue-600 focus:ring-blue-500" %>
          <%= option %>
        </label>
      <% end %>
    </div>
  </fieldset>
<% end %>

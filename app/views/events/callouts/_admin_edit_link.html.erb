<%# Admin-only jump from a callout page to a record's management surface. Opens
    in a new tab so the registrant view is kept. Shared by the callout pages so
    every "Edit …" link reads identically. Locals: `path`, `label`. %>
<%= render "shared/badge",
      href: path,
      label: label,
      classes: "bg-sky-100 text-sky-700 border-sky-200",
      icon: "fa-solid fa-pen-to-square text-[0.6rem]",
      extra: "admin-only",
      target: "_blank", rel: "noopener" %>

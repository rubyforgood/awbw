<%= turbo_frame_tag :training_attendees_results do %>
  <%= turbo_stream.replace("training_attendees_count", partial: "training_attendees_count") %>

  <% if @people.any? %>
    <% charts_src = training_attendees_events_path(request.query_parameters) %>
    <div data-controller="panel-toggle">
      <%# Toggle bar: hide/show the roster table and the stats charts. Charts start
          hidden; revealing the panel loads its lazy Turbo frame on first show. %>
      <div class="flex flex-wrap items-center justify-end gap-2 mb-3">
        <button type="button"
                data-panel-toggle-target="button"
                data-panel-toggle-shown-label="Hide table"
                data-panel-toggle-hidden-label="Show table"
                data-action="panel-toggle#toggle"
                aria-expanded="true"
                class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-800">
          <i class="fa-solid fa-table-list"></i>
          <span data-panel-toggle-target="label">Hide table</span>
        </button>
        <button type="button"
                data-panel-toggle-target="button"
                data-panel-toggle-shown-label="Hide charts"
                data-panel-toggle-hidden-label="Show charts"
                data-action="panel-toggle#toggle"
                aria-expanded="false"
                class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-800">
          <i class="fa-solid fa-chart-column"></i>
          <span data-panel-toggle-target="label">Show charts</span>
        </button>
      </div>

      <%# Table panel — shown by default. %>
      <div data-panel-toggle-target="panel">
        <div class="rounded-xl bg-white overflow-hidden animate-fade blur-on-submit">
          <%# Page-level toggle: expand every row's Training cell to all events, or
              collapse back to the most recent one. Broadcasts to each row's
              expandable-card via @window (see _registrant_roster). %>
          <div class="flex items-center justify-end px-4 py-3 border-b border-gray-100">
            <button type="button"
                    data-controller="expandable-cards"
                    data-expandable-cards-expanded-value="false"
                    data-expandable-cards-collapsed-label-value="Show all events attended"
                    data-expandable-cards-expanded-label-value="Show last event attended"
                    data-action="expandable-cards#toggleAll"
                    class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-600 hover:text-gray-800">
              <span data-expandable-cards-target="label">Show all events attended</span>
              <i class="fa-solid fa-chevron-down text-xs transition-transform" data-expandable-cards-target="icon"></i>
            </button>
          </div>
          <%= render "events/registrant_roster", roster: @roster, show_event_column: true, show_affiliation_status: true, clickable_rows: false %>
        </div>

        <div class="mt-6 flex justify-center">
          <div class="pagination"><%= tailwind_paginate @people %></div>
        </div>
      </div>

      <%# Charts panel — hidden by default; the lazy frame loads on first reveal. %>
      <div data-panel-toggle-target="panel" class="hidden mt-6">
        <%= turbo_frame_tag :training_attendees_charts, src: charts_src, loading: :lazy do %>
          <p class="text-sm text-gray-400 text-center py-8">Loading charts…</p>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="rounded-xl bg-white overflow-hidden animate-fade blur-on-submit">
      <p class="text-gray-500 text-center px-6 py-8">No training attendees found.</p>
    </div>
  <% end %>
<% end %>

<%# Header + count for the attendees index. Rendered on the shell (no count yet)
    and replaced out-of-band by the results frame once the page loads. %>
<div id="attendees_count">
  <%= render "events/report_header",
        title: "Event attendees",
        icon: "fa-solid fa-user-pen",
        theme: :event_registrations,
        event: @filter_event,
        subtitle: @count_display ?
          "#{pluralize(@count_display, "person")} who have attended a facilitator training" :
          "Everyone who has attended a facilitator training" %>
</div>

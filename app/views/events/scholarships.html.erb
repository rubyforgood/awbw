<% content_for(:page_bg_class, "admin-or-owner bg-blue-100") %>
<%# Opt out of the layout's max-w-7xl cap to match the wider event manage pages. %>
<% content_for(:full_width, true) %>

<div class="mx-auto max-w-[96rem] px-2 sm:px-6 lg:px-8">
  <div class="<%= DomainTheme.bg_class_for(:events) %> border border-primary/10 rounded-2xl shadow-sm p-6">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-2 sm:gap-4">
      <% if params[:return_to] == "dashboard" && params[:event_id].present? %>
        <%= link_to "← Dashboard", dashboard_event_path(params[:event_id]), class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
      <% else %>
        <%= link_to "← Reports", reports_events_path(report_to_hub_params), class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
      <% end %>
      <%= render "events/report_subnav", current: :scholarships %>
    </div>

    <%= render "events/report_header",
          title: "Event scholarships",
          icon: "fa-solid fa-graduation-cap",
          theme: :scholarships,
          event: @filter_event,
          subtitle: "Scholarship dollars and awards (funded vs unfunded) per event, by year, with trainees who attended and the organizations they came from." %>

    <%# Ahoy-style filters — time period, specific training, and abbreviation
        search — each auto-submitting a GET form so the report reshapes on change. %>
    <%# searchable-checkbox turns the event-type multiselect into checkboxes; the
        form's onchange submits it (the other fields submit themselves). %>
    <%= form_with url: scholarships_events_path, method: :get, local: true,
          data: { controller: "searchable-checkbox" },
          html: { onchange: "if (event.target.multiple) this.requestSubmit()" },
          class: "rounded-xl border border-gray-200 bg-white p-4 shadow-sm mb-8" do %>
      <%= hidden_field_tag :return_to, params[:return_to] %>
      <%= hidden_field_tag :view, params[:view] %>
      <%= hidden_field_tag :funding, params[:funding] %>
      <%# Marks the event types as submitted, so nothing checked means every event
          rather than the facilitator-trainings default. %>
      <%= hidden_field_tag "event_kinds[]", "", id: nil %>
      <%# One row on desktop: the fields shrink to fit (min-w-0 lets a select go
          narrower than its longest option) while the event-type chips keep room.
          The shared report filters are rendered one by one (rather than via
          events/_report_filters) so Event type can sit between search and funder. %>
      <div class="flex flex-wrap items-end gap-4 lg:flex-nowrap lg:*:min-w-0">
        <%= render "events/time_period_filter" %>
        <%= render "events/event_filter", all_label: scholarship_report_noun == "events" ? "All events" : "All trainings" %>
        <%= render "events/event_search_filter" %>
        <%= render "shared/filter_multiselect", param: :event_kinds, label: "Event type",
              options: Event::KIND_SHORT_LABELS.map { |kind, label| [ label, kind ] },
              selected: scholarship_event_kinds, placeholder: "All events", hide_placeholder: true,
              wrapper_class: "w-full sm:w-80 lg:shrink-0" %>
        <%= render "events/funder_filter" %>
      </div>
    <% end %>

    <% if @report.any? %>
      <%= render "scholarship_kpis", report: @report, all_label: "All #{scholarship_report_noun}" %>

      <%= render "scholarships_report", report: @report %>

      <%= render "scholarship_organizations", report: @report, split: scholarship_funding_split? %>

      <p class="mt-6 text-xs text-gray-500">
        <span class="font-medium">Funded</span> = backed by an external grant.
        <span class="font-medium">Unfunded</span> = no grant, or a grant <%= app_organization_name %> funded (org subsidy).
        <br>
        <span class="font-medium">Attended</span> counts all trainees whose registration is marked attended, including scholarship recipients and people who paid in full.
      </p>
    <% else %>
      <div class="text-center py-12 text-gray-500">
        No <%= scholarship_report_noun %> match these filters yet.
      </div>
    <% end %>
  </div>
</div>

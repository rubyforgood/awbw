<div class="space-y-2 rounded-2xl border p-3" data-controller="field-required" data-action="input->field-required#update">
  <%= f.input :description,
        label: "Description",
        required: true,
        input_html: { class: "bg-white", data: { field_required_target: "field required" } } %>

  <div class="grid grid-cols-4 gap-4">
    <%= f.input :date,
          as: :date,
          html5: true,
          label: "Date",
          input_html: { class: "bg-white", data: { field_required_target: "field" } } %>

    <%= f.input :quantity,
          label: "Quantity",
          required: true,
          input_html: { min: 1, class: "bg-white", data: { field_required_target: "field" } } %>

    <%= f.input :unit_price_dollars,
          label: "Unit price ($)",
          required: true,
          input_html: { min: 0, step: 0.01, placeholder: "0.00", class: "bg-white", data: { controller: "currency-input", action: "currency-input#format", field_required_target: "field" } } %>

    <%= f.input :_destroy, as: :boolean, label: "Remove" %>
  </div>
</div>

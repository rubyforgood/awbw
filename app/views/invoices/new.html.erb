<% content_for(:page_title, "New Invoice") %>
<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<div class="mx-auto max-w-3xl">
  <div class="mb-6 flex flex-wrap items-center gap-2">
    <%= link_to "← Invoices", invoices_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
  </div>

  <h1 class="text-primary mb-6 font-display text-2xl font-semibold">New Invoice</h1>

  <%= simple_form_for @invoice, url: invoices_path do |f| %>
    <%= render "shared/errors", resource: f.object %>

    <div data-controller="invoicee">
      <%= f.input :invoicee_sgid,
            collection: [],
            required: true,
            input_html: {
              class: "bg-white",
              data: { controller: "remote-select", invoicee_target: "invoiceeSelect", remote_select_model_value: "person_or_organization" }
            },
            prompt: "Search people and organizations",
            label: "Invoicee",
            hint: "The person or organization being billed." %>

      <%= f.input :bill_to_address,
            as: :text,
            label: "Address",
            required: true,
            input_html: { rows: 3, class: "bg-white", data: { invoicee_target: "billToAddress" } } %>
    </div>

    <%= f.input :attention_person_id,
          collection: [],
          required: false,
          input_html: {
            class: "bg-white",
            data: {
              controller: "remote-select",
              remote_select_model_value: "person"
            }
          },
          prompt: "Search a person for attention",
          label: "Attention (optional)",
          hint: "Optional person to receive this invoice." %>

    <%= f.input :date,
          as: :date,
          html5: true,
          label: "Invoice date",
          required: true,
          input_html: { class: "bg-white", value: Date.current } %>

    <%= f.input :number,
          label: "Invoice number",
          required: false,
          hint: "Auto-assigned if left blank",
          input_html: { class: "bg-white" } %>

    <%= render "line_items_fields", f: f %>

    <div class="mt-6 flex items-center gap-3 border-t border-gray-200 pt-6">
      <div class="ml-auto flex items-center gap-3">
        <%= link_to "Cancel", invoices_path, class: button_classes(:secondary_outline) %>
        <%= f.button :submit, "Create Invoice", class: button_classes(:primary) %>
      </div>
    </div>
  <% end %>
</div>

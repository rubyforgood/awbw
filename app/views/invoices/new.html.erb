<% content_for(:page_title, "New Invoice") %>
<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<div class="mx-auto max-w-3xl">
  <div class="mb-6 flex flex-wrap items-center gap-2">
    <%= link_to "← Invoices", invoices_path, class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
  </div>

  <h1 class="text-primary font-display text-2xl font-semibold mb-6">New Invoice</h1>

  <%= simple_form_for @invoice, url: invoices_path do |f| %>
    <%= render "shared/errors", resource: f.object %>

    <%= f.input :client_sgid,
          collection: [],
          required: true,
          input_html: {
            class: "bg-white",
            data: {
              controller: "remote-select invoice-client",
              remote_select_model_value: "person_or_organization"
            }
          },
          prompt: "Search people and organizations",
          label: "Client",
          hint: "The person or organization being billed." %>

    <%= f.input :bill_to_address,
          as: :text,
          label: "Address",
          required: true,
          input_html: { rows: 3, class: "bg-white" } %>

    <%= f.input :attention_person_id,
          collection: [],
          required: false,
          input_html: {
            class: "bg-white",
            data: {
              controller: "remote-select",
              remote_select_model_value: "person"
            }
          },
          prompt: "Search a person for attention",
          label: "Attention (optional)",
          hint: "Optional person to receive this invoice." %>

    <%= f.input :date,
          as: :date,
          html5: true,
          label: "Invoice date",
          required: true,
          input_html: { class: "bg-white", value: Date.current } %>

    <%= f.input :number,
          label: "Invoice number",
          required: false,
          hint: "Auto-assigned if left blank",
          input_html: { class: "bg-white" } %>

    <fieldset class="mt-6 border-t border-gray-200 pt-6">
      <legend class="mb-3 text-sm font-medium text-gray-700">Line items</legend>

      <%= f.simple_fields_for :invoice_line_items do |li| %>
        <div class="space-y-3 rounded-lg border border-gray-200 p-4">
          <%= li.input :description,
                label: "Description",
                required: true,
                input_html: { class: "bg-white" } %>
          <%= li.input :date,
                as: :date,
                html5: true,
                label: "Date",
                required: true,
                input_html: { class: "bg-white" } %>
          <div class="grid grid-cols-2 gap-4">
            <%= li.input :quantity,
                  label: "Quantity",
                  required: true,
                  input_html: { min: 1, class: "bg-white" } %>
            <%= li.input :unit_price_dollars,
                  label: "Unit price ($)",
                  required: true,
                  input_html: { min: 0, step: 0.01, placeholder: "0.00", class: "bg-white", data: { controller: "currency-input", action: "currency-input#format" } } %>
          </div>
        </div>
      <% end %>
    </fieldset>

    <div class="mt-6 flex items-center gap-3 border-t border-gray-200 pt-6">
      <div class="ml-auto flex items-center gap-3">
        <%= link_to "Cancel", invoices_path, class: button_classes(:secondary_outline) %>
        <%= f.button :submit, "Create Invoice", class: button_classes(:primary) %>
      </div>
    </div>
  <% end %>
</div>

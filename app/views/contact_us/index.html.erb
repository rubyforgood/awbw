<% content_for(:page_bg_class, "public") %>
<%= render "shared/public_welcome_banner" unless @from_story_share %>

<div class="px-4 py-8 sm:px-6 lg:px-8">
<div class="mx-auto w-full max-w-7xl rounded-xl border border-gray-200 bg-white p-6 shadow" id="contact-us-container">
      <!-- Header -->
      <header class="space-y-4">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900">
          Contact us
        </h2>
        <p class="max-w-2xl text-lg leading-relaxed text-gray-600">
          We welcome you to contact us with any questions. We are here to help.
        </p>
        <% unless user_signed_in? %>
          <div class="rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-700">
            <strong>Please note:</strong> We are a training organization. If you are a survivor and in need of support,
            call <strong>211</strong>, which connects people with social service organizations.
          </div>
        <% end %>
      </header>
      <!-- Contact Details (website variant only; the portal shows it below the form) -->
      <% unless @from_story_share %>
      <div class="mt-10 text-gray-800">
        <div class="space-y-4">
          <div class="grid grid-cols-3 gap-x-8">
            <div>
              <div class="mb-1 text-sm font-semibold tracking-wide text-gray-500 uppercase">
                Email
              </div>
              <%= mail_to ENV.fetch("REPLY_TO_EMAIL", "programs@awbw.org"),
                          subject: "AWBW Portal: Website question",
                          class: "text-blue-600 hover:text-blue-800 font-medium" %>
            </div>
            <div>
              <div class="mb-1 text-sm font-semibold tracking-wide text-gray-500 uppercase">
                Phone
              </div>
              <%= link_to "310-396-0317",
                          "tel:310-396-0317",
                          class: "text-blue-600 hover:text-blue-800 font-medium" %>
            </div>
            <div>
              <div class="mb-2 text-sm font-semibold tracking-wide text-gray-500 uppercase">
                Social Media
              </div>
              <div class="flex flex-wrap items-center gap-3">
                <!-- LinkedIn -->
                <%= link_to "https://www.linkedin.com/company/a-window-between-worlds",
                            target: "_blank", rel: "noopener noreferrer",
                            class: "group inline-flex items-center justify-center w-11 h-11 rounded-xl bg-gray-50 shadow-sm hover:shadow-md hover:bg-linkedin transition" do %>
                  <i class="fab fa-linkedin-in text-lg text-gray-600 group-hover:text-white"></i>
                <% end %>
                <!-- Instagram -->
                <%= link_to "https://www.instagram.com/awbworg",
                            target: "_blank", rel: "noopener noreferrer",
                            class: "group inline-flex items-center justify-center w-11 h-11 rounded-xl bg-gray-50 shadow-sm hover:shadow-md hover:bg-gradient-to-tr hover:from-instagram-start hover:via-instagram-mid hover:to-instagram-end transition" do %>
                  <i class="fab fa-instagram text-lg text-gray-600 group-hover:text-white"></i>
                <% end %>
                <!-- Facebook -->
                <%= link_to "https://www.facebook.com/awbworg",
                            target: "_blank", rel: "noopener noreferrer",
                            class: "group inline-flex items-center justify-center w-11 h-11 rounded-xl bg-gray-50 shadow-sm hover:shadow-md hover:bg-facebook transition" do %>
                  <i class="fab fa-facebook-f text-lg text-gray-600 group-hover:text-white"></i>
                <% end %>
                <!-- YouTube -->
                <%= link_to "https://www.youtube.com/@awbworg",
                            target: "_blank", rel: "noopener noreferrer",
                            class: "group inline-flex items-center justify-center w-11 h-11 rounded-xl bg-gray-50 shadow-sm hover:shadow-md hover:bg-youtube transition" do %>
                  <i class="fa-brands fa-youtube text-lg text-gray-600 group-hover:text-white"></i>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% end %>
      <!-- Divider -->
      <div class="mt-12 border-t border-gray-200 pt-12">
        <!-- Contact Form -->
        <div id="contact-form" class="space-y-8">
          <% if @form_submitted %>
            <!-- Thank You Message -->
            <div id="thank-you" class="space-y-4 py-12 text-center">
              <div class="mb-4 inline-flex h-16 w-16 items-center justify-center rounded-full bg-green-100">
                <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <h3 class="text-2xl font-semibold text-gray-900">
                Thank you for contacting us!
              </h3>
              <p class="mx-auto max-w-md text-gray-600">
                Your message has been received and our team will respond as soon as possible.
                <% if current_user && @user %>
                  We'll reply by email to <strong><%= @user.email %></strong>.
                <% end %>
              </p>
              <% if @from_story_share %>
                <div class="pt-2">
                  <%= link_to "Back to story share", story_shares_path, class: "btn btn-primary" %>
                </div>
              <% end %>
            </div>
            <script>document.getElementById("thank-you").scrollIntoView({ behavior: "smooth", block: "center" });</script>
          <% else %>
            <!-- Contact Form -->
            <div class="space-y-2">
              <h3 class="text-2xl font-semibold text-gray-900">
                Send us a message
              </h3>
              <p class="text-gray-600">
                Please complete the form below and our team will respond by email as soon as possible.
              </p>
            </div>
            <% if current_user && @user %>
              <div class="rounded-lg border border-blue-300 bg-blue-50 p-4 text-sm text-blue-700">
                Hello, <%= @user.first_name_or_email %>! We're glad to hear from you. We'll reply by email to <%= @user.email %>.
              </div>
            <% end %>
            <%= form_tag("/contact_us", method: "POST", class: "space-y-8", id: "contact-us-form", novalidate: true) do %>
              <input type="hidden" name="contact_us[q]" value="general">
              <% if @from_story_share %>
                <input type="hidden" name="from" value="story_share">
              <% end %>
              <% unless current_user %>
                <!-- Name Row -->
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-4">
                  <div>
                    <label class="mb-1 block text-sm font-medium text-gray-700">
                      First Name *
                    </label>
                    <input type="text"
                           name="contact_us[first_name]"
                           required
                           data-error-message="First name is required"
                           class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none">
                    <p class="field-error mt-1 hidden text-xs text-red-600"></p>
                  </div>
                  <div>
                    <label class="mb-1 block text-sm font-medium text-gray-700">
                      Last Name
                    </label>
                    <input type="text"
                           name="contact_us[last_name]"
                           class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none">
                  </div>
                  <div>
                    <label class="mb-1 block text-sm font-medium text-gray-700">
                      Email *
                    </label>
                    <input type="email"
                           name="contact_us[from]"
                           required
                           pattern="[^@\s]+@[^@\s]+\.[^@\s]+"
                           data-error-message="Please enter a valid email address"
                           class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none">
                    <p class="field-error mt-1 hidden text-xs text-red-600"></p>
                  </div>
                  <div>
                    <label class="mb-1 block text-sm font-medium text-gray-700">
                      Agency / Organization *
                    </label>
                    <input type="text"
                           name="contact_us[agency]"
                           required
                           data-error-message="Agency / Organization is required"
                           class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none">
                    <p class="field-error mt-1 hidden text-xs text-red-600"></p>
                  </div>
                </div>
              <% else %>
                <input type="hidden" name="contact_us[first_name]" value="<%= @user.person&.first_name %>">
                <input type="hidden" name="contact_us[last_name]" value="<%= @user.person&.last_name %>">
                <input type="hidden" name="contact_us[from]" value="<%= @user.email %>">
                <input type="hidden" name="contact_us[agency]" value="<%= @user.person&.primary_organization&.name || '' %>">
              <% end %>
              <!-- Honeypot -->
              <div class="absolute top-0 left-0 -z-10 h-0 w-0 opacity-0" aria-hidden="true">
                <label for="website_url">Website</label>
                <input type="text" name="contact_us[website_url]" id="website_url" tabindex="-1" autocomplete="off">
              </div>
              <!-- Subject -->
              <% if @from_story_share %>
                <!-- Preset picker posts straight through as the subject -->
                <div>
                  <label class="mb-1 block text-sm font-medium text-gray-700">
                    Select from the choices below so we can best serve you *
                  </label>
                  <select name="contact_us[subject]"
                          required
                          data-error-message="Please choose an option"
                          class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none">
                    <option value="" disabled selected>Choose an option…</option>
                    <% ContactUsController::PORTAL_SUBJECT_OPTIONS.each do |option| %>
                      <option value="<%= option %>"><%= option %></option>
                    <% end %>
                  </select>
                  <p class="field-error mt-1 hidden text-xs text-red-600"></p>
                </div>
              <% else %>
                <div>
                  <label class="mb-1 block text-sm font-medium text-gray-700">
                    Subject Line *
                  </label>
                  <input type="text"
                         name="contact_us[subject]"
                         required
                         maxlength="100"
                         data-error-message="Subject line is required"
                         class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none">
                  <p class="field-error mt-1 hidden text-xs text-red-600"></p>
                </div>
              <% end %>
              <!-- Message -->
              <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">
                  Your Message *
                </label>
                <textarea name="contact_us[message]"
                          required
                          rows="6"
                          data-error-message="Message is required"
                          class="w-full resize-none rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none"></textarea>
                <p class="field-error mt-1 hidden text-xs text-red-600"></p>
              </div>
              <!-- Submit -->
              <div class="flex justify-end">
                <button type="submit"
                        class="btn btn-primary">
                  Submit
                </button>
              </div>
            <% end %>
            <script>
              document.addEventListener("DOMContentLoaded", function() {
                var form = document.getElementById("contact-us-form");
                if (!form) return;

                form.addEventListener("submit", function(e) {
                  var fields = form.querySelectorAll("[required]");
                  var valid = true;

                  fields.forEach(function(field) {
                    var error = field.parentElement.querySelector(".field-error");
                    if (!field.validity.valid) {
                      valid = false;
                      field.classList.add("border-red-500");
                      field.classList.remove("border-gray-300");
                      if (error) {
                        error.textContent = field.getAttribute("data-error-message") || "This field is required";
                        error.classList.remove("hidden");
                      }
                    } else {
                      field.classList.remove("border-red-500");
                      field.classList.add("border-gray-300");
                      if (error) {
                        error.textContent = "";
                        error.classList.add("hidden");
                      }
                    }
                  });

                  if (!valid) e.preventDefault();
                });

                form.querySelectorAll("[required]").forEach(function(field) {
                  field.addEventListener("input", function() {
                    var error = field.parentElement.querySelector(".field-error");
                    if (field.validity.valid) {
                      field.classList.remove("border-red-500");
                      field.classList.add("border-gray-300");
                      if (error) {
                        error.textContent = "";
                        error.classList.add("hidden");
                      }
                    }
                  });
                });
              });
            </script>
          <% end %>
        </div>
      </div>
      <% if @from_story_share %>
        <!-- Contact details below the form (portal variant) -->
        <div class="mt-12 border-t border-gray-200 pt-12 text-gray-800">
          <%= render "portal_contact_info" %>
        </div>
      <% end %>
    </div>
</div>

<% content_for(:page_bg_class, "public") %>
<%= render "shared/public_welcome_banner" unless @from_story_share %>

<% profile_return_path = (edit_person_path(current_user.person, anchor: "affiliations") if @return_to == "person_edit" && current_user&.person) %>
<% show_contact_sidebar = !@from_story_share %>
<% autofocus_field = (@prefilled_subject.present? ? :message : :subject) if user_signed_in? %>
<div class="border-primary/10 mx-auto w-full max-w-7xl overflow-hidden rounded-2xl border bg-white shadow-sm" id="contact-us-container">
  <%= render accent_strip_partial %>
  <div class="p-6 sm:p-8">
      <% if profile_return_path %>
        <div class="mb-3">
          <%= link_to profile_return_path, class: "text-sm #{eyebrow_link_class}" do %>
            <i class="fa-solid fa-arrow-left text-xs"></i> Back to my profile
          <% end %>
        </div>
      <% end %>
      <header class="space-y-3">
        <h1 class="text-primary font-display text-3xl tracking-tight">
          Contact us
        </h1>
        <p class="max-w-2xl text-lg leading-relaxed text-gray-600">
          We welcome you to contact us with any questions. We are here to help.
        </p>
        <% unless user_signed_in? %>
          <div class="rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-700">
            <strong>Please note:</strong> We are a training organization. If you are a survivor and in need of support,
            call <strong>211</strong>, which connects people with social service organizations.
          </div>
        <% end %>
      </header>
      <div class="mt-8 grid grid-cols-1 gap-10 <%= "lg:grid-cols-3" if show_contact_sidebar %>">
        <div id="contact-form" class="space-y-6 <%= "lg:col-span-2" if show_contact_sidebar %>">
          <% if @form_submitted %>
            <!-- Thank You Message -->
            <div id="thank-you" class="space-y-4 py-12 text-center">
              <div class="mb-4 inline-flex h-16 w-16 items-center justify-center rounded-full bg-green-100">
                <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <h3 class="text-2xl font-semibold text-gray-900">
                Thank you for contacting us!
              </h3>
              <p class="mx-auto max-w-md text-gray-600">
                Your message has been received and our team will respond as soon as possible.
                <% if current_user && @user %>
                  We'll reply by email to <strong><%= @user.email %></strong>.
                <% end %>
              </p>
              <% if @from_story_share %>
                <div class="pt-2">
                  <%= link_to "Back to story share", story_shares_path, class: button_classes(:primary) %>
                </div>
              <% elsif profile_return_path %>
                <div class="pt-2">
                  <%= link_to "Back to my profile", profile_return_path, class: button_classes(:primary) %>
                </div>
              <% end %>
            </div>
            <script>document.getElementById("thank-you").scrollIntoView({ behavior: "smooth", block: "center" });</script>
          <% else %>
            <div class="space-y-1">
              <h2 class="text-2xl font-semibold text-gray-900">
                Send us a message
              </h2>
              <p class="text-gray-600">
                Our team will respond by email as soon as possible.
              </p>
            </div>
            <%= form_tag("/contact_us", method: "POST", class: "space-y-6", id: "contact-us-form", novalidate: true) do %>
              <input type="hidden" name="contact_us[q]" value="general">
              <% if @from_story_share %>
                <input type="hidden" name="from" value="story_share">
              <% end %>
              <% if @return_to.present? %>
                <input type="hidden" name="return_to" value="<%= @return_to %>">
              <% end %>
              <% unless current_user %>
                <!-- Name Row -->
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                  <div>
                    <label class="mb-1 block text-sm font-medium text-gray-700">
                      First name *
                    </label>
                    <input type="text"
                           name="contact_us[first_name]"
                           required
                           data-error-message="First name is required"
                           class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none">
                    <p class="field-error mt-1 hidden text-xs text-red-600"></p>
                  </div>
                  <div>
                    <label class="mb-1 block text-sm font-medium text-gray-700">
                      Last name
                    </label>
                    <input type="text"
                           name="contact_us[last_name]"
                           class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none">
                  </div>
                  <div>
                    <label class="mb-1 block text-sm font-medium text-gray-700">
                      Email *
                    </label>
                    <input type="email"
                           name="contact_us[from]"
                           required
                           pattern="[^@\s]+@[^@\s]+\.[^@\s]+"
                           data-error-message="Please enter a valid email address"
                           class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none">
                    <p class="field-error mt-1 hidden text-xs text-red-600"></p>
                  </div>
                  <div>
                    <label class="mb-1 block text-sm font-medium text-gray-700">
                      Agency / organization *
                    </label>
                    <input type="text"
                           name="contact_us[organization]"
                           required
                           data-error-message="Agency / Organization is required"
                           class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none">
                    <p class="field-error mt-1 hidden text-xs text-red-600"></p>
                  </div>
                </div>
              <% else %>
                <div>
                  <div class="mb-1 block text-sm font-medium text-gray-700">From</div>
                  <div class="flex items-center gap-3 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3">
                    <span class="bg-primary/10 text-primary inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-semibold">
                      <% if (initials = @user.decorate.initials.presence) %>
                        <%= initials %>
                      <% else %>
                        <i class="fa-solid fa-user"></i>
                      <% end %>
                    </span>
                    <div class="min-w-0 text-sm">
                      <p class="font-medium text-gray-900">Hello, <%= @user.first_name_or_email %>!</p>
                      <p class="truncate text-gray-600">We'll reply by email to <%= @user.email %>.</p>
                    </div>
                  </div>
                </div>
                <input type="hidden" name="contact_us[first_name]" value="<%= @user.person&.first_name %>">
                <input type="hidden" name="contact_us[last_name]" value="<%= @user.person&.last_name %>">
                <input type="hidden" name="contact_us[from]" value="<%= @user.email %>">
                <input type="hidden" name="contact_us[organization]" value="<%= @user.person&.primary_organization&.name || '' %>">
              <% end %>
              <%= render "shared/honeypot", scope: "contact_us" %>
              <!-- Subject -->
              <% if @from_story_share %>
                <!-- Preset picker posts straight through as the subject -->
                <div>
                  <label class="mb-1 block text-sm font-medium text-gray-700">
                    Select from the choices below so we can best serve you *
                  </label>
                  <select name="contact_us[subject]"
                          required
                          data-error-message="Please choose an option"
                          class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none">
                    <option value="" disabled selected>Choose an option…</option>
                    <% ContactUsController::PORTAL_SUBJECT_OPTIONS.each do |option| %>
                      <option value="<%= option %>"><%= option %></option>
                    <% end %>
                  </select>
                  <p class="field-error mt-1 hidden text-xs text-red-600"></p>
                </div>
              <% else %>
                <div>
                  <label class="mb-1 block text-sm font-medium text-gray-700">
                    Subject line *
                  </label>
                  <input type="text"
                         name="contact_us[subject]"
                         value="<%= @prefilled_subject %>"
                         <%= "autofocus" if autofocus_field == :subject %>
                         required
                         maxlength="100"
                         data-error-message="Subject line is required"
                         class="w-full rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none">
                  <p class="field-error mt-1 hidden text-xs text-red-600"></p>
                </div>
              <% end %>
              <!-- Message -->
              <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">
                  Your message *
                </label>
                <textarea name="contact_us[message]"
                          <%= "autofocus" if autofocus_field == :message %>
                          required
                          rows="6"
                          data-error-message="Message is required"
                          class="w-full resize-none rounded border border-gray-300 bg-white px-4 py-2.5 text-gray-800 shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none"><%= @prefilled_message %></textarea>
                <p class="field-error mt-1 hidden text-xs text-red-600"></p>
              </div>
              <div class="flex justify-end">
                <button type="submit"
                        class="<%= button_classes(:primary) %>">
                  <i class="fa-solid fa-paper-plane"></i> Send message
                </button>
              </div>
            <% end %>
            <script>
              document.addEventListener("DOMContentLoaded", function() {
                var form = document.getElementById("contact-us-form");
                if (!form) return;

                form.addEventListener("submit", function(e) {
                  var fields = form.querySelectorAll("[required]");
                  var valid = true;

                  fields.forEach(function(field) {
                    var error = field.parentElement.querySelector(".field-error");
                    if (!field.validity.valid) {
                      valid = false;
                      field.classList.add("border-red-500");
                      field.classList.remove("border-gray-300");
                      if (error) {
                        error.textContent = field.getAttribute("data-error-message") || "This field is required";
                        error.classList.remove("hidden");
                      }
                    } else {
                      field.classList.remove("border-red-500");
                      field.classList.add("border-gray-300");
                      if (error) {
                        error.textContent = "";
                        error.classList.add("hidden");
                      }
                    }
                  });

                  if (!valid) e.preventDefault();
                });

                form.querySelectorAll("[required]").forEach(function(field) {
                  field.addEventListener("input", function() {
                    var error = field.parentElement.querySelector(".field-error");
                    if (field.validity.valid) {
                      field.classList.remove("border-red-500");
                      field.classList.add("border-gray-300");
                      if (error) {
                        error.textContent = "";
                        error.classList.add("hidden");
                      }
                    }
                  });
                });
              });
            </script>
          <% end %>
        </div>
        <% if show_contact_sidebar %>
          <aside class="h-fit space-y-6 rounded-xl border border-gray-200 bg-gray-50 p-6 text-gray-800">
            <h2 class="text-base font-semibold text-gray-900">Other ways to reach us</h2>
            <div>
              <div class="mb-1 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                Email
              </div>
              <%= mail_to Setting.programs_email,
                          subject: "AWBW Portal: Website question",
                          class: "text-blue-600 hover:text-blue-800 font-medium break-all" %>
            </div>
            <div>
              <div class="mb-1 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                Phone
              </div>
              <% if (phone = app_organization_phone) %>
                <%= link_to phone, tel_href(phone),
                            class: "text-blue-600 hover:text-blue-800 font-medium" %>
              <% end %>
            </div>
            <div>
              <div class="mb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                Social media
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <%= link_to "https://www.linkedin.com/company/a-window-between-worlds",
                            target: "_blank", rel: "noopener noreferrer", "aria-label": "LinkedIn",
                            class: "group inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white shadow-sm hover:shadow-md hover:bg-linkedin transition" do %>
                  <i class="fab fa-linkedin-in text-gray-600 group-hover:text-white"></i>
                <% end %>
                <%= link_to "https://www.instagram.com/awbworg",
                            target: "_blank", rel: "noopener noreferrer", "aria-label": "Instagram",
                            class: "group inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white shadow-sm hover:shadow-md hover:bg-gradient-to-tr hover:from-instagram-start hover:via-instagram-mid hover:to-instagram-end transition" do %>
                  <i class="fab fa-instagram text-gray-600 group-hover:text-white"></i>
                <% end %>
                <%= link_to "https://www.facebook.com/awbworg",
                            target: "_blank", rel: "noopener noreferrer", "aria-label": "Facebook",
                            class: "group inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white shadow-sm hover:shadow-md hover:bg-facebook transition" do %>
                  <i class="fab fa-facebook-f text-gray-600 group-hover:text-white"></i>
                <% end %>
                <%= link_to "https://www.youtube.com/@awbworg",
                            target: "_blank", rel: "noopener noreferrer", "aria-label": "YouTube",
                            class: "group inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white shadow-sm hover:shadow-md hover:bg-youtube transition" do %>
                  <i class="fa-brands fa-youtube text-gray-600 group-hover:text-white"></i>
                <% end %>
              </div>
            </div>
          </aside>
        <% end %>
      </div>
      <% if @from_story_share %>
        <!-- Contact details below the form (portal variant) -->
        <div class="mt-12 border-t border-gray-200 pt-12 text-gray-800">
          <%= render "portal_contact_info" %>
        </div>
      <% end %>
  </div>
</div>

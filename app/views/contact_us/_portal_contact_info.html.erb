<div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
  <div>
    <div class="mb-1 text-sm font-semibold tracking-wide text-gray-500 uppercase">
      Phone
    </div>
    <%= link_to "(310) 396-0317", "tel:310-396-0317",
                class: "text-blue-600 hover:text-blue-800 font-medium" %>
  </div>
  <div>
    <div class="mb-1 text-sm font-semibold tracking-wide text-gray-500 uppercase">
      Email
    </div>
    <%= mail_to Setting.info_email,
                class: "text-blue-600 hover:text-blue-800 font-medium" %>
  </div>
  <div>
    <div class="mb-1 text-sm font-semibold tracking-wide text-gray-500 uppercase">
      Mailing address
    </div>
    <address class="leading-relaxed text-gray-700 not-italic">
      <% if (attention = Setting.contact_attention) %>
        Attn: <%= attention %><br>
      <% end %>
      <%= app_organization_name %>
      <% if (address_lines = Setting.organization_address_lines).any? %>
        <br><%= safe_join(address_lines, tag.br) %>
      <% end %>
    </address>
  </div>
</div>

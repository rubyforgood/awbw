<% address = f.object.decorate %>
<% if address.state_as_text? || (params[:admin] && allowed_to?(:enter_any_state?, Address)) %>
  <%= f.input :state,
              label: "Province / State",
              input_html: {
                value: address.default_state,
                class: "rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500"
              } %>
<% else %>
  <div class="mb-4">
    <%= f.input :state,
                label: "State / territory",
                as: :select,
                collection: state_select_options(address.default_state),
                include_blank: true,
                selected: address.default_state,
                wrapper_html: { class: "mb-0!" },
                input_html: {
                  class: "rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500"
                } %>
    <%= render layout: "shared/outside_usa", locals: { open: false } do %>
      <%= f.input :state_outside_usa,
                  label: "Province / State",
                  wrapper_html: { class: "mb-0!" },
                  input_html: {
                    class: "rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500"
                  } %>
    <% end %>
  </div>
<% end %>

<!-- Filter Dropdowns -->
<div id="explore-by-combination" class="mt-8 border-t border-gray-100 pt-6">
  <h3 class="mb-4 text-center text-sm font-semibold tracking-wide text-gray-500 uppercase">
    Explore by combination
  </h3>

  <div data-controller="tags-sync-list-heights tags-combination-highlight">

    <!-- Two-column grid ONLY -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">

      <!-- Sector -->
      <div class="min-w-0">
        <label class="mb-1 block text-sm font-medium text-gray-700">
          Sector
          <span class="block text-xs font-normal text-gray-500">Select all that apply</span>
        </label>

        <div class="divide-y divide-gray-100 overflow-y-auto rounded-md border border-gray-300 bg-white shadow-sm"
             data-tags-sync-list-heights-target="source">

          <% selected_sectors =
               @sector_names_all.to_s.split("--").map(&:strip).reject(&:blank?) %>

          <% @sectors.each do |sector| %>
            <label class="flex cursor-pointer items-center gap-2 px-3 py-1 text-sm hover:bg-lime-50">
              <input type="checkbox"
                     name="sector_names_all[]"
                     value="<%= sector.name %>"
                     data-tags-sync-list-heights-target="sector"
                     <%= "checked" if selected_sectors.include?(sector.name) %>
                     class="rounded border-gray-300 text-lime-600 focus:ring-lime-500" />

              <span class="text-gray-900"><%= sector.name %></span>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Category -->
      <div class="min-w-0">
        <label class="mb-1 block text-sm font-medium text-gray-700">
          Category
          <span class="block text-xs font-normal text-gray-500">Select all that apply</span>
        </label>

        <div class="divide-y divide-gray-100 overflow-y-auto rounded-md border border-gray-300 bg-white shadow-sm"
             data-tags-sync-list-heights-target="dest">

          <%
            selected_categories =
              @category_names_all.to_s
                             .split("--")
                             .map(&:strip)
                             .reject(&:blank?)
                             .map(&:downcase)
          %>

          <% @categories.each do |category| %>

            <label class="flex cursor-pointer items-center gap-2 px-3 py-1 text-sm hover:bg-lime-50">
              <input type="checkbox"
                     name="category_names_all[]"
                     value="<%= category.name %>"
                     data-tags-sync-list-heights-target="category"
                     <%= "checked" if selected_categories.include?(category.name.downcase) %>
                     class="rounded border-gray-300 text-lime-600 focus:ring-lime-500" />

              <span class="text-gray-900">
                    <%= "#{category.category_type&.name&.titleize}: " if category.category_type %>
                <%= category.name %>
                  </span>
            </label>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Apply Filters Button -->
    <div class="mt-4 text-center">
      <button type="button"
              class="<%= button_classes(:primary) %>"
              data-action="tags-sync-list-heights#applyFilters">
        Apply combination filters
      </button>
    </div>
  </div>
</div>
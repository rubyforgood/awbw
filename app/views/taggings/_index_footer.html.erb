<section class="other-categories mt-24 pt-6 border-t border-gray-100">
  <div class="max-w-7xl mx-auto">

    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4 text-center">
      <% if @sector_names.present? %>
        Explore other service populations
      <% else %>
        Explore by service population
      <% end %>
    </h3>

    <div class="flex flex-wrap justify-center gap-2 mb-6">
      <% Sector.published.order(:name).each do |sector| %>
        <% next if sector.name == @sector_names %>
        <%= render "sectors/tagging_label", sector: sector %>
      <% end %>
    </div>

    <!-- Explore all tags -->
    <div class="text-center">
      <%= link_to tags_path,
                  class: "
                    inline-flex items-center
                    text-sm font-medium
                    text-indigo-600
                    hover:text-indigo-800
                    hover:underline
                    transition
                  " do %>
        Explore all tags
        <i class="fa-solid fa-arrow-right ml-1 text-xs"></i>
      <% end %>
    </div>

    <!-- Filter Dropdowns -->
    <div class="mt-8 pt-6 border-t border-gray-100">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4 text-center">
        Filter by combination
      </h3>
      
      <div class="flex flex-wrap justify-center gap-4">
        <!-- Sector Multi-Select -->
        <div>
          <label for="sector-filter" class="block text-xs font-medium text-gray-600 mb-1">
            Service Population (hold Ctrl/Cmd for multiple)
          </label>
          <select id="sector-filter" 
                  multiple
                  size="8"
                  class="block w-64 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
            <% 
              selected_sectors = @sector_names.to_s.split("--").map(&:strip).reject(&:blank?)
              Sector.published.order(:name).each do |sector| 
            %>
              <option value="<%= sector.name %>" <%= 'selected' if selected_sectors.include?(sector.name) %>>
                <%= sector.name %>
              </option>
            <% end %>
          </select>
        </div>

        <!-- Category Multi-Select -->
        <div>
          <label for="category-filter" class="block text-xs font-medium text-gray-600 mb-1">
            Category (hold Ctrl/Cmd for multiple)
          </label>
          <select id="category-filter" 
                  multiple
                  size="8"
                  class="block w-64 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
            <% 
              selected_categories = @category_names.to_s.split("--").map(&:strip).reject(&:blank?).map(&:downcase)
              Category.published.joins(:category_type).select("categories.*, metadata.name AS category_type_name").distinct.order("category_type_name ASC, categories.name ASC").each do |category| 
            %>
              <option value="<%= category.name %>" <%= 'selected' if selected_categories.include?(category.name.downcase) %>>
                <%= "#{category.category_type&.name}: " if category.category_type %><%= category.name %>
              </option>
            <% end %>
          </select>
        </div>
      </div>

      <!-- Apply Filters Button -->
      <div class="text-center mt-4">
        <button id="apply-filters"
                class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition">
          Apply Filters
        </button>
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectorSelect = document.getElementById('sector-filter');
    const categorySelect = document.getElementById('category-filter');
    const applyButton = document.getElementById('apply-filters');

    function applyFilters() {
      // Get all selected values from multi-select
      const selectedSectors = Array.from(sectorSelect.selectedOptions).map(opt => opt.value);
      const selectedCategories = Array.from(categorySelect.selectedOptions).map(opt => opt.value);
      
      const params = new URLSearchParams(window.location.search);
      
      // Clear existing filters
      params.delete('sector_names');
      params.delete('category_names');
      
      // Add new filters joined with "--"
      if (selectedSectors.length > 0) {
        params.set('sector_names', selectedSectors.join('--'));
      }
      if (selectedCategories.length > 0) {
        params.set('category_names', selectedCategories.join('--'));
      }
      
      // Use window.location.search to update only the query parameters
      window.location.search = params.toString();
    }

    applyButton.addEventListener('click', applyFilters);
    
    // Allow Enter key in dropdowns to apply filters
    sectorSelect.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        applyFilters();
      }
    });
    
    categorySelect.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        applyFilters();
      }
    });
  });
</script>

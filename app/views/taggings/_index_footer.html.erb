<section class="other-categories mt-24 pt-6 border-t border-gray-100">
  <div class="max-w-7xl mx-auto">

    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4 text-center">
      <% if @sector_names.present? %>
        Explore other service populations
      <% else %>
        Explore by service population
      <% end %>
    </h3>

    <div class="flex flex-wrap justify-center gap-2 mb-6">
      <% Sector.published.order(:name).each do |sector| %>
        <% next if sector.name == @sector_names %>
        <%= render "sectors/tagging_label", sector: sector %>
      <% end %>
    </div>

    <!-- Explore all tags -->
    <div class="text-center">
      <%= link_to tags_path,
                  class: "
                    inline-flex items-center
                    text-sm font-medium
                    text-indigo-600
                    hover:text-indigo-800
                    hover:underline
                    transition
                  " do %>
        Explore all tags
        <i class="fa-solid fa-arrow-right ml-1 text-xs"></i>
      <% end %>
    </div>

    <!-- Filter Dropdowns -->
    <div class="mt-8 pt-6 border-t border-gray-100">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4 text-center">
        Filter by combination
      </h3>
      
      <div class="flex flex-wrap justify-center gap-4">
        <!-- Sector Dropdown -->
        <div>
          <label for="sector-filter" class="block text-xs font-medium text-gray-600 mb-1">
            Service Population
          </label>
          <select id="sector-filter" 
                  class="block w-64 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
            <option value="">Select a sector...</option>
            <% Sector.published.order(:name).each do |sector| %>
              <option value="<%= sector.name %>" <%= 'selected' if sector.name == @sector_names %>>
                <%= sector.name %>
              </option>
            <% end %>
          </select>
        </div>

        <!-- Category Dropdown -->
        <div>
          <label for="category-filter" class="block text-xs font-medium text-gray-600 mb-1">
            Category
          </label>
          <select id="category-filter" 
                  class="block w-64 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
            <option value="">Select a category...</option>
            <% Category.published.includes(:category_type).order("metadata.name ASC, categories.name ASC").each do |category| %>
              <option value="<%= category.name %>" <%= 'selected' if category.name == @category_names %>>
                <%= "#{category.category_type&.name}: " if category.category_type %><%= category.name %>
              </option>
            <% end %>
          </select>
        </div>
      </div>

      <!-- Apply Filters Button -->
      <div class="text-center mt-4">
        <button id="apply-filters"
                class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition">
          Apply Filters
        </button>
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectorSelect = document.getElementById('sector-filter');
    const categorySelect = document.getElementById('category-filter');
    const applyButton = document.getElementById('apply-filters');

    function applyFilters() {
      const sectorValue = sectorSelect.value;
      const categoryValue = categorySelect.value;
      
      const params = new URLSearchParams();
      if (sectorValue) {
        params.append('sector_names', sectorValue);
      }
      if (categoryValue) {
        params.append('category_names', categoryValue);
      }
      
      window.location.href = '<%= taggings_path %>' + (params.toString() ? '?' + params.toString() : '');
    }

    applyButton.addEventListener('click', applyFilters);
    
    // Allow Enter key in dropdowns to apply filters
    sectorSelect.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        applyFilters();
      }
    });
    
    categorySelect.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        applyFilters();
      }
    });
  });
</script>

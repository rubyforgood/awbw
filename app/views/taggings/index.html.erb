<% content_for(:page_bg_class, "public") %>
<% sector_names = @sector_names_all.to_s.split("--").join(", ") %>
<%# Resolve the active filters to records so admins can jump straight to editing
    the sector/category they're browsing. The header still falls back to the raw
    param names below for any value that doesn't match a record. %>
<% filtered_sectors = @sector_names_all.present? ? Sector.sector_names_all(@sector_names_all).order(:name).to_a : [] %>
<% filtered_categories = @category_names_all.present? ? Category.category_names_all(@category_names_all).includes(:category_type).order(:name).to_a : [] %>
<% category_full_names =
     filtered_categories.map { |c| "#{c.category_type&.name&.titleize}: #{c.name}" }.join(", ").presence
%>

<div class="taggings-index mx-auto max-w-7xl <%= DomainTheme.bg_class_for(:tags) %> rounded-xl border border-gray-200 p-6 shadow">

  <!-- HEADER -->
  <div class="mb-10 w-full">
    <div class="mb-6">
      <h1 class="mb-2 text-3xl font-semibold text-gray-900">
        Taggings
      </h1>

      <p class="max-w-2xl text-gray-600">
        Content tagged by sector or thematic category.
      </p>
    </div>

    <!-- ACTIVE FILTERS -->
    <% if sector_names.present? || category_full_names.present? || @category_names_all.present? %>
      <div class="mt-4 text-center">
        <% if sector_names.present? %>
          <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
            <span class="text-3xl leading-tight font-semibold text-gray-900 md:text-4xl">
              <%= sector_names %>
            </span>
            <% if filtered_sectors.any? && allowed_to?(:edit?, filtered_sectors.first) %>
              <% filtered_sectors.each do |sector| %>
                <%= link_to edit_sector_path(sector),
                            class: "admin-only bg-blue-100 btn btn-secondary-outline whitespace-nowrap" do %>
                  Edit sector<%= " (#{sector.name})" if filtered_sectors.size > 1 %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <% if category_full_names.present? || @category_names_all.present? %>
          <div class="mt-2 flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
            <span class="text-base font-semibold text-gray-600 md:text-lg">
              <%= category_full_names || @category_names_all %>
            </span>
            <% if filtered_categories.any? && allowed_to?(:edit?, filtered_categories.first) %>
              <% filtered_categories.each do |category| %>
                <%= link_to edit_category_path(category),
                            class: "admin-only bg-blue-100 btn btn-secondary-outline whitespace-nowrap" do %>
                  Edit category<%= " (#{category.name})" if filtered_categories.size > 1 %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- BODY -->
  <div class="space-y-6">

    <!-- EMPTY / NO RESULTS STATES -->
    <% if sector_names.blank? && category_full_names.blank? && @category_names_all.blank? %>
      <div class="rounded-xl border border-gray-200 bg-white p-10 text-center text-gray-400">
        Select a sector or explore tags to view related content.
      </div>

    <% elsif @grouped_tagged_items.values.all?(&:empty?) %>
      <div class="rounded-xl border border-gray-200 bg-white p-10 text-center text-gray-500">
        No items have this tag combination:
        <div class="font-semibold text-gray-700">
          <%= [sector_names.presence, category_full_names.presence, @category_names_all.presence].compact.join(", ") %>
        </div>
      </div>
    <% end %>

    <!-- RESULTS -->
    <% @grouped_tagged_items.each do |type, items| %>
      <% next if items.blank? %>

      <% bg_class = DomainTheme.bg_class_for(type) %>

      <section class="<%= bg_class %> rounded-xl border border-gray-200 px-6 py-8">
        <!-- SECTION HEADER -->
        <div class="mb-6 text-center">
          <% type_header = "#{type.to_s.humanize} (#{items.object.total_entries})" %>

          <h2 class="text-xl font-semibold text-gray-900">
            <%= link_to tagged_index_path(type,
                                          sector_names_all: @sector_names_all,
                                          category_names_all: @category_names_all),
                        class: "hover:underline inline-flex items-center gap-2" do %>
              <span><%= type_header %></span>
              <span class="text-sm text-gray-500">
                <i class="fa fa-external-link-alt"></i>
              </span>

            <% end %>
          </h2>
        </div>

        <%= render "tagged_items_carousel", items: items %>

        <div class="mt-6 text-right">
          <%= link_to "View all #{type.to_s.humanize} results",
                      tagged_index_path(type,
                                        sector_names_all: @sector_names_all,
                                        category_names_all: @category_names_all),
                      data: { turbo_frame: "_top"},
                      class: "text-primary font-medium hover:underline" %>
        </div>
      </section>
    <% end %>

  </div>
</div>

<!-- STAFF TAGS (internal, admin-only) -->
<% if allowed_to?(:index?, StaffTag) && @staff_tags.present? %>
  <div class="mx-auto mt-6 max-w-7xl">
    <section class="admin-only rounded-xl border border-blue-200 bg-blue-100 p-6">
      <div class="mb-5 flex items-start justify-between gap-6">
        <div>
          <h2 class="text-lg font-semibold text-slate-900">
            Staff tags
          </h2>
          <p class="text-sm text-slate-600">
            Internal only — pipelines, rosters, and outreach lists. Each links to the tagged people.
          </p>
        </div>

        <div class="flex-shrink-0">
          <%= link_to "Manage staff tags",
                      staff_tags_path,
                      class: "admin-only bg-blue-100 btn btn-secondary-outline whitespace-nowrap" %>
        </div>
      </div>

      <%= render "tags/staff_tags", return_to: "taggings" %>
    </section>
  </div>
<% end %>

<%= render "taggings/index_footer" %>

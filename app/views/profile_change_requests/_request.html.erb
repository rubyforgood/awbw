<% request = request.decorate unless request.respond_to?(:status_badge) %>
<% highlighted = params[:highlight].to_s == request.object.id.to_s %>
<div class="scroll-mt-24 rounded-lg border p-4 shadow-sm transition-colors duration-150 <%= highlighted ? "border-yellow-500 bg-yellow-50 ring-2 ring-inset ring-yellow-500" : "border-gray-200 bg-white" %>"
     id="<%= dom_id(request.object) %>">
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="font-semibold text-gray-800"><%= request.field_label %></span>
        <%= request.status_badge %>
        <% if request.resolution_note %>
          <span class="text-xs text-gray-500"><%= request.resolution_note %></span>
        <% end %>
      </div>
      <p class="mt-1 text-sm text-gray-500">
        Requested by <%= request.requested_by.full_name %> on <%= request.requested_on %>
      </p>
    </div>
  </div>

  <dl class="mt-3 space-y-1 text-sm">
    <% if request.affiliation_summary.present? %>
      <div class="flex gap-2">
        <dt class="w-32 shrink-0 text-gray-500">Affiliation</dt>
        <dd class="text-gray-800"><%= request.affiliation_summary %></dd>
      </div>
    <% end %>
    <% if request.license? %>
      <div class="flex gap-2">
        <dt class="w-32 shrink-0 text-gray-500">License</dt>
        <dd class="text-gray-800"><%= request.professional_license&.decorate&.summary || "Removed" %></dd>
      </div>
    <% elsif request.current_value.present? %>
      <div class="flex gap-2">
        <dt class="w-32 shrink-0 text-gray-500">Current</dt>
        <dd class="text-gray-800"><%= request.current_display %></dd>
      </div>
    <% end %>
    <% if request.requested_value.present? %>
      <div class="flex gap-2">
        <dt class="w-32 shrink-0 text-gray-500">Requested</dt>
        <dd class="font-medium text-gray-900"><%= request.requested_display %></dd>
      </div>
    <% end %>
    <% if request.proposed_change_summary.present? %>
      <div class="flex gap-2">
        <dt class="w-32 shrink-0 text-gray-500">New value</dt>
        <dd class="font-medium text-gray-900"><%= request.proposed_change_summary %></dd>
      </div>
    <% end %>
    <% if request.details.present? %>
      <div class="flex gap-2">
        <dt class="w-32 shrink-0 text-gray-500">Details</dt>
        <dd class="whitespace-pre-line text-gray-800"><%= request.details %></dd>
      </div>
    <% end %>
    <% if request.reviewer_note.present? %>
      <div class="flex gap-2">
        <dt class="w-32 shrink-0 text-gray-500">Staff note</dt>
        <dd class="whitespace-pre-line text-gray-800"><%= request.reviewer_note %></dd>
      </div>
    <% end %>
  </dl>

  <% if request.pending? && allowed_to?(:approve?, request.object) %>
    <%= form_with url: resolve_profile_change_request_path(request.object), method: :post, class: "mt-4 space-y-2" do |form| %>
      <%= form.text_area :reviewer_note, rows: 2,
                         placeholder: "Reason or note (shared with the requester) — optional, but please add one when declining",
                         class: "w-full rounded border border-gray-300 px-3 py-1.5 text-sm focus:border-blue-500 focus:ring-blue-200" %>
      <div class="flex flex-wrap items-center gap-2">
        <% if request.auto_appliable? %>
          <button type="submit"
                  formaction="<%= approve_profile_change_request_path(request.object) %>"
                  class="<%= button_classes(:primary, size: :sm) %>"
                  data-turbo-confirm="<%= request.approve_confirm %>">Approve</button>
        <% end %>
        <%= link_to "Update manually", request.manual_edit_path,
                    class: button_classes(:secondary_outline, size: :sm),
                    data: { turbo_frame: "_top" } %>
        <%= form.submit "Mark as resolved", class: button_classes(:secondary_outline, size: :sm),
                        data: { turbo_confirm: request.resolve_confirm } %>
        <button type="submit"
                formaction="<%= decline_profile_change_request_path(request.object) %>"
                class="<%= button_classes(:danger_outline, size: :sm) %>"
                data-turbo-confirm="<%= request.decline_confirm %>">Decline</button>
        <% if request.review_email_recipient %>
          <%= render "profile_change_requests/email_preview", request: request %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

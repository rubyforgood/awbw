<% content_for(:page_bg_class, "admin-or-owner") %>
<div class="mx-auto w-full max-w-4xl px-4 py-6">
  <div class="mb-2">
    <%= link_to @back_path, class: "text-sm #{eyebrow_link_class}" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> <%= @back_label %>
    <% end %>
  </div>
  <h1 class="text-primary font-display text-3xl font-semibold">What would you like to change?</h1>
  <p class="mt-2 text-lg text-gray-700"><%= @request.affiliation_summary %></p>
  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
    <% ProfileChangeRequestDecorator::AFFILIATION_CHANGE_CHOICES.except(ProfileChangeRequest::AFFILIATION_CHANGE_ADD).each do |change, choice| %>
      <%= link_to new_profile_change_request_path(person_id: @person, field: "affiliation", affiliation_id: @request.affiliation.id, change: change),
                  class: "border-primary/10 flex items-center gap-4 rounded-2xl border bg-white p-5 shadow-sm transition hover:border-primary hover:shadow-md" do %>
        <span class="bg-brand-cream text-primary flex h-12 w-12 shrink-0 items-center justify-center rounded-full text-xl">
          <i class="<%= choice[:icon] %>"></i>
        </span>
        <span class="text-primary font-display text-xl font-semibold"><%= choice[:label] %></span>
      <% end %>
    <% end %>
  </div>
</div>

<% content_for(:page_bg_class, "admin-or-owner") %>
<div class="mx-auto w-full max-w-2xl px-4 py-6">
  <div class="mb-2">
    <%= link_to @back_path || @request.decorate.profile_return_path, class: "text-sm #{eyebrow_link_class}" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> <%= @back_label || "Back to editing my profile" %>
    <% end %>
  </div>

  <h1 class="text-primary font-display text-3xl font-semibold"><%= @request.decorate.heading || "Request a change" %></h1>
  <% if @request.affiliation %>
    <p class="mt-1 text-lg font-medium text-gray-800"><%= @request.affiliation_summary %></p>
  <% end %>
  <p class="mt-1 text-gray-600">
    <% if @request.other? %>
      Tell us what you'd like changed on your profile and AWBW staff will take care of it.
    <% elsif @request.field == "affiliation" %>
      AWBW staff will look at your request and make the change.
    <% else %>
      <%= @request.field_label %> is maintained by AWBW staff.<br>
      Tell us what should change and we'll review it.
    <% end %>
  </p>

  <div class="mt-6 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <%= simple_form_for @request, url: profile_change_requests_path(person_id: @person), method: :post, html: { class: "space-y-5" } do |f| %>
      <%= render "shared/errors", resource: @request if @request.errors.any? %>
      <%= render "fields", f: f, request: @request %>

      <div class="flex justify-end">
        <%= f.button :submit, "Send request", class: button_classes(:primary) %>
      </div>
    <% end %>
  </div>
</div>

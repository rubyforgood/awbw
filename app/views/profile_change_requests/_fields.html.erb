<%# locals: (f:, request:) %>
<%= f.hidden_field :field %>

<% if request.current_value.present? %>
  <div>
    <span class="block text-sm font-medium text-gray-700">Current <%= request.field_label.downcase %></span>
    <span class="font-medium text-gray-900"><%= request.current_value %></span>
  </div>
<% end %>

<% if request.auto_appliable? %>
  <%= f.input :requested_value,
              label: "Change #{request.field_label.downcase} to",
              input_html: { class: "w-full" } %>
  <%= f.input :details,
              as: :text,
              label: "Anything else we should know? (optional)",
              input_html: { rows: 3, class: "w-full" } %>
<% else %>
  <% affiliations = request.person.affiliations.includes(:organization).map { |a| [ "#{a.title.presence || Affiliation::FACILITATOR_TITLE} @ #{a.organization&.name}", a.id ] } %>
  <%= f.input :affiliation_id,
              collection: affiliations,
              include_blank: "A new or different affiliation",
              label: "Which affiliation?",
              input_html: { class: "w-full" } %>
  <%= f.input :requested_value,
              collection: ProfileChangeRequest::AFFILIATION_CHANGE_TYPES,
              include_blank: "Select what to change…",
              label: "What should change?",
              input_html: { class: "w-full" } %>
  <%= f.input :details,
              as: :text,
              label: "Details — what it should be",
              input_html: { rows: 5, class: "w-full" } %>
<% end %>

<%# locals: (f:, request:) %>
<%= f.hidden_field :field %>

<% if request.current_value.present? %>
  <div>
    <span class="block text-sm font-medium text-gray-700">Current <%= request.field_label.downcase %></span>
    <span class="font-medium text-gray-900"><%= request.decorate.current_display %></span>
  </div>
<% end %>

<% if request.license? %>
  <%= f.hidden_field :professional_license_id %>
  <p class="text-sm text-gray-600">This license has continuing education credits, so AWBW staff make changes to it.</p>
  <%= f.input :details,
              as: :text,
              label: "What should change?",
              hint: "For example: \"The number should be 12345\" or \"It now expires June 30, 2027.\"",
              input_html: { rows: 4, class: "w-full text-lg" } %>
<% elsif request.other? %>
  <%= f.input :details,
              as: :text,
              label: "What would you like us to change?",
              hint: "For example: \"Please fix the spelling of my last name.\"",
              input_html: { rows: 5, class: "w-full text-lg" } %>
<% elsif request.email? %>
  <div class="grid grid-cols-1 gap-x-4 sm:grid-cols-[minmax(0,1fr)_10rem]">
    <%= f.input :requested_value,
                label: "Email address",
                input_html: { type: "email", class: "w-full" } %>
    <%= f.input :proposed_email_type,
                label: "Type",
                collection: Person::CONTACT_TYPES.map { |type| [ type.humanize, type ] },
                include_blank: true,
                input_html: { class: "w-full" } %>
  </div>
  <%= f.input :details,
              as: :text,
              label: "Anything else we should know? (optional)",
              input_html: { rows: 3, class: "w-full" } %>
<% elsif request.field.in?(ProfileChangeRequest::AUTO_APPLIABLE_FIELDS) %>
  <%= f.input :requested_value,
              label: "Change #{request.field_label.downcase} to",
              input_html: { class: "w-full" } %>
  <%= f.input :details,
              as: :text,
              label: "Anything else we should know? (optional)",
              input_html: { rows: 3, class: "w-full" } %>
<% else %>
  <% change = request.requested_value %>
  <% current = request.affiliation&.decorate %>
  <%= f.hidden_field :requested_value %>
  <% if change == ProfileChangeRequest::AFFILIATION_CHANGE_ADD %>
    <%= f.input :organization_id,
                include_blank: true,
                label: "Find your organization",
                prompt: "Search organizations…",
                input_html: { class: "w-full", data: { controller: "remote-select", remote_select_model_value: "organization" } } %>
    <%= f.input :proposed_organization_name, label: "Not on the list? Type the organization's name",
                hint: "AWBW staff will add it to the portal.", input_html: { class: "w-full text-lg" } %>
    <%= f.input :proposed_title, label: "Your title or role", input_html: { class: "w-full text-lg" } %>
  <% else %>
    <%= f.hidden_field :affiliation_id %>
  <% end %>
  <% if change == ProfileChangeRequest::AFFILIATION_CHANGE_TITLE %>
    <%= f.input :proposed_title, label: "New title or role",
                hint: ("Right now: #{current.display_title}" if current),
                input_html: { class: "w-full text-lg" } %>
  <% elsif change.in?([ ProfileChangeRequest::AFFILIATION_CHANGE_DATES, ProfileChangeRequest::AFFILIATION_CHANGE_ADD ]) %>
    <% if current %>
      <p class="text-gray-700">Right now: <span class="font-medium"><%= current.period_label %></span>. Leave a date blank to keep it as it is.</p>
    <% end %>
    <div class="flex flex-col gap-4 sm:flex-row">
      <%= f.input :proposed_start_date, as: :date, html5: true, label: "Start date", wrapper_html: { class: "flex-1" }, input_html: { class: "w-full text-lg" } %>
      <%= f.input :proposed_end_date, as: :date, html5: true, label: "End date", wrapper_html: { class: "flex-1" }, input_html: { class: "w-full text-lg" } %>
    </div>
  <% elsif change == ProfileChangeRequest::AFFILIATION_CHANGE_ORGANIZATION %>
    <%= f.input :proposed_organization_name, label: "Correct organization name",
                hint: ("Right now: #{current.organization&.name}" if current),
                input_html: { class: "w-full text-lg" } %>
  <% elsif change == ProfileChangeRequest::AFFILIATION_CHANGE_REMOVE %>
    <p class="text-lg text-gray-700">We'll mark <strong><%= current&.organization&.name %></strong> as an organization you no longer work with.</p>
  <% end %>
  <% if change == ProfileChangeRequest::AFFILIATION_CHANGE_WORK_ADDRESS %>
    <%= f.input :details, as: :text, label: "Your work address", hint: "Street, city, state, and zip code.", input_html: { rows: 3, class: "w-full text-lg" } %>
  <% elsif change == ProfileChangeRequest::AFFILIATION_CHANGE_UPDATE_WORK_ADDRESS %>
    <% if current&.organization_address %>
      <p class="text-gray-700">Right now: <span class="font-medium"><%= current.organization_address.name %></span></p>
    <% end %>
    <% other_addresses = current&.organization&.addresses.to_a.reject { |address| address.inactive? || address.id == current.organization_address_id } %>
    <% if other_addresses.any? %>
      <%= f.input :proposed_organization_address_id, label: "Your new work address",
                  collection: other_addresses.map { |address| [ address.name, address.id ] }, include_blank: "Pick an address",
                  input_html: { class: "w-full text-lg" } %>
    <% end %>
    <%= f.input :details, as: :text, label: (other_addresses.any? ? "Not on the list? Type it here" : "Your new work address"),
                hint: "Street, city, state, and zip code.", required: other_addresses.none?, input_html: { rows: 3, class: "w-full text-lg" } %>
  <% elsif change == ProfileChangeRequest::AFFILIATION_CHANGE_OTHER %>
    <%= f.input :details, as: :text, label: "What would you like us to change?", input_html: { rows: 5, class: "w-full text-lg" } %>
  <% else %>
    <%= f.input :details, as: :text, label: "Anything else we should know? (optional)", input_html: { rows: 3, class: "w-full" } %>
  <% end %>
<% end %>

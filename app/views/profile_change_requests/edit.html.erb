<% content_for(:page_bg_class, "admin-or-owner") %>
<div class="mx-auto w-full max-w-2xl px-4 py-6">
  <div class="mb-2">
    <%= link_to edit_person_path(@person, anchor: "affiliations"), class: "text-sm #{eyebrow_link_class}" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> Back to profile
    <% end %>
  </div>

  <h1 class="text-2xl font-semibold text-gray-900">Edit your change request</h1>
  <p class="mt-1 text-gray-600">
    Update your pending request to change your <%= @request.field_label.downcase %>.
  </p>

  <div class="mt-6 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <%= simple_form_for @request, html: { class: "space-y-5" } do |f| %>
      <%= render "shared/errors", resource: @request if @request.errors.any? %>
      <%= render "fields", f: f, request: @request %>

      <div class="flex justify-end">
        <%= f.button :submit, "Save changes", class: button_classes(:primary) %>
      </div>
    <% end %>
  </div>
</div>

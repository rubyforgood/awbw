<%= turbo_frame_tag :profile_change_requests_results do %>
  <nav class="mt-4 inline-flex rounded-lg bg-gray-100 p-0.5 text-sm font-medium" aria-label="Status filter">
    <% ProfileChangeRequest::STATUSES.each do |status| %>
      <%= link_to profile_change_requests_path(status: status, person_id: @person&.id),
                  class: "rounded-md px-3 py-1 transition-colors #{status == @status ? "bg-white text-gray-800 shadow-sm" : eyebrow_link_class}" do %>
        <%= status.capitalize %> <span class="text-gray-400"><%= @status_counts[status].to_i %></span>
      <% end %>
    <% end %>
  </nav>

  <div class="mt-6 space-y-3">
    <% if @requests.any? %>
      <% @requests.each do |request| %>
        <%= render "profile_change_requests/request", request: request %>
      <% end %>
    <% else %>
      <p class="rounded-lg border border-gray-200 bg-white p-6 text-center text-gray-500">
        No <%= @status %> requests.
      </p>
    <% end %>
  </div>
<% end %>

<%# The queue's status tabs + cards. Rendered inside the results frame, and
    directly into the page when a deep link needs a card in the first response. %>
<% tab_class = ->(active) { "rounded-md px-3 py-1 transition-colors #{active ? "bg-white text-gray-800 shadow-sm" : eyebrow_link_class}" } %>
<div class="mt-4 flex flex-wrap items-center gap-3">
  <nav class="inline-flex rounded-lg bg-gray-100 p-0.5 text-sm font-medium" aria-label="Status filter">
    <% ProfileChangeRequest::STATUSES.each do |status| %>
      <%= link_to change_requests_queue_path(status: status), class: tab_class.call(status == @status) do %>
        <%= status.capitalize %> <span class="text-gray-400"><%= @status_counts[status].to_i %></span>
      <% end %>
    <% end %>
  </nav>
  <nav class="inline-flex rounded-lg bg-gray-100 p-0.5 text-sm font-medium" aria-label="Submitted by filter">
    <%= link_to "Anyone", change_requests_queue_path(submitted_by: nil), class: tab_class.call(@submitted_by.nil?) %>
    <% ProfileChangeRequest::SUBMITTERS.each do |submitter, label| %>
      <%= link_to label, change_requests_queue_path(submitted_by: submitter), class: tab_class.call(submitter == @submitted_by) %>
    <% end %>
  </nav>
</div>

<div class="mt-6 space-y-3">
  <% if @requests.any? %>
    <% @requests.each do |request| %>
      <%= render "profile_change_requests/request", request: request %>
    <% end %>
  <% else %>
    <p class="rounded-lg border border-gray-200 bg-white p-6 text-center text-gray-500">
      No <%= @status %> requests.
    </p>
  <% end %>
</div>

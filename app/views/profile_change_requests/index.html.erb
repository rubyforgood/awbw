<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="mx-auto w-full max-w-4xl px-4 py-6">
  <% back_path, back_label = change_requests_return_link(@person) %>
  <div class="mb-2">
    <%= link_to back_path, class: "text-sm #{eyebrow_link_class}" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> <%= back_label %>
    <% end %>
  </div>

  <h1 class="text-2xl font-semibold text-gray-900">Changes requested</h1>
  <p class="mt-1 text-gray-600">
    Requests from facilitators to update profile details they can't edit themselves.
  </p>
  <% if @person %>
    <p class="mt-2 text-sm text-gray-700">
      Showing requests from <span class="font-medium"><%= @person.full_name %></span>.
      <%= link_to "Show everyone's", profile_change_requests_path(status: @status), class: "underline hover:text-blue-800" %>
    </p>
  <% end %>

  <%# A link to one card (highlight + anchor, from a change log) arrives with the
      requests already loaded, so the card is in this response for the browser to
      scroll to; everything else loads the queue lazily through the frame. %>
  <%= turbo_frame_tag :profile_change_requests_results,
                      src: (profile_change_requests_path(status: @status, person_id: @person&.id) unless @requests),
                      data: { turbo: "temporary" } do %>
    <% if @requests %>
      <%= render "profile_change_requests/results" %>
    <% else %>
      <p class="mt-6 text-gray-400">Loading…</p>
    <% end %>
  <% end %>
</div>

<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="mx-auto w-full max-w-4xl px-4 py-6">
  <div class="mb-2">
    <%= link_to root_path, class: "text-sm #{eyebrow_link_class}" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> Home
    <% end %>
  </div>

  <h1 class="text-2xl font-semibold text-gray-900">Changes requested</h1>
  <p class="mt-1 text-gray-600">
    Requests from facilitators to update profile details they can't edit themselves.
  </p>

  <div class="mt-4 flex flex-wrap gap-2">
    <% ProfileChangeRequest::STATUSES.each do |status| %>
      <%= link_to status.capitalize,
                  profile_change_requests_path(status: status),
                  class: "rounded-full px-3 py-1 text-sm #{status == @status ? "bg-primary text-white" : "bg-gray-100 text-gray-700 hover:bg-gray-200"}" %>
    <% end %>
  </div>

  <div class="mt-6 space-y-3">
    <% if @requests.any? %>
      <% @requests.each do |request| %>
        <%= render "profile_change_requests/request", request: request %>
      <% end %>
    <% else %>
      <p class="rounded-lg border border-gray-200 bg-white p-6 text-center text-gray-500">
        No <%= @status %> requests.
      </p>
    <% end %>
  </div>
</div>

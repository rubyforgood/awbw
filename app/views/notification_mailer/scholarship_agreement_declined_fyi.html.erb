<p style="margin-bottom: 6px;">
  Scholarship declined
</p>

<h1 style="margin: 0;">
  <strong><%= @person&.full_name %></strong>
  <% if @person&.preferred_email.present? %>(<%= @person.preferred_email %>)<% end %>
</h1>

<p style="margin: 4px 0 16px; font-size: 13px; color: #6b7280;">
  Declined on
  <%= Time.current
           .in_time_zone("Pacific Time (US & Canada)")
           .strftime("%B %-d, %Y at %-l:%M %p %Z") %>
</p>

<div style="text-align: center; background-color: #f3f4f6; border-radius: 6px; padding: 24px; margin: 16px 0;">
  <h2 style="font-size: 22px; font-weight: bold; color: #166534; margin: 0 0 8px; font-family: Lato, sans-serif;">
    <%= dollars_from_cents(@scholarship.amount_cents) %> scholarship
  </h2>

  <% if @event.present? %>
    <p style="font-size: 16px; color: #374151; margin: 0;">
      for <%= @event.title %>
    </p>
  <% end %>
</div>

<div style="border: 1px solid #e5e7eb; border-radius: 6px; padding: 16px; margin: 16px 0; background-color: #ffffff;">
  <p style="font-weight: bold; color: #374151; margin: 0 0 6px;">
    Reason given
  </p>
  <% if @reason.present? %>
    <p style="margin: 0; font-size: 14px; line-height: 1.5; color: #374151;"><%= @reason %></p>
  <% else %>
    <p style="margin: 0; font-size: 14px; color: #6b7280; font-style: italic;">No reason was provided.</p>
  <% end %>
</div>

<p>
  <a href="<%= edit_scholarship_url(@scholarship) %>"
     style="display:inline-block;background:#e5e7eb;color:#111827;
       text-decoration:none;padding:10px 16px;border-radius:6px;
       font-weight:bold;">
    View scholarship
  </a>
</p>

<h1>Submission received</h1>

<div style="margin-top: 36px; text-align: left;">
  <p>
    Hello <strong><%= @user.full_name %></strong>,
  </p>

  <p>
    Thank you for your submission. We have received your <%= @noticeable_klass.model_name.human.downcase %> and will review it shortly.
  </p>

  <% if @noticeable.respond_to?(:title) %>
    <div style="text-align: center; background-color: #f3f4f6; border-radius: 6px; padding: 24px; margin: 16px 0;">
      <h2 style="font-size: 22px; font-weight: bold; color: #166534; margin: 0 0 8px; font-family: Lato, sans-serif;">
        <%= @noticeable.title %>
      </h2>

      <p style="font-size: 13px; color: #6b7280; margin: 0;">
        Submitted on <%= @noticeable.created_at
                                    .in_time_zone("Pacific Time (US & Canada)")
                                    .strftime("%B %-d, %Y at %-l:%M %p %Z") %>
      </p>
    </div>
  <% end %>
</div>

<p>
  <% if @noticeable.present? %>
    <%= link_to "View submission",
                polymorphic_url(@noticeable),
                style: "display:inline-block;
                        padding:10px 16px;
                        background:#2563eb;
                        color:#ffffff;
                        text-decoration:none;
                        border-radius:6px;
                        font-weight:bold;" %>
  <% end %>
</p>

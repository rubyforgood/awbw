<%# Shared with the admin review queue's email preview so the two never drift.
    Locals: request, outcome ("completed" / "declined"), note. %>
<p style="margin: 0 0 16px; color:#374151;">
  Your request to update your <strong><%= request.field_label.downcase %></strong> has been
  <strong><%= outcome %></strong> by AWBW staff.
</p>

<% if outcome != "declined" && request.field == "primary_email" %>
  <p style="margin: 0 0 16px; color:#374151;">
    Check your inbox at <strong><%= request.requested_value %></strong> for a confirmation link to
    finish the change.
  </p>
<% end %>

<% if note.present? %>
  <p style="margin: 0 0 8px; color:#6b7280;">Note from staff:</p>
  <p style="margin: 0 0 16px; white-space: pre-line;"><%= note %></p>
<% end %>

<p style="margin: 0 0 16px; color:#374151;">
  Thank you,<br>
  AWBW Staff
</p>

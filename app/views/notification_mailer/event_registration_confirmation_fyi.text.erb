<% profile_url = person_url(@person) %>

New Event Registration
==========================

<%= @person.full_name %> (<%= @person.preferred_email %>)

Registered on
<%= @event_registration.created_at
                       .in_time_zone("Pacific Time (US & Canada)")
                       .strftime("%B %-d, %Y at %-l:%M %p %Z") %>

------------------------------------------------------------

Event
<%= @event.title %>

Event date
<%= @event.times(display_day: true, display_date: true) %>

<% if @event.location.present? %>
  Location
  <%= @event.location.name %>
<% end %>

<% if event_platform_label(@event).present? %>
  Videoconference
  <%= event_platform_label(@event) %>
<% end %>

<% if @event.labelled_cost.present? %>
  Cost
  <%= @event.labelled_cost %>
<% end %>

------------------------------------------------------------

View ticket:
<%= registration_ticket_url(@event_registration.slug) if @event_registration.present? %>

View profile:
<%= profile_url %>

View event:
<%= event_url(@event, reg: @event_registration.slug) %>


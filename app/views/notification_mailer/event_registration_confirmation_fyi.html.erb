<% portal_url = @facilitator ? facilitator_url(@facilitator) : user_url(@user) %>

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
      body { font-family: Arial, sans-serif; color: #333; }
      h1 { color: #2c3e50; }
      h2 { font-size: 1.1em; color: #2c3e50; margin-bottom: 0.5em; }
      p { margin: 0.5em 0; }
      ul { margin: 0.5em 0 1em 1.5em; }
      a { color: #1a73e8; text-decoration: none; }
      .footer { margin-top: 2em; font-size: 0.85em; color: #888; }
      .section { margin-bottom: 1.5em; }
      img { max-width: 100%; height: auto; border-radius: 4px; }
  </style>
</head>

<body>
<h1>
  <%= @notification_type %>
</h1>

<p>Hello,</p>

<p><%= link_to @user.full_name, portal_url %>
  registered for <%= @event.title %> on <%= Time.current.strftime("%A, %B %-d, %Y at %-l:%M %p %Z") %>.</p>


<div class="footer">
  This is an automated message from AWBW.
</div>
</body>
</html>


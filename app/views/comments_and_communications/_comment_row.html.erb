<%# One comment row on the combined feed, editable inline (mirrors
    comments/aggregated_comment's edit-toggle pattern). Saving PATCHes the
    top-level comment route directly (find-by-id, admin-only — works
    regardless of the commentable's own routing) with combined: 1, which the
    controller's turbo_stream response uses to re-render this same row in
    place. Locals: entry (a Comment). Optional: person and record_targets (the
    person feed's records the comment can be moved to). %>
<% person = local_assigns[:person] %>
<% source_chip = feed_source_chip(entry.commentable, icon: content_tag(:i, "", class: "fa-solid fa-comment text-gray-500", "aria-hidden": "true", title: "Comment")) %>
<% edit_button = content_tag(:button, safe_join([ content_tag(:i, "", class: "fa-solid fa-pen text-2xs"), " Edit" ]),
                              type: "button",
                              class: "ml-auto shrink-0 text-xs #{eyebrow_link_class}",
                              data: { action: "edit-toggle#toggle" }) %>
<div id="<%= dom_id(entry) %>" data-controller="edit-toggle">
  <%= tag.div class: "rounded-md border #{comment_card_class(warning: entry.body&.include?("[AGE_RANGE_DATA]"))} px-3 py-2",
              data: { edit_toggle_target: "view", **expandable_feed_row_data(clamp: false, key: dom_id(entry)) } do %>
    <div class="flex flex-wrap items-start gap-x-1 gap-y-1">
      <span class="mt-0.5 inline-flex w-4 shrink-0 justify-center leading-none"><%= render "comments/flag_toggle", comment: entry %></span>
      <%= render "comments/comment_line", comment: entry, truncate: false, leading: source_chip, trailing: edit_button, expandable: true,
                 date_path: feed_entry_path(entry, person: person) %>
    </div>
  <% end %>

  <div data-edit-toggle-target="edit" class="hidden rounded-md border <%= comment_card_class %> px-3 py-2">
    <%= simple_form_for entry, url: comment_path(entry), method: :patch do |f| %>
      <%= hidden_field_tag :combined, 1 %>
      <% if person %><%= hidden_field_tag :for_person_id, person.id %><% end %>
      <%= render "comments/commentable_picker", comment: entry, record_targets: local_assigns[:record_targets] %>
      <div class="flex items-start gap-x-2">
        <%= f.input_field :topic,
                          placeholder: "Topic",
                          class: "w-1/3 shrink-0 bg-white rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
        <%= f.input_field :body,
                          as: :text,
                          rows: 3,
                          required: true,
                          class: "grow bg-white rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
      </div>
      <div class="mt-3 flex items-center gap-x-3">
        <%= f.submit "Save", class: button_classes(:secondary_outline) %>
        <button type="button" data-action="edit-toggle#toggle" class="text-sm <%= eyebrow_link_class %>">Cancel</button>
        <label class="inline-flex cursor-pointer items-center select-none" title="Flag this note for follow-up">
          <%= f.check_box :flagged, class: "peer sr-only" %>
          <i class="fa-regular fa-flag text-gray-500 peer-checked:text-orange-500 peer-checked:[--fa-style:900]!"></i>
          <span class="ml-1.5 text-sm text-gray-500 peer-checked:text-orange-600">Flag</span>
        </label>
        <%= render "comments/delete_link", comment: entry %>
      </div>
    <% end %>
  </div>
</div>

<%# One manually-logged communication row on the combined feed, editable inline
    (mirrors comment_row's edit-toggle pattern). Saving PATCHes the notification
    directly with combined: 1, which the controller's turbo_stream response uses
    to re-render this same row in place. An autoemail is generated, not
    authored, so it renders through communication_row_readonly instead — this
    partial is only reached when entry.manual_log? is true. Locals: entry (a
    Notification). %>
<% chip_class = "inline-flex shrink-0 items-center gap-1 rounded-full border border-gray-300 bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-900" %>
<% record = entry.noticeable %>
<% source_chip = if record.present?
     inner = safe_join([ entry.decorate.channel_icon, commentable_label(record) ], " ")
     path = record_edit_path(record)
     path ? link_to(inner, path, target: "_blank", rel: "noopener", class: "#{chip_class} hover:underline") : content_tag(:span, inner, class: chip_class)
   end %>
<% edit_button = content_tag(:button, safe_join([ content_tag(:i, "", class: "fa-solid fa-pen text-2xs"), " Edit" ]),
                              type: "button",
                              class: "ml-auto shrink-0 text-xs #{eyebrow_link_class}",
                              data: { action: "edit-toggle#toggle" }) %>
<div id="<%= dom_id(entry) %>" data-controller="edit-toggle">
  <div data-edit-toggle-target="view">
    <%= render "notifications/communication_line", notification: entry, admin: true, truncate: false, leading: source_chip, trailing: edit_button %>
  </div>

  <div data-edit-toggle-target="edit" class="hidden rounded-md border <%= communication_card_class %> px-3 py-2">
    <%= simple_form_for entry, url: notification_path(entry), method: :patch do |f| %>
      <%= hidden_field_tag :combined, 1 %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start" data-controller="conditional-fields">
        <div class="shrink-0 space-y-2 sm:w-1/3">
          <%= f.select :channel, options_for_select(Notification::MANUAL_CHANNELS.map { |c| [ c.titleize, c ] }, entry.channel), { include_blank: false },
                       class: "w-full bg-white rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
          <%= render "notifications/direction_toggle", f: f, compact: true,
                     source_data: { conditional_fields_target: "source", action: "change->conditional-fields#toggle" } %>
          <label class="flex items-center gap-2" data-conditional-fields-target="field" data-show-when="incoming" hidden>
            <%= f.check_box :responded, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
            <span class="text-sm text-gray-700">Already responded</span>
          </label>
        </div>
        <div class="grow space-y-2">
          <%= f.input_field :email_subject,
                            required: true,
                            class: "w-full bg-white rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
          <%= f.input_field :email_body_text,
                            as: :text,
                            rows: 3,
                            class: "w-full bg-white rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
        </div>
      </div>
      <div class="mt-3 flex items-center gap-x-3">
        <%= f.submit "Save", class: button_classes(:secondary_outline) %>
        <button type="button" data-action="edit-toggle#toggle" class="text-sm <%= eyebrow_link_class %>">Cancel</button>
      </div>
    <% end %>
  </div>
</div>

<%# One automated-email row on the combined feed — read-only. An autoemail is
    generated by the system, not authored, so unlike communication_row (manually
    logged communications) it carries no Edit affordance — only the same quick
    "Responded" toggle the notifications index offers (e.g. for a contact-us
    FYI, which needs a reply despite being system-generated). Locals: entry (a
    Notification where entry.manual_log? is false). Optional: person (scopes the
    date link's feed). %>
<% source_chip = feed_source_chip(entry.noticeable, icon: entry.decorate.channel_icon) %>
<% trailing = content_tag(:span, render("notifications/responded_checkbox", notification: entry), class: "ml-auto shrink-0") %>
<%= tag.div id: dom_id(entry), data: expandable_feed_row_data(clamp: false, key: dom_id(entry)) do %>
  <%= render "notifications/communication_line", notification: entry, admin: true, truncate: false, expandable: true,
             date_path: feed_entry_path(entry, person: local_assigns[:person]),
             leading: source_chip, trailing: trailing, flag: render("notifications/flag_toggle", notification: entry) %>
<% end %>

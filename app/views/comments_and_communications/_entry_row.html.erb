<%# Dispatches one feed entry to its row partial: a comment, a manually-logged
    communication (editable), or an automated email (read-only). Locals: entry.
    Optional: person (passed to every row), record_targets (comment rows), and
    source_chip: false to show just the kind icon instead of the attached-record
    chip — for a record's own page, where the chip would only repeat the page. %>
<% source_chip = local_assigns.fetch(:source_chip, true) %>
<% if entry.is_a?(Comment) %>
  <%= render "comments_and_communications/comment_row", entry: entry,
             person: local_assigns[:person], record_targets: local_assigns[:record_targets], source_chip: source_chip %>
<% elsif entry.manual_log? %>
  <%= render "comments_and_communications/communication_row", entry: entry, person: local_assigns[:person], source_chip: source_chip %>
<% else %>
  <%= render "comments_and_communications/communication_row_readonly", entry: entry, person: local_assigns[:person], source_chip: source_chip %>
<% end %>

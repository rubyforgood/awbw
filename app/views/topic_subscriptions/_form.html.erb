<% field_class = "w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-800 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
<% label_class = "block text-sm font-medium text-gray-700 mb-1" %>
<% pencil_class = "inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs font-medium text-gray-500 hover:bg-gray-100 hover:text-gray-700 cursor-pointer" %>
<% value_class = "text-sm font-medium text-gray-900" %>

<%# Specific upcoming events to narrow to, plus the current selection so an
    already-chosen (possibly past) event stays selectable. %>
<% event_options = Event.upcoming.order(:start_date).to_a %>
<% current_event = @topic_subscription.interested_event %>
<% event_options.unshift(current_event) if current_event && event_options.exclude?(current_event) %>

<%# Active topics for the picker, plus the current one so an archived selection stays valid. %>
<% type_options = TopicSubscriptionType.active.ordered.to_a %>
<% current_type = @topic_subscription.topic_subscription_type %>
<% type_options.unshift(current_type) if current_type && type_options.exclude?(current_type) %>

<% cancel_path = topic_subscription_return_path %>

<%= simple_form_for @topic_subscription, html: { class: "space-y-5", data: { controller: "dirty-form conditional-fields" } } do |f| %>
  <%# Where this form was opened from, so the redirect after save matches the eyebrow. %>
  <% topic_subscription_return_params.each do |key, value| %>
    <%= hidden_field_tag key, value, id: nil %>
  <% end %>

  <% if @topic_subscription.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <ul class="list-disc list-inside space-y-1">
        <% @topic_subscription.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% person_select = capture do %>
    <%= f.select :person_id,
      options_for_select(Person.where(id: @topic_subscription.person_id).map { |p| [ p.full_name, p.id ] }, @topic_subscription.person_id),
      { include_blank: true, prompt: "Search for a person" },
      class: field_class,
      data: { controller: "remote-select", remote_select_model_value: "person", person_source_target: "existingField" } %>
  <% end %>

  <% if @topic_subscription.new_record? %>
    <%# Pick an existing person, or toggle to enter a new one that's created and
        linked on save (person_source disables the inactive mode's inputs). %>
    <div data-controller="person-source">
      <span class="<%= label_class %>">Person</span>
      <div class="mb-2 inline-flex rounded-lg border border-gray-300 p-0.5 text-sm">
        <label class="cursor-pointer">
          <input type="radio" name="person_source_mode" value="existing" class="peer sr-only" checked
                 data-person-source-target="radio" data-action="person-source#select">
          <span class="block rounded-md px-3 py-1.5 font-medium text-gray-600 peer-checked:bg-blue-600 peer-checked:text-white">Existing person</span>
        </label>
        <label class="cursor-pointer">
          <input type="radio" name="person_source_mode" value="new" class="peer sr-only"
                 data-person-source-target="radio" data-action="person-source#select">
          <span class="block rounded-md px-3 py-1.5 font-medium text-gray-600 peer-checked:bg-blue-600 peer-checked:text-white">New person</span>
        </label>
      </div>

      <div data-person-source-target="existingGroup"><%= person_select %></div>

      <div class="hidden space-y-3 rounded-lg border border-gray-200 bg-gray-50 p-3" data-person-source-target="newGroup">
        <%= f.simple_fields_for :person, @topic_subscription.person || Person.new do |pf| %>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <%= pf.label :first_name, "First name", class: label_class %>
              <%= pf.text_field :first_name, class: field_class, data: { person_source_target: "newField" } %>
            </div>
            <div>
              <%= pf.label :last_name, "Last name", class: label_class %>
              <%= pf.text_field :last_name, class: field_class, data: { person_source_target: "newField" } %>
            </div>
          </div>
          <div>
            <%= pf.label :email, "Email", class: label_class %>
            <%= pf.email_field :email, class: field_class, data: { person_source_target: "newField" } %>
          </div>
        <% end %>
        <p class="text-xs text-gray-500">A new person will be created and linked to this subscription.</p>
      </div>
    </div>
  <% else %>
    <div>
      <%= f.label :person_id, "Person", class: label_class %>
      <%= person_select %>
    </div>
  <% end %>

  <%# Topic — shown as a value with a pencil that reveals a picker (edit-toggle). %>
  <div data-controller="edit-toggle">
    <%= f.label :topic_subscription_type_id, "Topic", class: label_class %>
    <div class="flex items-center gap-2">
      <span class="<%= value_class %>" data-edit-toggle-target="view"><%= current_type&.name || "—" %></span>
      <div class="hidden flex-1" data-edit-toggle-target="edit">
        <%= f.select :topic_subscription_type_id,
          options_for_select(
            type_options.map { |type| [ type.name, type.id, { "data-event-selector": type.event_selector } ] },
            @topic_subscription.topic_subscription_type_id),
          { include_blank: true },
          class: field_class,
          data: { conditional_fields_target: "source", action: "change->conditional-fields#toggle" } %>
      </div>
      <button type="button" class="<%= pencil_class %>" data-action="edit-toggle#toggle" aria-label="Change topic">
        <i class="fa-solid fa-pen text-[0.6rem]"></i>
      </button>
    </div>
  </div>

  <%# Event — only for event-oriented topics (shown/hidden as the topic changes).
      Prefilled from the originating event; pencil flips to a picker to choose a
      different upcoming training or "All upcoming events". %>
  <div data-controller="edit-toggle" data-conditional-fields-target="field"
       data-show-when-attr="eventSelector"<%= " hidden".html_safe unless current_type&.event_selector? %>>
    <%= f.label :interested_event_id, "Event", class: label_class %>
    <div class="flex items-center gap-2">
      <span class="<%= value_class %>" data-edit-toggle-target="view"><%= current_event&.title || "All upcoming events" %></span>
      <div class="hidden flex-1" data-edit-toggle-target="edit">
        <%= f.select :interested_event_id,
          options_for_select(event_options.map { |e| [ e.title, e.id ] }, @topic_subscription.interested_event_id),
          { include_blank: "All upcoming events" },
          class: field_class %>
      </div>
      <button type="button" class="<%= pencil_class %>" data-action="edit-toggle#toggle" aria-label="Change event">
        <i class="fa-solid fa-pen text-[0.6rem]"></i>
      </button>
    </div>
    <p class="mt-1 text-xs text-gray-500">Choose a specific upcoming event, or “All upcoming events”.</p>
  </div>

  <div>
    <%= f.label :source, class: label_class %>
    <%= f.text_field :source, class: field_class, placeholder: "e.g. Facilitator Training registration, admin" %>
  </div>

  <%# ---- Comments (saved with the subscription; shown on the person's aggregated
      comments page). Replaces the old free-text note field. ---- %>
  <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm" id="comments-section" data-controller="edit-toggle">
    <div class="flex items-center gap-3 border-b border-gray-100 px-4 py-3">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg <%= DomainTheme.bg_class_for(:topic_subscriptions, intensity: 100) %> <%= DomainTheme.text_class_for(:topic_subscriptions, intensity: 600) %>">
        <i class="fa-solid fa-comments"></i>
      </span>
      <h2 class="text-sm font-semibold text-gray-700">Comments</h2>
      <% if @topic_subscription.person&.persisted? %>
        <%= link_to all_comments_person_path(@topic_subscription.person),
                    class: "ml-auto inline-flex items-center gap-1.5 text-xs font-medium text-transparent hover:text-gray-600 hover:underline",
                    target: "_blank", rel: "noopener" do %>
          View all
          <i class="fa-solid fa-arrow-up-right-from-square text-[0.6rem]"></i>
        <% end %>
      <% end %>
    </div>

    <div class="space-y-4 p-4" data-controller="paginated-fields" data-paginated-fields-per-page-value="5">
      <div id="comment-list" class="space-y-4">
        <%= f.simple_fields_for :comments do |cf| %>
          <%= render "comments/comment_fields", f: cf %>
        <% end %>
      </div>

      <div data-paginated-fields-target="nav"></div>

      <div class="flex items-center justify-between gap-2">
        <%= link_to_add_association f, :comments,
              partial: "comments/comment_fields",
              data: { association_insertion_node: "#comment-list", association_insertion_method: "append" },
              class: "inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 cursor-pointer" do %>
          <i class="fa-solid fa-plus text-[0.6rem]"></i>
          Add comment
        <% end %>

        <button type="button"
                class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 cursor-pointer"
                data-action="edit-toggle#toggle">
          <i class="fa-solid fa-pen text-[0.6rem]"></i>
          <span data-edit-toggle-target="editLabel">Edit comments</span>
          <span data-edit-toggle-target="viewLabel" class="hidden">Done editing</span>
        </button>
      </div>
    </div>
  </section>

  <div class="flex gap-2 justify-end">
    <%= link_to "Cancel", cancel_path, class: "btn btn-utility-outline", data: { action: "dirty-form#confirmCancel" } %>
    <%= f.submit submit_label, class: "btn btn-primary" %>
  </div>
<% end %>

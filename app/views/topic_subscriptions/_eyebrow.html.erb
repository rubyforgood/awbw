<%# Back link adapts to where the form was opened from (an event's Forms menu, or
    the subscriptions index). %>
<% case params[:return_to]
   when "dashboard" then back_label, back_path = "← Dashboard", (dashboard_event_path(params[:event_id]) if params[:event_id].present?)
   when "registrants" then back_label, back_path = "← Registrants", (registrants_event_path(params[:event_id]) if params[:event_id].present?)
   end %>
<% back_label ||= "← Subscriptions" %>
<% back_path ||= topic_subscriptions_path %>
<%= link_to back_label, back_path, class: "text-sm text-gray-500 hover:text-gray-700" %>

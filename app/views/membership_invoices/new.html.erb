<% content_for(:page_bg_class, "admin-only bg-blue-100") %>

<div class="border-primary/10 mx-auto max-w-2xl rounded-2xl border bg-white p-4 shadow-sm sm:p-6">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
    <%= link_to membership_path(@membership), class: "text-sm #{eyebrow_link_class} px-2 py-1" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> Membership
    <% end %>
  </div>

  <h1 class="text-primary mb-1 font-display text-2xl font-bold">Issue next invoice</h1>
  <p class="mb-6 text-sm text-gray-500"><%= @membership.person.full_name %></p>

  <dl class="mb-6 grid grid-cols-1 gap-x-6 gap-y-3 rounded-xl border border-gray-200 bg-gray-50 p-4 text-sm sm:grid-cols-3">
    <div>
      <dt class="text-xs tracking-wide text-gray-500 uppercase">Starts</dt>
      <dd class="mt-0.5 font-medium text-gray-800"><%= @membership_invoice.start_date.strftime("%b %-d, %Y") %></dd>
    </div>
    <div>
      <dt class="text-xs tracking-wide text-gray-500 uppercase">Ends</dt>
      <dd class="mt-0.5 font-medium text-gray-800"><%= @membership_invoice.end_date.strftime("%b %-d, %Y") %></dd>
    </div>
    <div>
      <dt class="text-xs tracking-wide text-gray-500 uppercase">Amount</dt>
      <dd class="mt-0.5 font-medium text-gray-800"><%= dollars_from_cents(@membership_invoice.cost_cents) %></dd>
    </div>
  </dl>

  <p class="mb-6 text-sm text-gray-600">
    This issues one year. The amount can be corrected on the invoice until a payment or discount is recorded.
  </p>

  <%= simple_form_for @membership_invoice, url: membership_membership_invoices_path(@membership), method: :post do |f| %>
    <div class="mt-6 flex items-center gap-3 border-t border-gray-200 pt-6">
      <div class="ml-auto flex items-center gap-3">
        <%= link_to "Cancel", membership_path(@membership), class: button_classes(:secondary_outline) %>
        <%= f.button :submit, "Issue next invoice", class: button_classes(:primary),
              title: "Creates the next year's invoice now. The ending invoice must be paid in full." %>
      </div>
    </div>
  <% end %>
</div>

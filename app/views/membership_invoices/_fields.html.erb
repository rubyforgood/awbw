<%= render "shared/errors", resource: f.object %>

<%= f.input :start_date,
      as: :date,
      html5: true,
      label: "Starts",
      hint: ("Runs 12 months from this date." unless include_end_date),
      input_html: { class: "bg-white" } %>

<% if include_end_date %>
  <%= f.input :end_date,
        as: :date,
        html5: true,
        label: "Ends",
        hint: "The last day covered.",
        input_html: { class: "bg-white" } %>
<% end %>

<%= f.input :cost_dollars,
      label: "Cost ($)",
      hint: "Enter 0 if this year is already covered. Can't go below what has already been paid against it.",
      input_html: { min: 0, step: 0.01, class: "bg-white" } %>

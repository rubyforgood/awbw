<%= render "shared/errors", resource: f.object %>

<%= f.input :start_date,
      as: :date,
      html5: true,
      label: "Starts",
      hint: "Runs 12 months from this date.",
      input_html: { class: "bg-white" } %>

<%= f.input :cost_dollars,
      label: "Cost ($)",
      hint: "Enter 0 if this invoice is already covered.",
      input_html: { min: 0, step: 0.01, class: "bg-white" } %>

<% field_class = search_field_class(extra: "bg-white") %>
<% label_class = search_label_class %>
<div class="mb-6 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
  <%= form_with url: membership_invoices_path, method: :get,
        data: { controller: "collection", turbo_frame: "membership_invoices_results" },
        autocomplete: "off", class: "space-y-2" do %>
    <div class="flex flex-wrap items-end gap-4 md:flex-nowrap">
      <div class="w-full md:w-44">
        <%= render "shared/filter_select",
              param: :status,
              label: "Payment",
              options: @status_filters.map { |status| [ status.capitalize, status ] },
              selected: @status_filter,
              blank: nil,
              clear_to: "all",
              field_class: field_class %>
      </div>

      <%= render "shared/filter_text", param: :person_name, label: "Person name", placeholder: "e.g. Jane Doe", submit: true,
            field_class: field_class, label_class: label_class, wrapper_class: "min-w-[200px] flex-1" %>
      <div>
        <label class="<%= label_class %>">&nbsp;</label>
        <%= render "shared/search_clear", url: membership_invoices_path %>
      </div>
    </div>
  <% end %>
</div>

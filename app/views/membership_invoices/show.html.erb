<% content_for(:page_title, "Invoice #{@invoice.number} — #{@membership_invoice.person.full_name}") %>
<% content_for(:page_bg_class, "admin-or-owner") %>
<% admin = allowed_to?(:manage?, @membership_invoice) %>
<% autopay_ready = @membership_invoice.membership.autopay_on? &&
                   @membership_invoice.person.stripe_customer&.payment_methods&.exists? %>

<%
  back_path, back_label =
    if admin
      [ membership_path(@membership_invoice.membership), "Membership" ]
    else
      [ person_path(@membership_invoice.person), "Back to profile" ]
    end
%>
<%= render "shared/print_actions", back_path: back_path, back_label: back_label %>

<div class="px-4 py-6 sm:px-8 print:p-0">
  <% if admin %>
    <%= render "membership_invoices/admin_details", membership_invoice: @membership_invoice %>
  <% end %>

  <% unless admin %>
    <% if @membership_invoice.remaining_cost.positive? &&
          (!@membership_invoice.payment_in_progress? || @membership_invoice.checkout_session_id.present?) %>
      <div class="mx-auto mb-6 flex max-w-3xl flex-wrap items-center justify-end gap-2 print:hidden">
        <% if @membership_invoice.upcoming? && autopay_ready &&
              @membership_invoice.checkout_session_id.blank? %>
          <p class="text-sm text-gray-600">Scheduled for <%= @membership_invoice.start_date.strftime("%b %-d, %Y") %>.</p>
        <% else %>
          <%= button_to "Pay now", membership_invoice_checkout_path(@membership_invoice),
                class: button_classes(:primary),
                title: "Pays this invoice once. The card is not saved for automatic payments.",
                data: { turbo: false } %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/printable_invoice", invoice: @invoice %>
</div>

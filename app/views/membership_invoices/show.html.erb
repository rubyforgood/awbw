<% content_for(:page_title, "Invoice #{@invoice.number} — #{@membership_invoice.person.full_name}") %>
<% content_for(:page_bg_class, "admin-or-owner") %>
<% invoice = @membership_invoice.decorate %>
<% admin = allowed_to?(:manage?, @membership_invoice) %>

<%
  back_path, back_label =
    if admin
      [ person_memberships_path(@membership_invoice.person), "Membership" ]
    else
      [ person_path(@membership_invoice.person), "Back to profile" ]
    end
%>
<%= render "shared/print_actions", back_path: back_path, back_label: back_label %>

<div class="px-4 py-6 sm:px-8 print:p-0">
  <% if admin %>
    <div class="admin-only border-primary/10 mx-auto mb-8 max-w-3xl rounded-2xl border bg-blue-100 p-4 shadow-sm sm:p-5 print:hidden">
      <div class="flex flex-wrap items-center gap-3">
        <h2 class="text-primary font-display text-lg font-bold">Invoice details</h2>
        <%= render "membership_invoices/status_pill", invoice: invoice, linked: true %>
        <div class="ml-auto flex flex-wrap items-center gap-2">
          <%= render "application/activity_log", record: @membership_invoice %>
          <%= link_to "Edit invoice details", edit_membership_invoice_path(@membership_invoice), class: button_classes(:secondary_outline, size: :sm) %>
          <% if @deletion_blocked_reason.nil? %>
            <%= button_to "Delete invoice", membership_invoice_path(@membership_invoice),
                  method: :delete, class: button_classes(:danger_outline, size: :sm),
                  data: { turbo_confirm: "Delete this invoice? This cannot be undone." } %>
          <% end %>
        </div>
      </div>

      <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 text-sm sm:grid-cols-4">
        <div>
          <dt class="text-xs tracking-wide text-gray-500 uppercase">Period</dt>
          <dd class="mt-0.5 font-medium text-gray-800"><%= invoice.period_range %></dd>
        </div>
        <div>
          <dt class="text-xs tracking-wide text-gray-500 uppercase">Cost</dt>
          <dd class="mt-0.5 font-medium text-gray-800"><%= invoice.cost %></dd>
        </div>
        <div>
          <dt class="text-xs tracking-wide text-gray-500 uppercase">Paid</dt>
          <dd class="mt-0.5 font-medium text-gray-800"><%= invoice.paid %></dd>
        </div>
        <% unless invoice.paid_in_full? %>
          <div>
            <dt class="text-xs tracking-wide text-gray-500 uppercase">Remaining</dt>
            <dd class="mt-0.5 font-medium text-gray-800"><%= invoice.remaining %></dd>
          </div>
        <% end %>
      </dl>

      <% if @membership_invoice.remaining_cost.positive? %>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <span class="text-xs tracking-wide text-gray-500 uppercase">Payment link</span>
          <% payment_link = memberships_public_invoice_checkout_url(@membership_invoice.signed_id(purpose: MembershipInvoice::PAYMENT_TOKEN_PURPOSE)) %>
          <%= link_to payment_link, payment_link, class: "text-primary font-mono text-xs break-all hover:underline" %>
        </div>
      <% end %>

      <% if @deletion_blocked_reason %>
        <p class="mt-3 text-xs text-gray-500">Can't be deleted: <%= @deletion_blocked_reason %>.</p>
      <% end %>

      <%= render "shared/audit_info", resource: @membership_invoice %>
    </div>
  <% end %>

  <% unless admin %>
    <% if @membership_invoice.remaining_cost.positive? %>
      <div class="mx-auto mb-6 flex max-w-3xl flex-wrap items-center justify-end gap-2 print:hidden">
        <%= button_to "Pay now", memberships_invoice_checkouts_path, params: { invoice_id: @membership_invoice.id },
              class: button_classes(:primary), data: { turbo: false } %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/printable_invoice", invoice: @invoice %>
</div>

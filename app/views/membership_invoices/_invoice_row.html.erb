<% invoice = invoice.decorate %>
<li class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-lg border border-gray-200 bg-white px-3 py-2">
  <div>
    <span class="block text-sm font-medium text-gray-800"><%= invoice.period_range %></span>
    <span class="block text-xs text-gray-500">
      <%= invoice.cost %> billed<% unless invoice.comped? %> &middot; <%= invoice.paid %> paid<% end %>
    </span>
  </div>
  <div class="flex items-center gap-2">
    <% if allowed_to?(:reconcile?, invoice.object) && invoice.needs_reconciliation? %>
      <%= render "shared/badge", label: "Check payment",
            classes: "bg-amber-50 text-amber-700 border-amber-200",
            title: "An automatic payment or checkout hasn't been reconciled with Stripe. Open the invoice for details." %>
    <% end %>
    <%= render "membership_invoices/status_pill", invoice: invoice, linked: local_assigns.fetch(:linked, false) %>

    <% if allowed_to?(:receipt?, invoice) && invoice.receipt_available? %>
      <%= link_to "Receipt", receipt_membership_invoice_path(invoice.object), class: button_classes(:secondary_outline, size: :sm) %>
    <% end %>

    <% if local_assigns.fetch(:viewable, false) %>
      <%= link_to "View", membership_invoice_path(invoice.object), class: button_classes(:secondary_outline, size: :sm) %>
    <% end %>
  </div>
</li>

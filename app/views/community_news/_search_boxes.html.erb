<!-- Filters -->
<%= form_with url: community_news_index_path,
              method: :get,
              data: {controller: "collection",
                    turbo_frame: "community_news_results" },
                    autocomplete: "off",
              class: "space-y-2" do |f| %>
  <div class="flex flex-wrap items-end gap-6 md:flex-nowrap">
    <!-- TITLE -->
    <%= render "shared/filter_text", param: :title, label: "Title contains", placeholder: "e.g. Art, Music…",
          field_class: search_field_class(extra: "bg-white"), wrapper_class: "min-w-[150px] pb-2",
          input_options: { oninput: "this.form.requestSubmit()" } %>

    <!-- KEYWORDS -->
    <%= render "shared/filter_text", param: :query, label: "Keywords", submit: true,
          field_class: search_field_class(extra: "bg-white"), wrapper_class: "min-w-[200px] flex-1 pb-2" %>

    <!-- YEAR -->
    <%= render "shared/filter_text", param: :year, label: "Year", placeholder: "e.g. 2025",
          field_class: search_field_class(extra: "bg-white"), wrapper_class: "w-24 pb-2",
          input_options: { oninput: "this.form.requestSubmit()" } %>

    <!-- VISIBILITY -->
    <div class="min-w-[150px] pb-2">
      <%= render "shared/visibility_filter",
                 model_class: CommunityNews,
                 admin: allowed_to?(:manage?, CommunityNews),
                 authenticated: user_signed_in?,
                 label_class: search_label_class,
                 button_text: "All" %>
    </div>

    <!-- ORGANIZATION -->
    <div class="min-w-[200px] pb-2">
      <label for="organization_id" class="<%= search_label_class %>">
        Organization
      </label>
      <%= f.select :organization_id,
                   options_from_collection_for_select(@organizations, :id, :name, params[:organization_id]),
                   { include_blank: "All organizations" },
                   class: search_field_class(extra: "bg-white"),
                   onchange: "this.form.requestSubmit()" %>
    </div>

    <!-- CLEAR FILTERS -->
    <div class="min-w-[120px] pb-3">
      <label class="<%= search_label_class %>">&nbsp;</label>
      <%= render "shared/search_clear", url: community_news_index_path %>
    </div>
  </div>
<% end %>

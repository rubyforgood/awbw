<div class="group relative flex cursor-pointer items-center gap-4 rounded-xl bg-white p-4 shadow-sm transition hover:shadow-md">

  <!-- Stretched link: the whole card navigates -->
  <%= link_to community_news_path(news),
              data: { turbo_prefetch: false, turbo_frame: "_top" },
              target: news.external_link? ? "_blank" : "", rel: "noopener noreferrer",
              class: "absolute inset-0 z-0",
              aria: { label: news.title } do %><% end %>

  <!-- TITLE -->
  <div class="min-w-0 flex-1">
    <h3 class="text-lg leading-tight font-semibold text-gray-900">
      <%= news.title %>
    </h3>
  </div>

  <!-- TRAILING CLUSTER: bookmark (clickable) + go-to chevron -->
  <div class="relative z-10 flex shrink-0 items-center gap-3">
    <%= render "bookmarks/editable_bookmark_icon", resource: news.object %>
    <i class="fa-solid fa-chevron-right pointer-events-none text-gray-300 transition group-hover:translate-x-0.5 group-hover:text-gray-500"></i>
  </div>
</div>

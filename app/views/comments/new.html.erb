<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<div class="mx-auto max-w-3xl <%= DomainTheme.bg_class_for(:comments) %> border-primary/10 rounded-2xl border p-4 shadow-sm sm:p-6">
  <div class="mb-4">
    <%= link_to "← Back", inline_record_path(@commentable, fallback: comments_path),
                class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
  </div>

  <h1 class="text-primary mb-6 font-display text-2xl font-bold">New comment</h1>

  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <% frame_id = "activity-new-slot" %>
    <% if params[:cancel].present? %>
      <%= turbo_frame_tag frame_id do %><% end %>
    <% else %>
      <%= render "comments/inline_form", comment: @comment, record: @commentable,
                 frame_id: frame_id, cancel_slot: (turbo_frame_request? ? frame_id : nil) %>
    <% end %>
  </div>
</div>

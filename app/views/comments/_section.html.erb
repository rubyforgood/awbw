<div class="form-group space-y-4">
  <div class="font-semibold text-gray-700 mb-2">
    Comments
  </div>

  <div class="rounded-lg border border-gray-200 bg-gray-50 p-4 mb-4 shadow-sm">
    <%= turbo_frame_tag "comment_form" do %>
      <%= render "comments/form", commentable: commentable %>
    <% end %>

    <%= turbo_frame_tag "comments_list", src: polymorphic_path([commentable, :comments], page: 1), loading: :lazy do %>
      <div class="text-gray-500 text-center py-4">Loading comments...</div>
    <% end %>
  </div>
</div>

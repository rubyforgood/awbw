<% content_for(:page_bg_class, "admin-only bg-blue-100") %>
<% record = @comment.commentable %>
<div class="mx-auto max-w-3xl <%= DomainTheme.bg_class_for(:comments) %> border-primary/10 rounded-2xl border p-4 shadow-sm sm:p-6">
  <div class="mb-4">
    <%= link_to "← Back", comment_path(@comment), class: "text-sm #{eyebrow_link_class} px-2 py-1" %>
  </div>

  <h1 class="text-primary mb-6 font-display text-2xl font-bold">Edit comment</h1>

  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <%= render "comments/page_form", comment: @comment, record: record,
               url: comment_path(@comment, format: :html),
               cancel_path: comment_path(@comment) %>
    <%= render "shared/audit_info", resource: @comment %>
  </div>
</div>

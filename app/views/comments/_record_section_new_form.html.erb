<div class="rounded-md border <%= comment_card_class %> px-3 py-2">
  <%= simple_form_for comment, url: url do |f| %>
    <%= render "shared/errors", resource: comment if comment.errors.any? %>
    <%= hidden_field_tag :commentable_sgid, record.to_sgid.to_s %>

    <div class="flex flex-wrap items-start gap-x-1 gap-y-1">
      <%= render "comments_and_communications/entry_date", time: Time.current %>
      <%= render "comments/author_chip", created_user: current_user, updated_user: nil %>
      <%= render "comments/record_section_fields", f: f %>

      <div class="flex shrink-0 items-center gap-x-2">
        <%= f.button :submit, "Save", class: button_classes(:secondary_outline, size: :sm) %>
        <%= link_to "Cancel", new_comment_path(commentable_sgid: record.to_sgid.to_s, cancel: 1),
              class: "text-sm #{eyebrow_link_class}", data: { turbo_stream: true } %>
      </div>
    </div>
  <% end %>
</div>

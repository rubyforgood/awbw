<% record = local_assigns[:record] || comment.commentable %>
<% persisted = comment.persisted? %>
<% form_url = persisted ? comment_path(comment) : comments_path %>
<% cancel_path = persisted ? inline_record_path(record, fallback: comment_path(comment)) : inline_record_path(record, fallback: comments_path) %>
<% cancel_slot = local_assigns[:cancel_slot] %>
<% frame_data = turbo_frame_request? ? {} : { turbo_frame: "_top" } %>
<% field_class = "w-full bg-white rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none" %>
<% created_user = persisted ? comment.created_by : current_user %>
<% updated_user = persisted ? comment.updated_by : nil %>
<% show_updated = updated_user.present? && updated_user != created_user %>
<% created_name = person_name(created_user) %>
<% created_first_name = created_user&.person&.first_name || created_user&.name.to_s.split.first %>
<% created_color = chip_color(created_user&.id) %>
<% updated_color = show_updated ? chip_color(updated_user.id) : nil %>

<%= turbo_frame_tag frame_id do %>
  <div class="rounded-md border <%= comment_card_class(warning: comment.body&.include?("[AGE_RANGE_DATA]")) %> px-3 py-2">
    <%= simple_form_for comment, url: form_url, data: frame_data do |f| %>
      <%= render "shared/errors", resource: comment if comment.errors.any? %>

      <%= hidden_field_tag :commentable_sgid, record.to_sgid.to_s unless persisted %>
      <%= hidden_field_tag :inline, 1 %>

      <div class="flex flex-wrap items-start gap-x-1 gap-y-1">
        <%= render "comments_and_communications/entry_date", time: (comment.created_at || Time.current) %>

        <span class="inline-flex w-20 shrink-0 items-center gap-x-1">
          <% if show_updated %>
            <span class="<%= created_color[0] %> <%= created_color[1] %> w-1/2 cursor-default truncate rounded px-1.5 py-0.5 text-center text-xs" title="<%= created_name %>"><%= created_user&.decorate&.initials.presence || "--" %></span>
            <span class="<%= updated_color[0] %> <%= updated_color[1] %> w-1/2 cursor-default truncate rounded px-1.5 py-0.5 text-center text-xs" title="Edited by <%= person_name(updated_user) %>"><%= updated_user.decorate.initials.presence || "--" %></span>
          <% else %>
            <span class="<%= created_color[0] %> <%= created_color[1] %> max-w-full cursor-default truncate rounded px-1.5 py-0.5 text-left text-xs" title="<%= created_name %>"><%= truncate(created_first_name.presence || "--", length: 10, omission: "..") %></span>
          <% end %>
        </span>

        <div class="flex min-w-0 grow items-start gap-x-2">
          <div class="w-1/3 shrink-0">
            <%= f.input_field :topic, placeholder: "Topic", class: field_class %>
            <p class="mt-1 text-xs text-gray-500">Reason for this note</p>
          </div>
          <%= f.input_field :body, as: :text, rows: 2, required: true, placeholder: "Type your comment",
                            class: "#{field_class} grow" %>
        </div>

        <div class="flex shrink-0 items-center gap-x-2">
          <%= f.button :submit, "Save", class: button_classes(:secondary_outline, size: :sm) %>
          <% if cancel_slot.present? %>
            <%= link_to "Cancel", new_comment_path(commentable_sgid: record.to_sgid.to_s, cancel: 1),
                  class: "text-sm #{eyebrow_link_class}", data: { turbo_frame: cancel_slot } %>
          <% else %>
            <%= link_to "Cancel", cancel_path, class: "text-sm #{eyebrow_link_class}", data: frame_data %>
          <% end %>
          <% if persisted && turbo_frame_request? %>
            <%= render "comments/delete_link", comment: comment, class_name: "shrink-0 whitespace-nowrap" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

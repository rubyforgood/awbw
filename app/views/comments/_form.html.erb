<%= simple_form_for Comment.new, url: polymorphic_path([commentable, :comments]), html: { class: "mb-6" } do |f| %>
  <%= f.input :body, 
              label: "Add a comment",
              as: :text,
              input_html: { rows: 3, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200" } %>
  
  <%= f.submit "Create Comment", 
               class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
<% end %>

<%= tag.div id: dom_id(comment) do %>
<div class="rounded-md border <%= comment_card_class(warning: comment.body&.include?("[AGE_RANGE_DATA]")) %> px-3 py-2">
  <%= simple_form_for comment, url: url do |f| %>
    <%= render "shared/errors", resource: comment if comment.errors.any? %>

    <div class="flex flex-wrap items-start gap-x-1 gap-y-1">
      <%= render "comments_and_communications/entry_date", time: comment.created_at || Time.current %>
      <%= render "comments/author_chip", created_user: comment.created_by, updated_user: comment.updated_by %>
      <%= render "comments/record_section_fields", f: f %>

      <div class="flex shrink-0 items-center gap-x-2">
        <%= f.button :submit, "Save", class: button_classes(:secondary_outline, size: :sm) %>
        <%= link_to "Cancel", comments_record_section_path(comment, cancel: 1), class: "text-sm #{eyebrow_link_class}", data: { turbo_stream: true } %>
        <%= render "comments/delete_link", comment: comment, delete_path: comments_record_section_path(comment), class_name: "shrink-0 whitespace-nowrap" %>
      </div>
    </div>
  <% end %>
</div>
<% end %>

<div class="mb-4 rounded-lg border-2 border-green-400 bg-green-200 p-4">
  <h3 class="mb-4 text-lg font-medium">New discount</h3>
  <%= form_with model: Discount.new, url: discounts_path do |f| %>
    <%= hidden_field_tag :"discount[allocatable_sgid]", params[:allocatable_sgid] %>

    <div class="grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2">
      <div class="mb-4">
        <%= f.label :amount_dollars, "Amount ($)", class: "block font-medium mb-1 text-gray-700" %>
        <%= f.text_field :amount_dollars,
              class: "w-full bg-white border border-gray-300 rounded-lg px-3 py-2 focus:ring-blue-500 focus:border-blue-500",
              placeholder: "0.00",
              data: { controller: "currency-input", action: "currency-input#format" } %>
      </div>

      <%= render "allocations/allocated_to", allocatable: @allocatable %>
    </div>

    <div class="mt-4 flex gap-2">
      <%= f.submit "Submit", class: button_classes(:primary) %>
      <%= link_to "Cancel", allocations_path(allocatable_sgid: params[:allocatable_sgid]), class: button_classes(:secondary_outline) %>
    </div>
  <% end %>
</div>

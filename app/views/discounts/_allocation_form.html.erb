<div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-4">
  <h3 class="text-lg font-medium mb-4">New Discount</h3>
  <%= form_with model: Discount.new, url: discounts_path, class: "space-y-4" do |f| %>
    <%= hidden_field_tag :"discount[allocatable_sgid]", params[:allocatable_sgid] %>
    <div>
      <%= f.label :amount_dollars, "Amount ($)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :amount_dollars,
            class: "w-full bg-white border border-gray-300 rounded-lg px-3 py-2 focus:ring-blue-500 focus:border-blue-500",
            placeholder: "0.00",
            data: { controller: "currency-input", action: "currency-input#format" } %>
    </div>
    <div class="flex gap-2">
      <%= f.submit "Create Discount", class: "btn btn-primary" %>
      <%= link_to "Cancel", allocations_path(allocatable_sgid: params[:allocatable_sgid]), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>

<%# Shared filter bar for both bulk-payment indexes — the global cross-event
    index and the per-event dashboard — so the two stay in sync. One search box
    spans the payer's name/email, their organization, every submitted answer, and
    the raw metadata. Auto-submits into the results frame on change.
    Locals: url (form action + clear), frame (turbo frame id),
            scoped_to_event (hide the Event picker on the per-event page). %>
<%= form_with url: url, method: :get, autocomplete: "off",
      data: { controller: "collection", turbo_frame: frame },
      class: "border-primary/10 mb-6 rounded-2xl border bg-white p-4 shadow-sm" do %>
  <div class="mb-3 flex items-center gap-2 text-gray-600">
    <i class="fa-solid fa-filter text-xs" aria-hidden="true"></i>
    <span class="text-xs font-semibold tracking-wide uppercase">Filters</span>
  </div>
  <div class="flex flex-wrap items-end gap-3">
    <div class="min-w-44 flex-1">
      <%= label_tag :search, "Search", class: search_label_class %>
      <%= text_field_tag :search, params[:search], placeholder: "Name, email, organization, or details", class: search_field_class %>
    </div>

    <%= render "events/filter_select", param: :payment_method, label: "Payment method",
          options: FormSubmission::PAYMENT_METHOD_FILTER_OPTIONS, selected: params[:payment_method],
          blank: "Any payment method", field_class: search_field_class, wrapper_class: "w-full sm:w-40" %>

    <%= render "events/filter_select", param: :payment_status, label: "Payment status",
          options: FormSubmission::PAYMENT_STATUS_FILTER_OPTIONS, selected: params[:payment_status],
          blank: "Any status", field_class: search_field_class, wrapper_class: "w-full sm:w-40" %>

    <% unless scoped_to_event %>
      <div class="w-full sm:w-44">
        <%= label_tag :event_id, "Event", class: search_label_class %>
        <%= select_tag :event_id,
              options_for_select(Event.where(id: params[:event_id]).map { |event| [ event.name, event.id ] }, params[:event_id]),
              include_blank: true,
              prompt: "Search for an event",
              class: search_field_class,
              data: { controller: "remote-select", remote_select_model_value: "event" } %>
      </div>
    <% end %>

    <%= render "events/filter_date", param: :start_date, label: "Submitted from", field_class: search_field_class, wrapper_class: "w-full sm:w-36" %>

    <%= render "events/filter_date", param: :end_date, label: "Submitted to", field_class: search_field_class, wrapper_class: "w-full sm:w-36" %>

    <div class="flex items-end">
      <%= render "shared/search_clear", url: url %>
    </div>
  </div>
<% end %>

<%= form_tag(story_ideas_path, method: :get, class: "space-y-4", data: { controller: "collection" }) do %>
  <div class="mb-6 flex flex-col md:flex-row md:items-end md:gap-4">
    <!-- Search -->
    <%= render "shared/filter_text", param: :query, label: "Search", submit: true,
          wrapper_class: "mb-3 w-full md:mb-0 md:flex-1" %>

    <!-- Author name -->
    <%= render "shared/filter_text", param: :author_name, label: "Author name", placeholder: "e.g. Jane Doe", submit: true,
          wrapper_class: "mb-3 w-full md:mb-0 md:w-64" %>

    <!-- Organization -->
    <div class="w-full md:w-auto md:min-w-[220px]">
      <%= label_tag :organization_id, "Organization", class: search_label_class %>
      <%= select_tag :organization_id,
                     options_from_collection_for_select(@organizations, :id, :name, params[:organization_id]),
                     include_blank: "All organizations",
                     class: search_field_class(extra: "search-select-placeholder"),
                     onchange: "this.form.submit()" %>
    </div>

    <!-- Clear filters -->
    <div class="w-full md:w-auto">
      <%= render "shared/search_clear", url: story_ideas_path %>
    </div>
  </div>
<% end %>

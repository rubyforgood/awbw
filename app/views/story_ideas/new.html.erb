<% content_for(:page_bg_class, "admin-or-auth") %>
<% intro = capture do %>
    Thank you for sharing your story with us! We read every story that comes in with care and look forward to
    spending time with your submission. Please give us 2-4 weeks to contact you about your story.
    <br><br>
    We encourage you to check out our
    <%= link_to "tips for sharing stories handout", resource_path(1084), class: "text-blue-600 hover:text-blue-800" %>
    as it might be helpful to reference as you prepare to submit your story.
    <br><br>
    For each checkbox you select below, we ask that you write about that in your story. For example, if you select
    Education and Teens, describe how art workshop participants were high school students.
    <br><br>
    <span class="italic">
      Note: edits may be made, and not all stories will be published to the site, but may still be used in other places.
    </span>
<% end %>
<%= render layout: "shared/form_page",
           locals: { domain: :story_ideas, icon: "fas fa-book-open",
                     title: "New #{@story_idea.class.model_name.human.downcase}", intro: intro } do %>
  <%= render "form", story_idea: @story_idea %>
<% end %>

<%= turbo_frame_tag :images_results do %>
  <p class="text-sm text-gray-500 mb-4"><%= @count_display %> <%= "image".pluralize(@images.total_entries) %></p>

  <% if @images.any? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 animate-fade">
      <% AssetDecorator.decorate_collection(@images).each do |image| %>
        <%= render "image_card", image: image %>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-center py-6">No images match your search. Try clearing the filters.</p>
  <% end %>

  <div class="pagination flex justify-center mt-6 w-full"><%= tailwind_paginate @images %></div>
<% end %>

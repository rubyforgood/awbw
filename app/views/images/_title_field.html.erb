<%= turbo_frame_tag dom_id(image.object, "title") do %>
  <%= form_with url: image_path(image.object), method: :patch do %>
    <label class="block text-xs font-semibold uppercase text-gray-400 tracking-wide">Label</label>
    <%= text_field_tag "asset[title]", image.title,
          placeholder: "Add a label",
          onblur: "this.form.requestSubmit()",
          class: "mt-1 w-full text-sm border border-gray-200 rounded-md px-2 py-1
                  focus:ring-blue-500 focus:border-blue-500" %>
  <% end %>
<% end %>

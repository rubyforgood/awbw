<div class="min-h-screen">
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 animate-pulse">
    <% 12.times do %>
      <div class="flex flex-col bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="aspect-square w-full bg-gray-200"></div>
        <div class="flex flex-col gap-2 p-3">
          <div class="h-3 w-16 bg-gray-200 rounded"></div>
          <div class="h-3 w-3/4 bg-gray-200 rounded"></div>
          <div class="h-7 w-full bg-gray-200 rounded"></div>
        </div>
      </div>
    <% end %>
  </div>
</div>
